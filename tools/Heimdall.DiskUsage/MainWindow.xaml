<Window x:Class="Heimdall.DiskUsage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Heimdall.DiskUsage.Models"
        Title="Heimdall Disk Usage"
        Height="720" Width="980"
        MinHeight="480" MinWidth="720"
        Background="#F4F5F7"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D0D4DC" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Drive" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontWeight="SemiBold"/>
                    <ComboBox x:Name="DriveCombo" Grid.Column="1" MinHeight="28" Margin="0,0,10,0"/>
                    <Button x:Name="ScanButton" Grid.Column="2" Content="Scan" MinWidth="88" MinHeight="28"
                            Margin="0,0,6,0" Click="ScanButton_Click" FontWeight="SemiBold"/>
                    <Button x:Name="CancelButton" Grid.Column="3" Content="Cancel" MinWidth="72" MinHeight="28"
                            IsEnabled="False" Click="CancelButton_Click"/>
                </Grid>

                <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                    <CheckBox x:Name="ExcludeSystemCheck"
                              Content="Exclude system folders (Windows, Program Files — not ccmcache)"
                              IsChecked="True" VerticalAlignment="Center" Margin="0,0,18,4"/>

                    <TextBlock Text="Min size" VerticalAlignment="Center" Margin="0,0,6,4"/>
                    <TextBox x:Name="MinSizeBox" Width="64" MinHeight="26" Margin="0,0,4,4"
                             ToolTip="Leave blank for no minimum. Folders smaller than this are hidden unless a child matches."/>
                    <ComboBox x:Name="MinSizeUnit" Width="56" MinHeight="26" Margin="0,0,14,4" SelectedIndex="2">
                        <ComboBoxItem>B</ComboBoxItem>
                        <ComboBoxItem>KB</ComboBoxItem>
                        <ComboBoxItem>MB</ComboBoxItem>
                        <ComboBoxItem>GB</ComboBoxItem>
                        <ComboBoxItem>TB</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Text="Max size" VerticalAlignment="Center" Margin="0,0,6,4"/>
                    <TextBox x:Name="MaxSizeBox" Width="64" MinHeight="26" Margin="0,0,4,4"
                             ToolTip="Leave blank for no maximum."/>
                    <ComboBox x:Name="MaxSizeUnit" Width="56" MinHeight="26" Margin="0,0,10,4" SelectedIndex="2">
                        <ComboBoxItem>B</ComboBoxItem>
                        <ComboBoxItem>KB</ComboBoxItem>
                        <ComboBoxItem>MB</ComboBoxItem>
                        <ComboBoxItem>GB</ComboBoxItem>
                        <ComboBoxItem>TB</ComboBoxItem>
                    </ComboBox>

                    <Button Content="Apply filter" MinHeight="26" MinWidth="90" Margin="0,0,0,4"
                            Click="ApplyFilter_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="4,8,4,0">
            <StackPanel>
                <ProgressBar x:Name="ProgressBar" Height="6" Margin="0,0,0,6"/>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Open folder" MinHeight="26" MinWidth="96" Margin="0,0,6,0"
                                Click="OpenButton_Click"
                                ToolTip="Open selected folder in Explorer (or double-click / Enter)"/>
                        <Button Content="Delete…" MinHeight="26" MinWidth="80"
                                Click="DeleteButton_Click"
                                ToolTip="Send selected folder to Recycle Bin (or press Delete)"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="Pick a drive and click Scan. Network drives are not listed."
                               TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#444"/>
                </DockPanel>
                <TextBlock x:Name="SelectionText" Margin="0,4,0,0" FontFamily="Consolas" FontSize="12"
                           Foreground="#333" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Background="White" BorderBrush="#D0D4DC" BorderThickness="1" CornerRadius="6" Padding="4">
            <TreeView x:Name="FolderTree"
                      BorderThickness="0"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectedItemChanged="FolderTree_SelectedItemChanged"
                      MouseDoubleClick="FolderTree_MouseDoubleClick"
                      KeyDown="FolderTree_KeyDown">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="2,2"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type models:FolderNode}"
                                              ItemsSource="{Binding VisibleChildren}">
                        <DockPanel LastChildFill="True" MinWidth="320" ToolTip="{Binding FullPath}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeLabel}"
                                       FontFamily="Consolas" Foreground="#555" Margin="16,0,4,0"/>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>
    </DockPanel>
</Window>
