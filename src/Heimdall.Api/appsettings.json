{
  "ConnectionStrings": {
    "Heimdall": "Data Source=heimdall.db"
  },
  "Heimdall": {
    "ApiKey": "heimdall-poc-key",
    "UiTheme": "Cosmic",
    "HostnameSerialPattern": "^(?<city>[A-Za-z]{3})(?<chassis>DT|LT)?(?<serial>[A-Za-z0-9\\-]+)$",
    "StaffAccess": {
      "RequireWindowsAuth": true,
      "EmailDomainSuffixes": [],
      "AllowDevBypass": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
