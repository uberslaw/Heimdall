{
  "ConnectionStrings": {
    "Heimdall": "Data Source=heimdall.db",
    "HeimdallSandbox": "Data Source=heimdall-dev.db"
  },
  "Heimdall": {
    "ApiKey": "heimdall-poc-key",
    "DatabaseMode": "live",
    "LiveDashboardUrl": "",
    "DevDashboardUrl": "http://localhost:5080",
    "UiTheme": "Cosmic",
    "RepoRoot": "C:\\Heimdall",
    "ClientPackRelativePath": "dist\\Heimdall-Client",
    "ApiInstallDir": "C:\\Program Files\\Heimdall\\Api",
    "HostnameSerialPattern": "^(?<city>[A-Za-z]{3})(?<chassis>DT|LT)?(?<serial>[A-Za-z0-9\\-]+)$",
    "StaffAccess": {
      "RequireWindowsAuth": true,
      "EmailDomainSuffixes": [ "arup.com" ],
      "AllowDevBypass": false,
      "AdminEmails": [ "christopher.owen@arup.com" ],
      "AdminPreviewMinutes": 30
    },
    "FloodTeamEmails": [],
    "Entra": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecret": "",
      "DefaultNetBiosDomain": "ARUP",
      "_comment": "Do not store ClientSecret here. Run scripts/Protect-HeimdallEntraSecret.ps1 — DPAPI file at %ProgramData%\\Heimdall\\secrets\\entra.json"
    },
    "CatalogBackfill": {
      "Enabled": true,
      "RunOnStartup": true,
      "InitialDelaySeconds": 60,
      "RunHourUtc": 0
    },
    "FleetSnapshotRetention": {
      "Enabled": true,
      "RetentionDays": 90,
      "RunOnStartup": true,
      "InitialDelaySeconds": 90,
      "IntervalHours": 24
    },
    "UsageAnalytics": {
      "Enabled": true,
      "LogClientIp": true,
      "RetentionDays": 90,
      "RetentionEnabled": true,
      "RetentionRunOnStartup": true,
      "RetentionInitialDelaySeconds": 120,
      "RetentionIntervalHours": 24,
      "BeaconMaxEventsPerMinute": 120,
      "BeaconMaxBodyBytes": 16384,
      "HeartbeatSeconds": 30
    },
    "ClientUpdate": {
      "StuckDetectionEnabled": true,
      "ApplyingStuckMinutes": 15,
      "StuckPollMinutes": 2,
      "StuckInitialDelaySeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
