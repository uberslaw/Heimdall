@page
@model DiscoveryModel
@{
    ViewData["Title"] = "Discovery & Classification";
    const int colCount = 7; // Name&Location, Version, Cat, SubCat, Classification, Installs, Actions
    var sort = Model.Sort?.ToLowerInvariant() ?? "name";
    var dir = Model.Dir?.ToLowerInvariant() == "asc" ? "asc" : "desc";
    // First click on a column → descending; same column toggles desc ↔ asc.
    string ToggleDir(string col) => sort == col && dir == "desc" ? "asc" : "desc";
    string SortClass(string col) => sort == col ? (dir == "asc" ? "sorted-asc" : "sorted-desc") : "";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
    <div>
        <h1 class="hd-title mb-1">Discovery &amp; Classification</h1>
        <p class="hd-sub mb-0" id="discovery-stats">
            @if (Model.Tab == "spec-review")
            {
                <span>@Model.SpecPending.Count pending Spec review</span>
                @if (Model.SpecStaleAlerts.Count > 0)
                {
                    <span class="text-warning"> · @Model.SpecStaleAlerts.Count network path(s) unseen 12+ months</span>
                }
                @if (Model.SpecUntamed.Count > 0)
                {
                    <span class="text-secondary"> · @Model.SpecUntamed.Count on machines not in a team</span>
                }
            }
            else
            {
                <span id="discovery-total-count">@Model.TotalCount</span><text> in catalog
                · </text><span id="discovery-unclassified-count" class="@(Model.UnclassifiedCount > 0 ? "text-warning" : "text-secondary")">@Model.UnclassifiedCount</span><text> awaiting classification</text>
                <span id="discovery-pending-wrap" class="text-secondary" style="@(Model.PendingSuggestionCount > 0 ? "" : "display:none")"> · <span id="discovery-pending-count">@Model.PendingSuggestionCount</span> pending suggestion(s)</span>
                @if (Model.BlankPathCount > 0)
                {
                    <span class="text-secondary"> · @Model.BlankPathCount missing path — use <strong>Find missing paths</strong> below, or <a asp-page="/AppLists">Request Inventory</a> on App Lists</span>
                }
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        <a class="hd-btn hd-btn-black" asp-page="/Apps">Application Usage</a>
        <a class="hd-btn hd-btn-black" asp-page="/AppLists">App lists</a>
        <a class="hd-btn hd-btn-black" asp-page="/Help" asp-fragment="discovery" title="How Discovery works">Help</a>
    </div>
</div>

<ul class="nav nav-tabs hd-ops-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model.Tab == "classify" ? "active" : null)"
           asp-page="/Discovery" asp-route-tab="classify">Classify</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Tab == "spec-review" ? "active" : null)"
           asp-page="/Discovery" asp-route-tab="spec-review">
            Spec review
            @if (Model.Tab == "spec-review" && Model.SpecPending.Count > 0)
            {
                <span class="badge text-bg-warning">@Model.SpecPending.Count</span>
            }
        </a>
    </li>
</ul>

<div id="hd-toast-region" class="hd-toast-region">
    @if (TempData["Message"] is string msg)
    {
        <div class="hd-toast hd-toast-success" role="status" data-autodismiss="5000">
            <span>@msg</span>
            <button type="button" class="hd-toast-close" aria-label="Dismiss">&times;</button>
        </div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="hd-toast hd-toast-error" role="alert" data-autodismiss="5000">
            <span>@err</span>
            <button type="button" class="hd-toast-close" aria-label="Dismiss">&times;</button>
        </div>
    }
</div>

@if (Model.Tab == "spec-review")
{
    <partial name="_SpecReview" model="Model" />
}
else
{
<form method="get" class="hd-panel mb-3" id="discovery-filter-form">
    <input type="hidden" name="tab" value="classify" />
    <input type="hidden" name="sort" value="@sort" />
    <input type="hidden" name="dir" value="@dir" />
    <div class="row g-3 align-items-end">
        <div class="col-md-5 col-lg-4">
            <label class="form-label" for="discovery-q">Search</label>
            <div class="input-group">
                <input type="search" class="form-control" name="q" id="discovery-q" value="@Model.Q"
                       placeholder="Name, path, category…" autocomplete="off" />
                <button type="submit" class="hd-btn hd-btn-silver">Search</button>
            </div>
        </div>
        <div class="col-auto">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="blankPathOnly" value="true" id="blank-path-only" @(Model.BlankPathOnly ? "checked" : null) onchange="this.form.submit()" />
                <label class="form-check-label" for="blank-path-only">Missing path only@(Model.BlankPathCount > 0 ? $" ({Model.BlankPathCount})" : "")</label>
            </div>
        </div>
        <div class="col-auto">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="hideIgnored" value="true" id="hide-ignored" @(Model.HideIgnored ? "checked" : null) onchange="this.form.submit()" />
                <label class="form-check-label" for="hide-ignored">Hide ignored@(Model.IgnoredCount > 0 ? $" ({Model.IgnoredCount})" : "")</label>
            </div>
        </div>
        <div class="col-auto">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="showClassified" value="true" id="show-classified" @(Model.ShowClassified ? "checked" : null) onchange="this.form.submit()" />
                <label class="form-check-label" for="show-classified">Show classified</label>
            </div>
        </div>
        <div class="col-auto">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="show-descriptions" />
                <label class="form-check-label" for="show-descriptions">Descriptions</label>
            </div>
        </div>
        <div class="col-auto ms-md-auto">
            <div class="d-flex gap-2 flex-wrap" id="discovery-toolbar">
                @if (Model.BlankPathCount > 0)
                {
                    <button type="submit" form="discovery-find-paths-form" class="hd-btn hd-btn-gold hd-btn-sm"
                            title="Reuse paths from process samples and inventories; request agent inventory where still unknown">
                        Find missing paths (@Model.BlankPathCount)
                    </button>
                }
                @if (Model.PendingSuggestionCount > 0)
                {
                    <button type="button" class="hd-btn hd-btn-gold hd-btn-sm" id="discovery-approve-all-btn"
                            title="Approve pending suggestions in small batches (keeps the API responsive)"
                            data-pending="@Model.PendingSuggestionCount">
                        Approve all (<span id="discovery-approve-all-count">@Model.PendingSuggestionCount</span>)
                    </button>
                }
                <button type="button" class="hd-btn hd-btn-silver hd-btn-sm" id="discovery-edit-btn">Edit</button>
                <button type="submit" form="discovery-save-form" class="hd-btn hd-btn-silver hd-btn-sm" id="discovery-save-btn" disabled>Save</button>
                <button type="button" class="hd-btn hd-btn-rose hd-btn-sm" id="discovery-discard-btn" disabled>Discard</button>
            </div>
        </div>
    </div>
</form>

@if (Model.BlankPathCount > 0)
{
    <form method="post" asp-page-handler="FindPaths" id="discovery-find-paths-form" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="hideIgnored" value="@Model.HideIgnored" />
        <input type="hidden" name="blankPathOnly" value="@Model.BlankPathOnly" />
        <input type="hidden" name="showClassified" value="@Model.ShowClassified" />
        <input type="hidden" name="q" value="@Model.Q" />
        <input type="hidden" name="sort" value="@sort" />
        <input type="hidden" name="dir" value="@dir" />
        <input type="hidden" name="requestInventory" value="true" />
    </form>
}

@if (Model.PendingSuggestionCount > 0)
{
    <form method="post" asp-page-handler="ApproveAll" id="discovery-approve-all-form" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="hideIgnored" value="@Model.HideIgnored" />
        <input type="hidden" name="blankPathOnly" value="@Model.BlankPathOnly" />
        <input type="hidden" name="showClassified" value="@Model.ShowClassified" />
        <input type="hidden" name="q" value="@Model.Q" />
        <input type="hidden" name="sort" value="@sort" />
        <input type="hidden" name="dir" value="@dir" />
    </form>
}

<form method="post" id="discovery-batch-token-form" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="hideIgnored" value="@Model.HideIgnored" />
    <input type="hidden" name="blankPathOnly" value="@Model.BlankPathOnly" />
    <input type="hidden" name="showClassified" value="@Model.ShowClassified" />
    <input type="hidden" name="q" value="@Model.Q" />
    <input type="hidden" name="sort" value="@sort" />
    <input type="hidden" name="dir" value="@dir" />
</form>

<div id="discovery-batch-bar" class="hd-discovery-batch-bar d-none" aria-live="polite">
    <span class="hd-discovery-batch-count" id="discovery-batch-count">0 selected</span>
    <label class="hd-discovery-batch-field">
        <span class="visually-hidden">Batch category</span>
        <select id="discovery-batch-category" class="form-select form-select-sm" aria-label="Batch category">
            <option value="">Category —</option>
            @foreach (var opt in Model.CategoryOptions)
            {
                <option value="@opt">@opt</option>
            }
        </select>
    </label>
    <label class="hd-discovery-batch-field">
        <span class="visually-hidden">Batch subcategory</span>
        <select id="discovery-batch-subcategory" class="form-select form-select-sm" aria-label="Batch subcategory">
            <option value="">Subcategory —</option>
            @foreach (var opt in Model.SubcategoryOptions)
            {
                <option value="@opt">@opt</option>
            }
        </select>
    </label>
    <button type="button" class="hd-btn hd-btn-silver hd-btn-sm" id="discovery-batch-apply-tax" title="Apply Category/Subcategory to selected rows">Apply labels</button>
    <label class="hd-discovery-batch-field">
        <span class="visually-hidden">Batch classification</span>
        <select id="discovery-batch-group" class="form-select form-select-sm" aria-label="Batch classification">
            <option value="CoreWindows">Core Windows</option>
            <option value="Soe">SOE</option>
            <option value="Specialization" selected>Specialization</option>
        </select>
    </label>
    <button type="button" class="hd-btn hd-btn-gold hd-btn-sm" id="discovery-batch-approve" title="Approve pending suggestions on selected rows">Approve</button>
    <button type="button" class="hd-btn hd-btn-silver hd-btn-sm" id="discovery-batch-set" title="Set Classification (+ labels) on selected rows">Set</button>
    <button type="button" class="hd-btn hd-btn-black hd-btn-sm" id="discovery-batch-clear">Clear</button>
</div>

<div class="hd-panel">
    <form method="post" asp-page-handler="SaveAll" id="discovery-save-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="hideIgnored" value="@Model.HideIgnored" />
        <input type="hidden" name="blankPathOnly" value="@Model.BlankPathOnly" />
        <input type="hidden" name="showClassified" value="@Model.ShowClassified" />
        <input type="hidden" name="q" value="@Model.Q" />
        <input type="hidden" name="sort" value="@sort" />
        <input type="hidden" name="dir" value="@dir" />
        <div class="hd-discovery-table-wrap">
            <table class="hd-table mb-0" id="discovery-table">
                <colgroup>
                    <col data-col="location" class="hd-discovery-col-location" />
                    <col data-col="version" class="hd-discovery-col-version" />
                    <col data-col="category" class="hd-discovery-col-category" />
                    <col data-col="subcategory" class="hd-discovery-col-subcategory" />
                    <col data-col="classification" class="hd-discovery-col-classification" />
                    <col data-col="installs" class="hd-discovery-col-installs" />
                    <col data-col="actions" class="hd-discovery-col-actions" />
                </colgroup>
                <thead>
                    <tr>
                        <th class="hd-discovery-location-cell" data-col="location">
                            <a class="hd-discovery-sort-link @SortClass("name")"
                               asp-page="/Discovery"
                               asp-route-q="@Model.Q"
                               asp-route-hideIgnored="@Model.HideIgnored"
                               asp-route-blankPathOnly="@Model.BlankPathOnly"
                               asp-route-showClassified="@Model.ShowClassified"
                               asp-route-sort="name"
                               asp-route-dir="@ToggleDir("name")">Name</a>
                            <span class="text-secondary"> &amp; </span>
                            <a class="hd-discovery-sort-link @SortClass("path")"
                               asp-page="/Discovery"
                               asp-route-q="@Model.Q"
                               asp-route-hideIgnored="@Model.HideIgnored"
                               asp-route-blankPathOnly="@Model.BlankPathOnly"
                               asp-route-showClassified="@Model.ShowClassified"
                               asp-route-sort="path"
                               asp-route-dir="@ToggleDir("path")">Location</a>
                            <span class="hd-col-resize" data-resize="location" title="Drag to resize"></span>
                        </th>
                        <th class="hd-discovery-version-col" data-col="version">
                            <a class="hd-discovery-sort-link @SortClass("version")"
                               asp-page="/Discovery"
                               asp-route-q="@Model.Q"
                               asp-route-hideIgnored="@Model.HideIgnored"
                               asp-route-blankPathOnly="@Model.BlankPathOnly"
                               asp-route-showClassified="@Model.ShowClassified"
                               asp-route-sort="version"
                               asp-route-dir="@ToggleDir("version")">Version</a>
                            <span class="hd-col-resize" data-resize="version" title="Drag to resize"></span>
                        </th>
                        <th class="hd-discovery-cat-col" data-col="category">
                            <a class="hd-discovery-sort-link @SortClass("category")"
                               asp-page="/Discovery"
                               asp-route-q="@Model.Q"
                               asp-route-hideIgnored="@Model.HideIgnored"
                               asp-route-blankPathOnly="@Model.BlankPathOnly"
                               asp-route-showClassified="@Model.ShowClassified"
                               asp-route-sort="category"
                               asp-route-dir="@ToggleDir("category")">Category</a>
                            <span class="hd-col-resize" data-resize="category" title="Drag to resize"></span>
                        </th>
                        <th class="hd-discovery-subcat-col" data-col="subcategory">
                            <a class="hd-discovery-sort-link @SortClass("subcategory")"
                               asp-page="/Discovery"
                               asp-route-q="@Model.Q"
                               asp-route-hideIgnored="@Model.HideIgnored"
                               asp-route-blankPathOnly="@Model.BlankPathOnly"
                               asp-route-showClassified="@Model.ShowClassified"
                               asp-route-sort="subcategory"
                               asp-route-dir="@ToggleDir("subcategory")">Subcategory</a>
                            <span class="hd-col-resize" data-resize="subcategory" title="Drag to resize"></span>
                        </th>
                        <th class="hd-discovery-class-col" data-col="classification">
                            <a class="hd-discovery-sort-link @SortClass("classification")"
                               asp-page="/Discovery"
                               asp-route-q="@Model.Q"
                               asp-route-hideIgnored="@Model.HideIgnored"
                               asp-route-blankPathOnly="@Model.BlankPathOnly"
                               asp-route-showClassified="@Model.ShowClassified"
                               asp-route-sort="classification"
                               asp-route-dir="@ToggleDir("classification")">Classification</a>
                            <span class="hd-col-resize" data-resize="classification" title="Drag to resize"></span>
                        </th>
                        <th class="hd-discovery-installs-col" data-col="installs" title="Number of machines where this process was seen">
                            <a class="hd-discovery-sort-link @SortClass("installs")"
                               asp-page="/Discovery"
                               asp-route-q="@Model.Q"
                               asp-route-hideIgnored="@Model.HideIgnored"
                               asp-route-blankPathOnly="@Model.BlankPathOnly"
                               asp-route-showClassified="@Model.ShowClassified"
                               asp-route-sort="installs"
                               asp-route-dir="@ToggleDir("installs")">Installs</a>
                            <span class="hd-col-resize" data-resize="installs" title="Drag to resize"></span>
                        </th>
                        <th class="hd-discovery-actions-col" data-col="actions"></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="@colCount">@(Model.ShowClassified ? "No processes match." : "No unclassified applications. Pending suggestions stay visible here until Approve or Set. Tick Show classified to browse the full catalog.")</td></tr>
                }
                @for (var i = 0; i < Model.Rows.Count; i++)
                {
                    var r = Model.Rows[i];
                    var versionFull = r.VersionDisplay ?? "—";
                    var hasDescription = !string.IsNullOrWhiteSpace(r.Description);
                    var descText = hasDescription ? r.Description!.Trim() : null;
                    var pathText = string.IsNullOrWhiteSpace(r.Path) ? null : r.Path;
                    var locationTip = descText is not null && pathText is not null
                        ? $"{descText}\n\n{pathText}"
                        : (descText ?? pathText);
                    var hasSuggestion = r.SuggestedGroup is not null;
                    var setFormId = $"discovery-set-{r.Id}";
                    var approveFormId = $"discovery-approve-{r.Id}";
                    var unignoreFormId = $"discovery-unignore-{r.Id}";
                    var findPathFormId = $"discovery-findpath-{r.Id}";
                    var defaultGroup = r.SuggestedGroup?.ToString() ?? "Specialization";
                    <tr class="hd-discovery-main @(r.Ignored ? "hd-row-muted" : null)"
                        data-discovery-id="@r.Id"
                        data-has-description="@(hasDescription ? "true" : "false")"
                        data-has-suggestion="@(hasSuggestion ? "true" : "false")"
                        data-name="@r.Name"
                        data-exe="@r.ExeName"
                        title="Ctrl+click to multi-select · Shift+click for a range">
                        <td class="hd-discovery-location-cell" title="@locationTip">
                            @* disabled until Edit mode so accidental/action posts never include ~6 fields × N rows
                               (ASP.NET FormOptions.ValueCountLimit → HTTP 400 once N ≳ 150). *@
                            <input type="hidden" class="hd-discovery-save-field" name="Edits[@i].Id" value="@r.Id" disabled />
                            <div class="hd-discovery-exe">
                                <code class="hd-discovery-name-display"
                                      data-field="name"
                                      data-id="@r.Id"
                                      title="@(hasDescription ? locationTip : "Double-click to edit name")">@r.Name</code>
                                <input class="form-control form-control-sm hd-discovery-name-input d-none"
                                       type="text" value="@r.Name" maxlength="200"
                                       data-id="@r.Id" data-original="@r.Name" aria-label="Process name" />
                                <input class="form-control form-control-sm hd-discovery-edit hd-discovery-save-field d-none" type="text"
                                       name="Edits[@i].Name" value="@r.Name" maxlength="200"
                                       data-original="@r.Name" data-field="name" disabled />
                            </div>
                            <div class="hd-meta-line hd-discovery-path">
                                @if (string.IsNullOrWhiteSpace(r.Path))
                                {
                                    <span class="text-warning">missing path</span>
                                }
                                else
                                {
                                    @r.Path
                                }
                            </div>
                            @if (hasSuggestion)
                            {
                                <span class="badge-pill badge-group-specialization mt-1"
                                      title="@(r.SuggestionReason ?? "Pending classification")">
                                    suggested: @DiscoveryModel.GroupLabel(r.SuggestedGroup!.Value)
                                </span>
                            }
                            @if (r.Ignored)
                            {
                                <span class="badge-pill badge-ended mt-1">ignored</span>
                            }
                        </td>
                        <td class="hd-discovery-version-col" title="@versionFull">
                            <span class="hd-discovery-read hd-discovery-version-text"
                                  data-field="version">@versionFull</span>
                            <input class="form-control form-control-sm hd-discovery-edit hd-discovery-save-field d-none hd-discovery-version-input" type="text"
                                   name="Edits[@i].Version" value="@r.ManualVersion"
                                   placeholder="@(r.VersionDisplay ?? "-")" maxlength="50"
                                   data-original="@(r.ManualVersion ?? "")" data-field="version" disabled />
                        </td>
                        <td class="hd-discovery-cat-col" title="@(r.Category ?? "")">
                            @if (!r.Ignored)
                            {
                                <select class="form-select form-select-sm hd-discovery-tax-select"
                                        form="@setFormId"
                                        name="category"
                                        aria-label="Category for @r.Name"
                                        data-field="category"
                                        data-id="@r.Id">
                                    <option value="">—</option>
                                    @foreach (var opt in Model.CategoryOptions)
                                    {
                                        if (string.Equals(r.Category, opt, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <option value="@opt" selected>@opt</option>
                                        }
                                        else
                                        {
                                            <option value="@opt">@opt</option>
                                        }
                                    }
                                    @if (!string.IsNullOrWhiteSpace(r.Category)
                                         && !Model.CategoryOptions.Contains(r.Category, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <option value="@r.Category" selected>@r.Category</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <span class="text-secondary">@(r.Category ?? "—")</span>
                            }
                            <input class="form-control form-control-sm hd-discovery-edit hd-discovery-save-field d-none" type="text"
                                   name="Edits[@i].Category" value="@r.Category" maxlength="100"
                                   data-original="@(r.Category ?? "")" data-field="category" disabled />
                        </td>
                        <td class="hd-discovery-subcat-col" title="@(r.Subcategory ?? "")">
                            @if (!r.Ignored)
                            {
                                <select class="form-select form-select-sm hd-discovery-tax-select"
                                        form="@setFormId"
                                        name="subcategory"
                                        aria-label="Subcategory for @r.Name"
                                        data-field="subcategory"
                                        data-id="@r.Id">
                                    <option value="">—</option>
                                    @foreach (var opt in Model.SubcategoryOptions)
                                    {
                                        if (string.Equals(r.Subcategory, opt, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <option value="@opt" selected>@opt</option>
                                        }
                                        else
                                        {
                                            <option value="@opt">@opt</option>
                                        }
                                    }
                                    @if (!string.IsNullOrWhiteSpace(r.Subcategory)
                                         && !Model.SubcategoryOptions.Contains(r.Subcategory, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <option value="@r.Subcategory" selected>@r.Subcategory</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <span class="text-secondary">@(r.Subcategory ?? "—")</span>
                            }
                            <input class="form-control form-control-sm hd-discovery-edit hd-discovery-save-field d-none" type="text"
                                   name="Edits[@i].Subcategory" value="@r.Subcategory" maxlength="100"
                                   data-original="@(r.Subcategory ?? "")" data-field="subcategory" disabled />
                        </td>
                        <td class="hd-discovery-class-col">
                            @if (!r.Ignored)
                            {
                                <select class="form-select form-select-sm hd-discovery-group-select"
                                        form="@setFormId"
                                        name="group"
                                        aria-label="Classification for @r.Name"
                                        data-id="@r.Id">
                                    @if (defaultGroup == "CoreWindows")
                                    {
                                        <option value="CoreWindows" selected>Core Windows</option>
                                    }
                                    else
                                    {
                                        <option value="CoreWindows">Core Windows</option>
                                    }
                                    @if (defaultGroup == "Soe")
                                    {
                                        <option value="Soe" selected>SOE</option>
                                    }
                                    else
                                    {
                                        <option value="Soe">SOE</option>
                                    }
                                    @if (defaultGroup == "Specialization")
                                    {
                                        <option value="Specialization" selected>Specialization</option>
                                    }
                                    else
                                    {
                                        <option value="Specialization">Specialization</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </td>
                        <td class="hd-discovery-installs-col" title="@(r.SeenHosts.Count == 0 ? "Not tied to a specific host yet" : string.Join(", ", r.SeenHosts))">
                            @r.SeenHosts.Count
                        </td>
                        <td class="hd-discovery-actions-col">
                            @if (r.Ignored)
                            {
                                <button type="submit" form="@unignoreFormId"
                                        class="hd-btn hd-btn-silver hd-btn-sm hd-discovery-action-btn">
                                    Restore
                                </button>
                            }
                            else if (hasSuggestion)
                            {
                                <button type="submit" form="@approveFormId"
                                        class="hd-btn hd-btn-gold hd-btn-sm hd-discovery-action-btn hd-discovery-approve-btn"
                                        data-approve-id="@r.Id"
                                        title="@(r.SuggestionReason ?? "Approve suggested group")">
                                    Approve
                                </button>
                                <button type="submit" form="@setFormId"
                                        class="hd-btn hd-btn-silver hd-btn-sm hd-discovery-action-btn hd-discovery-set-btn"
                                        data-set-id="@r.Id"
                                        title="Apply Classification dropdown (and current Category/Subcategory)">
                                    Set
                                </button>
                            }
                            else
                            {
                                <button type="submit" form="@setFormId"
                                        class="hd-btn hd-btn-silver hd-btn-sm hd-discovery-action-btn hd-discovery-set-btn"
                                        data-set-id="@r.Id"
                                        title="Apply Classification dropdown (and current Category/Subcategory)">
                                    Set
                                </button>
                            }
                            @if (!r.Ignored && string.IsNullOrWhiteSpace(r.Path))
                            {
                                <button type="submit" form="@findPathFormId"
                                        class="hd-btn hd-btn-silver hd-btn-sm hd-discovery-action-btn"
                                        title="Search process samples and inventories for this executable path">
                                    Find path
                                </button>
                            }
                        </td>
                    </tr>
                    <tr class="hd-discovery-desc d-none"
                        data-discovery-desc-for="@r.Id"
                        data-has-description="@(hasDescription ? "true" : "false")">
                        <td colspan="@colCount" class="hd-discovery-desc-cell">
                            <span class="hd-discovery-read hd-meta-line" data-field="description">@(r.Description ?? "")</span>
                            <textarea class="form-control form-control-sm hd-discovery-edit hd-discovery-save-field d-none" rows="2"
                                      name="Edits[@i].Description" maxlength="2000"
                                      data-original="@(r.Description ?? "")" data-field="description"
                                      placeholder="Description" disabled>@r.Description</textarea>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </form>

    @* Per-row action forms (cannot nest inside SaveAll). Buttons/selects use form= attribute.
       Approve/Restore/FindPath must NOT post via SaveAll — that posts every Edits[*] field and
       exceeds ASP.NET Core's default FormOptions.ValueCountLimit (1024), which returns HTTP 400. *@
    @foreach (var r in Model.Rows)
    {
        if (r.Ignored)
        {
            <form method="post" asp-page-handler="Unignore" id="discovery-unignore-@r.Id" class="d-none">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@r.Id" />
                <input type="hidden" name="hideIgnored" value="@Model.HideIgnored" />
                <input type="hidden" name="blankPathOnly" value="@Model.BlankPathOnly" />
                <input type="hidden" name="showClassified" value="@Model.ShowClassified" />
                <input type="hidden" name="q" value="@Model.Q" />
                <input type="hidden" name="sort" value="@sort" />
                <input type="hidden" name="dir" value="@dir" />
            </form>
        }
        else
        {
            <form method="post" asp-page-handler="Set" id="discovery-set-@r.Id" class="d-none" data-discovery-set-form="@r.Id">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@r.Id" />
                <input type="hidden" name="hideIgnored" value="@Model.HideIgnored" />
                <input type="hidden" name="blankPathOnly" value="@Model.BlankPathOnly" />
                <input type="hidden" name="showClassified" value="@Model.ShowClassified" />
                <input type="hidden" name="q" value="@Model.Q" />
                <input type="hidden" name="sort" value="@sort" />
                <input type="hidden" name="dir" value="@dir" />
            </form>
            @if (r.SuggestedGroup is not null)
            {
                <form method="post" asp-page-handler="Approve" id="discovery-approve-@r.Id" class="d-none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@r.Id" />
                    <input type="hidden" name="hideIgnored" value="@Model.HideIgnored" />
                    <input type="hidden" name="blankPathOnly" value="@Model.BlankPathOnly" />
                    <input type="hidden" name="showClassified" value="@Model.ShowClassified" />
                    <input type="hidden" name="q" value="@Model.Q" />
                    <input type="hidden" name="sort" value="@sort" />
                    <input type="hidden" name="dir" value="@dir" />
                </form>
            }
            @if (string.IsNullOrWhiteSpace(r.Path))
            {
                <form method="post" asp-page-handler="FindPath" id="discovery-findpath-@r.Id" class="d-none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@r.Id" />
                    <input type="hidden" name="hideIgnored" value="@Model.HideIgnored" />
                    <input type="hidden" name="blankPathOnly" value="@Model.BlankPathOnly" />
                    <input type="hidden" name="showClassified" value="@Model.ShowClassified" />
                    <input type="hidden" name="q" value="@Model.Q" />
                    <input type="hidden" name="sort" value="@sort" />
                    <input type="hidden" name="dir" value="@dir" />
                </form>
            }
        }
    }

    <p class="text-secondary small mt-3 mb-0">
        Default list is unclassified apps plus pending suggestions. <strong>Approve</strong> commits one import/AI suggestion;
        <strong>Approve all</strong> commits every pending suggestion in small batches (not only the current filter).
        <strong>Ctrl+click</strong> / <strong>Shift+click</strong> rows to multi-select, then use the batch bar for Category/Subcategory, Approve, or Set.
        Pick <strong>Classification</strong>, <strong>Category</strong>, and <strong>Subcategory</strong>, then click <strong>Set</strong> to apply all three.
        Double-click a name to rename. <strong>Installs</strong> is machines that reported the process (hover for hosts).
        <strong>Find missing paths</strong> reuses agent-reported paths from samples/inventories (and can request inventory where still unknown).
        Drag column borders to resize (saved for this browser session).
    </p>
</div>
}

@section Scripts {
@if (Model.Tab == "classify")
{
    <script>
(() => {
  document.querySelectorAll('.hd-toast[data-autodismiss]').forEach((toast) => {
    const dismiss = () => {
      toast.classList.add('hd-toast-hide');
      setTimeout(() => toast.remove(), 300);
    };
    const ms = parseInt(toast.dataset.autodismiss, 10) || 5000;
    const timer = setTimeout(dismiss, ms);
    toast.querySelector('.hd-toast-close')?.addEventListener('click', () => { clearTimeout(timer); dismiss(); });
  });

  const table = document.getElementById('discovery-table');
  const editBtn = document.getElementById('discovery-edit-btn');
  const saveBtn = document.getElementById('discovery-save-btn');
  const discardBtn = document.getElementById('discovery-discard-btn');
  const saveForm = document.getElementById('discovery-save-form');
  const descToggle = document.getElementById('show-descriptions');
  const descStorageKey = 'hd-discovery-show-descriptions';
  const colWidthKey = 'hd-discovery-col-widths';
  const filterForm = document.getElementById('discovery-filter-form');
  const qInput = document.getElementById('discovery-q');
  let editing = false;

  qInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      filterForm?.submit();
    }
  });

  function mainRows() {
    return [...table.querySelectorAll('tbody tr.hd-discovery-main')];
  }

  function descRowFor(id) {
    return table.querySelector(`tr.hd-discovery-desc[data-discovery-desc-for="${id}"]`);
  }

  function descriptionsWanted() {
    return !!descToggle?.checked;
  }

  function syncDescriptionVisibility() {
    const show = editing || descriptionsWanted();
    mainRows().forEach(row => {
      const desc = descRowFor(row.dataset.discoveryId);
      if (!desc) return;
      if (editing) {
        desc.classList.remove('d-none');
        desc.style.display = '';
        return;
      }
      if (show && desc.dataset.hasDescription === 'true') {
        desc.classList.remove('d-none');
        desc.style.display = '';
      } else {
        desc.classList.add('d-none');
        desc.style.display = '';
      }
    });
  }

  if (descToggle) {
    descToggle.checked = sessionStorage.getItem(descStorageKey) === '1';
    descToggle.addEventListener('change', () => {
      sessionStorage.setItem(descStorageKey, descToggle.checked ? '1' : '0');
      syncDescriptionVisibility();
    });
  }

  function setEditing(on) {
    editing = on;
    table.classList.toggle('hd-discovery-editing', on);
    editBtn.disabled = on;
    saveBtn.disabled = !on;
    discardBtn.disabled = !on;

    table.querySelectorAll('.hd-discovery-read').forEach(el => el.classList.toggle('d-none', on));
    table.querySelectorAll('.hd-discovery-edit').forEach(el => el.classList.toggle('d-none', !on));
    // SaveAll fields stay disabled until Edit so Approve/Set/FindPath never post ~6×N values (HTTP 400).
    table.querySelectorAll('.hd-discovery-save-field').forEach(el => { el.disabled = !on; });
    // During Edit, free-text Category/Subcategory inputs replace the Set dropdowns.
    table.querySelectorAll('.hd-discovery-tax-select').forEach(el => el.classList.toggle('d-none', on));
    syncDescriptionVisibility();
  }

  editBtn?.addEventListener('click', () => setEditing(true));

  discardBtn?.addEventListener('click', () => {
    table.querySelectorAll('.hd-discovery-edit').forEach(el => {
      el.value = el.dataset.original ?? '';
    });
    setEditing(false);
    saveBtn.disabled = true;
  });

  saveForm?.addEventListener('submit', () => {
    // Belt-and-suspenders: disabled fields are omitted from POST.
    table?.querySelectorAll('.hd-discovery-save-field').forEach(el => { el.disabled = false; });
  });

  saveForm?.querySelectorAll('.hd-discovery-edit').forEach(el => {
    el.addEventListener('input', () => {
      if (editing) saveBtn.disabled = false;
      if (el.dataset.field === 'description') {
        const row = el.closest('tr.hd-discovery-desc');
        if (row) {
          row.dataset.hasDescription = el.value.trim() ? 'true' : 'false';
          const main = table.querySelector(`tr.hd-discovery-main[data-discovery-id="${row.dataset.discoveryDescFor}"]`);
          if (main) main.dataset.hasDescription = row.dataset.hasDescription;
        }
      }
    });
  });

  // While editing, free-text Category/Subcategory must win over the (hidden) selects on Set.
  document.querySelectorAll('form[data-discovery-set-form]').forEach(form => {
    form.addEventListener('submit', () => {
      if (!editing) return;
      const id = form.dataset.discoverySetForm;
      const row = table?.querySelector(`tr.hd-discovery-main[data-discovery-id="${id}"]`);
      if (!row) return;
      const catInput = row.querySelector('.hd-discovery-edit[data-field="category"]');
      const subInput = row.querySelector('.hd-discovery-edit[data-field="subcategory"]');
      const catSelect = row.querySelector('.hd-discovery-tax-select[data-field="category"]');
      const subSelect = row.querySelector('.hd-discovery-tax-select[data-field="subcategory"]');
      if (catSelect && catInput) {
        const v = catInput.value || '';
        if (v && ![...catSelect.options].some(o => o.value === v)) {
          catSelect.add(new Option(v, v, true, true));
        }
        catSelect.value = v;
        catSelect.disabled = false;
      }
      if (subSelect && subInput) {
        const v = subInput.value || '';
        if (v && ![...subSelect.options].some(o => o.value === v)) {
          subSelect.add(new Option(v, v, true, true));
        }
        subSelect.value = v;
        subSelect.disabled = false;
      }
    });
  });

  // Double-click name → inline rename via AJAX
  async function saveName(id, name, displayEl, inputEl) {
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const body = new URLSearchParams();
    body.set('id', id);
    body.set('name', name);
    body.set('ajax', '1');
    if (token) body.set('__RequestVerificationToken', token);
    try {
      const res = await fetch('?handler=SaveName', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'RequestVerificationToken': token || '',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Save failed');
      displayEl.textContent = data.name;
      inputEl.dataset.original = data.name;
      const bulk = displayEl.closest('tr')?.querySelector('.hd-discovery-edit[data-field="name"]');
      if (bulk) {
        bulk.value = data.name;
        bulk.dataset.original = data.name;
      }
    } catch (err) {
      alert(err.message || 'Could not save name');
      inputEl.value = inputEl.dataset.original || displayEl.textContent;
    }
  }

  function showToast(text, kind) {
    const region = document.getElementById('hd-toast-region');
    if (!region) return;
    const toast = document.createElement('div');
    toast.className = `hd-toast hd-toast-${kind === 'error' ? 'error' : 'success'}`;
    toast.setAttribute('role', kind === 'error' ? 'alert' : 'status');
    toast.dataset.autodismiss = '5000';
    toast.innerHTML = `<span></span><button type="button" class="hd-toast-close" aria-label="Dismiss">&times;</button>`;
    toast.querySelector('span').textContent = text;
    region.appendChild(toast);
    const dismiss = () => {
      toast.classList.add('hd-toast-hide');
      setTimeout(() => toast.remove(), 300);
    };
    const timer = setTimeout(dismiss, 5000);
    toast.querySelector('.hd-toast-close')?.addEventListener('click', () => { clearTimeout(timer); dismiss(); });
  }

  function updateDiscoveryCounts(pending, unclassified) {
    const pendingEl = document.getElementById('discovery-pending-count');
    const pendingWrap = document.getElementById('discovery-pending-wrap');
    const unclassifiedEl = document.getElementById('discovery-unclassified-count');
    let approveAllBtn = document.getElementById('discovery-approve-all-btn');
    if (typeof pending === 'number') {
      if (pendingEl) pendingEl.textContent = String(pending);
      if (pendingWrap) pendingWrap.style.display = pending > 0 ? '' : 'none';
      if (approveAllBtn) {
        if (pending <= 0) {
          approveAllBtn.remove();
          document.getElementById('discovery-approve-all-form')?.remove();
          approveAllBtn = null;
        } else {
          approveAllBtn.dataset.pending = String(pending);
          restoreApproveAllLabel(approveAllBtn, pending);
        }
      }
    }
    if (typeof unclassified === 'number' && unclassifiedEl) {
      unclassifiedEl.textContent = String(unclassified);
      unclassifiedEl.classList.toggle('text-warning', unclassified > 0);
      unclassifiedEl.classList.toggle('text-secondary', unclassified <= 0);
    }
  }

  function restoreApproveAllLabel(btn, pending) {
    if (!btn) return;
    btn.innerHTML = `Approve all (<span id="discovery-approve-all-count">${pending}</span>)`;
    btn.dataset.pending = String(pending);
  }

  function applyRowActionResult(id, data, form, opts) {
    const quiet = opts && opts.quiet;
    const forceRemove = opts && opts.forceRemove;
    const row = table?.querySelector(`tr.hd-discovery-main[data-discovery-id="${id}"]`);
    const desc = descRowFor(id);
    const shouldRemove = forceRemove || data.removeRow;
    if (shouldRemove) {
      row?.remove();
      desc?.remove();
      form?.remove();
      document.getElementById(`discovery-set-${id}`)?.remove();
      document.getElementById(`discovery-approve-${id}`)?.remove();
      selectedIds.delete(String(id));
      if (table && !table.querySelector('tbody tr.hd-discovery-main')) {
        const tbody = table.querySelector('tbody');
        if (tbody) {
          const empty = document.createElement('tr');
          empty.innerHTML = '<td colspan="@colCount">No unclassified applications. Pending suggestions stay visible here until Approve or Set. Tick Show classified to browse the full catalog.</td>';
          tbody.appendChild(empty);
        }
      }
    } else if (row) {
      row.dataset.hasSuggestion = 'false';
      row.querySelector('.badge-pill.badge-group-specialization')?.remove();
      row.querySelector('.hd-discovery-approve-btn')?.remove();
      document.getElementById(`discovery-approve-${id}`)?.remove();
      if (data.groupLabel && data.group) {
        const sel = row.querySelector('.hd-discovery-group-select');
        if (sel) sel.value = data.group;
      }
      if (data.setCategory !== false && 'category' in data) {
        const cat = row.querySelector('.hd-discovery-tax-select[data-field="category"]');
        if (cat) cat.value = data.category || '';
      }
      if (data.setSubcategory !== false && 'subcategory' in data) {
        const sub = row.querySelector('.hd-discovery-tax-select[data-field="subcategory"]');
        if (sub) sub.value = data.subcategory || '';
      }
    }
    if (!quiet) {
      updateDiscoveryCounts(data.pendingSuggestionCount, data.unclassifiedCount);
      if (data.message) showToast(data.message, 'success');
    }
  }

  function antiforgeryToken(form) {
    return form?.querySelector('input[name="__RequestVerificationToken"]')?.value
      || document.querySelector('input[name="__RequestVerificationToken"]')?.value
      || '';
  }

  function appendFilterFields(body, form) {
    for (const name of ['hideIgnored', 'blankPathOnly', 'showClassified', 'q', 'sort', 'dir']) {
      const el = form?.querySelector(`[name="${name}"]`);
      if (el) body.set(name, el.value);
    }
  }

  async function postDiscovery(handler, bodyBuilder) {
    const form = document.getElementById('discovery-batch-token-form')
      || document.getElementById('discovery-approve-all-form')
      || document.getElementById('discovery-save-form');
    const token = antiforgeryToken(form);
    const body = new URLSearchParams();
    body.set('ajax', '1');
    appendFilterFields(body, form);
    if (token) body.set('__RequestVerificationToken', token);
    bodyBuilder(body);
    const res = await fetch(`?handler=${handler}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'RequestVerificationToken': token,
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
      },
      body
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || !data.ok) throw new Error(data.error || `Request failed (HTTP ${res.status})`);
    return data;
  }

  // --- Multi-select (Ctrl+click toggle, Shift+click range) ---
  const selectedIds = new Set();
  let selectionAnchorId = null;
  const batchBar = document.getElementById('discovery-batch-bar');
  const batchCountEl = document.getElementById('discovery-batch-count');

  function syncSelectionUi() {
    mainRows().forEach(row => {
      const id = row.dataset.discoveryId;
      row.classList.toggle('hd-discovery-selected', selectedIds.has(id));
      row.setAttribute('aria-selected', selectedIds.has(id) ? 'true' : 'false');
    });
    const n = selectedIds.size;
    if (batchBar) batchBar.classList.toggle('d-none', n === 0);
    if (batchCountEl) batchCountEl.textContent = n === 1 ? '1 selected' : `${n} selected`;
  }

  function clearSelection() {
    selectedIds.clear();
    selectionAnchorId = null;
    syncSelectionUi();
  }

  function isInteractiveTarget(el) {
    return !!el.closest('a, button, input, select, textarea, label, .hd-col-resize, .hd-discovery-action-btn');
  }

  table?.addEventListener('click', (e) => {
    const row = e.target.closest('tr.hd-discovery-main');
    if (!row || !table.contains(row)) return;
    if (isInteractiveTarget(e.target)) return;
    if (!(e.ctrlKey || e.metaKey || e.shiftKey)) return;

    e.preventDefault();
    const id = row.dataset.discoveryId;
    if (!id) return;
    const rows = mainRows();
    const ids = rows.map(r => r.dataset.discoveryId);

    if (e.shiftKey && selectionAnchorId) {
      const a = ids.indexOf(selectionAnchorId);
      const b = ids.indexOf(id);
      if (a >= 0 && b >= 0) {
        const [lo, hi] = a < b ? [a, b] : [b, a];
        if (!(e.ctrlKey || e.metaKey)) selectedIds.clear();
        for (let i = lo; i <= hi; i++) selectedIds.add(ids[i]);
      }
    } else if (e.ctrlKey || e.metaKey) {
      if (selectedIds.has(id)) selectedIds.delete(id);
      else selectedIds.add(id);
      selectionAnchorId = id;
    }
    syncSelectionUi();
  });

  document.getElementById('discovery-batch-clear')?.addEventListener('click', clearSelection);

  document.getElementById('discovery-batch-apply-tax')?.addEventListener('click', async () => {
    const ids = [...selectedIds];
    if (ids.length === 0) return;
    const cat = document.getElementById('discovery-batch-category')?.value ?? '';
    const sub = document.getElementById('discovery-batch-subcategory')?.value ?? '';
    try {
      const data = await postDiscovery('BatchTaxonomy', body => {
        for (const id of ids) body.append('ids', id);
        body.set('category', cat);
        body.set('subcategory', sub);
        body.set('setCategory', 'true');
        body.set('setSubcategory', 'true');
      });
      for (const id of (data.updatedIds || ids)) {
        applyRowActionResult(id, {
          category: data.category,
          subcategory: data.subcategory,
          setCategory: data.setCategory,
          setSubcategory: data.setSubcategory,
          removeRow: false
        }, null, { quiet: true });
      }
      showToast(data.message || 'Labels updated.', 'success');
    } catch (err) {
      showToast(err.message || 'Batch label update failed', 'error');
    }
  });

  document.getElementById('discovery-batch-approve')?.addEventListener('click', async () => {
    const ids = [...selectedIds];
    if (ids.length === 0) return;
    const withSuggestion = ids.filter(id => {
      const row = table?.querySelector(`tr.hd-discovery-main[data-discovery-id="${id}"]`);
      return row?.dataset.hasSuggestion === 'true';
    });
    if (withSuggestion.length === 0) {
      showToast('No pending suggestions on the selected rows.', 'error');
      return;
    }
    try {
      const data = await postDiscovery('BatchApprove', body => {
        for (const id of withSuggestion) body.append('ids', id);
      });
      const showClassified = /^(true|1)$/i.test(String(
        document.getElementById('discovery-batch-token-form')?.querySelector('[name="showClassified"]')?.value || ''));
      for (const id of (data.approvedIds || withSuggestion)) {
        applyRowActionResult(id, {
          removeRow: data.removeRow && !showClassified,
          pendingSuggestionCount: data.pendingSuggestionCount,
          unclassifiedCount: data.unclassifiedCount
        }, document.getElementById(`discovery-approve-${id}`), { quiet: true });
      }
      updateDiscoveryCounts(data.pendingSuggestionCount, data.unclassifiedCount);
      syncSelectionUi();
      showToast(data.message || 'Approved selection.', 'success');
    } catch (err) {
      showToast(err.message || 'Batch approve failed', 'error');
    }
  });

  document.getElementById('discovery-batch-set')?.addEventListener('click', async () => {
    const ids = [...selectedIds];
    if (ids.length === 0) return;
    const group = document.getElementById('discovery-batch-group')?.value || 'Specialization';
    const cat = document.getElementById('discovery-batch-category')?.value ?? '';
    const sub = document.getElementById('discovery-batch-subcategory')?.value ?? '';
    try {
      const data = await postDiscovery('BatchSet', body => {
        for (const id of ids) body.append('ids', id);
        body.set('group', group);
        body.set('category', cat);
        body.set('subcategory', sub);
      });
      const removeSet = new Set((data.removeIds || data.approvedIds || ids).map(String));
      for (const id of removeSet) {
        applyRowActionResult(id, {
          removeRow: !!data.removeRow,
          group: data.group,
          groupLabel: data.groupLabel,
          category: data.category,
          subcategory: data.subcategory,
          pendingSuggestionCount: data.pendingSuggestionCount,
          unclassifiedCount: data.unclassifiedCount
        }, document.getElementById(`discovery-set-${id}`), { quiet: true, forceRemove: !!data.removeRow });
      }
      for (const id of ids) {
        if (removeSet.has(String(id))) continue;
        applyRowActionResult(id, {
          removeRow: false,
          group: data.group,
          groupLabel: data.groupLabel,
          category: data.category,
          subcategory: data.subcategory
        }, null, { quiet: true });
      }
      updateDiscoveryCounts(data.pendingSuggestionCount, data.unclassifiedCount);
      clearSelection();
      showToast(data.message || 'Set selection.', 'success');
    } catch (err) {
      showToast(err.message || 'Batch set failed', 'error');
    }
  });

  // Approve all via AJAX batches — never one giant POST that can lock SQLite / drop the listener.
  // Progress uses server remaining counts (never btn.textContent, which destroyed #discovery-approve-all-count).
  document.getElementById('discovery-approve-all-btn')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const btn = e.currentTarget;
    if (btn.disabled) return;
    let pending = Number(btn.dataset.pending || document.getElementById('discovery-approve-all-count')?.textContent || '0');
    if (pending <= 0) return;
    if (!confirm(`Approve all ${pending} pending suggestion(s) in batches?`)) return;

    const form = document.getElementById('discovery-approve-all-form');
    const token = antiforgeryToken(form);
    const showClassified = /^(true|1)$/i.test(String(form?.querySelector('[name="showClassified"]')?.value || ''));
    btn.disabled = true;
    let totalApproved = 0;
    let remaining = pending;
    const batchSize = 40;
    const statusEl = document.createElement('span');
    statusEl.className = 'hd-discovery-approve-all-status';
    statusEl.setAttribute('aria-live', 'polite');

    const setBusyLabel = (text) => {
      btn.replaceChildren(statusEl);
      statusEl.textContent = text;
    };

    try {
      for (;;) {
        const body = new URLSearchParams();
        body.set('take', String(batchSize));
        body.set('ajax', '1');
        appendFilterFields(body, form);
        if (token) body.set('__RequestVerificationToken', token);

        setBusyLabel(totalApproved === 0
          ? 'Approving…'
          : `Approving… ${totalApproved} done, ${remaining} left`);

        const res = await fetch('?handler=ApproveAll', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'RequestVerificationToken': token,
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
          },
          body
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || `Approve-all batch failed (HTTP ${res.status})`);

        totalApproved += Number(data.approved || 0);
        remaining = Number(data.remaining ?? data.pendingSuggestionCount ?? 0);
        btn.dataset.pending = String(remaining);

        const ids = Array.isArray(data.approvedIds) ? data.approvedIds : [];
        for (const id of ids) {
          applyRowActionResult(id, {
            removeRow: !showClassified,
            pendingSuggestionCount: remaining,
            unclassifiedCount: data.unclassifiedCount
          }, document.getElementById(`discovery-approve-${id}`), { quiet: true });
        }
        updateDiscoveryCounts(remaining, data.unclassifiedCount);

        if (data.done || remaining <= 0) {
          showToast(
            totalApproved === 0
              ? (data.message || 'No pending suggestions to approve.')
              : (totalApproved === 1 ? 'Approved 1 pending suggestion.' : `Approved ${totalApproved} pending suggestions.`),
            'success'
          );
          break;
        }
      }
    } catch (err) {
      btn.disabled = false;
      restoreApproveAllLabel(btn, remaining);
      showToast(err.message || 'Approve all failed — try again (progress is saved).', 'error');
      return;
    }

    if (remaining <= 0) {
      btn.remove();
      form?.remove();
    } else {
      btn.disabled = false;
      restoreApproveAllLabel(btn, remaining);
    }
  });

  // Single Approve via AJAX — avoids full Discovery reload (backfill + catalog + ~400-row HTML).
  document.querySelectorAll('.hd-discovery-approve-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      if (btn.disabled) return;
      const id = btn.dataset.approveId;
      const form = id ? document.getElementById(`discovery-approve-${id}`) : null;
      if (!form || !id) return;

      const token = antiforgeryToken(form);
      const body = new URLSearchParams();
      body.set('id', id);
      body.set('ajax', '1');
      for (const name of ['hideIgnored', 'blankPathOnly', 'showClassified', 'q', 'sort', 'dir']) {
        const el = form.querySelector(`[name="${name}"]`);
        if (el) body.set(name, el.value);
      }
      if (token) body.set('__RequestVerificationToken', token);

      btn.disabled = true;
      try {
        const res = await fetch('?handler=Approve', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'RequestVerificationToken': token,
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
          },
          body
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || 'Approve failed');
        applyRowActionResult(id, data, form);
      } catch (err) {
        btn.disabled = false;
        showToast(err.message || 'Could not approve', 'error');
      }
    });
  });

  // Set via AJAX — same snappy path as Approve.
  document.querySelectorAll('.hd-discovery-set-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      if (btn.disabled) return;
      const id = btn.dataset.setId;
      const form = id ? document.getElementById(`discovery-set-${id}`) : null;
      const row = table?.querySelector(`tr.hd-discovery-main[data-discovery-id="${id}"]`);
      if (!form || !id || !row) return;

      // Mirror Edit-mode free-text Category/Subcategory into the Set selects (same as form submit hook).
      if (editing) {
        const catInput = row.querySelector('.hd-discovery-edit[data-field="category"]');
        const subInput = row.querySelector('.hd-discovery-edit[data-field="subcategory"]');
        const catSelect = row.querySelector('.hd-discovery-tax-select[data-field="category"]');
        const subSelect = row.querySelector('.hd-discovery-tax-select[data-field="subcategory"]');
        if (catSelect && catInput) {
          const v = catInput.value || '';
          if (v && ![...catSelect.options].some(o => o.value === v)) {
            catSelect.add(new Option(v, v, true, true));
          }
          catSelect.value = v;
        }
        if (subSelect && subInput) {
          const v = subInput.value || '';
          if (v && ![...subSelect.options].some(o => o.value === v)) {
            subSelect.add(new Option(v, v, true, true));
          }
          subSelect.value = v;
        }
      }

      const token = antiforgeryToken(form);
      const body = new URLSearchParams();
      body.set('id', id);
      body.set('ajax', '1');
      body.set('group', row.querySelector('.hd-discovery-group-select')?.value || 'Specialization');
      body.set('category', row.querySelector('.hd-discovery-tax-select[data-field="category"]')?.value || '');
      body.set('subcategory', row.querySelector('.hd-discovery-tax-select[data-field="subcategory"]')?.value || '');
      for (const name of ['hideIgnored', 'blankPathOnly', 'showClassified', 'q', 'sort', 'dir']) {
        const el = form.querySelector(`[name="${name}"]`);
        if (el) body.set(name, el.value);
      }
      if (token) body.set('__RequestVerificationToken', token);

      btn.disabled = true;
      try {
        const res = await fetch('?handler=Set', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'RequestVerificationToken': token,
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
          },
          body
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || 'Set failed');
        applyRowActionResult(id, data, form);
        btn.disabled = false;
      } catch (err) {
        btn.disabled = false;
        showToast(err.message || 'Could not set classification', 'error');
      }
    });
  });

  table?.querySelectorAll('.hd-discovery-name-display').forEach(display => {
    const row = display.closest('tr');
    const input = row?.querySelector('.hd-discovery-name-input');
    if (!input) return;

    display.addEventListener('dblclick', () => {
      if (editing) return;
      display.classList.add('d-none');
      input.classList.remove('d-none');
      input.focus();
      input.select();
    });

    const finish = async () => {
      input.classList.add('d-none');
      display.classList.remove('d-none');
      const next = input.value.trim();
      if (!next || next === (input.dataset.original || '')) {
        input.value = input.dataset.original || display.textContent;
        return;
      }
      await saveName(input.dataset.id, next, display, input);
    };

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
      if (e.key === 'Escape') {
        input.value = input.dataset.original || '';
        input.blur();
      }
    });
    input.addEventListener('blur', finish);
  });

  // Column resize (sessionStorage per column)
  (function initColResize() {
    if (!table) return;
    const cols = table.querySelectorAll('colgroup col[data-col]');
    const minWidths = {
      location: 120,
      version: 56,
      category: 64,
      subcategory: 72,
      classification: 110,
      installs: 52,
      actions: 64
    };

    try {
      const saved = JSON.parse(sessionStorage.getItem(colWidthKey) || '{}');
      cols.forEach(col => {
        const key = col.dataset.col;
        if (saved[key] && Number(saved[key]) > 0) {
          col.style.width = `${saved[key]}px`;
        }
      });
    } catch { /* ignore */ }

    function persist() {
      const widths = {};
      cols.forEach(col => {
        const w = col.style.width;
        if (w) widths[col.dataset.col] = parseFloat(w);
      });
      sessionStorage.setItem(colWidthKey, JSON.stringify(widths));
    }

    table.querySelectorAll('.hd-col-resize').forEach(handle => {
      handle.addEventListener('mousedown', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const key = handle.dataset.resize;
        const col = table.querySelector(`colgroup col[data-col="${key}"]`);
        const th = handle.closest('th');
        if (!col || !th) return;
        const startX = e.clientX;
        const startW = th.getBoundingClientRect().width;
        const min = minWidths[key] || 48;

        const onMove = (ev) => {
          const next = Math.max(min, startW + (ev.clientX - startX));
          col.style.width = `${next}px`;
        };
        const onUp = () => {
          document.removeEventListener('mousemove', onMove);
          document.removeEventListener('mouseup', onUp);
          document.body.classList.remove('hd-col-resizing');
          persist();
        };
        document.body.classList.add('hd-col-resizing');
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onUp);
      });
    });
  })();

  syncDescriptionVisibility();
})();
</script>
}
}
