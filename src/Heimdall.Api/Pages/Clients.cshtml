@page
@model ClientsModel
@{
    ViewData["Title"] = "Clients";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <h1 class="hd-title mb-1">Clients</h1>
    <a class="btn btn-ghost btn-sm" asp-page="/Help" asp-fragment="clients">Help</a>
</div>
<p class="hd-sub">
    Agent build reported per host (heartbeat) vs. the current published client pack version
</p>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="hd-panel mb-4">
    <form method="post" asp-page-handler="SetPublishedVersion" class="d-flex flex-wrap align-items-end gap-3">
        <div>
            <div class="hd-settings-label mb-1">Current published client version</div>
            @if (!string.IsNullOrWhiteSpace(Model.PublishedVersion))
            {
                <span class="badge-pill badge-active">@Model.PublishedVersion</span>
            }
            else
            {
                <span class="badge-pill badge-warn">Not set</span>
            }
            @if (Model.PublishedSetUtc is DateTimeOffset setUtc)
            {
                <div class="text-secondary small mt-1">
                    Set @ClientsModel.FormatContact(setUtc)@(string.IsNullOrWhiteSpace(Model.PublishedSetBy) ? "" : $" by {Model.PublishedSetBy}")
                </div>
            }
        </div>
        <div>
            <label class="hd-settings-label mb-1 d-block" for="NewPublishedVersion">Set / override</label>
            <input type="text" class="form-control form-control-sm" id="NewPublishedVersion" name="NewPublishedVersion"
                   placeholder="e.g. 0.1.0" style="width:220px" autocomplete="off" />
        </div>
        <button type="submit" class="btn btn-hd btn-sm">Save</button>
    </form>
    <p class="text-secondary small mt-2 mb-0">
        Set automatically when Launch Control's <strong>Create client pack</strong> can reach this API (best-effort — see
        <code>Publish-ClientVersionToApi</code> in <code>Heimdall-LaunchControl.ps1</code>), or overridden manually here.
        Comparison ignores build metadata after <code>+</code> (e.g. git commit hash), same rule as <code>Heimdall-VersionCompare.ps1</code>.
    </p>
</div>

<div class="hd-grid">
    <div class="hd-stat">
        <div class="label">Machines</div>
        <div class="value">@Model.Rows.Count</div>
    </div>
    <div class="hd-stat">
        <div class="label">Up to date</div>
        <div class="value">@Model.UpToDateCount</div>
    </div>
    <div class="hd-stat">
        <div class="label">Out of date / missing</div>
        <div class="value">@Model.OutOfDateCount</div>
    </div>
    <div class="hd-stat">
        <div class="label">No baseline</div>
        <div class="value">@Model.UnknownCount</div>
    </div>
</div>

<div class="hd-panel">
    <table class="hd-table">
        <thead>
            <tr>
                <th>Status</th>
                <th>Machine</th>
                <th>Group</th>
                <th>Agent version</th>
                <th>Online</th>
                <th>Last contact</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Rows.Count == 0)
        {
            <tr><td colspan="6">No agents reporting yet.</td></tr>
        }
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>
                    <span class="badge-pill @ClientsModel.StatusBadgeClass(r.Status)" title="@r.CoreVersion">
                        @ClientsModel.StatusLabel(r.Status)
                    </span>
                </td>
                <td><a asp-page="/Machine" asp-route-hostname="@r.Hostname"><strong>@r.Hostname</strong></a></td>
                <td class="text-secondary">@(r.MachineGroup ?? "—")</td>
                <td><code>@(r.AgentVersion ?? "—")</code></td>
                <td>
                    @if (r.IsOnline)
                    {
                        <span class="badge-pill badge-active">Online</span>
                    }
                    else
                    {
                        <span class="badge-pill badge-ended">Offline</span>
                    }
                </td>
                <td>@ClientsModel.FormatContact(r.LastSeenUtc)</td>
            </tr>
        }
        </tbody>
    </table>
</div>
