@model IReadOnlyList<Heimdall.Api.Services.MachineHierarchy.CountryNode>
@{
    var selectedCountries = (IReadOnlyCollection<string>?)ViewData["SelectedCountries"] ?? Array.Empty<string>();
    var selectedCities = (IReadOnlyCollection<string>?)ViewData["SelectedCities"] ?? Array.Empty<string>();
    var treeId = (string?)ViewData["LocationTreeId"] ?? "location-filter-tree";
}

@if (Model.Count == 0)
{
    <p class="text-secondary mb-0 small">No location data yet — agents populate Country and city (Office) from region/group.</p>
}
else
{
    <details class="hd-location-filter" id="@treeId-wrap">
        <summary class="hd-location-filter-summary">
            Location
            @if (selectedCountries.Count + selectedCities.Count > 0)
            {
                <span class="badge-pill badge-rdp ms-1">@(selectedCountries.Count + selectedCities.Count) selected</span>
            }
            else
            {
                <span class="text-secondary small ms-1">All</span>
            }
        </summary>
        <div class="hd-tree mt-2" id="@treeId" data-country-input="SelectedCountries" data-city-input="SelectedCities">
            @foreach (var country in Model)
            {
                var countrySelected = selectedCountries.Contains(country.Name, StringComparer.OrdinalIgnoreCase);
                <div class="hd-tree-country" data-country="@country.Name">
                    <label class="hd-tree-node">
                        <input type="checkbox" class="form-check-input hd-tree-check" data-level="country" value="@country.Name"
                               @(countrySelected ? "checked" : null) />
                        <span class="hd-tree-label">@country.Name</span>
                        <span class="hd-tree-meta">country</span>
                    </label>
                    <div class="hd-tree-children">
                        @foreach (var city in country.Cities)
                        {
                            var cityKey = $"{country.Name}/{city.Name}";
                            var citySelected = selectedCities.Contains(cityKey, StringComparer.OrdinalIgnoreCase);
                            <div class="hd-tree-city" data-city="@cityKey">
                                <label class="hd-tree-node">
                                    <input type="checkbox" class="form-check-input hd-tree-check" data-level="city" value="@cityKey"
                                           @(citySelected ? "checked" : null) />
                                    <span class="hd-tree-label">@city.Name</span>
                                    <span class="hd-tree-meta">@city.Machines.Count machine@(city.Machines.Count == 1 ? "" : "s")</span>
                                </label>
                            </div>
                        }
                    </div>
                </div>
            }
            <div class="hd-tree-hidden-inputs" aria-hidden="true"></div>
        </div>
    </details>
}
