@using Heimdall.Api.Data
@using Heimdall.Api.Services
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment
@inject HeimdallDbContext Db
@inject FloodAccessGuard FloodAccess
@inject ApiBuildStamp ApiBuild
@{
    var activeTheme = await ThemeResolution.ResolveAsync(Configuration, Context.Request.Cookies, Db);
    var uiTheme = activeTheme.BasePreset;
    var goldVariant = UiGoldVariant.Resolve(Context.Request.Cookies);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var isCosmic = uiTheme == UiTheme.Cosmic;
    var dbMode = HeimdallDatabaseMode.ResolveEffectiveMode(Configuration, Context.Request.Cookies, Environment);
    var isDevChrome = HeimdallDatabaseMode.ShowDevChrome(Configuration, Context.Request.Cookies, Environment);
    var dbPathDisplay = HeimdallDatabaseMode.GetDisplayDatabasePath(Configuration, dbMode);
    var liveDashboardUrl = Configuration["Heimdall:LiveDashboardUrl"];
    var devDashboardUrl = Configuration["Heimdall:DevDashboardUrl"];
    var isLiveMode = dbMode == HeimdallDatabaseMode.Live;
    var customGoogleFontsUrl = activeTheme.Custom is not null
        ? ThemeFonts.BuildGoogleFontsUrl(activeTheme.Custom.HeadingFont, activeTheme.Custom.BodyFont)
        : null;
    var showFloodNav = FloodAccess.CanAccessFlood(Context);
    var helpFragment = HelpNav.ResolveFragment(Context.Request, ViewData[HelpNav.ViewDataKey]);
}
<!DOCTYPE html>
<html lang="en" class="@(isDevChrome ? "hd-dev-mode" : "")" data-theme="@uiTheme"
      @(isCosmic && !activeTheme.IsCustom ? Html.Raw($"data-gold=\"{goldVariant}\"") : null)
      @(activeTheme.IsCustom ? Html.Raw($"data-custom-theme=\"{activeTheme.Custom!.Id}\"") : null)>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Heimdall</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Serif:wght@600&display=swap" rel="stylesheet" />
    @if (!string.IsNullOrEmpty(customGoogleFontsUrl))
    {
        <link href="@customGoogleFontsUrl" rel="stylesheet" />
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (activeTheme.Custom is not null)
    {
        <style>@Html.Raw(CustomThemeStyle.BuildOverrideStyleBlock(activeTheme.Custom, activeTheme.Custom.Id))</style>
    }
</head>
<body>
    <header class="hd-header">
        <div class="container hd-nav">
            <div class="hd-nav-brand-cluster">
                @if (isDevChrome)
                {
                    <span class="hd-dev-badge" title="Sandbox database — not production agents">DEV</span>
                }
                <a class="hd-brand hd-brand-text" asp-page="/Fleet">Heimdall</a>
                <a class="hd-brand hd-brand-cosmic" asp-page="/Fleet">
                    <img class="hd-brand-logo" src="~/img/heimdall-logo-cosmic.png" alt="Heimdall" width="440" height="144" />
                </a>
                <span class="hd-api-build-stamp"
                      title="API last build (local time) · @ApiBuild.BuiltAtUtc.ToString("yyyy-MM-dd HH:mm") UTC">
                    API last build: @ApiBuild.DisplayLocal
                </span>
            </div>
            <div class="hd-nav-end">
                <nav class="hd-links">
                    @{
                        var fleetPath = Context.Request.Path.Value ?? "";
                        var onFleet = fleetPath.Equals("/Fleet", StringComparison.OrdinalIgnoreCase)
                                      || fleetPath.Equals("/Ops", StringComparison.OrdinalIgnoreCase)
                                      || fleetPath.Equals("/", StringComparison.OrdinalIgnoreCase);
                        var fleetTab = Context.Request.Query["tab"].FirstOrDefault() ?? "machines";
                        fleetTab = FleetModel.NormalizeTab(fleetTab);
                    }
                    <div class="dropdown hd-nav-dropdown">
                        <button class="hd-nav-dropdown-toggle dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Fleet
                        </button>
                        <div class="dropdown-menu hd-nav-dropdown-menu">
                            @foreach (var t in FleetModel.Tabs)
                            {
                                var isActive = onFleet && t.Key == fleetTab;
                                <a class="dropdown-item @(isActive ? "active" : null)"
                                   asp-page="/Fleet"
                                   asp-route-tab="@t.Key">@t.Label</a>
                            }
                        </div>
                    </div>
                    <div class="dropdown hd-nav-dropdown">
                        <button class="hd-nav-dropdown-toggle dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Applications
                        </button>
                        <div class="dropdown-menu hd-nav-dropdown-menu">
                            <a class="dropdown-item" asp-page="/AppLists">Application Lists and Tracking</a>
                            <a class="dropdown-item" asp-page="/Apps">Application Usage</a>
                            <a class="dropdown-item" asp-page="/Discovery">Discovery &amp; Classification</a>
                            <a class="dropdown-item" asp-page="/Socratize">Socratize</a>
                            <a class="dropdown-item" asp-page="/Teams">Teams</a>
                        </div>
                    </div>
                    <div class="dropdown hd-nav-dropdown">
                        <button class="hd-nav-dropdown-toggle dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Staff
                        </button>
                        <div class="dropdown-menu hd-nav-dropdown-menu">
                            <a class="dropdown-item" asp-page="/StaffAccess">Staff Access</a>
                            @if (showFloodNav)
                            {
                                <a class="dropdown-item" asp-page="/Flood">Flood hub</a>
                                <a class="dropdown-item" asp-page="/TuflowRuns">TUFLOW Runs</a>
                            }
                        </div>
                    </div>
                    <div class="dropdown hd-nav-dropdown">
                        <button class="hd-nav-dropdown-toggle dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Admin">
                            Admin
                        </button>
                        <div class="dropdown-menu dropdown-menu-end hd-nav-dropdown-menu hd-settings-menu">
                            <div class="hd-settings-section">
                                <span class="hd-settings-label">Configuration</span>
                                <div class="d-flex flex-column gap-1">
                                    <a class="dropdown-item px-0" asp-page="/Config">Tracking config</a>
                                    <a class="dropdown-item px-0" asp-page="/Utilization">Utilization criteria</a>
                                    <a class="dropdown-item px-0" asp-page="/Finance">Finance</a>
                                </div>
                            </div>
                            <div class="hd-settings-section">
                                <span class="hd-settings-label">Access</span>
                                <div class="d-flex flex-column gap-1">
                                    <a class="dropdown-item px-0" asp-page="/Auth">Auth</a>
                                    <a class="dropdown-item px-0" asp-page="/RemoteAccessGroups">Remote Access Groups</a>
                                </div>
                            </div>
                            <div class="hd-settings-section">
                                <span class="hd-settings-label">Database mode</span>
                                <div class="hd-mode-status small mb-2">
                                    Current:
                                    @if (isLiveMode)
                                    {
                                        <strong>Live</strong>
                                    }
                                    else
                                    {
                                        <strong>Sandbox (DEV)</strong>
                                    }
                                    <div class="text-secondary mt-1"><code class="small">@dbPathDisplay</code></div>
                                </div>
                                @if (isLiveMode)
                                {
                                    <a class="dropdown-item px-0"
                                       href="/database-mode?mode=@HeimdallDatabaseMode.Sandbox&amp;returnUrl=@Uri.EscapeDataString(returnUrl)">
                                        Switch to Dev sandbox
                                    </a>
                                }
                                else
                                {
                                    <a class="dropdown-item px-0"
                                       href="/database-mode?mode=@HeimdallDatabaseMode.Live&amp;returnUrl=@Uri.EscapeDataString(returnUrl)">
                                        Switch to Live
                                    </a>
                                }
                                @if (!string.IsNullOrWhiteSpace(liveDashboardUrl) && !isLiveMode)
                                {
                                    <a class="dropdown-item px-0" href="@liveDashboardUrl" target="_blank" rel="noopener">
                                        Open Live dashboard (other URL)
                                    </a>
                                }
                                @if (!string.IsNullOrWhiteSpace(devDashboardUrl) && isLiveMode)
                                {
                                    <a class="dropdown-item px-0" href="@devDashboardUrl" target="_blank" rel="noopener">
                                        Open Dev dashboard (other URL)
                                    </a>
                                }
                            </div>
                            <div class="hd-settings-section">
                                <a class="dropdown-item px-0" asp-page="/Theme">Theme</a>
                            </div>
                        </div>
                    </div>
                </nav>
                <a class="hd-btn hd-btn-silver hd-btn-sm hd-global-help"
                   asp-page="/Help"
                   asp-fragment="@helpFragment"
                   data-hd-global-help
                   title="Help">Help</a>
            </div>
        </div>
    </header>
    <div class="container py-4">
        <main>
            @RenderBody()
        </main>
    </div>
    <footer class="hd-footer">
        <div class="container">
            <span>Heimdall POC · workstation utilisation for cost justification</span>
        </div>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/hd-duration.js" asp-append-version="true"></script>
    <script src="~/js/hd-table.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
