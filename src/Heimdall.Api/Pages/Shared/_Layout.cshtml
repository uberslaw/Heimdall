<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Heimdall</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Serif:wght@600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="hd-header">
        <div class="container hd-nav">
            <a class="hd-brand" asp-page="/Index">Heimdall</a>
            <nav class="hd-links">
                <a asp-page="/Index">Machines</a>
                <a asp-page="/Sessions">Sessions</a>
                <a asp-page="/Apps">Applications</a>
                <a asp-page="/AppLists">App lists</a>
                <a asp-page="/Cost">Cost</a>
                <a asp-page="/Stats">Stats</a>
                <a asp-page="/Teams">Teams</a>
                <a asp-page="/Utilization">Utilization</a>
                <a asp-page="/Config">Config</a>
            </nav>
        </div>
    </header>
    <div class="container py-4">
        <main>
            @RenderBody()
        </main>
    </div>
    <footer class="hd-footer">
        <div class="container">Heimdall POC · workstation utilisation for cost justification</div>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
