@page
@model FloodModel
@{
    ViewData["Title"] = "Flood";
    var active = Model.ActiveTabKey;
    var titleWord = active switch
    {
        "live" => "Live",
        "historical" => "Historical",
        "sims" => "Fleet Sims",
        "enroll" => "Enrollment",
        _ => "Live"
    };
    var helpFragment = active switch
    {
        "live" or "historical" or "enroll" => "historical-dashboard",
        "sims" => "tuflow-runs",
        _ => "historical-dashboard"
    };
}

<div class="hd-fleet-header mb-3">
    <div class="hd-fleet-header-main">
        <h1 class="hd-title hd-fleet-title mb-0">
            <span class="hd-fleet-title-fleet">Flood</span>
            <span class="hd-fleet-title-page" data-hd-flood-title>@titleWord</span>
        </h1>
        <ul class="nav nav-tabs hd-ops-tabs mb-0" id="hd-ops-tabs" role="tablist">
        @foreach (var t in FloodModel.Tabs)
        {
            var isActive = t.Key == active;
            <li class="nav-item" role="presentation">
                <a class="nav-link @(isActive ? "active" : null)"
                   href="/Flood?tab=@t.Key"
                   data-hd-ops-tab="@t.Key"
                   data-hd-ops-src="@FloodModel.PartialUrl(t.Key, ViewContext.HttpContext.Request)"
                   data-hd-flood-title="@t.Label"
                   data-hd-flood-help="@((t.Key) switch {
                       "sims" => "tuflow-runs",
                       _ => "historical-dashboard"
                   })"
                   role="tab"
                   aria-selected="@(isActive ? "true" : "false")">@t.Label</a>
            </li>
        }
        </ul>
    </div>
    <a class="btn btn-ghost btn-sm hd-fleet-help" asp-page="/Help" asp-fragment="@helpFragment" data-hd-flood-help-link>Help</a>
</div>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="hd-ops-pane" id="hd-ops-pane" data-hd-ops-active="@active" data-hd-ops-base="/Flood" aria-live="polite">
    <div class="hd-ops-loading text-secondary py-4" data-hd-ops-loading>Loading…</div>
    <div class="hd-ops-body" data-hd-ops-body hidden></div>
</div>

@section Scripts {
    <script src="~/js/ops-tabs.js" asp-append-version="true"></script>
    <script>
    (() => {
      const titleEl = document.querySelector('[data-hd-flood-title]');
      const helpLink = document.querySelector('[data-hd-flood-help-link]');
      document.querySelectorAll('[data-hd-ops-tab]').forEach((a) => {
        a.addEventListener('click', () => {
          const t = a.getAttribute('data-hd-flood-title');
          if (titleEl && t) titleEl.textContent = t;
          const frag = a.getAttribute('data-hd-flood-help');
          if (helpLink && frag) {
            const href = helpLink.getAttribute('href') || '/Help';
            helpLink.setAttribute('href', href.split('#')[0] + '#' + frag);
          }
        });
      });
    })();
    </script>
}
