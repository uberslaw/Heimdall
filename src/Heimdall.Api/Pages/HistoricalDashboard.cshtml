@page
@model HistoricalDashboardModel
@using Heimdall.Api.Services
@{
    ViewData["Title"] = "Historical Dashboard";
    ViewData["HelpFragment"] = "historical-dashboard";
    var tab = Model.Tab;
    var isPartial = OpsPartial.IsPartial(ViewContext.HttpContext.Request);
    if (isPartial)
        Layout = null;
}

@if (!isPartial)
{
    <div class="mb-2">
        <h1 class="hd-title mb-1">Historical Dashboard</h1>
        <p class="hd-sub mb-0">Flood TUFLOW fleet · live gauges · historical analytics</p>
    </div>

    <ul class="nav nav-pills gap-2 mb-3 flex-wrap">
        <li class="nav-item">
            <a class="hd-btn @(tab == "live" ? "hd-btn-gold" : "hd-btn-silver")" asp-page="/Flood" asp-route-tab="live">Live Fleet</a>
        </li>
        <li class="nav-item">
            <a class="hd-btn @(tab == "historical" ? "hd-btn-gold" : "hd-btn-silver")" asp-page="/Flood" asp-route-tab="historical" asp-route-histMode="@Model.HistMode" asp-route-period="@Model.Period">Historical Analytics</a>
        </li>
        <li class="nav-item">
            <a class="hd-btn @(tab == "enroll" ? "hd-btn-gold" : "hd-btn-silver")" asp-page="/Flood" asp-route-tab="enroll" asp-route-q="@Model.Q">Enrollment</a>
        </li>
    </ul>
}

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

@if (tab == "enroll")
{
    <div class="hd-panel mb-4">
        <h2 class="h5 mb-2">Flood allowlist</h2>
        <p class="text-secondary small mb-3">
            Enrollment selects which machines may run TUFLOW / Flood sims. Util sampling is always-on for every Heimdall client —
            you do not need to enroll hosts for Passive % or GPU/CPU hours on Fleet → Computers.
            Search by hostname, friendly name, or last-known IP, or pick from the list below.
        </p>
        <form method="get" class="row g-2 align-items-end mb-3">
            <input type="hidden" name="tab" value="enroll" />
            <div class="col-md-6">
                <label class="form-label small" for="q">Search hostname, friendly name, or IP</label>
                <input class="form-control" id="q" name="q" value="@Model.Q" placeholder="e.g. SYDDT1234, Flood-01, or 10.1.2.3" />
            </div>
            <div class="col-auto">
                <button type="submit" class="hd-btn hd-btn-gold">Search</button>
            </div>
        </form>

        <form method="post" asp-page-handler="Enroll" class="row g-2 align-items-end mb-4">
            <input type="hidden" name="Q" value="@Model.Q" />
            <div class="col-md-8">
                <label class="form-label small" for="enroll-pick">Or select a machine</label>
                <select class="form-select" id="enroll-pick" name="EnrollMachineId" required>
                    <option value="">— hostname - friendly name - IP —</option>
                    @foreach (var m in Model.PickerMachines.Where(x => !x.AlreadyEnrolled))
                    {
                        var friendly = string.IsNullOrWhiteSpace(m.FriendlyName) ? "—" : m.FriendlyName.Trim();
                        var ip = string.IsNullOrWhiteSpace(m.LastIp) ? "—" : m.LastIp.Trim();
                        <option value="@m.MachineId">@m.Hostname - @friendly - @ip</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="hd-btn hd-btn-gold">Add</button>
            </div>
            @if (Model.PickerMachines.Count == 0)
            {
                <div class="col-12">
                    <p class="text-secondary small mb-0">No machines in the database yet — wait for an agent heartbeat first.</p>
                </div>
            }
            else if (Model.PickerMachines.All(x => x.AlreadyEnrolled))
            {
                <div class="col-12">
                    <p class="text-secondary small mb-0">Every known machine is already on the Flood allowlist.</p>
                </div>
            }
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.Q))
        {
            if (Model.SearchHits.Count == 0)
            {
                <p class="text-secondary small">No machines matched “@Model.Q”.</p>
            }
            else
            {
                <table class="hd-table hd-sortable mb-3">
                    <thead>
                        <tr>
                            <th data-sort="text">Hostname</th>
                            <th data-sort="text">Friendly name</th>
                            <th data-sort="text">IP</th>
                            <th data-sort="date">Last seen</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var hit in Model.SearchHits)
                    {
                        <tr>
                            <td>@hit.Hostname</td>
                            <td>@(string.IsNullOrWhiteSpace(hit.FriendlyName) ? "—" : hit.FriendlyName)</td>
                            <td>@(hit.LastIp ?? "—")</td>
                            <td data-sort-value="@hit.LastSeenUtc.ToUnixTimeSeconds()">@HistoricalDashboardModel.FormatContact(hit.LastSeenUtc)</td>
                            <td>
                                @if (hit.AlreadyEnrolled)
                                {
                                    <span class="badge-pill badge-active">Enrolled</span>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Enroll" class="d-inline">
                                        <input type="hidden" name="EnrollMachineId" value="@hit.MachineId" />
                                        <input type="hidden" name="Q" value="@Model.Q" />
                                        <button type="submit" class="hd-btn hd-btn-gold hd-btn-sm">Add</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        }
    </div>

    <div class="hd-panel">
        <h2 class="h5 mb-2">Enrolled (@Model.Enrolled.Count)</h2>
        @if (Model.Enrolled.Count == 0)
        {
            <p class="text-secondary mb-0">No Flood machines enrolled yet. Search or pick a machine above — TUFLOW Runs and Flood sims only target this allowlist.</p>
        }
        else
        {
            <table class="hd-table hd-sortable">
                <thead>
                    <tr>
                        <th data-sort="text">Hostname</th>
                        <th data-sort="text">Friendly name</th>
                        <th data-sort="text">IP</th>
                        <th data-sort="date">Added</th>
                        <th data-sort="date">Agent last seen</th>
                        <th>Notes</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var e in Model.Enrolled)
                {
                    <tr>
                        <td>
                            <a asp-page="/HistoricalDashboardMachine" asp-route-id="@e.MachineId">@e.Hostname</a>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(e.FriendlyName) ? "—" : e.FriendlyName)</td>
                        <td>@(e.LastIp ?? "—")</td>
                        <td data-sort-value="@e.AddedUtc.ToUnixTimeSeconds()">@e.AddedUtc.ToLocalTime().ToString("g")</td>
                        <td data-sort-value="@e.LastSeenUtc.ToUnixTimeSeconds()">@HistoricalDashboardModel.FormatContact(e.LastSeenUtc)</td>
                        <td>@(e.Notes ?? "—")</td>
                        <td>
                            <form method="post" asp-page-handler="Unenroll" class="d-inline"
                                  onsubmit="return confirm('Remove @e.Hostname from the Flood allowlist? Snapshots are kept.');">
                                <input type="hidden" name="UnenrollId" value="@e.EnrollmentId" />
                                <button type="submit" class="hd-btn hd-btn-rose hd-btn-sm">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
}
@if (tab == "live")
{
    <div id="flood-live-root" data-flood-live-root data-live-only="@(Model.LiveOnly ? "1" : "0")">
    <div class="d-flex flex-wrap gap-2 align-items-end mb-3">
        <form method="get" class="d-flex flex-wrap gap-2 align-items-end" id="live-filter-form" action="/HistoricalDashboard" data-flood-live-filter>
            <input type="hidden" name="tab" value="live" />
            <input type="hidden" name="partial" value="1" />
            <div>
                <label class="form-label small mb-1" for="live-q">Search</label>
                <input class="form-control form-control-sm" id="live-q" name="q" value="@Model.Q" placeholder="User or machine" />
            </div>
            <div>
                <label class="form-label small mb-1" for="statusFilter">Status</label>
                <select class="form-select form-select-sm" id="statusFilter" name="statusFilter">
                    @if (Model.StatusFilter == "all")
                    {
                        <option value="all" selected>All</option>
                    }
                    else
                    {
                        <option value="all">All</option>
                    }
                    @if (Model.StatusFilter == "active")
                    {
                        <option value="active" selected>Active</option>
                    }
                    else
                    {
                        <option value="active">Active</option>
                    }
                    @if (Model.StatusFilter == "idle")
                    {
                        <option value="idle" selected>Idle</option>
                    }
                    else
                    {
                        <option value="idle">Idle</option>
                    }
                    @if (Model.StatusFilter is "notrunning" or "not-running" or "na" or "n/a")
                    {
                        <option value="notrunning" selected>Not Running</option>
                    }
                    else
                    {
                        <option value="notrunning">Not Running</option>
                    }
                </select>
            </div>
            <button type="submit" class="hd-btn hd-btn-silver hd-btn-sm">Apply</button>
        </form>
        <span class="hd-live-meta ms-auto align-self-center" data-live="meta"
              data-filtered="@Model.FilteredLiveRows.Count" data-total="@Model.Enrolled.Count"
              title="@Model.FilteredLiveRows.Count / @Model.Enrolled.Count enrolled">
            <span data-live-meta-countdown>Live update in …</span>
        </span>
    </div>
    @{
        var lic = Model.LicenseStrip;
        var licTitle = lic.StatusNote ?? "";
        string LicAge()
        {
            if (lic.QueriedAtUtc is null) return "";
            var sec = Math.Max(0, (int)(DateTimeOffset.UtcNow - lic.QueriedAtUtc.Value).TotalSeconds);
            return sec < 90 ? $"{sec}s ago" : $"{sec / 60}m ago";
        }
        var pollDurLabel = lic.PollDurationMs >= 1000
            ? (lic.PollDurationMs / 1000.0).ToString("0.0") + "s"
            : lic.PollDurationMs.ToString("0") + "ms";
        var stripTitle = string.Join(" · ", new[] { licTitle, pollDurLabel + " last poll" }.Where(s => !string.IsNullOrWhiteSpace(s)));
        var pollIntervalSec = Math.Clamp(lic.PollIntervalSeconds <= 0 ? 60 : lic.PollIntervalSeconds, 15, 600);
        string NextPollLabel()
        {
            if (lic.QueriedAtUtc is null) return "—";
            // Interval is measured from poll start ≈ QueriedAtUtc − duration.
            var started = lic.QueriedAtUtc.Value - TimeSpan.FromMilliseconds(Math.Max(0, lic.PollDurationMs));
            var next = started.AddSeconds(pollIntervalSec);
            var rem = (int)Math.Ceiling((next - DateTimeOffset.UtcNow).TotalSeconds);
            if (rem <= 0) return "due";
            return rem + "s";
        }
    }
    <div class="hd-live-license-strip mb-2 @(lic.Enabled ? null : "is-muted")"
         data-live="licenses"
         data-poll-interval="@pollIntervalSec"
         title="@stripTitle">
        @if (!lic.Enabled)
        {
            <div class="hd-lic-strip" data-live-lic-body>
                <span class="hd-lic-chip hd-lic-chip-label">CodeMeter</span>
                <span class="hd-lic-chip is-muted">Off</span>
            </div>
        }
        else if (!lic.Available)
        {
            <div class="hd-lic-strip" data-live-lic-body>
                <span class="hd-lic-chip hd-lic-chip-label">CodeMeter</span>
                <span class="hd-lic-chip hd-lic-chip-warn">Waiting for first poll…</span>
            </div>
        }
        else
        {
            <div class="hd-lic-strip" data-live-lic-body>
                <span class="hd-lic-chip hd-lic-chip-label">CodeMeter</span>
                <span class="hd-lic-chip" title="HPC pool Used=/Total from CodeMeter (product 926). Separate from Classic — do not add the two products.">
                    <span class="hd-lic-k">HPC</span>
                    <span class="hd-lic-v">@(lic.HpcUsed is null ? "—" : lic.HpcUsed.ToString())/@lic.HpcTotal</span>
                    @if (lic.HpcAvailable is int ha)
                    {
                        <span class="hd-lic-free">@ha free</span>
                    }
                </span>
                <span class="hd-lic-chip" title="Classic pool Used=/Total from CodeMeter (product 920). Separate from HPC — do not add the two products.">
                    <span class="hd-lic-k">Classic</span>
                    <span class="hd-lic-v">@(lic.ClassicUsed is null ? "—" : lic.ClassicUsed.ToString())/@lic.ClassicTotal</span>
                    @if (lic.ClassicAvailable is int ca)
                    {
                        <span class="hd-lic-free">@ca free</span>
                    }
                </span>
                <span class="hd-lic-chip hd-lic-chip-meta"
                      title="How long the last CodeMeter query took · age of that result"
                      data-live-lic-last>
                    <span class="hd-lic-k">Last poll</span>
                    <span class="hd-lic-v">@pollDurLabel · @LicAge()</span>
                </span>
                <span class="hd-lic-chip hd-lic-chip-meta"
                      title="Estimated time until the next CodeMeter poll starts"
                      data-live-lic-next>
                    <span class="hd-lic-k">Next poll</span>
                    <span class="hd-lic-v" data-live-lic-next-val>@NextPollLabel()</span>
                </span>
                @if (lic.Partial)
                {
                    <span class="hd-lic-chip hd-lic-chip-warn" title="Some license servers failed or timed out">Partial</span>
                }
                @if (lic.UnmatchedEffective > 0)
                {
                    var outsideTitle = string.IsNullOrWhiteSpace(lic.UnmatchedDetail)
                        ? $"Seats outside Flood enrollment: {lic.UnmatchedEffective} (max HPC/Classic per IP; not additive). CodeMeter products: HPC {lic.UnmatchedHpc} · Classic {lic.UnmatchedClassic}. Pool Used= is CodeMeter’s total and is not summed with this chip."
                        : lic.UnmatchedDetail!;
                    var outsideTitleAttr = outsideTitle
                        .Replace("&", "&amp;")
                        .Replace("\"", "&quot;")
                        .Replace("\r", "")
                        .Replace("\n", "&#10;");
                    <span class="hd-lic-chip hd-lic-chip-outside"
                          title="@Html.Raw(outsideTitleAttr)">
                        <span class="hd-lic-k">In use by other offices</span>
                        <span class="hd-lic-v">@lic.UnmatchedEffective</span>
                    </span>
                }
            </div>
        }
    </div>

    <div data-flood-live-body>
    <div class="hd-panel hd-live-fleet-panel">
        @if (Model.Enrolled.Count == 0)
        {
            <p class="text-secondary mb-0">
                No Flood machines enrolled.
                @if (!Model.LiveOnly)
                {
                    <text>Open the <a asp-page="/Flood" asp-route-tab="enroll">Enrollment</a> tab to add hosts by hostname or IP.</text>
                }
                else
                {
                    <text>Ask a Flood admin to enroll hosts.</text>
                }
            </p>
        }
        else
        {
            <table class="hd-table hd-live-fleet-table hd-sortable" id="live-fleet-table">
                <thead>
                    <tr>
                        <th class="hd-col-host hd-th-tip" data-sort="text" scope="col"
                            data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-custom-class="hd-th-tooltip"
                            title="Friendly name when set, otherwise hostname. Rose gold link; orange halo when agent is offline (no check-in in ~60 seconds). Hostname and IP show underneath when a friendly name is used. Click to sort.">Machine</th>
                        <th class="hd-col-user hd-th-tip" data-sort="text" scope="col"
                            data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-custom-class="hd-th-tooltip"
                            title="Workload user: prefer TUFLOW behaviour-run / non-ops session over a transient ops.* console fixer. Empty when no better signal exists. Click to sort.">User</th>
                        <th class="hd-col-active hd-th-tip" data-sort="num" scope="col"
                            data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-custom-class="hd-th-tooltip"
                            title="Detected run: HH:mm on top, dd/MM under (green = launch, red = stop — stop time stays until the next run starts). Elevated = CPU &gt; 20% or GPU &gt; 5% for 2 samples. Otherwise Active/Idle/N/A from busy thresholds. Click to sort.">Active</th>
                        <th class="hd-th-tip" data-sort="num" scope="col"
                            data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-custom-class="hd-th-tooltip"
                            title="CodeMeter HPC seats matched only by this machine’s LastIp (product 926). Not by session username. Number is CodeMeter; /N appears only when the agent claim disagrees. HA servers are de-duplicated (max per IP, not sum). Click to sort.">HPC</th>
                        <th class="hd-th-tip" data-sort="num" scope="col"
                            data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-custom-class="hd-th-tooltip"
                            title="CodeMeter Classic seats matched only by this machine’s LastIp (product 920). Not by session username. Number is CodeMeter; /N appears only when the agent claim disagrees. Click to sort.">Classic</th>
                        <th class="hd-th-tip" data-sort="num" data-default-desc scope="col"
                            data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-custom-class="hd-th-tooltip"
                            title="GPU utilisation from the latest ~30s sample. Can exceed 100% when Windows GPU Engine counters are summed across engines. Click to sort.">GPU %</th>
                        <th class="hd-th-tip" data-sort="num" scope="col"
                            data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-custom-class="hd-th-tooltip"
                            title="CPU utilisation from the latest ~30s sample. Click to sort.">CPU %</th>
                        <th class="hd-th-tip" data-sort="num" scope="col"
                            data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-custom-class="hd-th-tooltip"
                            title="GPU memory in use on the latest sample (auto-scaled KB/MB/GB). Click to sort.">GPU mem</th>
                        <th class="hd-th-tip" data-sort="num" scope="col"
                            data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-custom-class="hd-th-tooltip"
                            title="System RAM in use on the latest sample (auto-scaled KB/MB/GB). Click to sort.">RAM</th>
                        <th class="hd-th-tip" data-sort="num" scope="col"
                            data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-custom-class="hd-th-tooltip"
                            title="Disk read rate from the latest sample (auto-scaled KB/s–TB/s). Click to sort.">Disk R</th>
                        <th class="hd-th-tip" data-sort="num" scope="col"
                            data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-custom-class="hd-th-tooltip"
                            title="Disk write rate from the latest sample (auto-scaled KB/s–TB/s). Click to sort.">Disk W</th>
                        <th class="hd-th-tip" data-sort="num" scope="col"
                            data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-custom-class="hd-th-tooltip"
                            title="Network receive (inbound) rate from the latest sample. Click to sort.">Net Rx</th>
                        <th class="hd-th-tip" data-sort="num" scope="col"
                            data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-custom-class="hd-th-tooltip"
                            title="Network transmit (outbound) rate from the latest sample. Click to sort.">Net Tx</th>
                        <th class="hd-th-tip" data-sort="num" scope="col"
                            data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-custom-class="hd-th-tooltip"
                            title="Hours today with TUFLOW detected, from ~30s samples (sum of sample intervals while TUFLOW was running). Click to sort.">Today runtime</th>
                        <th class="hd-th-tip" data-sort="num" scope="col"
                            data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-custom-class="hd-th-tooltip"
                            title="Hours today counted as Active while TUFLOW was running (same busy thresholds as the Active column). Click to sort.">Today active</th>
                        <th class="hd-th-tip" data-sort="num" scope="col"
                            data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-custom-class="hd-th-tooltip"
                            title="GPU-hours today from samples: Σ (GPU% ÷ 100 × interval hours). Can exceed wall-clock hours when GPU% is over 100. Click to sort.">Today GPU h</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.FilteredLiveRows.Count == 0)
                {
                    <tr><td colspan="16">No rows match the current filter.</td></tr>
                }
                @foreach (var r in Model.FilteredLiveRows)
                {
                    var checkInUtc = r.LastSeenUtc;
                    var offline = checkInUtc < DateTimeOffset.UtcNow.Add(-RemoteMachineService.OnlineWindow);
                    var checkInLabel = HistoricalDashboardModel.FormatContact(checkInUtc);
                    var liveUser = UsernameDisplay.Format(r.Username);
                    var statusLabel = HistoricalDashboardModel.ActiveColumnLabel(r);
                    var statusClass = HistoricalDashboardModel.ActiveColumnCssClass(r);
                    var statusTitle = HistoricalDashboardModel.ActiveColumnTitle(r);
                    var hasActiveStamp = HistoricalDashboardModel.TryGetActiveStamp(r, out var activeStamp);
                    var (hpcSeats, classicSeats) = Model.LicenseSeatsFor(r);
                    var hpcDetail = Model.LicenseSeatDetailFor(r, hpc: true);
                    var classicDetail = Model.LicenseSeatDetailFor(r, hpc: false);
                    var hpcMismatch = r.ClaimedHpcSeats is int ch && ch != hpcSeats;
                    var classicMismatch = r.ClaimedClassicSeats is int cc && cc != classicSeats;
                    <tr data-machine-id="@r.MachineId">
                        <td class="hd-col-host" data-sort-value="@r.DisplayName" data-live="host" title="@(offline ? $"Last agent check-in: {checkInLabel} (offline)" : r.Hostname)">
                            @if (Model.LiveOnly)
                            {
                                <span class="hd-live-host @(offline ? "hd-live-host-offline" : null)" data-live-host-text>@r.DisplayName</span>
                            }
                            else
                            {
                                <a class="hd-live-host @(offline ? "hd-live-host-offline" : null)"
                                   asp-page="/HistoricalDashboardMachine"
                                   asp-route-id="@r.MachineId"
                                   title="@(offline ? $"Last agent check-in: {checkInLabel}" : r.Hostname)">@r.DisplayName</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(r.FriendlyName))
                            {
                                <div class="hd-live-hostname text-secondary small">@r.Hostname</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(r.LastIp))
                            {
                                <div class="hd-live-ip small">@r.LastIp</div>
                            }
                        </td>
                        <td class="hd-col-user" data-sort-value="@liveUser" data-live="user"
                            title="@(string.IsNullOrWhiteSpace(liveUser) ? null : liveUser)"
                            aria-label="@(string.IsNullOrWhiteSpace(liveUser) ? null : liveUser)">@UsernameDisplay.FormatOrDash(r.Username)</td>
                        <td class="hd-col-active" data-sort-value="@HistoricalDashboardModel.ActiveColumnSortValue(r)" data-live="status">
                            @if (hasActiveStamp)
                            {
                                <span class="hd-active-stamp hd-status-text @activeStamp.CssClass" title="@statusTitle">
                                    <span class="hd-active-stamp-time">@activeStamp.Time</span>
                                    <span class="hd-active-stamp-date">@activeStamp.Date</span>
                                </span>
                            }
                            else if (statusLabel == "N/A")
                            {
                                <span class="text-secondary" title="@statusTitle">N/A</span>
                            }
                            else if (statusLabel != "—")
                            {
                                <span class="hd-status-text @statusClass" title="@statusTitle">@statusLabel</span>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </td>
                        <td class="hd-live-metric@(hpcMismatch ? " hd-lic-cell-warn" : null)" data-sort-value="@hpcSeats" data-live="hpc"
                            title="@HistoricalDashboardModel.FormatLicenseProductCellTitle(hpcSeats, hpcDetail, r.ClaimedHpcSeats, r.TuflowClaimDetail, hpc: true)">@Html.Raw(HistoricalDashboardModel.FormatLicenseCellHtml(hpcSeats, r.ClaimedHpcSeats, hpcMismatch))</td>
                        <td class="hd-live-metric@(classicMismatch ? " hd-lic-cell-warn" : null)" data-sort-value="@classicSeats" data-live="classic"
                            title="@HistoricalDashboardModel.FormatLicenseProductCellTitle(classicSeats, classicDetail, r.ClaimedClassicSeats, r.TuflowClaimDetail, hpc: false)">@Html.Raw(HistoricalDashboardModel.FormatLicenseCellHtml(classicSeats, r.ClaimedClassicSeats, classicMismatch))</td>
                        <td class="hd-live-metric" data-sort-value="@(r.GpuPercent ?? -1)" data-live="gpu">@HistoricalDashboardModel.FormatGauge(r.GpuPercent)</td>
                        <td class="hd-live-metric" data-sort-value="@(r.CpuPercent ?? -1)" data-live="cpu">@HistoricalDashboardModel.FormatGauge(r.CpuPercent)</td>
                        <td class="hd-live-metric" data-sort-value="@(r.GpuMemoryUsedMb ?? -1)" data-live="gpumem">@HistoricalDashboardModel.FormatDataFromMb(r.GpuMemoryUsedMb)</td>
                        <td class="hd-live-metric" data-sort-value="@(r.RamUsedMb ?? -1)" data-live="ram">@HistoricalDashboardModel.FormatDataFromMb(r.RamUsedMb)</td>
                        <td class="hd-live-metric" data-sort-value="@(r.DiskReadMBps ?? -1)" data-live="diskr">@HistoricalDashboardModel.FormatDataRateFromMBps(r.DiskReadMBps)</td>
                        <td class="hd-live-metric" data-sort-value="@(r.DiskWriteMBps ?? -1)" data-live="diskw">@HistoricalDashboardModel.FormatDataRateFromMBps(r.DiskWriteMBps)</td>
                        <td class="hd-live-metric" data-sort-value="@(r.NetworkInMBps ?? -1)" data-live="netin">@HistoricalDashboardModel.FormatDataRateFromMBps(r.NetworkInMBps)</td>
                        <td class="hd-live-metric" data-sort-value="@(r.NetworkOutMBps ?? -1)" data-live="netout">@HistoricalDashboardModel.FormatDataRateFromMBps(r.NetworkOutMBps)</td>
                        <td class="hd-live-metric" data-sort-value="@r.TodayRuntimeHours" data-live="runtime">@(HistoricalDashboardModel.FormatHours(r.TodayRuntimeHours) + "\u00A0h")</td>
                        <td class="hd-live-metric" data-sort-value="@r.TodayActiveHours" data-live="activeh">@(HistoricalDashboardModel.FormatHours(r.TodayActiveHours) + "\u00A0h")</td>
                        <td class="hd-live-metric" data-sort-value="@r.TodayGpuHours" data-live="gpuh">@(HistoricalDashboardModel.FormatHours(r.TodayGpuHours) + "\u00A0h")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
    </div>
    </div>
    <script src="~/js/hd-gpu-run-chart.js" asp-append-version="true"></script>
    <script src="~/js/hd-flood-live.js" asp-append-version="true"></script>
}

@if (tab == "historical")
{
    <div class="d-flex flex-wrap gap-2 align-items-end mb-3">
        <form method="get" class="d-flex flex-wrap gap-2 align-items-end">
            <input type="hidden" name="tab" value="historical" />
            <div>
                <label class="form-label small mb-1" for="histMode">Mode</label>
                <select class="form-select form-select-sm" id="histMode" name="histMode" onchange="this.form.submit()">
                    @if (Model.HistMode != "averages")
                    {
                        <option value="totals" selected>Totals</option>
                    }
                    else
                    {
                        <option value="totals">Totals</option>
                    }
                    @if (Model.HistMode == "averages")
                    {
                        <option value="averages" selected>Averages</option>
                    }
                    else
                    {
                        <option value="averages">Averages</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label small mb-1" for="period">Period</label>
                <select class="form-select form-select-sm" id="period" name="period" onchange="this.form.submit()">
                    @if (Model.IsAveragesMode)
                    {
                        @if (Model.Period == "daily")
                        {
                            <option value="daily" selected>Daily</option>
                        }
                        else
                        {
                            <option value="daily">Daily</option>
                        }
                        @if (Model.Period is "7d" or "7-day")
                        {
                            <option value="7d" selected>7-day</option>
                        }
                        else
                        {
                            <option value="7d">7-day</option>
                        }
                        @if (Model.Period == "monthly")
                        {
                            <option value="monthly" selected>Monthly</option>
                        }
                        else
                        {
                            <option value="monthly">Monthly</option>
                        }
                        @if (Model.Period is "all" or "all-time")
                        {
                            <option value="all" selected>All-time</option>
                        }
                        else
                        {
                            <option value="all">All-time</option>
                        }
                    }
                    else
                    {
                        @if (Model.Period == "today")
                        {
                            <option value="today" selected>Today</option>
                        }
                        else
                        {
                            <option value="today">Today</option>
                        }
                        @if (Model.Period is "week" or "7d")
                        {
                            <option value="week" selected>Week</option>
                        }
                        else
                        {
                            <option value="week">Week</option>
                        }
                        @if (Model.Period == "month")
                        {
                            <option value="month" selected>Month</option>
                        }
                        else
                        {
                            <option value="month">Month</option>
                        }
                        @if (Model.Period == "30d")
                        {
                            <option value="30d" selected>30 days</option>
                        }
                        else
                        {
                            <option value="30d">30 days</option>
                        }
                        @if (Model.Period is "3m" or "90d")
                        {
                            <option value="3m" selected>3 months</option>
                        }
                        else
                        {
                            <option value="3m">3 months</option>
                        }
                        @if (Model.Period == "6m")
                        {
                            <option value="6m" selected>6 months</option>
                        }
                        else
                        {
                            <option value="6m">6 months</option>
                        }
                        @if (Model.Period is "year" or "365d")
                        {
                            <option value="year" selected>Year</option>
                        }
                        else
                        {
                            <option value="year">Year</option>
                        }
                        @if (Model.Period is "all" or "all-time")
                        {
                            <option value="all" selected>All-time</option>
                        }
                        else
                        {
                            <option value="all">All-time</option>
                        }
                    }
                </select>
            </div>
        </form>
        <span class="text-secondary small">@Model.PeriodLabel · Flood enrolled</span>
    </div>

    <div class="hd-grid mb-4">
        <div class="hd-stat"><div class="label">Total machines</div><div class="value">@Model.Enrolled.Count</div></div>
        <div class="hd-stat"><div class="label">Machines active today</div><div class="value">@Model.MachinesActiveToday</div></div>
        <div class="hd-stat"><div class="label">Runtime</div><div class="value">@HistoricalDashboardModel.FormatHours(Model.Summary.RuntimeHours) h</div></div>
        <div class="hd-stat"><div class="label">Active runtime</div><div class="value">@HistoricalDashboardModel.FormatHours(Model.Summary.ActiveRuntimeHours) h</div></div>
        <div class="hd-stat"><div class="label">Avg active / machine</div><div class="value">@HistoricalDashboardModel.FormatHours(Model.AvgActiveRuntimePerMachine) h</div></div>
        <div class="hd-stat"><div class="label">Idle runtime</div><div class="value">@HistoricalDashboardModel.FormatHours(Model.Summary.IdleRuntimeHours) h</div></div>
        <div class="hd-stat"><div class="label">GPU hours</div><div class="value">@HistoricalDashboardModel.FormatHours(Model.Summary.GpuHours)</div></div>
        <div class="hd-stat"><div class="label">CPU hours</div><div class="value">@HistoricalDashboardModel.FormatHours(Model.Summary.CpuHours)</div></div>
        <div class="hd-stat"><div class="label">RAM GB-hours</div><div class="value">@HistoricalDashboardModel.FormatHours(Model.Summary.RamGbHours)</div></div>
        <div class="hd-stat"><div class="label">Total disk IO</div><div class="value">@((Model.Summary.DiskReadGb + Model.Summary.DiskWriteGb).ToString("0.##")) GB</div></div>
        <div class="hd-stat"><div class="label">Total network</div><div class="value">@((Model.Summary.NetworkInGb + Model.Summary.NetworkOutGb).ToString("0.##")) GB</div></div>
        <div class="hd-stat"><div class="label">Samples</div><div class="value">@Model.Summary.SampleCount</div></div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="hd-panel h-100">
                <h3 class="h6">Top GPU</h3>
                @if (Model.TopGpu.Count == 0)
                {
                    <p class="text-secondary small mb-0">No data yet.</p>
                }
                else
                {
                    <ol class="small mb-0 ps-3">
                    @foreach (var p in Model.TopGpu)
                    {
                        <li class="mb-1"><a asp-page="/HistoricalDashboardMachine" asp-route-id="@p.MachineId">@p.Hostname</a>
                            <span class="text-secondary">— @HistoricalDashboardModel.FormatHours(p.Metrics.GpuHours) h</span></li>
                    }
                    </ol>
                }
            </div>
        </div>
        <div class="col-md-4">
            <div class="hd-panel h-100">
                <h3 class="h6">Top CPU</h3>
                @if (Model.TopCpu.Count == 0)
                {
                    <p class="text-secondary small mb-0">No data yet.</p>
                }
                else
                {
                    <ol class="small mb-0 ps-3">
                    @foreach (var p in Model.TopCpu)
                    {
                        <li class="mb-1"><a asp-page="/HistoricalDashboardMachine" asp-route-id="@p.MachineId">@p.Hostname</a>
                            <span class="text-secondary">— @HistoricalDashboardModel.FormatHours(p.Metrics.CpuHours) h</span></li>
                    }
                    </ol>
                }
            </div>
        </div>
        <div class="col-md-4">
            <div class="hd-panel h-100">
                <h3 class="h6">Top RAM</h3>
                @if (Model.TopRam.Count == 0)
                {
                    <p class="text-secondary small mb-0">No data yet.</p>
                }
                else
                {
                    <ol class="small mb-0 ps-3">
                    @foreach (var p in Model.TopRam)
                    {
                        <li class="mb-1"><a asp-page="/HistoricalDashboardMachine" asp-route-id="@p.MachineId">@p.Hostname</a>
                            <span class="text-secondary">— @HistoricalDashboardModel.FormatHours(p.Metrics.RamGbHours) GB·h</span></li>
                    }
                    </ol>
                }
            </div>
        </div>
        <div class="col-md-6">
            <div class="hd-panel h-100">
                <h3 class="h6">Top Disk I/O</h3>
                @if (Model.TopDisk.Count == 0)
                {
                    <p class="text-secondary small mb-0">No data yet.</p>
                }
                else
                {
                    <ol class="small mb-0 ps-3">
                    @foreach (var p in Model.TopDisk)
                    {
                        <li class="mb-1"><a asp-page="/HistoricalDashboardMachine" asp-route-id="@p.MachineId">@p.Hostname</a>
                            <span class="text-secondary">— @((p.Metrics.DiskReadGb + p.Metrics.DiskWriteGb).ToString("0.##")) GB</span></li>
                    }
                    </ol>
                }
            </div>
        </div>
        <div class="col-md-6">
            <div class="hd-panel h-100">
                <h3 class="h6">Most Active</h3>
                @if (Model.TopActive.Count == 0)
                {
                    <p class="text-secondary small mb-0">No data yet.</p>
                }
                else
                {
                    <ol class="small mb-0 ps-3">
                    @foreach (var p in Model.TopActive)
                    {
                        <li class="mb-1"><a asp-page="/HistoricalDashboardMachine" asp-route-id="@p.MachineId">@p.Hostname</a>
                            <span class="text-secondary">— @HistoricalDashboardModel.FormatHours(p.Metrics.ActiveRuntimeHours) h</span></li>
                    }
                    </ol>
                }
            </div>
        </div>
    </div>

    <div class="hd-panel">
        <h2 class="h5 mb-2">Per machine</h2>
        @if (Model.PerMachine.Count == 0)
        {
            <p class="text-secondary mb-0">No Flood machines enrolled.</p>
        }
        else
        {
            <table class="hd-table hd-sortable">
                <thead>
                    <tr>
                        <th data-sort="text">Machine</th>
                        <th data-sort="num" data-default-desc>Runtime</th>
                        <th data-sort="num">Active</th>
                        <th data-sort="num">GPU h</th>
                        <th data-sort="num">CPU h</th>
                        <th data-sort="num">RAM GB·h</th>
                        <th data-sort="num">Disk GB</th>
                        <th data-sort="num">Net GB</th>
                        <th data-sort="num">Samples</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model.PerMachine)
                {
                    <tr>
                        <td><a asp-page="/HistoricalDashboardMachine" asp-route-id="@p.MachineId">@p.Hostname</a></td>
                        <td data-sort-value="@p.Metrics.RuntimeHours">@HistoricalDashboardModel.FormatHours(p.Metrics.RuntimeHours) h</td>
                        <td data-sort-value="@p.Metrics.ActiveRuntimeHours">@HistoricalDashboardModel.FormatHours(p.Metrics.ActiveRuntimeHours) h</td>
                        <td data-sort-value="@p.Metrics.GpuHours">@HistoricalDashboardModel.FormatHours(p.Metrics.GpuHours)</td>
                        <td data-sort-value="@p.Metrics.CpuHours">@HistoricalDashboardModel.FormatHours(p.Metrics.CpuHours)</td>
                        <td data-sort-value="@p.Metrics.RamGbHours">@HistoricalDashboardModel.FormatHours(p.Metrics.RamGbHours)</td>
                        <td data-sort-value="@(p.Metrics.DiskReadGb + p.Metrics.DiskWriteGb)">@((p.Metrics.DiskReadGb + p.Metrics.DiskWriteGb).ToString("0.##"))</td>
                        <td data-sort-value="@(p.Metrics.NetworkInGb + p.Metrics.NetworkOutGb)">@((p.Metrics.NetworkInGb + p.Metrics.NetworkOutGb).ToString("0.##"))</td>
                        <td data-sort-value="@p.Metrics.SampleCount">@p.Metrics.SampleCount</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
}

<script src="~/js/hd-table.js" asp-append-version="true"></script>
<script>
(() => {
  const root = document.querySelector('[data-flood-live-root]');
  if (!root) {
    if (window.HeimdallTable) {
      HeimdallTable.initSort(document);
      HeimdallTable.initTextFilter(document);
    }
    return;
  }
  function initHeaderTooltips(scope) {
    if (!window.bootstrap?.Tooltip) return;
    (scope || root).querySelectorAll('.hd-live-fleet-table thead th[data-bs-toggle="tooltip"]').forEach((el) => {
      bootstrap.Tooltip.getOrCreateInstance(el, {
        container: 'body',
        trigger: 'hover focus',
        delay: { show: 150, hide: 50 }
      });
    });
  }
  if (window.HeimdallTable) {
    HeimdallTable.initSort(root);
    HeimdallTable.initTextFilter(root);
  }
  initHeaderTooltips(root);
  if (window.HeimdallFloodLive) window.HeimdallFloodLive.init(root);
})();
</script>
