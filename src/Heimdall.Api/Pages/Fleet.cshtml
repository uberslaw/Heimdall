@page
@model FleetModel
@{
    ViewData["Title"] = "Fleet";
    var active = Model.ActiveTabKey;
    var titleWord = active switch
    {
        "machines" => "Computers",
        "live" => "Live",
        "sessions" => "Sessions",
        "online" => "Online status",
        "clients" => "Client version",
        "cost" => "Cost",
        "stats" => "Stats",
        _ => "Computers"
    };
    var helpFragment = active switch
    {
        "machines" => "machines",
        "live" => "fleet-live",
        "sessions" => "sessions",
        "online" => "remote-machines",
        "clients" => "client-version",
        "cost" => "cost",
        "stats" => "stats",
        _ => "fleet"
    };
    ViewData["HelpFragment"] = helpFragment;
}

<div class="hd-fleet-header mb-3">
    <div class="hd-fleet-header-main">
        <h1 class="hd-title hd-fleet-title mb-0">
            <span class="hd-fleet-title-fleet">Fleet</span>
            <span class="hd-fleet-title-page" data-hd-fleet-title>@titleWord</span>
        </h1>
        <ul class="nav nav-tabs hd-ops-tabs mb-0" id="hd-ops-tabs" role="tablist">
        @foreach (var t in FleetModel.Tabs)
        {
            var isActive = t.Key == active;
            var tabTitle = t.Key switch
            {
                "machines" => "Computers",
                "live" => "Live",
                "sessions" => "Sessions",
                "online" => "Online status",
                "clients" => "Client version",
                "cost" => "Cost",
                "stats" => "Stats",
                _ => t.Label
            };
            <li class="nav-item" role="presentation">
                <a class="nav-link @(isActive ? "active" : null)"
                   href="/Fleet?tab=@t.Key"
                   data-hd-ops-tab="@t.Key"
                   data-hd-ops-src="@FleetModel.PartialUrl(t.Key, ViewContext.HttpContext.Request)"
                   data-hd-fleet-title="@tabTitle"
                   data-hd-fleet-help="@((t.Key) switch {
                       "machines" => "machines",
                       "live" => "fleet-live",
                       "sessions" => "sessions",
                       "online" => "remote-machines",
                       "clients" => "client-version",
                       "cost" => "cost",
                       "stats" => "stats",
                       _ => "fleet"
                   })"
                   data-hd-fleet-purpose="@((t.Key) switch {
                       "machines" => "Estate utilisation and last user for the selected period. Live is current metrics; Online is ping and RDP.",
                       "live" => "Latest ~30s CPU, GPU, disk, and network. Not ping or RDP.",
                       "sessions" => "Who signed in, and active vs disconnected time.",
                       "online" => "Ping, RDP, and RDS from this API host.",
                       "clients" => "Agent build vs published pack. Deploy from here.",
                       "cost" => "Per-machine purchase, warranty, and 30-day hours. Org rollup is Finance.",
                       "stats" => "Ranked users and apps. Click a row to open the user, app, or machine page.",
                       _ => ""
                   })"
                   role="tab"
                   aria-selected="@(isActive ? "true" : "false")">@t.Label</a>
            </li>
        }
        </ul>
        <p class="hd-sub mb-0 mt-2" data-hd-fleet-purpose-line>@(active switch
        {
            "machines" => "Estate utilisation and last user for the selected period. Live is current metrics; Online is ping and RDP.",
            "live" => "Latest ~30s CPU, GPU, disk, and network. Not ping or RDP.",
            "sessions" => "Who signed in, and active vs disconnected time.",
            "online" => "Ping, RDP, and RDS from this API host.",
            "clients" => "Agent build vs published pack. Deploy from here.",
            "cost" => "Per-machine purchase, warranty, and 30-day hours. Org rollup is Finance.",
            "stats" => "Ranked users and apps. Click a row to open the user, app, or machine page.",
            _ => ""
        })</p>
    </div>
</div>

<partial name="_Toasts" />

<div class="hd-ops-pane" id="hd-ops-pane" data-hd-ops-active="@active" data-hd-ops-base="/Fleet" aria-live="polite">
    <div class="hd-ops-loading text-secondary py-4" data-hd-ops-loading>Loading…</div>
    <div class="hd-ops-body" data-hd-ops-body hidden></div>
</div>

@section Scripts {
    <script src="~/js/ops-tabs.js" asp-append-version="true"></script>
    <script>
    (() => {
      const titleEl = document.querySelector('[data-hd-fleet-title]');
      const helpLink = document.querySelector('[data-hd-global-help]');
      const purposeEl = document.querySelector('[data-hd-fleet-purpose-line]');
      document.querySelectorAll('[data-hd-ops-tab]').forEach((a) => {
        a.addEventListener('click', () => {
          const t = a.getAttribute('data-hd-fleet-title');
          if (titleEl && t) titleEl.textContent = t;
          const purpose = a.getAttribute('data-hd-fleet-purpose');
          if (purposeEl && purpose) purposeEl.textContent = purpose;
          const frag = a.getAttribute('data-hd-fleet-help');
          if (helpLink && frag) {
            const href = helpLink.getAttribute('href') || '/Help';
            helpLink.setAttribute('href', href.split('#')[0] + '#' + frag);
          }
        });
      });
    })();
    </script>
}
