@page
@model ClientVersionModel
@{
    ViewData["Title"] = "Client Version";
    ViewData["HelpFragment"] = "client-version";
    var isPartial = OpsPartial.IsPartial(ViewContext.HttpContext.Request);
    if (isPartial)
        Layout = null;
}

@if (!isPartial)
{
    <h1 class="hd-title mb-1">Client Version</h1>
}

<partial name="_Toasts" />

<div class="hd-panel mb-4">
    <form method="post" asp-page-handler="SetPublishedVersion" class="d-flex flex-wrap align-items-end gap-3">
        <div>
            <div class="hd-settings-label mb-1">Current published client version</div>
            @if (!string.IsNullOrWhiteSpace(Model.PublishedVersion))
            {
                <span class="badge-pill badge-active">@(Model.PublishedSimpleVersion?.ToString() ?? Model.PublishedVersion)</span>
                @if (Model.PublishedIsDefault)
                {
                    <span class="text-secondary small ms-1">(default)</span>
                }
            }
            else
            {
                <span class="badge-pill badge-warn">Not set</span>
            }
            @if (Model.PublishedSetUtc is DateTimeOffset setUtc)
            {
                <div class="text-secondary small mt-1">
                    Set @ClientVersionModel.FormatContact(setUtc)@(string.IsNullOrWhiteSpace(Model.PublishedSetBy) ? "" : $" by {Model.PublishedSetBy}")
                </div>
            }
        </div>
        <div>
            <label class="hd-settings-label mb-1 d-block" for="NewPublishedVersion">Set / override</label>
            <input type="text" class="form-control form-control-sm" id="NewPublishedVersion" name="NewPublishedVersion"
                   placeholder="e.g. 3" style="width:120px" autocomplete="off" inputmode="numeric" />
        </div>
        <button type="submit" class="hd-btn hd-btn-gold hd-btn-sm"
                title="Override the published client version baseline used for Up to date / Out of date. Packs usually set this automatically.">Save</button>
    </form>
</div>

<div class="hd-panel mb-4" id="pack-readiness-panel">
    <div class="d-flex flex-wrap align-items-center gap-3 justify-content-between">
        <div>
            <div class="hd-settings-label mb-1">Client pack readiness</div>
            <div id="pack-status-line" class="text-secondary">Checking pack…</div>
            <div id="pack-deploy-hint" class="small mt-1 text-secondary"></div>
            <div id="pack-api-note" class="text-secondary small mt-1"></div>
            <div id="pack-last-result" class="text-secondary small mt-2" style="display:none"></div>
            <pre id="pack-log-tail" class="small mt-2 mb-0 p-2" style="display:none;max-height:160px;overflow:auto;background:rgba(0,0,0,.04);white-space:pre-wrap"></pre>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="hd-btn hd-btn-silver hd-btn-sm" id="btn-pack-client" disabled
                    title="Rebuild the client pack under dist\Heimdall-Client. Skips bump if already Ready; confirm to force N+1.">Pack client</button>
            <button type="button" class="hd-btn hd-btn-silver hd-btn-sm" id="btn-refresh-pack" disabled
                    title="Re-read dist\Heimdall-Client from disk (use after Launch Control packs) without rebuilding.">Refresh from disk</button>
            <button type="button" class="hd-btn hd-btn-silver hd-btn-sm" id="btn-cancel-pack" style="display:none"
                    title="Stop the in-flight pack job on this API host.">Cancel</button>
            <button type="button" class="hd-btn hd-btn-gold hd-btn-sm" id="btn-deploy-client" disabled
                    title="Waiting for pack readiness check">Deploy Client</button>
        </div>
    </div>
</div>

<div class="hd-grid">
    <div class="hd-stat">
        <div class="label">Machines</div>
        <div class="value">@Model.Rows.Count</div>
    </div>
    <div class="hd-stat">
        <div class="label">Up to date</div>
        <div class="value">@Model.UpToDateCount</div>
    </div>
    <div class="hd-stat">
        <div class="label">Out of date / missing</div>
        <div class="value">@Model.OutOfDateCount</div>
    </div>
    <div class="hd-stat">
        <div class="label">No baseline</div>
        <div class="value">@Model.UnknownCount</div>
    </div>
</div>

<form method="post" asp-page="/ClientVersion" asp-page-handler="Deploy" id="deploy-form">
    @Html.AntiForgeryToken()
    <div class="hd-panel">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <label class="form-check-label small text-secondary mb-0">
                <input type="checkbox" class="form-check-input" id="select-all-hosts" /> Select all
            </label>
            <span class="text-secondary small" id="selected-count">0 selected</span>
            <button type="button" class="hd-btn hd-btn-silver hd-btn-sm" id="btn-select-outdated"
                    title="Check every host that is out of date or missing a version (clears other checks first).">Select out of date</button>
            <button type="submit" class="hd-btn hd-btn-silver hd-btn-sm" id="btn-restart-agent"
                    formaction="/ClientVersion?handler=RestartAgent"
                    title="Restart HeimdallAgent on selected hosts (blocked if Deploy/UpdateClient is pending).">Restart agent</button>
            <button type="submit" class="hd-btn hd-btn-silver hd-btn-sm" id="btn-cleanup-staging"
                    formaction="/ClientVersion?handler=CleanupStaging"
                    title="Delete %ProgramData%\Heimdall\update\ and C:\Temp\Heimdall-Client* staging folders on selected hosts (not Program Files).">Cleanup staging</button>
            <button type="submit" class="hd-btn hd-btn-silver hd-btn-sm" id="btn-deposit-pack"
                    formaction="/ClientVersion?handler=DepositClientPack"
                    title="Queue selected agents to download the Ready pack to C:\Temp\Heimdall-Client-v{version}-{timestamp} for manual Install.lnk (not silent Deploy).">Deposit pack to Temp</button>
            <div class="d-flex flex-wrap align-items-center gap-1 ms-auto">
                <label class="form-label small mb-0 text-secondary" for="new-api-base-url">API URL</label>
                <input class="form-control form-control-sm" style="min-width:14rem" id="new-api-base-url"
                       name="NewApiBaseUrl" value="@Model.NewApiBaseUrl"
                       placeholder="http://host:5080"
                       title="New Heimdall:ApiBaseUrl for selected agents. Only works while they can still reach this API." />
                <button type="submit" class="hd-btn hd-btn-silver hd-btn-sm" id="btn-set-api-url"
                        formaction="/ClientVersion?handler=SetApiBaseUrl"
                        title="Queue SetApiBaseUrl: agents rewrite Program Files appsettings and restart. Must reach this API first. Offline hosts: Set-ApiUrl.lnk in the client pack (API IP baked into Set-HeimdallAgentApiBaseUrl.cmd).">Set API URL</button>
            </div>
        </div>
        <table class="hd-table hd-sortable">
            <thead>
                <tr>
                    <th style="width:2rem" title="Select hosts for Deploy Client, Restart agent, Cleanup staging, or Deposit pack. Offline hosts still queue until the agent checks in."></th>
                    <th data-sort="text" title="Friendly name (if set), with hostname and last reported IP underneath. Opens the machine detail page.">Machine</th>
                    <th data-sort="text" title="Online = agent heartbeat within the last 5 minutes. Offline = no recent heartbeat (Ping/RDP can still succeed). Commands queued for offline hosts wait until the agent is back.">Online</th>
                    <th data-sort="text" title="Yes when the last heartbeat reported any open interactive session (Active or Disconnected). Separate from Online and from Active User state.">In use</th>
                    <th data-sort="text" title="Primary open session user from the API. Green text = Active (connected); red text = Disconnected. Silent Deploy defers while any session is Active — Disconnected is OK.">Active User</th>
                    <th data-sort="num" title="Installed HeimdallAgent simple version from the last heartbeat. Legacy SemVer builds count as 1. Compared to the published baseline for Behind.">Client version</th>
                    <th data-sort="num" title="How many simple versions this host is behind the published baseline (published − installed). Empty when up to date or no baseline.">Behind</th>
                    <th data-sort="text" title="Silent update / remote-op phase for this host: Queued → Downloading → DeferredWaitingForIdle (Active session) → Applying → Succeeded or Failed. Stuck = Downloading/Applying with no heartbeat or no version bump for 15+ minutes (pending Deploy cleared so you can re-queue). Hover the cell for raw progress JSON.">Progress</th>
                    <th data-sort="date" title="When this host last posted a heartbeat to the API. Used for Online (5 minutes) and Stuck detection (15 minutes without contact during Downloading/Applying).">Last contact</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="9">No agents reporting yet.</td></tr>
            }
            @foreach (var r in Model.Rows)
            {
                var hasFriendly = !string.IsNullOrWhiteSpace(r.FriendlyName);
                <tr class="@ClientVersionModel.BehindRowClass(r.VersionsBehind)"
                    data-status="@r.Status">
                    <td>
                        <input type="checkbox" class="form-check-input host-check" name="SelectedHostnames" value="@r.Hostname"
                               @(r.IsOnline ? null : "title=\"Offline — queue when agent is back\"") />
                    </td>
                    <td data-sort-value="@r.DisplayName">
                        <a asp-page="/Machine" asp-route-hostname="@r.Hostname" asp-route-range="7d" title="@r.Hostname"><strong>@r.DisplayName</strong></a>
                        @if (hasFriendly)
                        {
                            <div class="text-secondary small">@r.Hostname</div>
                        }
                        <div class="text-secondary small">@(string.IsNullOrWhiteSpace(r.LastIp) ? "—" : r.LastIp.Trim())</div>
                    </td>
                    <td data-sort-value="@(r.IsOnline ? 1 : 0)">
                        @if (r.IsOnline)
                        {
                            <span class="hd-status-text hd-status-active">Online</span>
                        }
                        else
                        {
                            <span class="hd-status-text hd-status-off">Offline</span>
                        }
                    </td>
                    <td data-sort-value="@(r.IsInUse ? 1 : 0)">
                        @if (r.IsInUse)
                        {
                            <span class="hd-status-text hd-status-active">Yes</span>
                        }
                        else
                        {
                            <span class="hd-status-text hd-status-off">No</span>
                        }
                    </td>
                    <td data-sort-value="@UsernameDisplay.Format(r.ActiveUser)">
                        @if (!string.IsNullOrWhiteSpace(r.ActiveUser))
                        {
                            <a asp-page="/User" asp-route-username="@UsernameDisplay.Format(r.ActiveUser)" asp-route-range="1d"
                               class="@ClientVersionModel.ActiveUserTextClass(r.ActiveUserState)"
                               title="@ClientVersionModel.ActiveUserLabel(r.ActiveUserState)">@UsernameDisplay.Format(r.ActiveUser)</a>
                        }
                        else
                        {
                            <span class="text-secondary">—</span>
                        }
                    </td>
                    <td class="@ClientVersionModel.VersionCellClass(r.VersionsBehind)" data-sort-value="@(r.SimpleVersion ?? -1)">
                        @if (r.SimpleVersion is int sv)
                        {
                            <code>@sv</code>
                            @if (!Heimdall.Api.Services.VersionCompare.IsPureIntegerVersion(r.AgentVersion))
                            {
                                <span class="text-secondary small" title="@r.AgentVersion"> (legacy)</span>
                            }
                        }
                        else
                        {
                            <code>—</code>
                        }
                    </td>
                    <td data-sort-value="@(r.VersionsBehind ?? 0)">
                        @if (r.VersionsBehind is int behind and > 0)
                        {
                            <span>@behind version@(behind == 1 ? "" : "s") behind</span>
                        }
                        else
                        {
                            <span class="text-secondary">—</span>
                        }
                    </td>
                    <td class="small text-secondary" title="@(r.ClientUpdateProgressJson ?? "")">
                        @(ClientVersionModel.FormatUpdateProgress(r.ClientUpdateProgressJson) ?? "—")
                        @if (!string.IsNullOrWhiteSpace(r.PendingApiBaseUrl))
                        {
                            <div class="small" title="Queued SetApiBaseUrl">→ @r.PendingApiBaseUrl</div>
                        }
                    </td>
                    <td data-sort-value="@r.LastSeenUtc.ToUnixTimeSeconds()">@ClientVersionModel.FormatContact(r.LastSeenUtc)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</form>

<script>
(function () {
    const statusLine = document.getElementById('pack-status-line');
    const deployHint = document.getElementById('pack-deploy-hint');
    const apiNote = document.getElementById('pack-api-note');
    const btnPack = document.getElementById('btn-pack-client');
    const btnRefreshPack = document.getElementById('btn-refresh-pack');
    const btnCancel = document.getElementById('btn-cancel-pack');
    const btnDeploy = document.getElementById('btn-deploy-client');
    const selectAll = document.getElementById('select-all-hosts');
    const selectedCount = document.getElementById('selected-count');
    const deployForm = document.getElementById('deploy-form');
    const lastResultEl = document.getElementById('pack-last-result');
    const logTailEl = document.getElementById('pack-log-tail');
    let deployUnlocked = false;
    let readinessDone = false;
    let packPollTimer = null;

    function updateSelectedCount() {
        const n = document.querySelectorAll('.host-check:checked').length;
        selectedCount.textContent = n + ' selected';
        const canDeploy = readinessDone && deployUnlocked && n > 0;
        btnDeploy.disabled = !canDeploy;
        const btnRestart = document.getElementById('btn-restart-agent');
        const btnCleanup = document.getElementById('btn-cleanup-staging');
        const btnDeposit = document.getElementById('btn-deposit-pack');
        if (btnRestart) {
            btnRestart.disabled = n === 0;
            btnRestart.title = n === 0
                ? 'Select at least one machine to restart HeimdallAgent.'
                : 'Restart HeimdallAgent on ' + n + ' selected host(s) (blocked if Deploy/UpdateClient is pending).';
        }
        if (btnCleanup) {
            btnCleanup.disabled = n === 0;
            btnCleanup.title = n === 0
                ? 'Select at least one machine to clean staging folders.'
                : 'Delete update/ and C:\\Temp\\Heimdall-Client* staging on ' + n + ' selected host(s).';
        }
        if (btnDeposit) {
            btnDeposit.disabled = n === 0;
            btnDeposit.title = n === 0
                ? 'Select at least one machine to deposit the pack to Temp.'
                : 'Queue DepositClientPack for ' + n + ' host(s) → C:\\Temp\\Heimdall-Client-v{version}-{timestamp} (manual Install.lnk).';
        }
        const btnSetUrl = document.getElementById('btn-set-api-url');
        if (btnSetUrl) {
            btnSetUrl.disabled = n === 0;
            btnSetUrl.title = n === 0
                ? 'Select at least one machine to set the API URL.'
                : 'Queue SetApiBaseUrl for ' + n + ' host(s) (must still reach this API).';
        }
        if (!btnDeploy) return;
        if (!readinessDone) {
            btnDeploy.title = 'Waiting for pack readiness check';
        } else if (!deployUnlocked) {
            btnDeploy.title = 'Deploy locked — pack must be Ready (Pack client again if Stale)';
        } else if (n === 0) {
            btnDeploy.title = 'Select at least one machine to Deploy';
        } else {
            btnDeploy.title = 'Queue silent client update for ' + n + ' machine(s)';
        }
        if (deployHint && readinessDone && deployUnlocked) {
            deployHint.textContent = n > 0
                ? 'Ready — Deploy enabled for ' + n + ' selected machine(s).'
                : 'Ready — select machines and Deploy.';
            deployHint.className = 'small mt-1 text-success';
        }
    }

    function setDeployHint(data, packing) {
        if (!deployHint) return;
        if (packing) {
            deployHint.textContent = 'Deploy locked while packing…';
            deployHint.className = 'small mt-1 text-secondary';
            return;
        }
        const n = document.querySelectorAll('.host-check:checked').length;
        if (data.deployUnlocked) {
            deployHint.textContent = n > 0
                ? 'Ready — Deploy enabled for ' + n + ' selected machine(s).'
                : 'Ready — select machines and Deploy.';
            deployHint.className = 'small mt-1 text-success';
        } else if (data.status === 'Stale' || data.status === 'MissingPack') {
            deployHint.textContent = 'Deploy locked: ' + (data.status === 'MissingPack'
                ? 'no pack — Pack client first.'
                : 'pack is stale — Pack client again.');
            deployHint.className = 'small mt-1 text-danger';
        } else if (data.status === 'Error') {
            deployHint.textContent = 'Deploy locked: pack check error.';
            deployHint.className = 'small mt-1 text-danger';
        } else {
            deployHint.textContent = 'Deploy locked until pack is Ready.';
            deployHint.className = 'small mt-1 text-secondary';
        }
    }

    function clearPackPoll() {
        if (packPollTimer) {
            clearTimeout(packPollTimer);
            packPollTimer = null;
        }
    }

    function setCancelVisible(show) {
        if (!btnCancel) return;
        btnCancel.style.display = show ? '' : 'none';
        btnCancel.disabled = !show;
    }

    function packingStatusText(data) {
        const secs = data.packingElapsed != null ? Math.floor(data.packingElapsed) + 's' : null;
        const stage = data.packStage
            ? ('stage ' + data.packStage + (data.packStageLabel ? ': ' + data.packStageLabel : ''))
            : null;
        const parts = ['Packing'];
        if (secs) parts.push(secs);
        if (stage) parts.push(stage);
        return parts.join(' · ');
    }

    function showLastPack(data) {
        const failed = data.lastPackExitCode != null && data.lastPackExitCode !== 0;
        const exitOk = data.lastPackExitCode === 0;
        const hasMsg = !!(data.lastPackMessage || data.lastPackLogPath);
        if (!hasMsg && !failed) {
            lastResultEl.style.display = 'none';
            logTailEl.style.display = 'none';
            return;
        }
        const parts = [];
        if (exitOk && data.status === 'Stale') {
            parts.push('Last pack exit 0 but readiness is Stale (fingerprint mismatch) — Pack client again.');
            if (data.packProductVersion) parts.push('pack v' + data.packProductVersion);
            if (data.lastPackLogPath) parts.push('Log: ' + data.lastPackLogPath);
        } else if (exitOk && data.status === 'Ready') {
            parts.push(data.lastPackMessage
                || ('Last pack exit 0' + (data.packProductVersion ? ' · v' + data.packProductVersion : '')));
            if (data.lastPackLogPath && !(data.lastPackMessage && data.lastPackMessage.indexOf(data.lastPackLogPath) >= 0))
                parts.push('Log: ' + data.lastPackLogPath);
        } else if (data.lastPackMessage) {
            parts.push(data.lastPackMessage);
            if (data.lastPackLogPath && data.lastPackMessage.indexOf(data.lastPackLogPath) < 0)
                parts.push('Log: ' + data.lastPackLogPath);
        } else if (failed) {
            parts.push('Last pack failed (exit ' + data.lastPackExitCode + ').');
            if (data.lastPackLogPath) parts.push('Log: ' + data.lastPackLogPath);
        }
        lastResultEl.textContent = parts.join(' ');
        lastResultEl.style.display = 'block';
        lastResultEl.className = (failed || data.status === 'Error' || (exitOk && data.status === 'Stale'))
            ? 'text-danger small mt-2'
            : 'text-secondary small mt-2';
        if (data.lastPackLogTail && (failed || data.status === 'Error' || data.status === 'Stale')) {
            logTailEl.textContent = data.lastPackLogTail;
            logTailEl.style.display = 'block';
        } else {
            logTailEl.style.display = 'none';
        }
    }

    document.querySelectorAll('.host-check').forEach(cb => cb.addEventListener('change', updateSelectedCount));
    selectAll?.addEventListener('change', () => {
        document.querySelectorAll('.host-check').forEach(cb => { cb.checked = selectAll.checked; });
        updateSelectedCount();
    });
    document.getElementById('btn-select-outdated')?.addEventListener('click', () => {
        document.querySelectorAll('tr[data-status="OutOfDate"] .host-check, tr[data-status="Missing"] .host-check')
            .forEach(cb => { cb.checked = true; });
        updateSelectedCount();
    });

    btnDeploy?.addEventListener('click', () => {
        if (btnDeploy.disabled) return;
        if (!confirm('Queue silent client update for selected machines?\n\nAgents on version 3+ download and install when no Active user session is present (Disconnected is OK). No reboot or logoff.\n\nAgents below 3 (legacy) cannot silent-update — Deploy marks them Failed with bootstrap guidance (use Launch Control / Install.lnk once).'))
            return;
        deployForm.submit();
    });

    document.getElementById('btn-restart-agent')?.addEventListener('click', (e) => {
        const n = document.querySelectorAll('.host-check:checked').length;
        if (n === 0) {
            e.preventDefault();
            return;
        }
        if (!confirm('Restart HeimdallAgent on ' + n + ' selected machine(s)?\n\nBlocked on hosts that already have Deploy/UpdateClient pending.'))
            e.preventDefault();
    });

    document.getElementById('btn-cleanup-staging')?.addEventListener('click', (e) => {
        const n = document.querySelectorAll('.host-check:checked').length;
        if (n === 0) {
            e.preventDefault();
            return;
        }
        if (!confirm('Cleanup staging on ' + n + ' selected machine(s)?\n\nDeletes only:\n• %ProgramData%\\Heimdall\\update\\\n• C:\\Temp\\Heimdall-Client* (exact Heimdall-Client, Heimdall-Client-v{version}, Heimdall-Client-v{version}-{timestamp})\n\nDoes not touch other Temp folders, Program Files\\Heimdall\\Agent, queue, secrets, or logs.\nBlocked if Deploy/UpdateClient is pending.'))
            e.preventDefault();
    });

    document.getElementById('btn-deposit-pack')?.addEventListener('click', (e) => {
        const n = document.querySelectorAll('.host-check:checked').length;
        if (n === 0) {
            e.preventDefault();
            return;
        }
        if (!confirm('Deposit client pack on ' + n + ' selected machine(s)?\n\nAgents download the Ready pack to C:\\Temp\\Heimdall-Client-v{version}-{yyyyMMdd-HHmmss} for manual Install.lnk.\nDoes NOT silent-install or replace HeimdallAgent.\nRequires pack Ready; blocked if Deploy/UpdateClient or Deposit already pending.'))
            e.preventDefault();
    });

    document.getElementById('btn-set-api-url')?.addEventListener('click', (e) => {
        const n = document.querySelectorAll('.host-check:checked').length;
        const urlInput = document.getElementById('new-api-base-url');
        const url = (urlInput && urlInput.value || '').trim();
        if (n === 0) {
            e.preventDefault();
            return;
        }
        if (!url) {
            e.preventDefault();
            alert('Enter the new API URL (e.g. http://host:5080).');
            return;
        }
        if (!confirm('Set API URL on ' + n + ' selected machine(s) to:\n\n' + url + '\n\nAgents rewrite Program Files appsettings and restart HeimdallAgent.\nThey must still be able to reach THIS API to pick up the command.\nOffline hosts: open the pack and run Set-ApiUrl.lnk (IP is set in Set-HeimdallAgentApiBaseUrl.cmd).'))
            e.preventDefault();
    });

    async function refreshReadiness() {
        // While packing, keep the last one-liner visible (don't flash "Checking pack…").
        const keepPackingLine = statusLine.textContent && statusLine.textContent.startsWith('Packing');
        if (!keepPackingLine)
            statusLine.textContent = 'Checking pack…';
        btnDeploy.disabled = true;
        readinessDone = false;
        deployUnlocked = false;
        clearPackPoll();
        try {
            const res = await fetch('/api/admin/client-pack/status', { credentials: 'same-origin' });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const data = await res.json();
            readinessDone = true;
            deployUnlocked = !!data.deployUnlocked;
            const shortFp = (fp) => fp ? (fp.substring(0, 12) + '…') : '—';
            const packing = data.status === 'Packing' || data.isPacking;
            if (packing) {
                statusLine.textContent = packingStatusText(data);
                statusLine.className = 'text-secondary';
                btnPack.disabled = true;
                if (btnRefreshPack) btnRefreshPack.disabled = true;
                setCancelVisible(true);
                packPollTimer = setTimeout(refreshReadiness, 2000);
            } else {
                statusLine.textContent = (data.message || data.status)
                    + (data.packProductVersion ? ' · pack v' + data.packProductVersion : '')
                    + (data.packFolder ? ' · ' + data.packFolder : '')
                    + (data.liveSourceFingerprint ? ' · source ' + shortFp(data.liveSourceFingerprint) : '');
                statusLine.className = (data.status === 'Error' || data.status === 'Stale' || data.status === 'MissingPack')
                    ? 'text-danger'
                    : (data.deployUnlocked ? 'text-success' : 'text-secondary');
                btnPack.disabled = !data.canPack;
                if (btnRefreshPack) btnRefreshPack.disabled = !data.canPack && !data.packFolder;
                setCancelVisible(false);
            }
            setDeployHint(data, packing);
            apiNote.textContent = data.apiInstallNote
                || (packing ? 'Self-contained publish often takes 1–5 minutes (same as Launch Control).' : '');
            showLastPack(data);
            updateSelectedCount();
        } catch (e) {
            readinessDone = true;
            deployUnlocked = false;
            statusLine.textContent = 'Pack check failed: ' + (e.message || e);
            statusLine.className = 'text-danger';
            if (deployHint) {
                deployHint.textContent = 'Deploy locked: readiness check failed.';
                deployHint.className = 'small mt-1 text-danger';
            }
            btnPack.disabled = false;
            if (btnRefreshPack) btnRefreshPack.disabled = false;
            setCancelVisible(false);
            updateSelectedCount();
        }
    }

    btnRefreshPack?.addEventListener('click', async () => {
        btnRefreshPack.disabled = true;
        statusLine.textContent = 'Refreshing pack from disk…';
        try {
            const res = await fetch('/api/admin/client-pack/refresh', { method: 'POST', credentials: 'same-origin' });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) {
                statusLine.textContent = data.message || ('Refresh failed: HTTP ' + res.status);
                statusLine.className = 'text-danger';
            }
            await refreshReadiness();
        } catch (e) {
            statusLine.textContent = 'Refresh failed: ' + (e.message || e);
            statusLine.className = 'text-danger';
            btnRefreshPack.disabled = false;
        }
    });

    btnPack?.addEventListener('click', async () => {
        let force = false;
        if (deployUnlocked) {
            if (!confirm('Pack on disk already matches source — Deploy is unlocked.\n\nRebuild and bump version (N+1) anyway?\n\nChoose Cancel to leave the current pack (use Refresh from disk after Launch Control).'))
                return;
            force = true;
        }
        btnPack.disabled = true;
        setCancelVisible(false);
        statusLine.textContent = force ? 'Starting forced pack (N+1)…' : 'Starting pack…';
        lastResultEl.style.display = 'none';
        logTailEl.style.display = 'none';
        try {
            const url = '/api/admin/client-pack/pack' + (force ? '?force=1' : '');
            const res = await fetch(url, { method: 'POST', credentials: 'same-origin' });
            const data = await res.json().catch(() => ({}));
            if (data.outcome === 'already-ready' || data.skipped) {
                statusLine.textContent = data.message || 'Pack already matches source — Deploy unlocked.';
                statusLine.className = 'text-success';
                await refreshReadiness();
                return;
            }
            if (!res.ok) {
                statusLine.textContent = data.message || ('Pack failed: HTTP ' + res.status);
                statusLine.className = 'text-danger';
                btnPack.disabled = false;
                return;
            }
            statusLine.textContent = 'Packing · 0s · stage 1/5: preparing';
            setCancelVisible(true);
            packPollTimer = setTimeout(refreshReadiness, 1500);
        } catch (e) {
            statusLine.textContent = 'Pack start failed: ' + (e.message || e);
            statusLine.className = 'text-danger';
            btnPack.disabled = false;
            setCancelVisible(false);
        }
    });

    btnCancel?.addEventListener('click', async () => {
        if (!confirm('Cancel pack?')) return;
        btnCancel.disabled = true;
        statusLine.textContent = 'Cancelling pack…';
        try {
            const res = await fetch('/api/admin/client-pack/cancel', { method: 'POST', credentials: 'same-origin' });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) {
                statusLine.textContent = data.message || ('Cancel failed: HTTP ' + res.status);
                statusLine.className = 'text-danger';
            }
            clearPackPoll();
            packPollTimer = setTimeout(refreshReadiness, 1000);
        } catch (e) {
            statusLine.textContent = 'Cancel failed: ' + (e.message || e);
            statusLine.className = 'text-danger';
            btnCancel.disabled = false;
        }
    });

    refreshReadiness();
})();
</script>
