@page "{id:int}"
@model StaffModel
@{
    ViewData["Title"] = Model.Group is null ? "Staff Access" : $"Staff · {Model.Group.Name}";
}

@if (Model.Group is null)
{
    <h1 class="hd-title">Staff Access</h1>
    <div class="alert alert-danger">Group not found.</div>
    <a class="btn btn-hd" asp-page="/StaffAccess">Back to Staff Access</a>
    return;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-2">
    <div>
        <h1 class="hd-title mb-1">@Model.Group.Name</h1>
        <p class="hd-sub mb-0">
            Your machines · CPU / GPU / RAM / disk activity.
            Signed in as @Model.SignedInEmail · <a asp-page="/StaffAccess">switch group</a>
        </p>
    </div>
    <div class="hd-staff-live-bar" data-hd-staff-live-bar>
        <div class="hd-staff-live-idle d-flex flex-wrap align-items-center gap-2" data-hd-live-idle>
            <label class="text-secondary small mb-0" for="hd-live-duration">Duration</label>
            <select class="form-select form-select-sm hd-staff-live-duration" id="hd-live-duration" data-hd-live-duration>
                <option value="30" selected>30 min</option>
                <option value="60">1 hour</option>
                <option value="120">2 hours</option>
                <option value="180">3 hours</option>
                <option value="240">4 hours</option>
                <option value="360">6 hours</option>
                <option value="480">8 hours</option>
            </select>
            <button type="button" class="hd-btn hd-btn-gold" data-hd-live-start>Start Live</button>
        </div>
        <div class="hd-staff-live-active d-flex flex-wrap align-items-center gap-2" data-hd-live-active hidden>
            <span class="badge-pill badge-active hd-staff-pill">Live</span>
            <span class="hd-staff-live-countdown" aria-live="polite">
                <span class="text-secondary small">Remaining</span>
                <span class="hd-countdown-digits" data-hd-live-countdown>30:00</span>
            </span>
            <button type="button" class="hd-btn hd-btn-rose hd-btn-sm" data-hd-live-stop>Stop</button>
        </div>
    </div>
</div>

@if (Model.IsAdminPreview)
{
    <div class="alert alert-warning">
        <strong>Admin preview.</strong> You are viewing this Staff page without group membership.
        Live metrics and favourites still work. Configure allowlisted admins under
        <code>Heimdall:StaffAccess:AdminEmails</code>.
    </div>
}

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<p class="text-secondary small @(Model.Rows.Any(r => string.IsNullOrWhiteSpace(r.FriendlyName)) ? "mb-2" : "mb-3")">
    <strong>Live tracking:</strong> click <strong>Start Live</strong> to begin a timed session (default 30 minutes, up to 8 hours).
    While active, the agent takes 1 sample/sec for the first 10 seconds (average shown first), then one reading every 10 seconds.
    When the timer ends or you click <strong>Stop</strong>, sampling stops for your tab. If teammates also have live sessions open,
    sampling still runs only once per machine — everyone reads the same data from the API.
</p>
@if (Model.Rows.Any(r => string.IsNullOrWhiteSpace(r.FriendlyName)))
{
    <p class="text-secondary small mb-3">
        Machines without a friendly name show hostname only.
        Set a <strong>friendly name</strong> under
        <a asp-page="/RemoteAccessGroups" asp-route-edit="@Model.Id">Admin → Remote Access Groups → Edit group → Machines</a>.
    </p>
}

<div class="hd-panel hd-remote-panel hd-staff-panel mb-4">
    <table class="hd-table hd-staff-table">
        <thead>
            <tr>
                <th class="hd-staff-th-status">Status</th>
                <th class="hd-staff-th-machine">Machine</th>
                <th class="hd-staff-th-ip">IP</th>
                <th class="hd-staff-th-contact">Last contact</th>
                <th class="hd-staff-th-rds hd-th-stacked"><span>RDS</span><span>Service</span></th>
                <th class="hd-staff-th-metric">CPU</th>
                <th class="hd-staff-th-metric">GPU</th>
                <th class="hd-staff-th-metric">RAM</th>
                <th class="hd-staff-th-metric hd-th-stacked"><span>Disk</span><span>Reads</span></th>
                <th class="hd-staff-th-metric hd-th-stacked"><span>Disk</span><span>Writes</span></th>
                <th class="hd-staff-th-sampling">Sampling</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Rows.Count == 0)
        {
            <tr><td colspan="11">No machines assigned to this group yet — ask an admin to add some under Admin → Remote Access Groups.</td></tr>
        }
        @foreach (var r in Model.Rows)
        {
            var m = r.Metric;
            <tr data-hd-staff-row data-hostname="@r.Hostname" data-display-name="@r.DisplayName">
                <td class="hd-staff-status">
                    @if (r.IsOnline)
                    {
                        <span class="badge-pill badge-active hd-staff-pill">Online</span>
                    }
                    else
                    {
                        <span class="badge-pill badge-ended hd-staff-pill">Offline</span>
                    }
                </td>
                <td class="hd-staff-machine">
                    @if (string.IsNullOrWhiteSpace(r.FriendlyName))
                    {
                        <strong class="hd-staff-hostname">@r.Hostname</strong>
                    }
                    else
                    {
                        <strong class="hd-staff-display-name" title="@r.Hostname">@r.DisplayName</strong>
                        <span class="text-secondary small d-block hd-staff-hostname-sub">@r.Hostname</span>
                    }
                </td>
                <td class="hd-remote-ip hd-staff-ip">@(r.LastIp ?? "—")</td>
                <td class="hd-remote-contact hd-staff-contact">@StaffModel.FormatContact(r.LastSeenUtc)</td>
                <td class="hd-staff-rds">
                    @if (!string.IsNullOrWhiteSpace(r.TermServiceStatus))
                    {
                        <span class="badge-pill hd-staff-pill @StaffModel.TermServiceBadgeClass(r.TermServiceStatus)">@r.TermServiceStatus</span>
                    }
                    else
                    {
                        <span class="text-secondary">—</span>
                    }
                </td>
                <td class="hd-metric-cell hd-staff-metric" data-hd-metric="cpu">
                    <div class="hd-metric-value">@StaffModel.FormatPercent(m.CpuPercent)</div>
                    <ul class="hd-metric-top hd-staff-metric-top" data-hd-top="cpu">
                        @foreach (var p in m.TopCpuProcesses)
                        {
                            <li>@p.ProcessName <span class="text-secondary">@p.Value.ToString("0.#")%</span></li>
                        }
                    </ul>
                </td>
                <td class="hd-metric-cell hd-staff-metric" data-hd-metric="gpu">
                    <div class="hd-metric-value">@StaffModel.FormatPercent(m.GpuPercent)</div>
                    <ul class="hd-metric-top hd-staff-metric-top" data-hd-top="gpu">
                        @foreach (var p in m.TopGpuProcesses)
                        {
                            <li>@p.ProcessName <span class="text-secondary">@p.Value.ToString("0.#")%</span></li>
                        }
                    </ul>
                    @if (m.GpuPercent is null && m.CpuPercent is not null)
                    {
                        <div class="text-secondary small">n/a on this host</div>
                    }
                </td>
                <td class="hd-metric-cell hd-staff-metric" data-hd-metric="ram">
                    <div class="hd-metric-value">@StaffModel.FormatRam(m)</div>
                    <ul class="hd-metric-top hd-staff-metric-top" data-hd-top="ram">
                        @foreach (var p in m.TopRamProcesses)
                        {
                            <li>@p.ProcessName <span class="text-secondary">@p.Value.ToString("0.#") MB</span></li>
                        }
                    </ul>
                </td>
                <td class="hd-metric-cell hd-staff-metric" data-hd-metric="diskRead">
                    <span class="badge-pill hd-staff-pill @StaffModel.DiskLevelBadgeClass(m.DiskReadLevel)" data-hd-level="diskRead">@m.DiskReadLevel</span>
                    <ul class="hd-metric-top hd-staff-metric-top" data-hd-top="diskRead">
                        @foreach (var p in m.TopDiskReadProcesses)
                        {
                            <li>@p.ProcessName <span class="text-secondary">@FormatBytesPerSec(p.Value)</span></li>
                        }
                    </ul>
                </td>
                <td class="hd-metric-cell hd-staff-metric" data-hd-metric="diskWrite">
                    <span class="badge-pill hd-staff-pill @StaffModel.DiskLevelBadgeClass(m.DiskWriteLevel)" data-hd-level="diskWrite">@m.DiskWriteLevel</span>
                    <ul class="hd-metric-top hd-staff-metric-top" data-hd-top="diskWrite">
                        @foreach (var p in m.TopDiskWriteProcesses)
                        {
                            <li>@p.ProcessName <span class="text-secondary">@FormatBytesPerSec(p.Value)</span></li>
                        }
                    </ul>
                </td>
                <td class="hd-staff-sampling" data-hd-sampling-status>
                    <span class="badge-pill hd-staff-pill hd-staff-sampling-pill @StaffModel.SamplingStatusBadgeClass(m)">@StaffModel.SamplingStatusLabel(m)</span>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="hd-panel h-100">
            <h2 class="h5 mb-2">Favourite processes</h2>
            <form method="post" asp-page-handler="ToggleFavoritesOnly" class="mb-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" asp-for="FavoritesOnly" id="favOnlySwitch" onchange="this.form.requestSubmit()" />
                    <label class="form-check-label" for="favOnlySwitch">Track only favourites (hides the generic top-3 lists above once favourites exist)</label>
                </div>
            </form>

            @if (Model.Group.FavoriteProcesses.Count == 0)
            {
                <p class="text-secondary">No favourites yet — add a process name below (e.g. Revit, acad).</p>
            }
            else
            {
                <div class="hd-process-list mb-3">
                    <div class="hd-process-items">
                        @foreach (var f in Model.Group.FavoriteProcesses.OrderBy(x => x.ProcessName, StringComparer.OrdinalIgnoreCase))
                        {
                            <div class="hd-process-item">
                                <span class="hd-process-name flex-grow-1">★ @f.ProcessName</span>
                                <form method="post" asp-page-handler="RemoveFavorite" class="d-inline">
                                    <input type="hidden" name="FavoriteId" value="@f.Id" />
                                    <button type="submit" class="btn btn-ghost btn-sm">Remove</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }

            <form method="post" asp-page-handler="AddFavorite" class="d-flex gap-2 flex-wrap">
                <input class="form-control" style="max-width: 260px;" asp-for="FavoriteProcessInput" placeholder="Process name (e.g. Revit)" />
                <button type="submit" class="btn btn-hd btn-sm">Add favourite</button>
            </form>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="hd-panel h-100">
            <h2 class="h5 mb-2">Favourites — live values</h2>
            <p class="text-secondary small">
                Shown for machines where a favourite process is currently running, even if it's not in that machine's top 3.
            </p>
            <div data-hd-favorites-panel>
                @foreach (var r in Model.Rows.Where(r => r.Metric.FavoriteProcesses.Count > 0))
                {
                    <div class="mb-2">
                        @if (string.IsNullOrWhiteSpace(r.FriendlyName))
                        {
                            <strong>@r.Hostname</strong>
                        }
                        else
                        {
                            <strong title="@r.Hostname">@r.DisplayName</strong>
                            <span class="text-secondary small">(@r.Hostname)</span>
                        }
                        <ul class="hd-metric-top">
                            @foreach (var f in r.Metric.FavoriteProcesses)
                            {
                                <li>
                                    @f.ProcessName —
                                    CPU @StaffModel.FormatPercent(f.CpuPercent),
                                    GPU @StaffModel.FormatPercent(f.GpuPercent),
                                    RAM @(f.RamMb is double mb ? $"{mb:0.#} MB" : "—")
                                </li>
                            }
                        </ul>
                    </div>
                }
                @if (Model.Rows.All(r => r.Metric.FavoriteProcesses.Count == 0))
                {
                    <p class="text-secondary mb-0">No favourite processes currently running on your machines.</p>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    string FormatBytesPerSec(double bytesPerSec)
    {
        var mb = bytesPerSec / (1024.0 * 1024.0);
        return mb >= 1 ? $"{mb:0.#} MB/s" : $"{bytesPerSec / 1024.0:0.#} KB/s";
    }
}

@section Scripts {
    <script>
        window.HeimdallStaffGroupId = @Model.Id;
    </script>
    <script src="~/js/staff-live-metrics.js" asp-append-version="true"></script>
}
