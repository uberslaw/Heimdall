@page
@model SocratizeModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Host) ? "Socratize" : $"Socratize · {Model.Host}";
    var brief = Model.Brief;
    var appOpenTotal = brief?.Apps.Sum(a => a.TotalOpenSeconds) ?? 0;
    var localAccounted = brief is null ? 0 : brief.LocalActiveSeconds + brief.LocalDisconnectedSeconds;
    var inboundAccounted = brief is null ? 0 : brief.RdpActiveSeconds + brief.RdpDisconnectedSeconds;
    var outboundAccounted = brief?.OutboundRdpSeconds ?? 0;
}

<h1 class="hd-title">Socratize</h1>
<p class="hd-sub">One-machine cost-justification brief — probe Heimdall’s collected data (sessions, local vs inbound/outbound RDP, util, apps, teams). Verdict from <a asp-page="/Utilization">Utilization criteria</a>.</p>

<form method="get" class="hd-panel mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="host">Machine</label>
            <select class="form-select" name="Host" id="host">
                <option value="">— select host —</option>
                @foreach (var h in Model.Hostnames)
                {
                    if (string.Equals(Model.Host, h, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@h" selected>@h</option>
                    }
                    else
                    {
                        <option value="@h">@h</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="days">Period</label>
            <select class="form-select" name="Days" id="days">
                @{
                    var dayOpts = new (int V, string L)[] { (7, "Last 7 days"), (30, "Last 30 days"), (90, "Last 90 days"), (0, "Custom dates") };
                    var selectedDays = Model.Days is 7 or 90 or 0 ? Model.Days : 30;
                }
                @foreach (var opt in dayOpts)
                {
                    if (opt.V == selectedDays)
                    {
                        <option value="@opt.V" selected>@opt.L</option>
                    }
                    else
                    {
                        <option value="@opt.V">@opt.L</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">From (UTC)</label>
            <input class="form-control" type="date" name="From" value="@(Model.From ?? Model.FromUtc.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2">
            <label class="form-label">To (UTC)</label>
            <input class="form-control" type="date" name="To" value="@(Model.To ?? Model.ToUtc.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-hd w-100">Socratize</button>
        </div>
    </div>
</form>

@if (string.IsNullOrWhiteSpace(Model.Host))
{
    <div class="hd-panel">
        <p class="text-secondary mb-0">Pick a machine (or use <strong>Socratize</strong> on the Machines page) to generate a retrospective Q&amp;A brief from already-collected Heimdall data.</p>
    </div>
}
else if (Model.HostNotFound)
{
    <div class="hd-panel">
        <p class="mb-0" style="color:#f0a0a0;">No machine named <strong>@Model.Host</strong> in the database yet.</p>
    </div>
}
else if (brief is not null)
{
    <div class="hd-grid mb-3">
        <div class="hd-stat">
            <div class="label">Host</div>
            <div class="value" style="font-size:1.25rem;">@brief.Hostname</div>
        </div>
        <div class="hd-stat">
            <div class="label">Period</div>
            <div class="value" style="font-size:1.1rem;">@Model.PeriodLabel</div>
        </div>
        <div class="hd-stat">
            <div class="label">Utilisation</div>
            <div class="value">@brief.UtilisationPct.ToString("0")%</div>
        </div>
        <div class="hd-stat">
            <div class="label">POC verdict</div>
            <div class="value" style="font-size:1.15rem;">
                <span class="badge-pill badge-socratize-@brief.Verdict.Code">@brief.Verdict.Label</span>
            </div>
        </div>
    </div>

    <p class="hd-meta-line mb-3">
        @(brief.Region ?? "—") / @(brief.Office ?? "—")
        @if (!string.IsNullOrWhiteSpace(brief.MachineGroup))
        {
            <span>· group @brief.MachineGroup</span>
        }
        · @brief.SessionCount sessions · @brief.ProcessRunCount process runs
        · @brief.FromUtc.ToString("yyyy-MM-dd") → @brief.ToUtc.ToString("yyyy-MM-dd") UTC
    </p>

    <div class="hd-panel mb-3">
        <h2 class="hd-section-title">Interrogation</h2>
        <div class="hd-qa-list">

            <div class="hd-qa">
                <div class="hd-q">Who uses this machine?</div>
                @if (brief.Users.Count == 0)
                {
                    <p class="hd-a text-secondary mb-0">
                        @(brief.SessionCount == 0 && brief.ProcessRunCount == 0
                            ? "No sessions or process runs in this period."
                            : "No user sessions recorded. Process runs may still show app activity without a matched logon.")
                    </p>
                }
                else
                {
                    <table class="hd-table mb-0">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Team</th>
                                <th>Logons</th>
                                <th>Active</th>
                                <th>Disconnected</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var u in brief.Users)
                        {
                            <tr>
                                <td>@u.Username</td>
                                <td>@(u.TeamName ?? "—")</td>
                                <td>@u.LogonCount</td>
                                <td>@FormatDur(u.ActiveSeconds)</td>
                                <td>@FormatDur(u.DisconnectedSeconds)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    @if (brief.Teams.Count > 0)
                    {
                        <p class="hd-meta-line mb-0 mt-2">
                            Teams:
                            @string.Join(", ", brief.Teams.Select(t => $"{t.TeamName} ({t.UserCount})"))
                        </p>
                    }
                }
            </div>

            <div class="hd-qa">
                <div class="hd-q">How do they connect?</div>
                @if (brief.SessionCount == 0)
                {
                    <p class="hd-a text-secondary mb-0">No session type mix available.</p>
                }
                else
                {
                    <div class="hd-grid mb-2" style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));">
                        <div class="hd-stat">
                            <div class="label">Local time</div>
                            <div class="value" style="font-size:1.25rem;">@FormatDur(localAccounted)</div>
                        </div>
                        <div class="hd-stat">
                            <div class="label">Inbound RDP</div>
                            <div class="value" style="font-size:1.25rem;">@FormatDur(inboundAccounted)</div>
                        </div>
                        <div class="hd-stat">
                            <div class="label">Outbound RDP</div>
                            <div class="value" style="font-size:1.25rem;">@FormatDur(outboundAccounted)</div>
                        </div>
                        <div class="hd-stat">
                            <div class="label">Local %</div>
                            <div class="value" style="font-size:1.25rem;">@brief.LocalSharePct.ToString("0")%</div>
                        </div>
                        <div class="hd-stat">
                            <div class="label">Inbound %</div>
                            <div class="value" style="font-size:1.25rem;">@brief.RdpSharePct.ToString("0")%</div>
                        </div>
                        <div class="hd-stat">
                            <div class="label">Outbound %</div>
                            <div class="value" style="font-size:1.25rem;">@brief.OutboundRdpSharePct.ToString("0")%</div>
                        </div>
                    </div>
                    @if (brief.Users.Count > 0)
                    {
                        <table class="hd-table mb-0">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Local</th>
                                    <th>Inbound RDP</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var u in brief.Users)
                            {
                                <tr>
                                    <td>@u.Username</td>
                                    <td><span class="badge-pill badge-local">@u.LocalLogons</span></td>
                                    <td><span class="badge-pill badge-rdp">@u.RdpLogons</span></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        <p class="hd-meta-line mb-0 mt-2">
                            <strong>Inbound RDP</strong> = remote client connected to this machine (protocol / RDP- WinStation).
                            <strong>Outbound RDP</strong> = time with mstsc/msrdc/msrdcw running on this host (process allowlist).
                            RDP-to-self still counts as inbound.
                        </p>
                    }
                }
            </div>

            <div class="hd-qa">
                <div class="hd-q">How much of the time is it occupied?</div>
                <div class="hd-grid mb-2" style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));">
                    <div class="hd-stat">
                        <div class="label">Occupancy</div>
                        <div class="value" style="font-size:1.25rem;">@brief.UtilisationPct.ToString("0")%</div>
                    </div>
                    <div class="hd-stat">
                        <div class="label">Occupied time</div>
                        <div class="value" style="font-size:1.25rem;">@FormatDur(brief.OccupiedSeconds)</div>
                    </div>
                    <div class="hd-stat">
                        <div class="label">Sessions</div>
                        <div class="value" style="font-size:1.25rem;">@brief.SessionCount</div>
                    </div>
                </div>
                <p class="hd-meta-line mb-0">POC note: share of calendar window with ≥1 open session; overlapping sessions are not de-duplicated (can look oddly low or inflated).</p>
            </div>

            <div class="hd-qa">
                <div class="hd-q">Active vs disconnected inbound RDP waste?</div>
                @if (brief.RdpDisconnectedSeconds <= 0 && brief.RdpSharePct < 1)
                {
                    <p class="hd-a text-secondary mb-0">Little or no inbound RDP disconnected time in this window.</p>
                }
                else
                {
                    <table class="hd-table mb-0">
                        <thead>
                            <tr>
                                <th>Metric</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Inbound RDP active</td>
                                <td>@FormatDur(brief.RdpActiveSeconds)</td>
                            </tr>
                            <tr>
                                <td>Inbound RDP disconnected</td>
                                <td>@FormatDur(brief.RdpDisconnectedSeconds)</td>
                            </tr>
                            <tr>
                                <td>% of inbound RDP time disconnected</td>
                                <td>@brief.RdpIdleShareOfRdpPct.ToString("0")%</td>
                            </tr>
                            <tr>
                                <td>Inbound RDP sessions</td>
                                <td>@brief.RdpSessionCount</td>
                            </tr>
                        </tbody>
                    </table>
                }
            </div>

            <div class="hd-qa">
                <div class="hd-q">What applications dominate time?</div>
                @if (brief.Apps.Count == 0)
                {
                    <p class="hd-a text-secondary mb-0">
                        @(brief.SessionCount > 0
                            ? "No allowlisted process runs in this period. Check Track Software / Config include lists."
                            : "No tracked process runs in this period.")
                    </p>
                }
                else
                {
                    <table class="hd-table mb-0">
                        <thead>
                            <tr>
                                <th>App</th>
                                <th>Open time</th>
                                <th>Runs</th>
                                <th>Share %</th>
                                <th>Cost / yr</th>
                                <th>$ / h</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var a in brief.Apps.Take(15))
                        {
                            var share = appOpenTotal <= 0 ? 0 : a.TotalOpenSeconds * 100.0 / appOpenTotal;
                            <tr>
                                <td>@a.ProcessName</td>
                                <td>@FormatDur(a.TotalOpenSeconds)</td>
                                <td>@a.RunCount</td>
                                <td>@share.ToString("0")%</td>
                                <td>@(a.LicenseCostPerYear is double c ? c.ToString("0.##") : "—")</td>
                                <td>@(a.CostPerHour is double h ? h.ToString("0.##") : "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>

            <div class="hd-qa">
                <div class="hd-q">Any high-threshold metric policies in scope?</div>
                @if (brief.PoliciesInScope.Count == 0)
                {
                    <p class="hd-a text-secondary mb-0">No enabled MetricPolicy matches this host’s scope.</p>
                }
                else
                {
                    <table class="hd-table mb-0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Scope</th>
                                <th>Thresholds</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var p in brief.PoliciesInScope)
                        {
                            <tr>
                                <td>@p.Name</td>
                                <td><span class="badge-pill">@p.MetricType</span></td>
                                <td>@(string.IsNullOrWhiteSpace(p.ScopeValue) ? p.Scope : $"{p.Scope}={p.ScopeValue}")</td>
                                <td>@p.ThresholdSummary</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    @if (!brief.HasGpuSamples || !brief.HasDiskSamples)
                    {
                        <p class="hd-meta-line mb-0 mt-2">Note: agent GPU/disk sampling may still be stubbed — thresholds can exist without samples.</p>
                    }
                }
            </div>

            <div class="hd-qa">
                <div class="hd-q">POC verdict</div>
                <div class="hd-a mb-2">
                    <span class="badge-pill badge-socratize-@brief.Verdict.Code">@brief.Verdict.Label</span>
                    @if (brief.OverallScore is double score)
                    {
                        <span class="text-secondary"> · score @score.ToString("0.#")/100</span>
                    }
                    <span class="text-secondary"> — @brief.Verdict.Detail</span>
                </div>
                @if (brief.ScoreBreakdown.Count > 0)
                {
                    <table class="hd-table mb-2">
                        <thead>
                            <tr>
                                <th>Criterion</th>
                                <th>Weight</th>
                                <th>Score</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in brief.ScoreBreakdown)
                        {
                            <tr>
                                <td>@row.Criterion</td>
                                <td>@row.Weight.ToString("0.#") <span class="text-secondary">(@row.WeightPct.ToString("0")%)</span></td>
                                <td>@row.Score.ToString("0.#")</td>
                                <td class="small">@row.Notes</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                <p class="hd-meta-line mb-0">
                    Criteria: <a asp-page="/Utilization">Utilization criteria</a> (Global weights &amp; license costs)
                </p>
            </div>

        </div>
    </div>

    <p class="hd-meta-line mb-4">
        <a asp-page="/Index">← Machines</a>
        ·
        <a asp-page="/Stats" asp-route-ScopeKind="Machine" asp-route-ScopeValue="@brief.Hostname" asp-route-Days="30">Open in Stats</a>
    </p>
}

@* Parked product idea — keep the Socratize name for retrospective; Flight Recorder is the future deep-observe arm. *@
<div class="hd-panel hd-flight-recorder">
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
        <div>
            <h2 class="hd-section-title mb-1">Flight Recorder <span class="badge-pill badge-coming">coming</span></h2>
            <p class="hd-flight-copy mb-0">
                Optional high-cardinality capture <em>while</em> a watched process runs (or on demand) — e.g. <code>tuflow.exe</code> choking on network dropouts —
                then ship a ring buffer for AI / Socratize analysis: what was happening when it failed?
                Candidate later tech: ETW (TcpIp / Kernel-Network), perf counters, <code>Get-NetTCPConnection</code> sampling;
                correlate SessionId + NIC errors + RDP disconnects. Not ProcMon/WFP in the default agent.
            </p>
        </div>
        <button type="button" class="btn btn-ghost btn-sm" disabled title="Backlog — see docs/BACKLOG.md">Flight Recorder (coming)</button>
    </div>
</div>

@functions {
    static string FormatDur(double seconds)
    {
        if (seconds < 60) return $"{seconds:0}s";
        if (seconds < 3600) return $"{seconds / 60.0:0.#}m";
        if (seconds < 86400) return $"{seconds / 3600.0:0.#}h";
        return $"{seconds / 86400.0:0.#}d";
    }
}
