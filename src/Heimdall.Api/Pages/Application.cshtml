@page
@model ApplicationModel
@using Heimdall.Api.Services
@using Heimdall.Shared.Contracts
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Process) ? "Application" : Model.Detail?.DisplayName ?? Model.Process;
    var d = Model.Detail;
    var shortLabel = Model.RangeDays == 1 ? "1d" : $"{Model.RangeDays}d";
}

<p class="hd-meta-line mb-2">
    <a asp-page="/Apps" asp-route-range="@Model.Range">← Application Usage</a>
    @if (d is not null)
    {
        <span> · </span>
        <a asp-page="/Stats" asp-route-ScopeKind="All" asp-route-Days="@Model.RangeDays" asp-route-View="apps-time">Open in Stats</a>
        <span> · </span>
        <a asp-page="/Discovery" asp-route-q="@d.ProcessName">Open in Discovery</a>
    }
</p>

@if (TempData["Message"] is string toastMsg)
{
    <div class="hd-toast hd-toast-success mb-3" role="status">@toastMsg</div>
}
@if (TempData["Error"] is string toastErr)
{
    <div class="hd-toast hd-toast-error mb-3" role="alert">@toastErr</div>
}

@if (Model.MissingProcess)
{
    <div class="hd-panel">
        <p class="text-secondary mb-0">No process name specified. Pick an app from the <a asp-page="/Apps">Application Usage</a> list.</p>
    </div>
}
else if (d is not null)
{
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-1">
        <div>
            <h1 class="hd-title mb-0">@d.DisplayName</h1>
            <p class="hd-sub mb-0">
                @Model.RangeLabel usage
                @if (!string.Equals(d.DisplayName, d.ProcessName, StringComparison.OrdinalIgnoreCase))
                {
                    <span>· process <code>@d.ProcessName</code></span>
                }
                else
                {
                    <span>· <code>@d.ProcessName</code></span>
                }
            </p>
        </div>
        <a class="hd-btn hd-btn-silver"
           href="@Model.GoogleSearchUrl"
           target="_blank"
           rel="noopener noreferrer"
           title="Search Google for this application">
            Google this app
        </a>
    </div>

    <section class="hd-panel mb-3">
        <h2 class="hd-section-title">Identity</h2>
        <div class="row g-3 small mb-3">
            <div class="col-md-6">
                <div class="text-secondary">Executable</div>
                <div><code>@d.ProcessName</code></div>
            </div>
            <div class="col-md-6">
                <div class="text-secondary">Publisher</div>
                <div>@(string.IsNullOrWhiteSpace(d.CompanyName) ? "—" : d.CompanyName)</div>
            </div>
            <div class="col-md-6">
                <div class="text-secondary">File description (from binary)</div>
                <div>@(string.IsNullOrWhiteSpace(d.FileDescription) ? "—" : d.FileDescription)</div>
            </div>
            <div class="col-md-6">
                <div class="text-secondary">Classification</div>
                <div>
                    <strong>@ProcessClassification.GroupLabel(d.Classification)</strong>
                    @if (d.SuggestedGroup is AppGroup sug && sug != d.Classification)
                    {
                        <span class="text-secondary"> · suggested @ProcessClassification.GroupLabel(sug)</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(d.SuggestionReason))
                {
                    <div class="text-secondary mt-1">@d.SuggestionReason</div>
                }
            </div>
        </div>

        @if (d.CatalogPaths.Count == 0)
        {
            <p class="text-secondary small mb-0">No install paths recorded yet for this process.</p>
        }
        else
        {
            <table class="hd-table table-sm small mb-0">
                <thead>
                    <tr>
                        <th>Full path</th>
                        <th>Version</th>
                        <th>Seen</th>
                        <th>Last seen</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in d.CatalogPaths)
                {
                    <tr>
                        <td>
                            @if (string.IsNullOrWhiteSpace(p.ExecutablePath))
                            {
                                <span class="text-secondary">path unknown</span>
                            }
                            else
                            {
                                <code style="word-break:break-all">@p.ExecutablePath</code>
                            }
                        </td>
                        <td>@(p.Version ?? "—")</td>
                        <td>@(p.SeenCount > 0 ? p.SeenCount.ToString() : "—")</td>
                        <td>
                            @(p.LastSeenUtc is DateTimeOffset ls
                                ? IndexModel.FormatLocalTimestamp(ls)
                                : "—")
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>

    <section class="hd-panel mb-3">
        <h2 class="hd-section-title">Categorization &amp; lists</h2>
        <p class="text-secondary small mb-3">
            Edit category labels and classification here (same data as Discovery). App-list membership controls which lists include this process for tracking.
        </p>

        <form method="post" asp-page-handler="SaveIdentity" class="mb-4">
            <input type="hidden" name="Process" value="@d.ProcessName" />
            <input type="hidden" name="Range" value="@Model.Range" />
            <input type="hidden" name="Hostname" value="@Model.Hostname" />
            <div class="row g-3 align-items-end">
                <div class="col-lg-6">
                    <label class="form-label" for="edit-description">Description</label>
                    <textarea class="form-control form-control-sm" id="edit-description" name="EditDescription"
                              rows="3" maxlength="2000"
                              placeholder="What this app is / how it is used">@d.Description</textarea>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="edit-category">Category</label>
                    <input class="form-control form-control-sm" list="app-category-options"
                           id="edit-category" name="EditCategory" value="@d.Category" maxlength="100" />
                    <datalist id="app-category-options">
                        @foreach (var opt in Model.CategoryOptions)
                        {
                            <option value="@opt"></option>
                        }
                    </datalist>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="edit-subcategory">Subcategory</label>
                    <input class="form-control form-control-sm" list="app-subcategory-options"
                           id="edit-subcategory" name="EditSubcategory" value="@d.Subcategory" maxlength="100" />
                    <datalist id="app-subcategory-options">
                        @foreach (var opt in Model.SubcategoryOptions)
                        {
                            <option value="@opt"></option>
                        }
                    </datalist>
                </div>
                <div class="col-auto">
                    <button type="submit" class="hd-btn hd-btn-gold">Save labels</button>
                </div>
            </div>
        </form>

        <form method="post" asp-page-handler="SetClassification" class="row g-2 align-items-end mb-4">
            <input type="hidden" name="Process" value="@d.ProcessName" />
            <input type="hidden" name="Range" value="@Model.Range" />
            <input type="hidden" name="Hostname" value="@Model.Hostname" />
            <div class="col-md-4 col-lg-3">
                <label class="form-label" for="edit-group">Classification</label>
                <select class="form-select form-select-sm" id="edit-group" name="EditGroup">
                    @foreach (AppGroup g in Enum.GetValues<AppGroup>())
                    {
                        if (d.Classification == g)
                        {
                            <option value="@g" selected>@ProcessClassification.GroupLabel(g)</option>
                        }
                        else
                        {
                            <option value="@g">@ProcessClassification.GroupLabel(g)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="hd-btn hd-btn-silver">Set classification</button>
            </div>
        </form>

        <h3 class="h6 mb-2">App lists</h3>
        @if (Model.ListMembership.Count == 0)
        {
            <p class="text-secondary small">Not on any app list yet.</p>
        }
        else
        {
            <ul class="list-unstyled small mb-3">
                @foreach (var m in Model.ListMembership)
                {
                    <li class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <a asp-page="/AppLists" asp-route-editId="@m.Id">@m.Name</a>
                        @if (m.IsSystem)
                        {
                            <span class="badge text-bg-secondary">system</span>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="RemoveFromList" class="d-inline">
                                <input type="hidden" name="Process" value="@d.ProcessName" />
                                <input type="hidden" name="Range" value="@Model.Range" />
                                <input type="hidden" name="Hostname" value="@Model.Hostname" />
                                <input type="hidden" name="RemoveAppListId" value="@m.Id" />
                                <button type="submit" class="hd-btn hd-btn-silver hd-btn-sm py-0 px-2"
                                        style="font-size:0.7rem;line-height:1.4"
                                        onclick="return confirm('Remove @d.ProcessName from @m.Name?');">
                                    Remove
                                </button>
                            </form>
                        }
                    </li>
                }
            </ul>
        }

        @if (Model.EditableLists.Count > 0)
        {
            <form method="post" asp-page-handler="AddToList" class="row g-2 align-items-end">
                <input type="hidden" name="Process" value="@d.ProcessName" />
                <input type="hidden" name="Range" value="@Model.Range" />
                <input type="hidden" name="Hostname" value="@Model.Hostname" />
                <div class="col-md-6 col-lg-4">
                    <label class="form-label" for="add-list">Add to list</label>
                    <select class="form-select form-select-sm" id="add-list" name="AddAppListId">
                        <option value="0">— choose —</option>
                        @foreach (var list in Model.EditableLists)
                        {
                            var already = Model.ListMembership.Any(m => m.Id == list.Id);
                            if (already)
                            {
                                <option value="@list.Id" disabled>@list.Name (already)</option>
                            }
                            else
                            {
                                <option value="@list.Id">@list.Name (@list.EntryCount)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="hd-btn hd-btn-gold">Add</button>
                </div>
            </form>
        }
        else
        {
            <p class="text-secondary small mb-0">
                No custom app lists yet — create one under <a asp-page="/AppLists">App lists</a>.
                System lists (Core Windows / SOE / Specialization) follow classification above.
            </p>
        }
    </section>

    <div class="hd-grid mb-3">
        <div class="hd-stat">
            <div class="label">Total time open</div>
            <div class="value">@DurationDisplay.Render(d.TotalOpenSeconds)</div>
        </div>
        <div class="hd-stat">
            <div class="label">Avg # processes open</div>
            <div class="value">@ConcurrentDisplay.Render(d.AvgConcurrentProcesses)</div>
        </div>
        <div class="hd-stat">
            <div class="label">Runs</div>
            <div class="value">@d.RunCount</div>
        </div>
        <div class="hd-stat">
            <div class="label">Avg run time</div>
            <div class="value">@DurationDisplay.Render(d.AvgRunSeconds)</div>
        </div>
        <div class="hd-stat">
            <div class="label">Last used</div>
            <div class="value" style="font-size:1rem;margin-top:0.35rem">
                @(d.LastUsedUtc is DateTimeOffset lu ? IndexModel.FormatLocalTimestamp(lu) : "—")
            </div>
        </div>
        <div class="hd-stat">
            <div class="label">Users</div>
            <div class="value">@d.UniqueUsers</div>
        </div>
        <div class="hd-stat">
            <div class="label">Machines</div>
            <div class="value">@d.UniqueMachines</div>
        </div>
    </div>

    <form method="get" class="hd-panel mb-3">
        <input type="hidden" name="process" value="@d.ProcessName" />
        <div class="row g-3 align-items-end">
            <div class="col-md-4 col-lg-3">
                <label class="form-label" for="util-range">Period</label>
                <select class="form-select" name="range" id="util-range">
                    @foreach (var opt in IndexModel.RangeOptions)
                    {
                        if (Model.Range == opt.Key)
                        {
                            <option value="@opt.Key" selected>@opt.Label</option>
                        }
                        else
                        {
                            <option value="@opt.Key">@opt.Label</option>
                        }
                    }
                </select>
            </div>
            @if (d.MachineFilterOptions.Count > 0)
            {
                <div class="col-md-4 col-lg-3">
                    <label class="form-label" for="host-filter">Machine</label>
                    <select class="form-select" name="hostname" id="host-filter">
                        <option value="">All machines</option>
                        @foreach (var h in d.MachineFilterOptions)
                        {
                            if (string.Equals(Model.Hostname, h, StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@h" selected>@h</option>
                            }
                            else
                            {
                                <option value="@h">@h</option>
                            }
                        }
                    </select>
                </div>
            }
            <div class="col-auto">
                <button type="submit" class="hd-btn hd-btn-gold">Apply</button>
            </div>
        </div>
    </form>

    @if (d.RunCount == 0)
    {
        <div class="hd-panel mb-3">
            <p class="text-secondary mb-0">
                No process runs for this app in the selected period
                @(string.IsNullOrWhiteSpace(Model.Hostname) ? "" : $" on {Model.Hostname}").
                Stats come from allowlisted <code>ProcessRun</code> records.
            </p>
        </div>
    }
    else
    {
        <div class="hd-panel mb-3">
            <h2 class="hd-section-title">By machine</h2>
            <table class="hd-table hd-sortable" id="app-machines-table">
                <thead>
                    <tr>
                        <th data-sort="text">Machine</th>
                        <th data-sort="num" data-default-desc>Time open</th>
                        <th data-sort="num">Avg # processes open</th>
                        <th data-sort="num">Runs</th>
                        <th data-sort="num">Avg run</th>
                        <th data-sort="text">Last used</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var m in d.Machines)
                {
                    <tr>
                        <td>
                            <a asp-page="/Machine" asp-route-hostname="@m.Hostname" asp-route-range="@Model.Range">
                                <strong>@m.Hostname</strong>
                            </a>
                        </td>
                        <td data-sort-value="@m.TotalOpenSeconds">@DurationDisplay.Render(m.TotalOpenSeconds)</td>
                        <td data-sort-value="@m.AvgConcurrentProcesses.ToString("0.###")">@ConcurrentDisplay.Render(m.AvgConcurrentProcesses)</td>
                        <td data-sort-value="@m.RunCount">@m.RunCount</td>
                        <td data-sort-value="@m.AvgRunSeconds">@DurationDisplay.Render(m.AvgRunSeconds)</td>
                        <td data-sort-value="@m.LastUsedUtc.ToUnixTimeSeconds()">@IndexModel.FormatLocalTimestamp(m.LastUsedUtc)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="hd-panel">
            <h2 class="hd-section-title">By user</h2>
            <table class="hd-table hd-sortable" id="app-users-table">
                <thead>
                    <tr>
                        <th data-sort="text">User</th>
                        <th data-sort="num" data-default-desc>Time open</th>
                        <th data-sort="num">Avg # processes open</th>
                        <th data-sort="num">Runs</th>
                        <th data-sort="num">Avg run</th>
                        <th data-sort="text">Last used</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var u in d.Users)
                {
                    <tr>
                        <td><strong>@UsernameDisplay.Format(u.Username)</strong></td>
                        <td data-sort-value="@u.TotalOpenSeconds">@DurationDisplay.Render(u.TotalOpenSeconds)</td>
                        <td data-sort-value="@u.AvgConcurrentProcesses.ToString("0.###")">@ConcurrentDisplay.Render(u.AvgConcurrentProcesses)</td>
                        <td data-sort-value="@u.RunCount">@u.RunCount</td>
                        <td data-sort-value="@u.AvgRunSeconds">@DurationDisplay.Render(u.AvgRunSeconds)</td>
                        <td data-sort-value="@u.LastUsedUtc.ToUnixTimeSeconds()">@IndexModel.FormatLocalTimestamp(u.LastUsedUtc)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}
