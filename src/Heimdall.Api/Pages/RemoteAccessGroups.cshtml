@page
@model RemoteAccessGroupsModel
@{
    ViewData["Title"] = "Remote Access Groups";
    var editing = Model.EditingGroup;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <h1 class="hd-title mb-1">Remote Access Groups</h1>
    <a class="btn btn-ghost btn-sm" asp-page="/Help" asp-fragment="remote-access-groups">Help</a>
</div>
<p class="hd-sub">
    Staff Access setup · who can see which machines on their Staff page, and which processes they can favourite.
    Staff sign in at <a asp-page="/StaffAccess">Staff Access</a> — their Windows login must match the email you register here (UPN or <code>user@domain</code>).
</p>

@if (!Model.AdminPreviewConfigured)
{
    <div class="alert alert-secondary">
        <strong>Admin preview:</strong> add your email to <code>Heimdall:StaffAccess:AdminEmails</code> in appsettings
        to enable the Preview button below (Windows auth required in production).
    </div>
}
else if (!Model.IsConfiguredAdmin)
{
    <div class="alert alert-secondary">
        <strong>Admin preview:</strong> your current Windows login is not in <code>AdminEmails</code> — Preview links will be disabled until it matches.
        @if (Model.WindowsAuthRequired)
        {
            <div class="small mt-2 mb-0">
                <div><strong>Windows login:</strong>
                    @(Model.WindowsPrincipal is string wp ? wp : "(none — Negotiate did not authenticate this request)")
                </div>
                @if (Model.CandidateEmails.Count > 0)
                {
                    <div><strong>Derived emails:</strong> @string.Join(", ", Model.CandidateEmails)</div>
                }
                else if (Model.WindowsPrincipal is not null)
                {
                    <div><strong>Derived emails:</strong> (none — check <code>Heimdall:StaffAccess:EmailDomainSuffixes</code>)</div>
                }
                @if (Model.ConfiguredAdminEmails.Length > 0)
                {
                    <div><strong>Configured AdminEmails:</strong> @string.Join(", ", Model.ConfiguredAdminEmails)</div>
                }
                @if (Model.SamAccountName is string sam)
                {
                    <div class="mt-2 text-secondary">
                        Look up the correct UPN in AD (RSAT / domain connectivity required):
                        <code class="d-block mt-1 user-select-all">Get-ADUser -Identity '@sam' -Properties UserPrincipalName,SamAccountName,Mail | Select-Object SamAccountName, UserPrincipalName, Mail</code>
                    </div>
                }
            </div>
        }
    </div>
}

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="hd-panel mb-4">
    <h2 class="h5 mb-2">Group directory · Staff page links</h2>
    <p class="text-secondary small mb-3">
        Each group's Staff page URL — share with registered staff, or use <strong>Preview</strong> to open as an admin
        (requires <code>AdminEmails</code> + Windows auth).
    </p>
    @if (Model.Groups.Count == 0)
    {
        <p class="text-secondary mb-0">Create a group first — URLs appear here.</p>
    }
    else
    {
        <table class="hd-table mb-0">
            <thead>
                <tr>
                    <th>Group</th>
                    <th>Staff</th>
                    <th>Machines</th>
                    <th>Staff page URL</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var g in Model.Groups)
            {
                var staffUrl = $"/Staff/{g.Id}";
                <tr class="@(editing?.Id == g.Id ? "hd-row-active" : "")">
                    <td><strong>@g.Name</strong></td>
                    <td>@g.Staff.Count</td>
                    <td>@g.Machines.Count</td>
                    <td>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <code class="small">@staffUrl</code>
                            <button type="button" class="btn btn-ghost btn-sm"
                                    onclick="navigator.clipboard.writeText(window.location.origin + '@staffUrl'); this.textContent='Copied'; setTimeout(() => this.textContent='Copy', 1500);">
                                Copy
                            </button>
                            <a class="btn btn-ghost btn-sm" href="@staffUrl" target="_blank" rel="noopener">Open</a>
                            @if (Model.IsConfiguredAdmin)
                            {
                                <a class="btn btn-hd btn-sm" asp-page="/RemoteAccessGroups" asp-page-handler="Preview" asp-route-groupId="@g.Id">Preview</a>
                            }
                            else
                            {
                                <span class="btn btn-ghost btn-sm disabled" title="Add your email to Heimdall:StaffAccess:AdminEmails">Preview</span>
                            }
                        </div>
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-ghost btn-sm" asp-page="/RemoteAccessGroups" asp-route-edit="@g.Id">Edit</a>
                        <form method="post" asp-page="/RemoteAccessGroups" asp-page-handler="DeleteGroup" class="d-inline"
                              onsubmit="return confirm('Delete group @g.Name? Staff, machine assignments, favourites and viewer sessions for this group will be removed.');">
                            <input type="hidden" name="GroupId" value="@g.Id" />
                            <button type="submit" class="btn btn-ghost btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

@if (editing is null)
{
    <div class="row g-4 mb-4">
        <div class="col-lg-5">
            <form method="post" asp-page="/RemoteAccessGroups" asp-page-handler="CreateGroup" class="hd-panel h-100">
                <h2 class="h5 mb-3">Create group</h2>
                <div class="mb-3">
                    <label class="form-label" for="createGroupName">Group name</label>
                    <input class="form-control" id="createGroupName" asp-for="GroupName" placeholder="e.g. Sydney Structures Support" required />
                </div>
                <button type="submit" class="btn btn-hd">Create</button>
            </form>
        </div>
    </div>
}

@if (editing is not null)
{
    <div class="hd-panel mb-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
            <h2 class="h5 mb-0">Editing “@editing.Name”</h2>
            <a class="btn btn-ghost btn-sm" asp-page="/RemoteAccessGroups">Close</a>
        </div>
        @{
            var editingStaffUrl = $"/Staff/{editing.Id}";
        }
        <div class="d-flex align-items-center gap-2 flex-wrap mb-3 p-2 rounded" style="background: var(--hd-surface-2, rgba(0,0,0,.04));">
            <span class="text-secondary small">Staff page URL:</span>
            <code class="small">@editingStaffUrl</code>
            <button type="button" class="btn btn-ghost btn-sm"
                    onclick="navigator.clipboard.writeText(window.location.origin + '@editingStaffUrl'); this.textContent='Copied'; setTimeout(() => this.textContent='Copy', 1500);">
                Copy
            </button>
            <a class="btn btn-ghost btn-sm" href="@editingStaffUrl" target="_blank" rel="noopener">Open</a>
            @if (Model.IsConfiguredAdmin)
            {
                <a class="btn btn-hd btn-sm" asp-page="/RemoteAccessGroups" asp-page-handler="Preview" asp-route-groupId="@editing.Id">Preview</a>
            }
        </div>

        <form method="post" asp-page="/RemoteAccessGroups" asp-page-handler="RenameGroup" asp-route-edit="@editing.Id"
              class="row g-2 align-items-end mb-4">
            <input type="hidden" name="GroupId" value="@editing.Id" />
            <div class="col-auto">
                <label class="form-label" for="renameGroupName">Group name</label>
                <input class="form-control" id="renameGroupName" name="GroupName" value="@Model.GroupName" required />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-hd btn-sm">Rename</button>
            </div>
        </form>

        <div class="row g-4">
            <div class="col-lg-6">
                <h3 class="h6 mb-2">Staff emails (@editing.Staff.Count)</h3>
                <p class="text-secondary small mb-2">
                    Anyone signing in at <a asp-page="/StaffAccess">Staff Access</a> with one of these emails sees this group's Staff page.
                    No password — see deliverable notes on the POC identity model.
                </p>
                @if (editing.Staff.Count > 0)
                {
                    <div class="hd-process-list mb-3">
                        <div class="hd-process-items">
                            @foreach (var s in editing.Staff.OrderBy(x => x.Email, StringComparer.OrdinalIgnoreCase))
                            {
                                <div class="hd-process-item">
                                    <span class="hd-process-name flex-grow-1">@s.Email</span>
                                    <form method="post" asp-page="/RemoteAccessGroups" asp-page-handler="RemoveStaff"
                                          asp-route-edit="@editing.Id" class="d-inline">
                                        <input type="hidden" name="GroupId" value="@editing.Id" />
                                        <input type="hidden" name="StaffId" value="@s.Id" />
                                        <button type="submit" class="btn btn-ghost btn-sm">Remove</button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                }
                <form method="post" asp-page="/RemoteAccessGroups" asp-page-handler="AddStaff" asp-route-edit="@editing.Id">
                    <input type="hidden" name="GroupId" value="@editing.Id" />
                    <label class="form-label" for="staffEmailsInput">Add staff emails</label>
                    <textarea class="form-control mb-2" id="staffEmailsInput" name="EmailsInput" rows="2"
                              placeholder="jane.smith@example.com, alex.jones@example.com (comma, semicolon or one per line)"></textarea>
                    <button type="submit" class="btn btn-hd btn-sm">Add email(s)</button>
                </form>
            </div>

            <div class="col-lg-6">
                <h3 class="h6 mb-2">Machines (@editing.Machines.Count)</h3>
                <p class="text-secondary small mb-2">
                    Each machine can have a <strong>friendly display name</strong> for this group.
                    Staff see the friendly name on their page; the hostname stays underneath as a subtitle.
                    Open <strong>Edit</strong> on this group, then set the name in the <strong>Friendly name</strong> field and click <strong>Save</strong>.
                </p>
                @if (editing.Machines.Count > 0)
                {
                    <div class="hd-process-list mb-3">
                        <div class="hd-process-items">
                            @foreach (var m in editing.Machines.OrderBy(x => x.Hostname, StringComparer.OrdinalIgnoreCase))
                            {
                                var display = RemoteAccessGroupService.GetMachineDisplayName(m);
                                <div class="hd-process-item flex-wrap gap-2">
                                    <div class="flex-grow-1" style="min-width: 160px;">
                                        @if (string.IsNullOrWhiteSpace(m.FriendlyName))
                                        {
                                            <span class="hd-process-name d-block">@m.Hostname</span>
                                        }
                                        else
                                        {
                                            <span class="hd-process-name d-block" title="@m.Hostname">@display</span>
                                            <span class="text-secondary small">@m.Hostname</span>
                                        }
                                    </div>
                                    <form method="post" asp-page="/RemoteAccessGroups" asp-page-handler="SetMachineFriendlyName"
                                          asp-route-edit="@editing.Id" class="d-flex flex-column flex-sm-row gap-1 align-items-sm-center flex-grow-1">
                                        <input type="hidden" name="GroupId" value="@editing.Id" />
                                        <input type="hidden" name="GroupMachineId" value="@m.Id" />
                                        <label class="visually-hidden" for="friendly-@m.Id">Friendly name for @m.Hostname</label>
                                        <input type="text" class="form-control form-control-sm" id="friendly-@m.Id" name="MachineFriendlyName"
                                               value="@m.FriendlyName" placeholder="Friendly name (e.g. Revit workstation)" aria-describedby="friendly-help-@m.Id" />
                                        <button type="submit" class="btn btn-ghost btn-sm text-nowrap">Save name</button>
                                    </form>
                                    <span id="friendly-help-@m.Id" class="visually-hidden">Shown on the Staff page instead of hostname.</span>
                                    <form method="post" asp-page="/RemoteAccessGroups" asp-page-handler="RemoveMachine"
                                          asp-route-edit="@editing.Id" class="d-inline">
                                        <input type="hidden" name="GroupId" value="@editing.Id" />
                                        <input type="hidden" name="GroupMachineId" value="@m.Id" />
                                        <button type="submit" class="btn btn-ghost btn-sm">Remove</button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                }
                @{
                    var assigned = editing.Machines.Select(m => m.Hostname).ToHashSet(StringComparer.OrdinalIgnoreCase);
                    var available = Model.AllMachineHostnames.Where(h => !assigned.Contains(h)).ToList();
                }
                <form method="post" asp-page="/RemoteAccessGroups" asp-page-handler="AddMachines" asp-route-edit="@editing.Id">
                    <input type="hidden" name="GroupId" value="@editing.Id" />
                    <label class="form-label">Add machines</label>
                    @if (available.Count == 0)
                    {
                        <p class="text-secondary small">No more machines to add — every known machine is already in this group.</p>
                    }
                    else
                    {
                        <div class="hd-machine-picker" data-hd-machine-picker>
                            <input type="text" class="form-control mb-2 hd-machine-filter" placeholder="Filter by hostname…" data-hd-machine-filter />
                            <div class="hd-process-list">
                                <div class="hd-process-items hd-machine-checklist" data-hd-machine-checklist>
                                    @foreach (var host in available)
                                    {
                                        <label class="hd-process-item">
                                            <input type="checkbox" class="form-check-input" name="SelectedMachines" value="@host" />
                                            <span class="hd-process-name">@host</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-hd btn-sm mt-2">Add selected machines</button>
                    }
                </form>
            </div>
        </div>

        <hr class="my-4" />

        <div class="row g-4">
            <div class="col-lg-6">
                <h3 class="h6 mb-2">Favourite processes (@editing.FavoriteProcesses.Count)</h3>
                <p class="text-secondary small mb-2">
                    Favourites are shared by the whole group (not per-staff — see deliverable notes). The agent guarantees
                    favourited processes are reported even when they rank outside the top 3 for a resource.
                </p>
                @if (editing.FavoriteProcesses.Count > 0)
                {
                    <div class="hd-process-list mb-3">
                        <div class="hd-process-items">
                            @foreach (var f in editing.FavoriteProcesses.OrderBy(x => x.ProcessName, StringComparer.OrdinalIgnoreCase))
                            {
                                <div class="hd-process-item">
                                    <span class="hd-process-name flex-grow-1">★ @f.ProcessName</span>
                                    <form method="post" asp-page="/RemoteAccessGroups" asp-page-handler="RemoveFavorite"
                                          asp-route-edit="@editing.Id" class="d-inline">
                                        <input type="hidden" name="GroupId" value="@editing.Id" />
                                        <input type="hidden" name="FavoriteId" value="@f.Id" />
                                        <button type="submit" class="btn btn-ghost btn-sm">Remove</button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                }
                <form method="post" asp-page="/RemoteAccessGroups" asp-page-handler="AddFavorite" asp-route-edit="@editing.Id">
                    <input type="hidden" name="GroupId" value="@editing.Id" />
                    <label class="form-label">Add favourite process(es)</label>
                    <input class="form-control mb-2" asp-for="FavoriteProcessInput" placeholder="Revit, acad" list="known-process-names" />
                    <datalist id="known-process-names">
                        @foreach (var p in Model.DiscoveredProcessNames)
                        {
                            <option value="@p"></option>
                        }
                    </datalist>
                    <button type="submit" class="btn btn-hd btn-sm">Add</button>
                </form>
            </div>
            <div class="col-lg-6">
                <h3 class="h6 mb-2">Staff page defaults</h3>
                <form method="post" asp-page="/RemoteAccessGroups" asp-page-handler="SetFavoritesOnly" asp-route-edit="@editing.Id">
                    <input type="hidden" name="GroupId" value="@editing.Id" />
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" role="switch" asp-for="FavoritesOnly" id="favoritesOnlySwitch"
                               onchange="this.form.requestSubmit()" />
                        <label class="form-check-label" for="favoritesOnlySwitch">Track only favourites by default</label>
                    </div>
                    <p class="text-secondary small mb-0">
                        When on, the Staff page shows favourite processes instead of the generic top-3 lists.
                        Staff can still toggle this themselves on their page — it's a shared group default, not a lock.
                    </p>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/remote-access-groups.js" asp-append-version="true"></script>
}
