@page
@model TeamsModel
@{
    ViewData["Title"] = "Teams";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <h1 class="hd-title mb-1">Teams</h1>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <a class="hd-btn hd-btn-silver" asp-page="/Teams/ImportCsv">Import CSV</a>
        <a class="hd-btn hd-btn-gold" asp-page="/Teams/EditTeam">Add team</a>
        <a class="btn btn-ghost btn-sm" asp-page="/Help" asp-fragment="teams">Help</a>
    </div>
</div>

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

@if (Model.IsEmpty)
{
    <div class="hd-panel mb-4">
        <p class="mb-3 text-secondary">No teams yet. Import a CSV or add a team to get started.</p>
        <div class="d-flex flex-wrap gap-2">
            <a class="hd-btn hd-btn-silver" asp-page="/Teams/ImportCsv">Import CSV</a>
            <a class="hd-btn hd-btn-gold" asp-page="/Teams/EditTeam">Add team</a>
        </div>
    </div>
}
else
{
    <div class="hd-panel mb-4">
        <table class="hd-table mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Public</th>
                    <th>People</th>
                    <th>Machines</th>
                    <th>Tracking</th>
                    <th>Ignored</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                var indent = r.Depth > 0 ? new string('\u2014', r.Depth) + " " : "";
                <tr>
                    <td>
                        <a asp-page="/Teams/Detail" asp-route-id="@r.Id">@indent<strong>@r.Name</strong></a>
                    </td>
                    <td>@(r.Code ?? "—")</td>
                    <td>@(r.IsPublicFacing ? "Yes" : "—")</td>
                    <td>@r.PeopleCount</td>
                    <td>@r.MachineCount</td>
                    <td>@r.TrackingListCount</td>
                    <td>@r.IgnoredListCount</td>
                    <td class="text-nowrap">
                        <div class="d-flex flex-wrap gap-1 justify-content-end">
                            <a class="btn btn-ghost btn-sm" asp-page="/Teams/Detail" asp-route-id="@r.Id">Open</a>
                            <a class="btn btn-ghost btn-sm" asp-page="/Teams/EditTeam" asp-route-id="@r.Id">Edit</a>
                            <form method="post" asp-page-handler="DeleteTeam" class="d-inline"
                                  onsubmit="return confirm('Delete team “@r.Name”? Machines are unassigned, not deleted.');">
                                <input type="hidden" name="teamId" value="@r.Id" />
                                <button type="submit" class="btn btn-ghost btn-sm">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
