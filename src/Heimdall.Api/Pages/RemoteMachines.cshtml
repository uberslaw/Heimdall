@page
@model RemoteMachinesModel
@{
    ViewData["Title"] = "Online Status";
    var isPartial = OpsPartial.IsPartial(ViewContext.HttpContext.Request);
    if (isPartial)
        Layout = null;
}

@if (!isPartial)
{
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <h1 class="hd-title mb-1">Online Status</h1>
        <a class="btn btn-ghost btn-sm" asp-page="/Help" asp-fragment="remote-machines">Help</a>
    </div>
}
<p class="hd-sub">
    RDP health · RDS service status · ping from API server · restart RDS via agent command queue
</p>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="hd-grid">
    <div class="hd-stat">
        <div class="label">Machines</div>
        <div class="value">@Model.Rows.Count</div>
    </div>
    <div class="hd-stat">
        <div class="label">Online (5m)</div>
        <div class="value">@Model.OnlineCount</div>
    </div>
    <div class="hd-stat">
        <div class="label">Offline</div>
        <div class="value">@Model.OfflineCount</div>
    </div>
    <div class="hd-stat">
        <div class="label">RDP accepting (last probe)</div>
        <div class="value">@Model.RdpAcceptingCount</div>
    </div>
</div>

<p class="text-secondary small mb-3">
    <strong>Diagnostics:</strong> Ping uses ICMP from this API host (may be blocked by firewall). Click <strong>Ping</strong> to probe — results are not automatic.
    RDS service status is reported by the agent on each heartbeat.
    <strong>Restart RDS</strong> queues <code>RestartTermService</code> for the agent. A per-machine countdown estimates agent pickup (~config refresh interval, typically 300s).
    When the agent acknowledges the restart (or TermService reports Running after the expected window), the API automatically runs an RDP test and updates the row.
    RDP probe opens TCP 3389 from the API server and validates the RDP negotiation handshake (no WinRM required).
</p>

<div class="hd-panel hd-remote-panel">
    <table class="hd-table hd-remote-table hd-sortable">
        <colgroup>
            <col class="hd-col-status" />
            <col class="hd-col-machine" />
            <col class="hd-col-ip" />
            <col class="hd-col-contact" />
            <col class="hd-col-ping" />
            <col class="hd-col-rds" />
            <col class="hd-col-rdp" />
            <col class="hd-col-actions" />
        </colgroup>
        <thead>
            <tr>
                <th data-sort="text">Status</th>
                <th data-sort="text">Machine</th>
                <th class="hd-th-stacked" data-sort="text"><span>IP</span><span>Address</span></th>
                <th class="hd-th-contact" data-sort="text">Agent last contact</th>
                <th data-sort="text">Ping</th>
                <th class="hd-th-stacked" data-sort="text"><span>RDS</span><span>Service</span></th>
                <th data-sort="text">RDP status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Rows.Count == 0)
        {
            <tr><td colspan="8">No agents reporting yet.</td></tr>
        }
        @foreach (var r in Model.Rows)
        {
            var restartActive = r.RestartProgress is not null
                && RemoteMachineService.IsActiveRestartPhase(r.RestartProgress.Phase);
            <tr class="@(r.IsOnline ? null : "hd-remote-offline")"
                data-hostname="@r.Hostname"
                @(restartActive ? Html.Raw("data-restart-poll=\"true\"") : null)
                @(RemoteMachinesModel.ShouldShowRdpStatus(r) && r.RdpResponding is bool rdShow
                    ? Html.Raw($"data-rdp-responding=\"{rdShow}\"")
                    : null)>
                <td>
                    @if (r.IsOnline)
                    {
                        <span class="badge-pill badge-active hd-status-badge">
                            <span class="hd-status-full">Online</span>
                            <span class="hd-status-short" aria-hidden="true">On</span>
                        </span>
                    }
                    else
                    {
                        <span class="badge-pill badge-ended hd-status-badge">
                            <span class="hd-status-full">Offline</span>
                            <span class="hd-status-short" aria-hidden="true">Off</span>
                        </span>
                    }
                </td>
                <td class="hd-remote-machine" data-sort-value="@r.DisplayName">
                    <a asp-page="/Machine" asp-route-hostname="@r.Hostname" title="@r.Hostname"><strong>@r.DisplayName</strong></a>
                    @if (!string.IsNullOrWhiteSpace(r.FriendlyName))
                    {
                        <div class="text-secondary small">@r.Hostname</div>
                    }
                    @if (RemoteMachinesModel.ShowRestartProgress(r))
                    {
                        <div class="hd-restart-progress">
                            <span class="badge-pill hd-restart-badge @RemoteMachinesModel.RestartProgressBadgeClass(r)"
                                  title="@r.RestartProgress?.Detail">
                                @RemoteMachinesModel.RestartProgressLabel(r)
                            </span>
                            @if (r.ShowCountdown && r.CountdownUntilUtc is DateTimeOffset countdownUntil)
                            {
                                <div class="hd-restart-countdown" data-until="@countdownUntil.ToString("o")">
                                    <span class="text-secondary small">Pickup in </span>
                                    <span class="hd-countdown-value hd-countdown-digits">--:--</span>
                                    <span class="hd-countdown-expired text-secondary small" hidden>Past expected pickup — still waiting</span>
                                </div>
                            }
                            else if (r.RestartProgress?.LastEventUtc is DateTimeOffset restartUtc)
                            {
                                <span class="text-secondary small hd-restart-when">@RemoteMachinesModel.FormatContact(restartUtc)</span>
                            }
                        </div>
                    }
                </td>
                <td class="hd-remote-ip">@(r.LastIp ?? "—")</td>
                <td class="hd-remote-contact">@RemoteMachinesModel.FormatContact(r.LastSeenUtc)</td>
                <td class="hd-cell-ping">
                    <form method="post" asp-page-handler="Ping" class="hd-ping-form" data-handler="Ping">
                        <input type="hidden" name="hostname" value="@r.Hostname" />
                        <button type="submit" class="btn btn-ghost btn-sm">Ping</button>
                        @if (r.PingReachable is bool pingOk)
                        {
                            <span class="hd-ping-icon @(pingOk ? "hd-ping-ok" : "hd-ping-fail")"
                                  title="@r.PingDetail"
                                  aria-label="@(pingOk ? "Reachable" : "Unreachable")">@(pingOk ? "✓" : "✗")</span>
                        }
                        else
                        {
                            <span class="hd-ping-icon hd-ping-empty" aria-hidden="true"></span>
                        }
                    </form>
                </td>
                <td>
                    @if (!r.IsOnline)
                    {
                        <span class="badge-pill badge-ended">Offline</span>
                    }
                    else if (!string.IsNullOrWhiteSpace(r.TermServiceStatus))
                    {
                        <span class="badge-pill @RemoteMachinesModel.TermServiceBadgeClass(r.TermServiceStatus)">@r.TermServiceStatus</span>
                    }
                    else
                    {
                        <span class="text-secondary">—</span>
                    }
                </td>
                <td class="hd-remote-rdp">
                    @if (!r.IsOnline)
                    {
                        <span class="badge-pill badge-ended">Offline</span>
                    }
                    else if (RemoteMachinesModel.IsRdpTesting(r))
                    {
                        <span class="badge-pill badge-rdp">Testing RDP…</span>
                    }
                    else if (RemoteMachinesModel.ShouldShowRdpStatus(r) && r.RdpResponding is bool rd)
                    {
                        <span class="badge-pill @RemoteMachinesModel.RdpBadgeClass(rd)" title="@r.RdpError">
                            @RemoteMachinesModel.RdpStatusLabel(rd)
                        </span>
                    }
                </td>
                <td class="hd-cell-actions">
                    <a class="hd-btn hd-btn-silver hd-btn-sm hd-btn-compact hd-connect-rdp"
                       asp-page-handler="ConnectRdp"
                       asp-route-hostname="@r.Hostname"
                       title="Open Remote Desktop (mstsc) to @r.Hostname">
                        <svg class="hd-btn-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M8 1a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V1Zm1 13.5a.5.5 0 1 0 1 0 .5.5 0 0 0-1 0Zm2 0a.5.5 0 1 0 1 0 .5.5 0 0 0-1 0ZM9.5 1a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1h-5ZM9 3.5a.5.5 0 0 0 .5.5h5a.5.5 0 0 0 0-1h-5a.5.5 0 0 0-.5.5ZM1.5 2A1.5 1.5 0 0 0 0 3.5v7A1.5 1.5 0 0 0 1.5 12H6v2h-.5a.5.5 0 0 0 0 1H7a.5.5 0 0 0 0-1H6.5v-2h.041a.5.5 0 0 0 .052-.004l.592-.032a.5.5 0 0 0 .46-.5V3.5a.5.5 0 0 0-.5-.5H1.5ZM1 3.5a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-.5.5h-4a.5.5 0 0 1-.5-.5v-7Z"/>
                        </svg>
                        <span>Connect</span>
                    </a>
                    <form method="post" asp-page-handler="ProbeRdp" class="hd-action-form" data-handler="ProbeRdp">
                        <input type="hidden" name="hostname" value="@r.Hostname" />
                        <button type="submit" class="hd-btn hd-btn-gold hd-btn-sm hd-btn-compact">Test RDP</button>
                    </form>
                    <form method="post" asp-page-handler="RestartRds" class="hd-action-form" data-handler="RestartRds"
                          data-confirm="Queue TermService restart on @r.Hostname? Active RDP sessions may disconnect.">
                        <input type="hidden" name="hostname" value="@r.Hostname" />
                        @if (r.IsOnline)
                        {
                            <button type="submit" class="hd-btn hd-btn-silver hd-btn-sm hd-btn-compact">Restart RDS</button>
                        }
                        else
                        {
                            <button type="submit" class="hd-btn hd-btn-silver hd-btn-sm hd-btn-compact" disabled title="Agent must be online to receive command">Restart RDS</button>
                        }
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@* Inline (not @section) so Fleet partial fetch still runs AJAX ping / RDP / countdown. *@
<script src="~/js/remote-machines.js" asp-append-version="true"></script>
<script src="~/js/restart-countdown.js" asp-append-version="true"></script>

