@page
@using Heimdall.Shared.Contracts
@model SessionsModel
@{
    ViewData["Title"] = "Sessions";
    ViewData["HelpFragment"] = "sessions";
    var isPartial = OpsPartial.IsPartial(ViewContext.HttpContext.Request);
    if (isPartial)
        Layout = null;
    var snap = Model.Snapshot;
    var shortLabel = Model.UsesStatsDuration
        ? Model.RangeLabel
        : (Model.RangeDays == 1 ? "1d" : $"{Model.RangeDays}d");
}

@if (!isPartial)
{
    <h1 class="hd-title mb-1">Sessions</h1>
}

<form method="get" asp-page="/Sessions" class="hd-panel mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-4 col-lg-3">
            <label class="form-label" for="util-range">Period</label>
            @if (Model.UsesStatsDuration)
            {
                <select class="form-select" name="statsDuration" id="util-range">
                    @foreach (var opt in MachineModel.StatsDurationOptions)
                    {
                        if (Model.StatsDuration == opt.Key)
                        {
                            <option value="@opt.Key" selected>@opt.Label</option>
                        }
                        else
                        {
                            <option value="@opt.Key">@opt.Label</option>
                        }
                    }
                </select>
            }
            else
            {
                <select class="form-select" name="range" id="util-range">
                    @foreach (var opt in IndexModel.RangeOptions)
                    {
                        if (Model.Range == opt.Key)
                        {
                            <option value="@opt.Key" selected>@opt.Label</option>
                        }
                        else
                        {
                            <option value="@opt.Key">@opt.Label</option>
                        }
                    }
                </select>
            }
        </div>
        <div class="col-md-4 col-lg-5">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="hideSystem" value="true" id="hide-system" @(Model.HideSystem ? "checked" : null) />
                <label class="form-check-label" for="hide-system">Hide system processes (SOE / Windows noise)</label>
            </div>
            <div class="form-check mt-1">
                <input class="form-check-input" type="checkbox" name="onlyDisconnectedApps" value="true" id="only-disc-apps" @(Model.OnlyDisconnectedApps ? "checked" : null) />
                <label class="form-check-label" for="only-disc-apps">Only sessions with app activity while disconnected</label>
            </div>
        </div>
        <div class="col-auto">
            <button type="submit" class="hd-btn hd-btn-gold">Apply</button>
        </div>
    </div>
    @foreach (var h in Model.Hosts)
    {
        <input type="hidden" name="hosts" value="@h" />
    }
</form>

@if (snap is null)
{
    <div class="hd-panel"><p class="mb-0 text-secondary">Loading…</p></div>
}
else
{
    <div class="hd-grid mb-3">
        <div class="hd-stat">
            <div class="label">Sessions (@shortLabel)</div>
            <div class="value">@snap.Totals.SessionCount</div>
        </div>
        <div class="hd-stat">
            <div class="label">Active time</div>
            <div class="value" style="font-size:1.1rem;">@DurationDisplay.Render(snap.Totals.ActiveSeconds)</div>
        </div>
        <div class="hd-stat">
            <div class="label">Disconnected time</div>
            <div class="value" style="font-size:1.1rem;">@DurationDisplay.Render(snap.Totals.DisconnectedSeconds)</div>
        </div>
        <div class="hd-stat">
            <div class="label">Local / RDP</div>
            <div class="value" style="font-size:1.1rem;">@snap.Totals.LocalCount / @snap.Totals.RdpCount</div>
        </div>
        <div class="hd-stat">
            <div class="label">Disc. + apps</div>
            <div class="value">@snap.Totals.DisconnectedWithAppCount</div>
        </div>
    </div>

    <div class="hd-panel mb-3">
        <h2 class="hd-section-title">By machine</h2>
        <p class="text-secondary small">
            Select one or more machines and Apply for the session log. Click a name for machine detail.
            @if (!snap.ShowSessionDetails)
            {
                <span>Or <a href="@Url.Page("/Sessions", new { range = Model.Range, hideSystem = Model.HideSystem, onlyDisconnectedApps = Model.OnlyDisconnectedApps, hosts = snap.MachineSummaries.Select(m => m.Hostname).ToArray() })">view all @snap.MachineSummaries.Count machines</a>.</span>
            }
        </p>

        @if (snap.MachineSummaries.Count == 0)
        {
            <p class="text-secondary mb-0">No sessions in this period.</p>
        }
        else
        {
            <form method="get" id="machine-select-form">
                @if (Model.UsesStatsDuration)
                {
                    <input type="hidden" name="statsDuration" value="@Model.StatsDuration" />
                }
                else
                {
                    <input type="hidden" name="range" value="@Model.Range" />
                }
                @if (Model.HideSystem)
                {
                    <input type="hidden" name="hideSystem" value="true" />
                }
                @if (Model.OnlyDisconnectedApps)
                {
                    <input type="hidden" name="onlyDisconnectedApps" value="true" />
                }
                <table class="hd-table hd-sortable" id="sessions-by-machine">
                    <thead>
                        <tr>
                            <th style="width:2.5rem;">
                                <input type="checkbox" id="select-all-hosts" title="Select all" />
                            </th>
                            <th data-sort="text">Machine</th>
                            <th data-sort="num" data-default-desc>Sessions</th>
                            <th data-sort="num">Active</th>
                            <th data-sort="num">Disconnected</th>
                            <th data-sort="num">Local</th>
                            <th data-sort="num">RDP</th>
                            <th data-sort="num">Open</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var m in snap.MachineSummaries)
                    {
                        var isChecked = Model.Hosts.Contains(m.Hostname, StringComparer.OrdinalIgnoreCase);
                        <tr>
                            <td>
                                <input type="checkbox" class="host-checkbox" name="hosts" value="@m.Hostname" @(isChecked ? "checked" : null) />
                            </td>
                            <td>
                                <a asp-page="/Machine" asp-route-hostname="@m.Hostname" asp-route-range="@Model.Range">@m.Hostname</a>
                            </td>
                            <td>@m.SessionCount</td>
                            <td data-sort-value="@m.ActiveSeconds">@DurationDisplay.Render(m.ActiveSeconds)</td>
                            <td data-sort-value="@m.DisconnectedSeconds">@DurationDisplay.Render(m.DisconnectedSeconds)</td>
                            <td>@m.LocalCount</td>
                            <td>@m.RdpCount</td>
                            <td>
                                @if (m.OpenCount > 0)
                                {
                                    <button type="button" class="hd-open-count-btn js-open-drilldown" data-hostname="@m.Hostname" title="See who has @m.Hostname open right now">@m.OpenCount</button>
                                }
                                else
                                {
                                    @m.OpenCount
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                <div class="mt-3 d-flex gap-2 flex-wrap">
                    <button type="submit" class="hd-btn hd-btn-gold">Show selected sessions</button>
                    <button type="button" class="hd-btn hd-btn-silver" id="clear-hosts">Clear selection</button>
                </div>
            </form>
        }
    </div>

    @if (snap.ShowSessionDetails)
    {
        <div class="hd-panel mb-3" id="sessions-by-user">
            <h2 class="hd-section-title mb-1">By user</h2>
            <p class="text-secondary small mb-2">
                Sessions per username · @Model.RangeLabel
                @if (Model.Hosts.Count == 1)
                {
                    <span> · @Model.Hosts[0]</span>
                }
                else if (Model.Hosts.Count > 1)
                {
                    <span> · @Model.Hosts.Count machines</span>
                }
            </p>
            @if (Model.UserSummaries.Count == 0)
            {
                <p class="text-secondary mb-0">No sessions match the current filters.</p>
            }
            else
            {
                <table class="hd-table hd-sortable" id="sessions-by-user-table">
                    <thead>
                        <tr>
                            <th data-sort="text">User</th>
                            <th data-sort="text">Team</th>
                            <th data-sort="num" data-default-desc>Sessions</th>
                            <th data-sort="num">Local</th>
                            <th data-sort="num">RDP</th>
                            <th data-sort="num">Open</th>
                            <th data-sort="num">Active</th>
                            <th data-sort="num">Disconnected</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var u in Model.UserSummaries)
                    {
                        <tr>
                            <td data-sort-value="@u.DisplayName">
                                @{
                                    var sessUser = UsernameDisplay.Format(u.Username, u.Domain);
                                }
                                @if (!string.IsNullOrWhiteSpace(sessUser))
                                {
                                    <a asp-page="/User" asp-route-username="@sessUser" asp-route-range="@Model.Range">@sessUser</a>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td>@(u.TeamName ?? "—")</td>
                            <td>@u.SessionCount</td>
                            <td>@u.LocalCount</td>
                            <td>@u.RdpCount</td>
                            <td>@u.OpenCount</td>
                            <td data-sort-value="@u.ActiveSeconds">@DurationDisplay.Render(u.ActiveSeconds)</td>
                            <td data-sort-value="@u.DisconnectedSeconds">@DurationDisplay.Render(u.DisconnectedSeconds)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>

        <div class="hd-panel" id="session-log">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                <div>
                    <h2 class="hd-section-title mb-1">Session log</h2>
                    <p class="text-secondary small mb-0">
                        @if (Model.Hosts.Count == 1)
                        {
                            <span>Sessions on <strong>@Model.Hosts[0]</strong> · @Model.RangeLabel</span>
                        }
                        else if (Model.Hosts.Count > 1)
                        {
                            <span>@Model.Hosts.Count machines · @Model.RangeLabel</span>
                        }
                        else
                        {
                            <span>@Model.RangeLabel</span>
                        }
                        · @Model.SessionRows.Count session@(Model.SessionRows.Count == 1 ? "" : "s")
                    </p>
                </div>
                @if (Model.Hosts.Count == 1)
                {
                    <a class="hd-btn hd-btn-silver hd-btn-sm" asp-page="/Machine" asp-route-hostname="@Model.Hosts[0]" asp-route-range="@Model.Range">Machine detail</a>
                }
            </div>
            @if (Model.SessionRows.Count == 0)
            {
                <p class="text-secondary mb-0">No sessions match the current filters.</p>
            }
            else
            {
                <table class="hd-table hd-sortable" id="sessions-detail">
                    <thead>
                        <tr>
                            <th data-sort="text">Machine</th>
                            <th data-sort="text">User</th>
                            <th data-sort="text">Team</th>
                            <th data-sort="text">Type</th>
                            <th data-sort="text">State</th>
                            <th data-sort="date">Started</th>
                            <th data-sort="date">Ended</th>
                            <th data-sort="num">Duration</th>
                            <th data-sort="num">Active</th>
                            <th data-sort="num">Disconnected</th>
                            <th data-sort="text">Disc. apps</th>
                            <th data-sort="text">Client</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var s in Model.SessionRows)
                    {
                        var durationSec = s.ActiveSeconds + s.DisconnectedSeconds;
                        <tr class="@(s.HadAppActivityWhileDisconnected ? "hd-row-highlight" : null)">
                            <td>@s.Hostname</td>
                            <td data-sort-value="@UsernameDisplay.Format(s.Username, s.Domain)">
                                @{
                                    var logUser = UsernameDisplay.Format(s.Username, s.Domain);
                                }
                                @if (!string.IsNullOrWhiteSpace(logUser))
                                {
                                    <a asp-page="/User" asp-route-username="@logUser" asp-route-range="@Model.Range">@logUser</a>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td>@(s.TeamName ?? "—")</td>
                            <td>
                                @if (s.SessionType == SessionType.Rdp)
                                {
                                    <span class="badge-pill badge-rdp">Inbound RDP</span>
                                }
                                else
                                {
                                    <span class="badge-pill badge-local">Local</span>
                                }
                            </td>
                            <td>
                                @switch (s.State)
                                {
                                    case SessionState.Active:
                                        <span class="badge-pill badge-active">Active</span>
                                        break;
                                    case SessionState.Disconnected:
                                        <span class="badge-pill badge-disc">Disconnected</span>
                                        break;
                                    default:
                                        <span class="badge-pill badge-ended">Ended</span>
                                        break;
                                }
                            </td>
                            <td data-sort-value="@s.StartedAtUtc.ToUnixTimeSeconds()">@IndexModel.FormatLocalTimestamp(s.StartedAtUtc)</td>
                            <td data-sort-value="@(s.EndedAtUtc?.ToUnixTimeSeconds() ?? 0)">@(s.EndedAtUtc is DateTimeOffset ended ? IndexModel.FormatLocalTimestamp(ended) : "—")</td>
                            <td data-sort-value="@durationSec">@DurationDisplay.Render(durationSec)</td>
                            <td data-sort-value="@s.ActiveSeconds">@DurationDisplay.Render(s.ActiveSeconds)</td>
                            <td data-sort-value="@s.DisconnectedSeconds">@DurationDisplay.Render(s.DisconnectedSeconds)</td>
                            <td>
                                @if (s.HadAppActivityWhileDisconnected)
                                {
                                    <span class="badge-pill badge-warn" title="@string.Join(", ", s.AppProcesses)">Yes · @s.AppProcesses.Count</span>
                                    <span class="text-secondary small d-block">@string.Join(", ", s.AppProcesses.Take(3))@(s.AppProcesses.Count > 3 ? "…" : "")</span>
                                }
                                else if (s.DisconnectedSeconds > 0)
                                {
                                    <span class="text-secondary">—</span>
                                }
                                else
                                {
                                    <span class="text-secondary">n/a</span>
                                }
                            </td>
                            <td>@(s.ClientName ?? s.ClientAddress ?? "—")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    }
}

<div class="modal fade" id="session-drilldown-modal" tabindex="-1" aria-labelledby="session-drilldown-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="session-drilldown-title">Open sessions</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="session-drilldown-body">
                <p class="text-secondary mb-0">Loading…</p>
            </div>
        </div>
    </div>
</div>

@* Inline (not @section) so Fleet partial fetch still runs these scripts. *@
<script>
(function () {
    var selectAll = document.getElementById('select-all-hosts');
    var boxes = document.querySelectorAll('.host-checkbox');
    if (selectAll && boxes.length) {
        selectAll.addEventListener('change', function () {
            boxes.forEach(function (cb) { cb.checked = selectAll.checked; });
        });
    }
    var clearBtn = document.getElementById('clear-hosts');
    if (clearBtn) {
        clearBtn.addEventListener('click', function () {
            boxes.forEach(function (cb) { cb.checked = false; });
            if (selectAll) selectAll.checked = false;
        });
    }

    if (window.HeimdallTable) HeimdallTable.init(document);

    var log = document.getElementById('session-log');
    if (log) {
        log.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
})();
</script>
<script src="~/js/session-drilldown.js" asp-append-version="true"></script>
