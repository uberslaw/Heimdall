@page
@model TrackSoftwareModel
@{
    ViewData["Title"] = "Track Software";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
    <div>
        <h1 class="hd-title mb-1">Track Software</h1>
        <p class="hd-sub mb-0">Add a title to track on selected regions, offices, or machines</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-ghost" asp-page="/AppLists">App lists</a>
        <a class="btn btn-ghost" asp-page="/Apps">← Application Usage</a>
        <a class="btn btn-ghost" asp-page="/Help" asp-fragment="track-software">Help</a>
    </div>
</div>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<form method="post" id="track-software-form" class="hd-panel">
    <div class="row g-4">
        <div class="col-lg-5">
            <h2 class="h5 mb-3">1. Machine scope</h2>
            <p class="text-secondary small">Check a region or office to include all children. Individual machines can be mixed in.</p>
            @{
                ViewData["TreeId"] = "track-tree";
                ViewData["TreeInputPrefix"] = "Selected";
            }
            <partial name="_MachineTree" model="Model.Tree" />
        </div>
        <div class="col-lg-7">
            <h2 class="h5 mb-3">2. Software source</h2>
            <div class="hd-source-tabs mb-3">
                <label class="hd-source-tab">
                    <input type="radio" name="Source" value="Known" @(Model.Source == "Known" ? "checked" : null) />
                    Known apps
                </label>
                <label class="hd-source-tab">
                    <input type="radio" name="Source" value="Discovered" @(Model.Source == "Discovered" ? "checked" : null) />
                    Discovered
                </label>
                <label class="hd-source-tab">
                    <input type="radio" name="Source" value="Custom" @(Model.Source == "Custom" ? "checked" : null) />
                    Custom
                </label>
            </div>

            <div data-source-panel="Known" class="mb-3">
                <label class="form-label">Known application</label>
                <select class="form-select" name="KnownAppId" asp-for="KnownAppId">
                    <option value="">— select —</option>
                    @foreach (var app in Model.KnownApps)
                    {
                        <option value="@app.Id">@app.DisplayName (@app.ProcessName)</option>
                    }
                </select>
            </div>

            <div data-source-panel="Discovered" class="mb-3" hidden>
                <label class="form-label">Discovered process</label>
                <select class="form-select" name="DiscoveredKey" asp-for="DiscoveredKey">
                    <option value="">— select —</option>
                    @foreach (var d in Model.Discovered)
                    {
                        <option value="@d.Key">@d.ProcessName @(string.IsNullOrEmpty(d.Path) ? "" : $"· {d.Path}")</option>
                    }
                </select>
                @if (Model.Discovered.Count == 0)
                {
                    <p class="text-secondary small mt-2 mb-0">No process runs ingested yet.</p>
                }
            </div>

            <div data-source-panel="Custom" class="mb-3" hidden>
                <p class="text-secondary small">Browse picks an .exe from the machine running this browser (not the remote host).</p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Executable name</label>
                        <div class="input-group">
                            <input class="form-control" name="CustomProcessName" asp-for="CustomProcessName" id="custom-process-name" placeholder="e.g. Speckle" />
                            <button type="button" class="btn btn-ghost" id="browse-custom-exe">Browse…</button>
                            <input type="file" id="browse-custom-file" accept=".exe,.EXE,application/x-msdownload" hidden />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Display name (optional)</label>
                        <input class="form-control" name="CustomDisplayName" asp-for="CustomDisplayName" id="custom-display-name" placeholder="e.g. Speckle Connector" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Full path (optional)</label>
                        <input class="form-control" name="CustomPath" asp-for="CustomPath" id="custom-path" placeholder="C:\Program Files\..." />
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-hd mt-2">Start tracking</button>
        </div>
    </div>
</form>

@section Scripts {
<script src="~/js/machine-tree.js" asp-append-version="true"></script>
<script>
(() => {
  const form = document.getElementById('track-software-form');
  const radios = form.querySelectorAll('input[name="Source"]');
  function syncPanels() {
    const src = form.querySelector('input[name="Source"]:checked')?.value || 'Known';
    form.querySelectorAll('[data-source-panel]').forEach(p => {
      p.hidden = p.getAttribute('data-source-panel') !== src;
    });
  }
  radios.forEach(r => r.addEventListener('change', syncPanels));
  syncPanels();
  HeimdallTree.init(document.getElementById('track-tree'));

  const browseBtn = document.getElementById('browse-custom-exe');
  const browseFile = document.getElementById('browse-custom-file');
  browseBtn?.addEventListener('click', () => browseFile?.click());
  browseFile?.addEventListener('change', () => {
    const file = browseFile.files?.[0];
    if (!file) return;
    let name = file.name.replace(/^.*[\\/]/, '').replace(/\.exe$/i, '').trim();
    browseFile.value = '';
    if (!name) return;
    const proc = document.getElementById('custom-process-name');
    const disp = document.getElementById('custom-display-name');
    const path = document.getElementById('custom-path');
    if (proc) proc.value = name;
    if (disp && !disp.value.trim()) disp.value = name;
    // Browsers do not expose full path for security; keep name-only unless user pastes path.
    if (path && !path.value.trim()) path.placeholder = 'Paste full path if known (browser cannot read it)';
  });
})();
</script>
}
