@page
@model StatsModel
@using Heimdall.Api.Services
@{
    ViewData["Title"] = "Stats";
    ViewData["HelpFragment"] = "stats";
    var isPartial = OpsPartial.IsPartial(ViewContext.HttpContext.Request);
    if (isPartial)
        Layout = null;
    var snap = Model.Snapshot;
    var expandView = (Model.View ?? "").Trim().ToLowerInvariant();
    var statsRange = IndexModel.RangeFromStatsDays(Model.Days);

    var userCards = new (string Id, string Title, string Tip)[]
    {
        ("logon-count", "Logon count", "Users ranked by number of logons in the selected scope and range."),
        ("active-time", "Active logon length", "Users ranked by ActiveSeconds (excludes disconnected time)."),
        ("total-time", "Total logon length", "Users ranked by active + disconnected time."),
        ("by-duration", "By duration", "Users ranked by active time; total includes disconnected."),
        ("avg-session", "Avg per session", "Users ranked by average active time per logon."),
        ("avg-per-day", "Avg use / day", "Total active ÷ distinct calendar days with at least one session (empty days ignored)."),
        ("rdp-disc", "RDP disconnected", "Users ranked by RDP disconnected time."),
    };

    var appCards = new (string Id, string Title, string Tip)[]
    {
        ("apps-time", "Apps by time open", "Applications ranked by total time open."),
        ("apps-cpu", "Apps by CPU", "Applications ranked by peak CPU %."),
        ("apps-gpu", "Apps by GPU", "Applications ranked by peak GPU %."),
        ("apps-disk", "Apps by disk", "Applications ranked by disk read + write volume."),
    };

    static string ShortName(string? name, int max = 18)
    {
        if (string.IsNullOrWhiteSpace(name)) return "—";
        var n = name.Trim();
        return n.Length <= max ? n : n[..(max - 1)] + "…";
    }

    IOrderedEnumerable<UserStatRow> OrderUsers(string id) => id switch
    {
        "logon-count" => snap!.UserStats.OrderByDescending(u => u.LogonCount),
        "total-time" => snap!.UserStats.OrderByDescending(u => u.TotalSeconds),
        "by-duration" => snap!.UserStats.OrderByDescending(u => u.ActiveSeconds),
        "avg-session" => snap!.UserStats.OrderByDescending(u => u.AvgSessionActiveSeconds),
        "avg-per-day" => snap!.UserStats.OrderByDescending(u => u.AvgActivePerDaySeconds),
        "rdp-disc" => snap!.UserStats.OrderByDescending(u => u.RdpDisconnectedSeconds),
        _ => snap!.UserStats.OrderByDescending(u => u.ActiveSeconds),
    };

    IOrderedEnumerable<AppStatRow> OrderApps(string id) => id switch
    {
        "apps-cpu" => snap!.AppStats.OrderByDescending(a => a.PeakCpuPercent ?? -1),
        "apps-gpu" => snap!.AppStats.OrderByDescending(a => a.PeakGpuPercent ?? -1),
        "apps-disk" => snap!.AppStats.OrderByDescending(a => a.DiskReadBytes ?? -1),
        _ => snap!.AppStats.OrderByDescending(a => a.TotalOpenSeconds),
    };
}

@if (!isPartial)
{
    <h1 class="hd-title mb-1">Stats</h1>
}

<form method="get" asp-page="/Stats" class="hd-panel mb-3" id="stats-scope-form">
    <div class="row g-3 align-items-end">
        <div class="col-md-2">
            <label class="form-label">Scope</label>
            <select class="form-select" name="ScopeKind" id="scope-kind" asp-for="ScopeKind">
                <option value="All">All machines</option>
                <option value="Region">Region</option>
                <option value="Country">Country</option>
                <option value="Office">Office</option>
                <option value="Group">Custom group</option>
                <option value="Machine">Single machine</option>
            </select>
        </div>
        <div class="col-md-3" id="scope-value-wrap">
            <label class="form-label">Scope value</label>
            <select class="form-select" name="ScopeValue" id="scope-value" asp-for="ScopeValue">
                <option value="">— select —</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Quick range</label>
            <select class="form-select" name="Days" asp-for="Days" id="stats-days">
                <option value="7">Last 7 days</option>
                <option value="30">Last 30 days</option>
                <option value="90">Last 90 days</option>
                <option value="0">Custom dates</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">From (UTC)</label>
            <input class="form-control" type="date" name="From" value="@(Model.From ?? Model.FromUtc.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2">
            <label class="form-label">To (UTC)</label>
            <input class="form-control" type="date" name="To" value="@(Model.To ?? Model.ToUtc.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-auto">
            <button type="submit" class="hd-btn hd-btn-gold">Apply</button>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(Model.PatternApp))
    {
        <input type="hidden" name="PatternApp" value="@Model.PatternApp" />
    }
    @if (Model.MinRuntimeMin is not null)
    {
        <input type="hidden" name="MinRuntimeMin" value="@Model.MinRuntimeMin" />
    }
    @if (Model.MaxRuntimeMin is not null)
    {
        <input type="hidden" name="MaxRuntimeMin" value="@Model.MaxRuntimeMin" />
    }
</form>

@if (snap is null)
{
    <div class="hd-panel">
        <p class="text-secondary mb-0">Select a scope value (or choose All machines) and Apply.</p>
    </div>
}
else
{
    <div class="hd-grid mb-3">
        <div class="hd-stat">
            <div class="label">Machines in scope</div>
            <div class="value">@snap.MachineCount</div>
        </div>
        <div class="hd-stat">
            <div class="label">Users</div>
            <div class="value">@snap.UserStats.Count</div>
        </div>
        <div class="hd-stat">
            <div class="label">Apps seen</div>
            <div class="value">@snap.AppStats.Count</div>
        </div>
        <div class="hd-stat">
            <div class="label">Range</div>
            <div class="value" style="font-size:1rem;margin-top:0.45rem">@snap.FromUtc.ToString("dd MMM") – @snap.ToUtc.ToString("dd MMM")</div>
        </div>
    </div>

    @if (!snap.GpuDiskSamplesPresent)
    {
        <div class="alert hd-alert-info mb-3">
            GPU / disk samples are not yet reported by agents. Ranking columns show “—” until collection ships; CPU and time-open stats still work.
        </div>
    }

    <div class="hd-stats-cards" data-stats-cards data-expand-view="@expandView">
        <div class="hd-stats-card-group-label">Users</div>
        @foreach (var card in userCards)
        {
            var rows = OrderUsers(card.Id).ToList();
            var open = string.Equals(expandView, card.Id, StringComparison.OrdinalIgnoreCase);
            <article class="hd-stats-card @(open ? "is-expanded" : null)" data-stats-card="@card.Id">
                <button type="button" class="hd-stats-card-head" data-stats-expand aria-expanded="@(open ? "true" : "false")" title="@card.Tip">
                    <span class="hd-stats-card-title">@card.Title</span>
                    <span class="hd-stats-card-toggle">@(open ? "Show less" : "Show more")</span>
                </button>
                <div class="hd-stats-card-scroll">
                    <table class="hd-table hd-sortable hd-stats-card-table" data-hd-sort-key="stats-@card.Id">
                        <thead>
                            <tr>
                                <th data-sort="text">User</th>
                                @switch (card.Id)
                                {
                                    case "logon-count":
                                        <th data-sort="num" data-default-desc>Logons</th>
                                        <th data-sort="num">Active</th>
                                        <th data-sort="num">Disc.</th>
                                        break;
                                    case "active-time":
                                        <th data-sort="num" data-default-desc>Active</th>
                                        <th data-sort="num">Logons</th>
                                        <th data-sort="num">Disc.</th>
                                        break;
                                    case "total-time":
                                        <th data-sort="num" data-default-desc>Total</th>
                                        <th data-sort="num">Active</th>
                                        <th data-sort="num">Disc.</th>
                                        break;
                                    case "by-duration":
                                        <th data-sort="num" data-default-desc>Active</th>
                                        <th data-sort="num">Total</th>
                                        <th data-sort="num">Logons</th>
                                        break;
                                    case "avg-session":
                                        <th data-sort="num" data-default-desc>Avg/sess</th>
                                        <th data-sort="num">Logons</th>
                                        <th data-sort="num">Active</th>
                                        break;
                                    case "avg-per-day":
                                        <th data-sort="num" data-default-desc>Avg/day</th>
                                        <th data-sort="num">Days</th>
                                        <th data-sort="num">Active</th>
                                        break;
                                    default:
                                        <th data-sort="num" data-default-desc>RDP disc.</th>
                                        <th data-sort="num">All disc.</th>
                                        <th data-sort="num">Logons</th>
                                        break;
                                }
                            </tr>
                        </thead>
                        <tbody>
                        @if (rows.Count == 0)
                        {
                            <tr><td colspan="4" class="text-secondary">No sessions.</td></tr>
                        }
                        @foreach (var u in rows)
                        {
                            var statsUser = UsernameDisplay.Format(u.Username);
                            var shortUser = ShortName(statsUser);
                            <tr>
                                <td class="hd-stats-card-name" title="@statsUser">
                                    @if (!string.IsNullOrWhiteSpace(statsUser))
                                    {
                                        <a asp-page="/User" asp-route-username="@statsUser" asp-route-range="@statsRange" title="@statsUser">@shortUser</a>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                @switch (card.Id)
                                {
                                    case "logon-count":
                                        <td data-sort-value="@u.LogonCount">@u.LogonCount</td>
                                        <td data-sort-value="@u.ActiveSeconds">@DurationDisplay.Render(u.ActiveSeconds)</td>
                                        <td data-sort-value="@u.DisconnectedSeconds">@DurationDisplay.Render(u.DisconnectedSeconds)</td>
                                        break;
                                    case "active-time":
                                        <td data-sort-value="@u.ActiveSeconds">@DurationDisplay.Render(u.ActiveSeconds)</td>
                                        <td data-sort-value="@u.LogonCount">@u.LogonCount</td>
                                        <td data-sort-value="@u.DisconnectedSeconds">@DurationDisplay.Render(u.DisconnectedSeconds)</td>
                                        break;
                                    case "total-time":
                                        <td data-sort-value="@u.TotalSeconds">@DurationDisplay.Render(u.TotalSeconds)</td>
                                        <td data-sort-value="@u.ActiveSeconds">@DurationDisplay.Render(u.ActiveSeconds)</td>
                                        <td data-sort-value="@u.DisconnectedSeconds">@DurationDisplay.Render(u.DisconnectedSeconds)</td>
                                        break;
                                    case "by-duration":
                                        <td data-sort-value="@u.ActiveSeconds">@DurationDisplay.Render(u.ActiveSeconds)</td>
                                        <td data-sort-value="@u.TotalSeconds">@DurationDisplay.Render(u.TotalSeconds)</td>
                                        <td data-sort-value="@u.LogonCount">@u.LogonCount</td>
                                        break;
                                    case "avg-session":
                                        <td data-sort-value="@u.AvgSessionActiveSeconds">@DurationDisplay.Render(u.AvgSessionActiveSeconds)</td>
                                        <td data-sort-value="@u.LogonCount">@u.LogonCount</td>
                                        <td data-sort-value="@u.ActiveSeconds">@DurationDisplay.Render(u.ActiveSeconds)</td>
                                        break;
                                    case "avg-per-day":
                                        <td data-sort-value="@u.AvgActivePerDaySeconds">@DurationDisplay.Render(u.AvgActivePerDaySeconds)</td>
                                        <td data-sort-value="@u.DistinctDays">@u.DistinctDays</td>
                                        <td data-sort-value="@u.ActiveSeconds">@DurationDisplay.Render(u.ActiveSeconds)</td>
                                        break;
                                    default:
                                        <td data-sort-value="@u.RdpDisconnectedSeconds">@DurationDisplay.Render(u.RdpDisconnectedSeconds)</td>
                                        <td data-sort-value="@u.DisconnectedSeconds">@DurationDisplay.Render(u.DisconnectedSeconds)</td>
                                        <td data-sort-value="@u.LogonCount">@u.LogonCount</td>
                                        break;
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </article>
        }

        <div class="hd-stats-card-group-label">Apps</div>
        @foreach (var card in appCards)
        {
            var rows = OrderApps(card.Id).ToList();
            var open = string.Equals(expandView, card.Id, StringComparison.OrdinalIgnoreCase);
            <article class="hd-stats-card @(open ? "is-expanded" : null)" data-stats-card="@card.Id">
                <button type="button" class="hd-stats-card-head" data-stats-expand aria-expanded="@(open ? "true" : "false")" title="@card.Tip">
                    <span class="hd-stats-card-title">@card.Title</span>
                    <span class="hd-stats-card-toggle">@(open ? "Show less" : "Show more")</span>
                </button>
                <div class="hd-stats-card-scroll">
                    <table class="hd-table hd-sortable hd-stats-card-table" data-hd-sort-key="stats-@card.Id">
                        <thead>
                            <tr>
                                <th data-sort="text">App</th>
                                @switch (card.Id)
                                {
                                    case "apps-cpu":
                                        <th data-sort="num" data-default-desc>Peak CPU</th>
                                        <th data-sort="num">Time</th>
                                        <th data-sort="num">Users</th>
                                        break;
                                    case "apps-gpu":
                                        <th data-sort="num" data-default-desc>Peak GPU</th>
                                        <th data-sort="num">Time</th>
                                        <th data-sort="num">Users</th>
                                        break;
                                    case "apps-disk":
                                        <th data-sort="num" data-default-desc>Disk R</th>
                                        <th data-sort="num">Disk W</th>
                                        <th data-sort="num">Time</th>
                                        break;
                                    default:
                                        <th data-sort="num" data-default-desc>Time</th>
                                        <th data-sort="num">Users</th>
                                        <th data-sort="num">Runs</th>
                                        break;
                                }
                            </tr>
                        </thead>
                        <tbody>
                        @if (rows.Count == 0)
                        {
                            <tr><td colspan="4" class="text-secondary">No process runs.</td></tr>
                        }
                        @foreach (var a in rows)
                        {
                            var shortApp = ShortName(a.ProcessName, 16);
                            <tr>
                                <td class="hd-stats-card-name" title="@a.ProcessName">
                                    <a asp-page="/Application" asp-route-process="@a.ProcessName" asp-route-range="@statsRange" title="@a.ProcessName">@shortApp</a>
                                </td>
                                @switch (card.Id)
                                {
                                    case "apps-cpu":
                                        <td data-sort-value="@(a.PeakCpuPercent ?? -1)">@StatsModel.FormatPct(a.PeakCpuPercent)</td>
                                        <td data-sort-value="@a.TotalOpenSeconds">@DurationDisplay.Render(a.TotalOpenSeconds)</td>
                                        <td data-sort-value="@a.UniqueUsers">@a.UniqueUsers</td>
                                        break;
                                    case "apps-gpu":
                                        <td data-sort-value="@(a.PeakGpuPercent ?? -1)">@StatsModel.FormatPct(a.PeakGpuPercent)</td>
                                        <td data-sort-value="@a.TotalOpenSeconds">@DurationDisplay.Render(a.TotalOpenSeconds)</td>
                                        <td data-sort-value="@a.UniqueUsers">@a.UniqueUsers</td>
                                        break;
                                    case "apps-disk":
                                        <td data-sort-value="@(a.DiskReadBytes ?? -1)">@StatsModel.FormatBytes(a.DiskReadBytes)</td>
                                        <td data-sort-value="@(a.DiskWriteBytes ?? -1)">@StatsModel.FormatBytes(a.DiskWriteBytes)</td>
                                        <td data-sort-value="@a.TotalOpenSeconds">@DurationDisplay.Render(a.TotalOpenSeconds)</td>
                                        break;
                                    default:
                                        <td data-sort-value="@a.TotalOpenSeconds">@DurationDisplay.Render(a.TotalOpenSeconds)</td>
                                        <td data-sort-value="@a.UniqueUsers">@a.UniqueUsers</td>
                                        <td data-sort-value="@a.RunCount">@a.RunCount</td>
                                        break;
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </article>
        }

        <div class="hd-stats-card-group-label">Patterns</div>
        @{
            var patternOpen = string.Equals(expandView, "patterns", StringComparison.OrdinalIgnoreCase);
            var patternRows = snap.UsagePatterns.OrderByDescending(p => p.ActiveMinutes).ToList();
        }
        <article class="hd-stats-card hd-stats-card-wide @(patternOpen ? "is-expanded" : null)" data-stats-card="patterns">
            <button type="button" class="hd-stats-card-head" data-stats-expand aria-expanded="@(patternOpen ? "true" : "false")"
                    title="User × day-of-week by active minutes. Use filters below to limit by app or runtime.">
                <span class="hd-stats-card-title">Usage patterns</span>
                <span class="hd-stats-card-toggle">@(patternOpen ? "Show less" : "Show more")</span>
            </button>
            <form method="get" class="hd-stats-card-filters" asp-page="/Stats">
                <input type="hidden" name="ScopeKind" value="@Model.ScopeKind" />
                <input type="hidden" name="ScopeValue" value="@Model.ScopeValue" />
                <input type="hidden" name="Days" value="@Model.Days" />
                <input type="hidden" name="From" value="@Model.From" />
                <input type="hidden" name="To" value="@Model.To" />
                <input type="hidden" name="View" value="patterns" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small mb-0">App filter</label>
                        <select class="form-select form-select-sm" name="PatternApp">
                            <option value="">All (session active time)</option>
                            @foreach (var app in snap.AppFilterOptions)
                            {
                                if (string.Equals(app, Model.PatternApp, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@app" selected>@app</option>
                                }
                                else
                                {
                                    <option value="@app">@app</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Min (min)</label>
                        <input class="form-control form-control-sm" type="number" step="0.1" min="0" name="MinRuntimeMin" value="@Model.MinRuntimeMin" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Max (min)</label>
                        <input class="form-control form-control-sm" type="number" step="0.1" min="0" name="MaxRuntimeMin" value="@Model.MaxRuntimeMin" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="hd-btn hd-btn-silver hd-btn-sm">Filter</button>
                    </div>
                </div>
            </form>
            <div class="hd-stats-card-scroll">
                <table class="hd-table hd-sortable hd-stats-card-table" data-hd-sort-key="stats-patterns">
                    <thead>
                        <tr>
                            <th data-sort="text">User</th>
                            <th data-sort="text">Day</th>
                            <th data-sort="num" data-default-desc>Active min</th>
                            <th data-sort="num">Sess.</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (patternRows.Count == 0)
                    {
                        <tr><td colspan="4" class="text-secondary">No pattern rows.</td></tr>
                    }
                    @foreach (var p in patternRows)
                    {
                        var patternUser = UsernameDisplay.Format(p.Username);
                        <tr>
                            <td class="hd-stats-card-name" title="@patternUser">@ShortName(patternUser)</td>
                            <td>@(p.DayOfWeek switch
                            {
                                DayOfWeek.Monday => "Mon",
                                DayOfWeek.Tuesday => "Tue",
                                DayOfWeek.Wednesday => "Wed",
                                DayOfWeek.Thursday => "Thu",
                                DayOfWeek.Friday => "Fri",
                                DayOfWeek.Saturday => "Sat",
                                _ => "Sun"
                            })</td>
                            <td data-sort-value="@p.ActiveMinutes">@p.ActiveMinutes.ToString("0.#")</td>
                            <td data-sort-value="@p.SessionCount">@p.SessionCount</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </article>
    </div>
}

@* Inline (not @section) so Fleet partial fetch still runs these scripts. *@
<script>
(() => {
  const options = {
    Region: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ScopeOptions.Regions)),
    Country: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ScopeOptions.Countries)),
    Office: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ScopeOptions.Offices)),
    Group: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ScopeOptions.Groups)),
    Machine: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ScopeOptions.Machines))
  };
  const kindEl = document.getElementById('scope-kind');
  const valueEl = document.getElementById('scope-value');
  const wrap = document.getElementById('scope-value-wrap');
  const current = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ScopeValue ?? ""));

  function refill() {
    if (!kindEl || !valueEl || !wrap) return;
    const kind = kindEl.value;
    const list = options[kind] || [];
    wrap.style.display = kind === 'All' ? 'none' : '';
    valueEl.innerHTML = '<option value="">— select —</option>';
    list.forEach(v => {
      const opt = document.createElement('option');
      opt.value = v;
      opt.textContent = v;
      if (v === current) opt.selected = true;
      valueEl.appendChild(opt);
    });
  }
  if (kindEl) {
    kindEl.addEventListener('change', refill);
    refill();
  }

  const root = document.querySelector('[data-stats-cards]');
  if (root) {
    root.querySelectorAll('[data-stats-expand]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = btn.closest('[data-stats-card]');
        if (!card) return;
        const willOpen = !card.classList.contains('is-expanded');
        root.querySelectorAll('[data-stats-card].is-expanded').forEach((el) => {
          if (el === card) return;
          el.classList.remove('is-expanded');
          const b = el.querySelector('[data-stats-expand]');
          const t = el.querySelector('.hd-stats-card-toggle');
          if (b) b.setAttribute('aria-expanded', 'false');
          if (t) t.textContent = 'Show more';
        });
        card.classList.toggle('is-expanded', willOpen);
        btn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
        const toggle = card.querySelector('.hd-stats-card-toggle');
        if (toggle) toggle.textContent = willOpen ? 'Show less' : 'Show more';
      });
    });

    const expandId = root.getAttribute('data-expand-view');
    if (expandId) {
      const target = root.querySelector('[data-stats-card="' + expandId + '"]');
      if (target) {
        if (!target.classList.contains('is-expanded'))
          target.querySelector('[data-stats-expand]')?.click();
        target.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    }
  }
})();
</script>
