@page
@model Heimdall.Api.Pages.Teams.EditTeamModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit team" : "Add team";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <h1 class="hd-title mb-1">@(Model.IsEdit ? "Edit team" : "Add team")</h1>
    <a class="btn btn-ghost btn-sm" asp-page="/Teams">Back to teams</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <div asp-validation-summary="All"></div>
    </div>
}

<form method="post" class="hd-panel mb-4" style="max-width: 36rem;">
    <input type="hidden" asp-for="EditingTeamId" />
    <div class="mb-3">
        <label class="form-label" asp-for="TeamName">Name</label>
        <input class="form-control" asp-for="TeamName" placeholder="e.g. Digital" required />
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="TeamCode">Code (optional)</label>
        <input class="form-control" asp-for="TeamCode" placeholder="e.g. DIG" />
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="TeamParentId">Parent team</label>
        <select class="form-select" asp-for="TeamParentId">
            <option value="">— none —</option>
            @foreach (var t in Model.TeamOptions.Where(o => o.Id != Model.EditingTeamId))
            {
                <option value="@t.Id">@t.Label</option>
            }
        </select>
    </div>
    <div class="mb-3 form-check">
        <input class="form-check-input" type="checkbox" asp-for="TeamIsPublicFacing" id="teamPublicFacing" />
        <label class="form-check-label" for="teamPublicFacing">
            Public-facing (machines on this team appear in Staff RDP pool)
        </label>
    </div>

    <hr class="my-4" />
    <h2 class="h6 mb-2">Entra ID membership</h2>
    @if (!Model.EntraConfigured)
    {
        <p class="small text-secondary mb-3">@Model.EntraSetupHint</p>
    }
    else
    {
        <p class="small text-secondary mb-3">
            Paste the group <strong>Object ID</strong> from Entra admin center (or Azure portal → Groups).
            Sync on the team detail page replaces People with transitive group members.
        </p>
    }
    <div class="mb-3">
        <label class="form-label" asp-for="EntraGroupId">Entra group Object ID</label>
        <input class="form-control font-monospace" asp-for="EntraGroupId" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" autocomplete="off" />
        @if (!string.IsNullOrWhiteSpace(Model.EntraGroupName))
        {
            <div class="form-text">Linked group: <strong>@Model.EntraGroupName</strong></div>
        }
        @if (Model.EntraMembersSyncedUtc is DateTimeOffset synced)
        {
            <div class="form-text">Last sync: @synced.ToString("u") UTC</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.EntraLastSyncError))
        {
            <div class="form-text text-danger">Last sync error: @Model.EntraLastSyncError</div>
        }
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <button type="submit" class="hd-btn hd-btn-gold">@(Model.IsEdit ? "Save" : "Create")</button>
        @if (Model.IsEdit)
        {
            <a class="hd-btn hd-btn-silver" asp-page="/Teams/Detail" asp-route-id="@Model.EditingTeamId">Cancel</a>
        }
        else
        {
            <a class="hd-btn hd-btn-silver" asp-page="/Teams">Cancel</a>
        }
    </div>
</form>
