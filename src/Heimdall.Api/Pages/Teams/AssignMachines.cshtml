@page
@model Heimdall.Api.Pages.Teams.AssignMachinesModel
@{
    ViewData["Title"] = $"Assign machines · {Model.TeamName}";
    var selected = Model.SelectedMachineIds.ToHashSet();
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <h1 class="hd-title mb-1">Assign machines</h1>
    <a class="btn btn-ghost btn-sm" asp-page="/Teams/Detail" asp-route-id="@Model.TeamId" asp-route-tab="membership">Back to @Model.TeamName</a>
</div>

@if (Model.FormError is string err)
{
    <div class="alert alert-danger">@err</div>
}

<p class="text-secondary small mb-3">
    Select machines for <strong>@Model.TeamName</strong>. Unchecking removes them from this team only — machines are never deleted.
</p>

<form method="post" class="hd-panel mb-4">
    <input type="hidden" asp-for="TeamId" />
    @if (Model.Machines.Count == 0)
    {
        <p class="text-secondary mb-3">No machines in the fleet yet.</p>
    }
    else
    {
        <div class="mb-3" style="max-height: 28rem; overflow-y: auto;">
            <table class="hd-table hd-sortable mb-0">
                <thead>
                    <tr>
                        <th style="width: 2.5rem;"></th>
                        <th data-sort="text">Hostname</th>
                        <th data-sort="text">Friendly name</th>
                        <th data-sort="text">Current team</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var m in Model.Machines)
                {
                    var checkedAttr = selected.Contains(m.Id);
                    <tr>
                        <td>
                            <input class="form-check-input" type="checkbox" name="SelectedMachineIds" value="@m.Id"
                                   @(checkedAttr ? "checked" : null) />
                        </td>
                        <td><code>@m.Hostname</code></td>
                        <td>@(m.FriendlyName ?? "—")</td>
                        <td>
                            @if (m.TeamId == Model.TeamId)
                            {
                                <span>@Model.TeamName</span>
                            }
                            else if (m.TeamId is not null)
                            {
                                <span class="text-secondary">Other team</span>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    <div class="d-flex gap-2 flex-wrap">
        <button type="submit" class="hd-btn hd-btn-gold">Save assignments</button>
        <a class="hd-btn hd-btn-silver" asp-page="/Teams/Detail" asp-route-id="@Model.TeamId" asp-route-tab="membership">Cancel</a>
    </div>
</form>
