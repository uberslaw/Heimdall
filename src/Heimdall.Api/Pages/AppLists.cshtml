@page
@model AppListsModel
@using Heimdall.Api.Data
@using Heimdall.Api.Services
@using Heimdall.Shared.Contracts
@{
    ViewData["Title"] = "Application Lists and Tracking";
    ViewData["HelpFragment"] = "app-lists";
    var isPartial = OpsPartial.IsPartial(ViewContext.HttpContext.Request);
    if (isPartial)
        Layout = null;
    var active = Model.ActiveTabKey;
    var renderBody = isPartial
        || string.Equals(ViewContext.HttpContext.Request.Method, "POST", StringComparison.OrdinalIgnoreCase)
        || Model.EditId is int;
}

@if (!isPartial)
{
<div class="hd-fleet-header mb-3">
    <div class="hd-fleet-header-main">
        <h1 class="hd-title hd-fleet-title mb-0">
            <span class="hd-fleet-title-fleet">Application Lists and Tracking</span>
        </h1>
        <ul class="nav nav-tabs hd-ops-tabs mb-0" id="hd-ops-tabs" role="tablist">
            @foreach (var t in AppListsModel.Tabs)
            {
                var isActive = t.Key == active;
                var src = t.Key == "analyze" && !string.IsNullOrWhiteSpace(Model.FocusHostname)
                    ? $"/AppLists?tab={t.Key}&host={Uri.EscapeDataString(Model.FocusHostname)}&partial=1"
                    : $"/AppLists?tab={t.Key}&partial=1";
                <li class="nav-item" role="presentation">
                    <a class="nav-link @(isActive ? "active" : null)"
                       href="/AppLists?tab=@t.Key"
                       data-hd-ops-tab="@t.Key"
                       data-hd-ops-src="@src"
                       role="tab"
                       aria-selected="@(isActive ? "true" : "false")">@t.Label</a>
                </li>
            }
        </ul>
        <p class="hd-sub mb-0 mt-2">Curated software lists and per-PC analyze. Classification is Discovery; usage totals are Application Usage.</p>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <a class="hd-btn hd-btn-silver hd-btn-sm" asp-page="/AppListChangelog">Changelog</a>
    </div>
</div>

<partial name="_Toasts" />

@if (!renderBody)
{
<div class="hd-ops-pane" id="hd-ops-pane" data-hd-ops-active="@active" data-hd-ops-base="/AppLists" aria-live="polite">
    <div class="hd-ops-loading text-secondary py-4" data-hd-ops-loading>Loading…</div>
    <div class="hd-ops-body" data-hd-ops-body hidden></div>
</div>
}
}
@if (renderBody)
{
if (active == "create")
{
    <partial name="_AppListsCreate" model="Model" />
}
else if (active == "lists")
{
<details class="hd-panel mb-4 hd-collapsible" data-key="existing-lists" open>
            <summary class="h5 mb-3">Existing lists <span class="text-secondary small">(@Model.Lists.Count)</span></summary>
            @if (Model.Lists.Count == 0)
            {
                <p class="text-secondary mb-0">No app lists yet.</p>
            }
            else
            {
                @* Export form wraps only the footer — row checkboxes use form="…" so Delete forms are not nested (invalid HTML). *@
                <div class="hd-existing-lists-wrap">
                    <table class="hd-table hd-existing-lists-table hd-sortable mb-2">
                        <thead>
                            <tr>
                                <th class="hd-existing-lists-col-check"><input class="form-check-input" type="checkbox" id="lists-select-all" title="Select all" form="lists-export-form" /></th>
                                <th class="hd-existing-lists-col-name" data-sort="text">Name</th>
                                <th class="hd-existing-lists-col-team" data-sort="text">Team</th>
                                <th class="hd-existing-lists-col-apps" data-sort="num">Apps</th>
                                <th class="hd-existing-lists-col-scopes" data-sort="num">Scopes</th>
                                <th class="hd-existing-lists-col-actions"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var l in Model.Lists)
                        {
                            <tr>
                                <td class="hd-existing-lists-col-check"><input class="form-check-input lists-row-check" type="checkbox" name="SelectedListIds" value="@l.Id" form="lists-export-form" /></td>
                                <td class="hd-existing-lists-col-name" title="@l.Name">
                                    <span class="hd-existing-lists-name-inner">
                                        <strong class="hd-existing-lists-truncate">@l.Name</strong>
                                        @if (l.IsSystem)
                                        {
                                            <span class="badge-pill badge-active" title="Synced from classifications; cannot delete">System</span>
                                        }
                                        else if (l.IsAutoDiscovered)
                                        {
                                            <span class="badge-pill badge-ended">auto</span>
                                        }
                                    </span>
                                </td>
                                <td class="hd-existing-lists-col-team hd-existing-lists-truncate" title="@(l.TeamName ?? "—")">@(l.TeamName ?? "—")</td>
                                <td class="hd-existing-lists-col-apps">@l.EntryCount</td>
                                <td class="hd-existing-lists-col-scopes">@l.AssignmentCount</td>
                                <td class="hd-existing-lists-col-actions">
                                    <a class="hd-btn hd-btn-silver hd-btn-icon-round"
                                       asp-page-handler="Edit"
                                       asp-route-id="@l.Id"
                                       title="Edit @l.Name"
                                       aria-label="Edit @l.Name">
                                        <svg class="hd-btn-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                                        </svg>
                                        <span class="hd-btn-label">Edit</span>
                                    </a>
                                    @if (!l.IsSystem)
                                    {
                                        <form method="post" asp-page-handler="DeleteList" class="d-inline">
                                            <input type="hidden" name="id" value="@l.Id" />
                                            <button type="submit"
                                                    class="hd-btn hd-btn-rose hd-btn-icon-round"
                                                    title="Delete @l.Name"
                                                    aria-label="Delete @l.Name"
                                                    onclick="return confirm('Delete app list “@l.Name” (@l.EntryCount apps)? This cannot be undone.');">
                                                <svg class="hd-btn-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                                    <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                                                </svg>
                                                <span class="hd-btn-label">Delete</span>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <form method="post" asp-page-handler="ExportSelectedLists" id="lists-export-form">
                    <div class="d-flex flex-wrap gap-2 align-items-center hd-existing-lists-export">
                        <select class="form-select form-select-sm hd-existing-lists-export-format" name="format">
                            <option value="csv">App list CSV</option>
                            <option value="json">App list JSON</option>
                            <option value="classification-csv">Classification CSV</option>
                        </select>
                        <button type="submit" class="hd-btn hd-btn-silver">Export Selected</button>
                    </div>
                </form>
            }
        </details>

<details class="hd-panel mb-4 hd-collapsible" data-key="apply-scope" open>
            <summary class="h5 mb-3">Track Software</summary>
            <form method="post" asp-page-handler="Apply" id="apply-form">
                <div class="mb-3">
                    <label class="form-label">App list</label>
                    <select class="form-select" asp-for="ApplyAppListId" required>
                        <option value="">— select —</option>
                        @foreach (var l in Model.Lists)
                        {
                            <option value="@l.Id">@l.Name (@l.EntryCount apps)</option>
                        }
                    </select>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" asp-for="ApplyGlobal" id="apply-global" />
                    <label class="form-check-label" for="apply-global">Global (all machines)</label>
                </div>
                <p class="text-secondary small">Or tick regions, offices, and/or individual machines below.</p>
                @{
                    ViewData["TreeId"] = "app-list-tree";
                    ViewData["TreeInputPrefix"] = "Selected";
                }
                <partial name="_MachineTree" model="Model.Tree" />
                <button type="submit" class="hd-btn hd-btn-silver mt-3">Apply List</button>
            </form>
        </details>

}
else if (active == "analyze")
{

<details class="hd-panel mb-4 hd-collapsible" data-key="machine-focus" id="machine-focus" open="@(Model.Lookup is not null)">
            <summary class="h5 mb-3">Machine lookup &amp; analysis</summary>
            <form method="post" class="row g-2 align-items-end mb-3" id="machine-lookup-form">
                <div class="col-md-8">
                    <label class="form-label">Machine</label>
                    <select class="form-select font-monospace hd-machine-lookup-select" asp-for="LookupHostname" required
                            onchange="if(this.value){ window.location.href = '@Url.Page("/AppLists")?tab=analyze&host=' + encodeURIComponent(this.value); }">
                        <option value="">— hostname · friendly name · IP —</option>
                        @foreach (var m in Model.AllMachines)
                        {
                            <option value="@m.Hostname">@AppListsModel.FormatMachineLookupOption(m, Model.MachineOptionHostWidth, Model.MachineOptionFriendlyWidth, Model.MachineOptionIpWidth)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex flex-column gap-2">
                    <button type="submit" formaction="?handler=Analyze" class="hd-btn hd-btn-gold" title="Classify apps and propose specialization tracking">Analyze Apps</button>
                    <button type="submit" formaction="?handler=RequestInventory" class="hd-btn hd-btn-silver" title="Agent uploads full process inventory (~5 min config + ~1 min upload)">Request Inventory</button>
                </div>
            </form>

            @if (Model.Lookup is not null && Model.FocusHostname is not null)
            {
                var status = Model.FocusStatus ?? AppAnalysisStatus.None;
                <div class="mb-3 mt-3">
                    <strong>@Model.FocusHostname</strong>
                    @if (status == AppAnalysisStatus.PendingApproval)
                    {
                        <span class="badge-pill badge-rdp ms-2">Pending approval</span>
                    }
                    else if (status == AppAnalysisStatus.Approved)
                    {
                        <span class="badge-pill badge-active ms-2">Approved</span>
                    }
                    else if (status == AppAnalysisStatus.Dismissed)
                    {
                        <span class="badge-pill badge-ended ms-2">Dismissed</span>
                    }
                    else
                    {
                        <span class="badge-pill badge-ended ms-2">Not analyzed</span>
                    }
                </div>

                <h3 class="h6">Active app lists</h3>
                @if (Model.Lookup.ActiveLists.Count == 0)
                {
                    <p class="text-secondary small">No app lists assigned to this host yet. Tracking uses App lists applied to this machine (or its team/region/office).</p>
                }
                else
                {
                    <ul class="small">
                        @foreach (var a in Model.Lookup.ActiveLists)
                        {
                            <li>
                                <strong>@a.Name</strong>
                                (@a.Scope@(string.IsNullOrEmpty(a.ScopeValue) ? "" : $":{a.ScopeValue}"))
                                · @a.EntryCount apps
                                @if (!string.IsNullOrEmpty(a.TeamName))
                                {
                                    <span>· team @a.TeamName</span>
                                }
                            </li>
                        }
                    </ul>
                }

                <h3 class="h6">Merged processes currently tracked (from lists)</h3>
                <p class="small font-monospace">@(Model.Lookup.MergedProcesses.Count == 0 ? "—" : string.Join(", ", Model.Lookup.MergedProcesses))</p>

                <hr />
                <h3 class="h6 mb-2" id="team-apps">Team apps</h3>
                <p class="small text-secondary mb-3">
                    Find team applications on this machine: Specialization list overlay (grey = not installed here),
                    plus inventory that is Spec or not on any app list. Search path/exe, then add to a list, track, remove from Spec, or ignore.
                </p>
                <div class="mb-3">
                    <label class="form-label small" for="team-apps-keyword">Search name or path</label>
                    <input type="search" class="form-control form-control-sm" id="team-apps-keyword" placeholder="Filter both tables…" autocomplete="off" />
                </div>

                var teamListOptions = Model.EditableAppLists;
                <form method="post" id="team-apps-form" class="mb-4">
                    <input type="hidden" name="AnalyzeHostname" value="@Model.FocusHostname" />
                    <input type="hidden" name="LookupHostname" value="@Model.FocusHostname" />
                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-md-5">
                            <label class="form-label small">Target app list</label>
                            <select class="form-select form-select-sm" name="TargetAppListId" id="team-apps-target-list">
                                <option value="">— select list (Track can create “Team – host”) —</option>
                                @foreach (var l in teamListOptions)
                                {
                                    <option value="@l.Id">@l.Name (@l.EntryCount)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check mt-4">
                                <input class="form-check-input" type="checkbox" name="AlsoAssignToMachine" value="true" id="also-assign-machine" checked />
                                <label class="form-check-label small" for="also-assign-machine">Apply list to this machine</label>
                            </div>
                        </div>
                        <div class="col-md-4 d-flex flex-wrap gap-2">
                            <button type="submit" formaction="?handler=AddToAppList" class="hd-btn hd-btn-silver hd-btn-sm">Add to list</button>
                            <button type="submit" formaction="?handler=TrackTeamApps" class="hd-btn hd-btn-gold hd-btn-sm"
                                    title="Add to selected list (or create Team – host) and apply to this machine. Skips apps not present here.">Track</button>
                            <button type="submit" formaction="?handler=RemoveFromSpecialization" class="hd-btn hd-btn-silver hd-btn-sm"
                                    onclick="return confirm('Remove selected from Specialization classification?');">Remove Spec</button>
                            <button type="submit" formaction="?handler=IgnoreCatalog" class="hd-btn hd-btn-rose hd-btn-sm"
                                    onclick="return confirm('Ignore selected in Discovery catalog?');">Ignore</button>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-lg-6">
                            <h4 class="h6">Specialization on this machine (@Model.SpecOverlay.Count)</h4>
                            <p class="small text-secondary mb-2">Grey rows are on the global Spec list but not found on this host.</p>
                            <div class="table-responsive">
                                <table class="hd-table hd-team-apps-table hd-sortable mb-0" id="spec-overlay-table">
                                    <thead>
                                        <tr>
                                            <th style="width:2rem"><input type="checkbox" id="spec-select-all" title="Select all visible" /></th>
                                            <th data-sort="text">Process</th>
                                            <th data-sort="text">Path</th>
                                            <th data-sort="text">Present</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @if (Model.SpecOverlay.Count == 0)
                                    {
                                        <tr><td colspan="4" class="text-secondary">Specialization list is empty — classify apps on Discovery first.</td></tr>
                                    }
                                    @foreach (var row in Model.SpecOverlay)
                                    {
                                        var label = string.IsNullOrWhiteSpace(row.DisplayName) || row.DisplayName == row.ProcessName
                                            ? row.ProcessName
                                            : $"{row.DisplayName} ({row.ProcessName})";
                                        <tr class="@(row.OnMachine ? null : "hd-row-absent")"
                                            data-on-machine="@(row.OnMachine ? "1" : "0")"
                                            data-filter-text="@($"{row.ProcessName} {row.DisplayName} {row.ExecutablePath}".ToLowerInvariant())">
                                            <td>
                                                <input class="form-check-input team-app-check" type="checkbox" name="SelectedTeamAppProcesses" value="@row.ProcessName"
                                                       title="@(row.OnMachine ? null : "Not on this machine — Remove Spec / Ignore still work; Track skips this row")" />
                                            </td>
                                            <td title="@label"><strong>@row.ProcessName</strong>
                                                @if (!string.IsNullOrWhiteSpace(row.DisplayName) && row.DisplayName != row.ProcessName)
                                                {
                                                    <div class="text-secondary small">@row.DisplayName</div>
                                                }
                                            </td>
                                            <td class="small text-secondary" title="@(row.ExecutablePath ?? "")">@(row.ExecutablePath ?? "—")</td>
                                            <td>@(row.OnMachine ? "Y" : "N")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <h4 class="h6">On machine — Spec or unlisted (@Model.TeamCandidates.Count)</h4>
                            <p class="small text-secondary mb-2">Inventory that is Specialization or not in any app list.</p>
                            <div class="table-responsive">
                                <table class="hd-table hd-team-apps-table hd-sortable mb-0" id="team-candidates-table">
                                    <thead>
                                        <tr>
                                            <th style="width:2rem"><input type="checkbox" id="cand-select-all" /></th>
                                            <th data-sort="text">Process</th>
                                            <th data-sort="text">Path</th>
                                            <th data-sort="text">Group</th>
                                            <th data-sort="text">Listed</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @if (Model.TeamCandidates.Count == 0)
                                    {
                                        <tr><td colspan="5" class="text-secondary">No Spec/unlisted inventory — Request Inventory or Analyze first.</td></tr>
                                    }
                                    @foreach (var row in Model.TeamCandidates)
                                    {
                                        <tr data-filter-text="@($"{row.ProcessName} {row.DisplayName} {row.ExecutablePath}".ToLowerInvariant())">
                                            <td>
                                                <input class="form-check-input team-app-check" type="checkbox" name="SelectedTeamAppProcesses" value="@row.ProcessName" />
                                            </td>
                                            <td title="@row.ProcessName"><strong>@row.ProcessName</strong>
                                                @if (!string.Equals(row.DisplayName, row.ProcessName, StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <div class="text-secondary small">@row.DisplayName</div>
                                                }
                                            </td>
                                            <td class="small text-secondary" title="@(row.ExecutablePath ?? "")">@(row.ExecutablePath ?? "—")</td>
                                            <td><span class="badge-pill badge-group-@row.Group.ToString().ToLowerInvariant()">@ProcessClassification.GroupLabel(row.Group)</span></td>
                                            <td>@(row.InAnyAppList ? "Y" : "N")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </form>

                @if (Model.FocusPendingInventory)
                {
                    <div class="alert alert-secondary py-2 small mb-3">
                        <strong>Pending inventory</strong> — agent has been asked to upload all running processes.
                        Expect ~5 min (config refresh) + ~1 min (upload). Re-select this machine above (or reload) to refresh.
                    </div>
                }

                @if (Model.MachineInventory.Count > 0)
                {
                    var agentInventoryCount = Model.MachineInventory.Count(r => string.Equals(r.Source, "AgentInventory", StringComparison.OrdinalIgnoreCase));
                    var runsOnlyInventory = agentInventoryCount == 0;
                    <hr />
                    <h3 class="h6">Discovered inventory (@Model.MachineInventory.Count processes)</h3>
                    @if (runsOnlyInventory)
                    {
                        <div class="alert alert-warning py-2 small mb-2">
                            Showing @Model.MachineInventory.Count process(es) from <strong>tracked runs only</strong> (Config includes / known apps).
                            For a full snapshot (~100+ processes), click <strong>Request full inventory</strong> above and wait for the agent upload.
                            Toggle <em>Show Core Windows</em> / <em>Show SOE</em> below — many entries are hidden by default.
                        </div>
                    }
                    <p class="small text-secondary mb-2">
                        Processes seen on this machine@(agentInventoryCount > 0 ? $" ({agentInventoryCount} from agent inventory snapshot)" : "").
                        Grouped as Core Windows, SOE, or Specialization.
                        Select rows and move groups in bulk; user overrides persist in the database and win over static catalogs.
                        Rows marked <span class="badge-pill badge-group-specialization">suggested</span> are new to the catalog with a heuristic classification hint — still needs your confirmation.
                    </p>
                    <form method="post" id="group-edit-form">
                        <input type="hidden" name="AnalyzeHostname" value="@Model.FocusHostname" />
                        <input type="hidden" name="LookupHostname" value="@Model.FocusHostname" />
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                        <input type="search" class="form-control hd-table-filter" placeholder="Filter name or path…" data-filter-for="inventory-table" style="max-width:240px" />
                        <select class="form-select" id="inventory-group-filter" style="max-width:180px">
                            <option value="">All groups</option>
                            <option value="Specialization">Specialization</option>
                            <option value="Soe">SOE</option>
                            <option value="CoreWindows">Core Windows</option>
                        </select>
                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input hd-group-toggle" type="checkbox" id="show-core-windows" data-group="CoreWindows" />
                            <label class="form-check-label small" for="show-core-windows">Show Core Windows</label>
                        </div>
                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input hd-group-toggle" type="checkbox" id="show-soe" data-group="Soe" />
                            <label class="form-check-label small" for="show-soe">Show SOE</label>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-2 align-items-center">
                        <button type="submit" formaction="?handler=MoveToCoreWindows" class="hd-btn hd-btn-silver" title="Move selected to Core Windows">Move Core</button>
                        <button type="submit" formaction="?handler=MoveToSoe" class="hd-btn hd-btn-silver" title="Move selected to SOE">Move SOE</button>
                        <button type="submit" formaction="?handler=MoveToSpecialization" class="hd-btn hd-btn-silver" title="Move selected to Specialization">Move Spec</button>
                        <span class="vr"></span>
                        <select class="form-select form-select-sm" name="format" style="max-width:200px">
                            <option value="classification-csv">Classification CSV</option>
                            <option value="classification-json">Classification JSON</option>
                            <option value="applist-csv">App list CSV</option>
                            <option value="applist-json">App list JSON</option>
                        </select>
                        <button type="submit" formaction="?handler=ExportSelectedInventory" class="hd-btn hd-btn-silver">Export Selected</button>
                    </div>
                    <div class="table-responsive" style="max-height:22rem;overflow:auto">
                        <table class="hd-table hd-sortable mb-0" id="inventory-table">
                            <thead>
                                <tr>
                                    <th style="width:2rem"><input class="form-check-input" type="checkbox" id="inventory-select-all" title="Select all visible" /></th>
                                    <th data-sort="text">Process</th>
                                    <th data-sort="text">Path</th>
                                    <th data-sort="text">Group</th>
                                    <th data-sort="text">Status</th>
                                    <th data-sort="text">Source</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var row in Model.MachineInventory)
                            {
                                var groupLabel = AppListsModel.GroupLabel(row.Group);
                                var statusLabel = AppListsModel.StatusLabel(row.Status);
                                <tr data-group="@row.Group" class="@(row.Status == AppListService.InventoryStatus.Proposed ? "hd-row-highlight" : null)">
                                    <td>
                                        <input class="form-check-input inventory-row-check" type="checkbox" name="SelectedGroupProcesses" value="@row.ProcessName" />
                                    </td>
                                    <td data-sort-value="@row.ProcessName">
                                        <code>@row.ProcessName</code>
                                        @if (!string.Equals(row.DisplayName, row.ProcessName, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="text-secondary small">@row.DisplayName</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(row.ProgramDisplay))
                                        {
                                            <div class="hd-meta-line text-secondary">Program: @row.ProgramDisplay</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(row.ExecutablePath))
                                        {
                                            <div class="hd-process-path">@row.ExecutablePath</div>
                                        }
                                        @if (row.AllowForPresence)
                                        {
                                            <span class="badge-pill badge-rdp ms-1" title="Presence signal only — not proposed for app tracking">signal</span>
                                        }
                                    </td>
                                    <td data-sort-value="@(row.ExecutablePath ?? "")" class="hd-process-path-cell">@(string.IsNullOrWhiteSpace(row.ExecutablePath) ? "—" : row.ExecutablePath)</td>
                                    <td data-sort-value="@groupLabel">
                                        <span class="badge-pill badge-group-@row.Group.ToString().ToLowerInvariant()">@groupLabel</span>
                                        @if (row.SuggestedGroup is not null)
                                        {
                                            <div class="text-secondary small mt-1" title="@row.SuggestionReason">suggested: @AppListsModel.GroupLabel(row.SuggestedGroup.Value)</div>
                                        }
                                    </td>
                                    <td data-sort-value="@statusLabel">@statusLabel</td>
                                    <td data-sort-value="@row.Source" class="small">@row.Source</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    </form>
                }

                @if (Model.HasAutoDiscoveredList && Model.FocusHostname is not null)
                {
                    <form method="post" asp-page-handler="CleanupDiscovered" class="mt-2">
                        <input type="hidden" name="AnalyzeHostname" value="@Model.FocusHostname" />
                        <input type="hidden" name="LookupHostname" value="@Model.FocusHostname" />
                        <button type="submit" class="hd-btn hd-btn-rose"
                                title="Remove Core Windows and SOE from the discovered list (@Model.AutoDiscoveredEntryCount). Specialization stays."
                                onclick="return confirm('Remove Core Windows and SOE apps from “Discovered on @Model.FocusHostname” (@Model.AutoDiscoveredEntryCount entries)? Specialization apps stay tracked.');">
                            Clear Noise
                        </button>
                    </form>
                }

                @if (status == AppAnalysisStatus.PendingApproval && Model.PendingProposals.Count > 0)
                {
                    <hr />
                    <h3 class="h6">Pending approval — proposed specialization apps</h3>
                    <p class="small text-secondary">Choose how to proceed. Nothing below is tracked until you confirm. Core Windows and SOE are omitted.</p>

                    <form method="post" id="approval-form">
                        <input type="hidden" name="AnalyzeHostname" value="@Model.FocusHostname" />
                        <input type="hidden" name="LookupHostname" value="@Model.FocusHostname" />
                        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                            <input type="search" class="form-control hd-table-filter" placeholder="Filter proposals…" data-filter-for="proposals-table" style="max-width:220px" />
                        </div>
                        <table class="hd-table hd-sortable mb-3" id="proposals-table">
                            <thead>
                                <tr>
                                    <th style="width:2rem"></th>
                                    <th data-sort="text">App</th>
                                    <th data-sort="text">Process</th>
                                    <th data-sort="text">Path</th>
                                    <th data-sort="text">Group</th>
                                    <th data-sort="text">Source</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var p in Model.PendingProposals)
                            {
                                var groupLabel = AppListsModel.GroupLabel(p.Group);
                                <tr data-group="@p.Group">
                                    <td>
                                        <input class="form-check-input" type="checkbox" name="SelectedProcesses" value="@p.ProcessName" checked />
                                    </td>
                                    <td data-sort-value="@p.DisplayName">@p.DisplayName</td>
                                    <td data-sort-value="@p.ProcessName"><code>@p.ProcessName</code>
                                        @if (!string.IsNullOrWhiteSpace(p.ExecutablePath))
                                        {
                                            <div class="hd-process-path">@p.ExecutablePath</div>
                                        }
                                    </td>
                                    <td data-sort-value="@(p.ExecutablePath ?? "")" class="hd-process-path-cell">@(string.IsNullOrWhiteSpace(p.ExecutablePath) ? "—" : p.ExecutablePath)</td>
                                    <td data-sort-value="@groupLabel"><span class="badge-pill badge-group-specialization">@groupLabel</span></td>
                                    <td data-sort-value="@p.Source">@p.Source</td>
                                </tr>
                            }
                            </tbody>
                        </table>

                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <button type="submit" formaction="?handler=ApproveAll" class="hd-btn hd-btn-gold">Approve All</button>
                            <button type="submit" formaction="?handler=ApproveSelected" class="hd-btn hd-btn-gold">Approve Selected</button>
                            <button type="submit" formaction="?handler=Dismiss" class="hd-btn hd-btn-rose" onclick="return confirm('Ignore all proposed apps for this machine?');">Dismiss All</button>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
                            <select class="form-select form-select-sm" name="format" style="max-width:200px">
                                <option value="classification-csv">Classification CSV</option>
                                <option value="classification-json">Classification JSON</option>
                                <option value="applist-csv">App list CSV</option>
                                <option value="applist-json">App list JSON</option>
                            </select>
                            <button type="submit" formaction="?handler=ExportSelectedProposals" class="hd-btn hd-btn-silver">Export Selected</button>
                        </div>
                        <p class="small text-secondary mb-2">
                            <strong>Approve all / selected</strong> → creates machine-scoped list “Discovered on @Model.FocusHostname” and tracks those apps.
                        </p>

                        <div class="border-top pt-3 mt-2">
                            <h3 class="h6">Apply team app list instead</h3>
                            <p class="small text-secondary">Tracks <em>only</em> the chosen team schema on this machine (discards discovered proposals; disables auto-discovered machine lists).</p>
                            @if (Model.TeamOptions.Count == 0)
                            {
                                <p class="text-secondary small mb-0">No team-linked app lists yet. Link lists on <a asp-page="/Teams">Teams</a> (App lists by team).</p>
                            }
                            else
                            {
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-8">
                                        <select class="form-select" name="ApplyTeamListId" asp-for="ApplyTeamListId">
                                            <option value="">— select team list —</option>
                                            @foreach (var o in Model.TeamOptions)
                                            {
                                                <option value="@o.AppListId">
                                                    @o.ListName (@(o.TeamName ?? "team")) · @o.EntryCount apps@(o.MatchesMachineUsers ? " · matches users" : "")
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <button type="submit" formaction="?handler=ApplyTeam" class="hd-btn hd-btn-silver w-100">Apply List</button>
                                    </div>
                                </div>
                                @if (Model.TeamOptions.FirstOrDefault(o => o.AppListId == Model.ApplyTeamListId) is { } preview)
                                {
                                    <p class="small mt-2 mb-0">Will track: <code>@string.Join(", ", preview.ProcessNames)</code></p>
                                }
                                else
                                {
                                    <p class="small mt-2 text-secondary mb-0">Pick a list to see which processes will be tracked.</p>
                                }
                            }
                        </div>
                    </form>
                }
            }
        </details>

<div class="row g-4">
    <div class="col-lg-6">
<details class="hd-panel mb-4 hd-collapsible" data-key="csv-classifications" id="csv-classifications">
            <summary class="h5 mb-3">
                Bulk Update Software Classifications
                <span class="text-secondary" title="Export → fill Category/Subcategory/Group in AI → Import proposes suggestions. Approve on Discovery &amp; Classification.">ⓘ</span>
            </summary>
            <p class="small mb-2">
                <strong>Central catalog:</strong> @Model.CatalogTotalCount unique process(es) tracked
                <span class="text-secondary" title="Each row is one ProcessName + ExecutablePath pair. The same exe name at different paths (or with an empty path) is a separate entry until merged by backfill or a new sighting with a path.">(by name + path)</span>
                · <span class="@(Model.CatalogUnclassifiedCount > 0 ? "text-warning" : "text-secondary")">@Model.CatalogUnclassifiedCount awaiting classification</span>
                @if (Model.CatalogDiscoverySourceCount > 0)
                {
                    <span class="text-secondary" title="Unique name+path pairs across ProcessRuns, machine inventories, app lists, and assignments — sources may overlap."> · @Model.CatalogDiscoverySourceCount in discovery sources</span>
                }
                @if (Model.CatalogMissingFromDiscoveryCount > 0)
                {
                    <span class="text-warning"> · @Model.CatalogMissingFromDiscoveryCount not yet in catalog</span>
                }
                @if (Model.CatalogBlankPathCount > 0)
                {
                    <span class="text-secondary"> · @Model.CatalogBlankPathCount missing path</span>
                    <span class="text-secondary"> — <a asp-page="/Discovery" asp-route-blankPathOnly="true">view on Discovery</a> or use <strong>Request Inventory</strong> in Machine lookup</span>
                }
                · <a asp-page="/Discovery">Discovery &amp; Classification</a> to Approve or browse the catalog.
            </p>
            @if (Model.ShowCatalogBackfill)
            {
                <div class="alert alert-warning py-2 px-3 small mb-2 d-flex flex-wrap align-items-center gap-2">
                    <span>@Model.CatalogMissingFromDiscoveryCount discovery key(s) are not in the central catalog yet (from ProcessRuns, inventories, and lists). Backfill imports them and merges blank-path / version-folder duplicates where safe. A daily automatic backfill also runs on the API (idempotent — skips duplicates).</span>
                    <form method="post" asp-page-handler="BackfillCatalog" class="d-inline">
                        @if (Model.FocusHostname is not null)
                        {
                            <input type="hidden" name="LookupHostname" value="@Model.FocusHostname" />
                            <input type="hidden" name="AnalyzeHostname" value="@Model.FocusHostname" />
                        }
                        <button type="submit" class="hd-btn hd-btn-rose">Backfill Discovered</button>
                    </form>
                </div>
            }
            <div class="d-flex flex-wrap gap-2 mb-3">
                <a class="hd-btn hd-btn-silver" asp-page-handler="ExportAllCsv" title="CSV of already-classified processes only">Export Classified</a>
                <a class="hd-btn hd-btn-silver" asp-page-handler="ExportCatalogCsv" title="CSV of every discovered process, including unclassified — header: @ProcessGroupService.CsvHeader">Export All</a>
                @if (Model.FocusHostname is not null)
                {
                    <a class="hd-btn hd-btn-silver" asp-page-handler="ExportMachineCsv" asp-route-host="@Model.FocusHostname" title="Export @Model.FocusHostname for AI description fill → Import below">Export Machine</a>
                }
            </div>
            <form method="post" asp-page-handler="ImportClassifications" enctype="multipart/form-data">
                @if (Model.FocusHostname is not null)
                {
                    <input type="hidden" name="LookupHostname" value="@Model.FocusHostname" />
                    <input type="hidden" name="AnalyzeHostname" value="@Model.FocusHostname" />
                }
                <div class="row g-2 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label">Import CSV</label>
                        <div class="hd-file-picker" data-hd-file-picker>
                            <label class="hd-btn hd-btn-silver hd-file-picker-label">
                                Choose File
                                <input class="hd-file-picker-input" type="file" name="ClassificationCsvFile" accept=".csv,text/csv" required
                                       title="Updates ProcessGroupAssignment by ProcessName. Group values: CoreWindows, Soe, Specialization. SOE rows sync SoeApps membership." />
                            </label>
                            <span class="hd-file-picker-name">No file chosen</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="hd-btn hd-btn-gold w-100">Import CSV</button>
                    </div>
                </div>
            </form>
        </details>
    </div>
    <div class="col-lg-6">
<details class="hd-panel mb-4 hd-collapsible" data-key="upload">
            <summary class="h5 mb-3">
                Upload CSV / JSON
                <span class="text-secondary" title="Header ProcessName or DisplayName,ProcessName; optional Team, ListName columns. JSON: array of {processName, displayName?, team?, listName?}. Export Selected on Existing lists produces files in this exact format.">ⓘ</span>
            </summary>
            <form method="post" asp-page-handler="Upload" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label">Default team (if column omitted)</label>
                    <select class="form-select" asp-for="DefaultUploadTeamId">
                        <option value="">— none —</option>
                        @foreach (var t in Model.Teams)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">File</label>
                    <div class="hd-file-picker" data-hd-file-picker>
                        <label class="hd-btn hd-btn-silver hd-file-picker-label">
                            Choose File
                            <input class="hd-file-picker-input" type="file" name="UploadFile" accept=".csv,.json,text/csv,application/json" required
                                   title="Header ProcessName or DisplayName,ProcessName; optional Team, ListName columns for bulk create." />
                        </label>
                        <span class="hd-file-picker-name">No file chosen</span>
                    </div>
                </div>
                <button type="submit" class="hd-btn hd-btn-silver">Upload File</button>
            </form>
        </details>
    </div>
</div>
}

<script src="~/js/machine-tree.js" asp-append-version="true"></script>
<script src="~/js/hd-table.js" asp-append-version="true"></script>
<script>
(() => {
  // Collapsible cards: collapsed by default (server-rendered), remembered per-browser-session.
  document.querySelectorAll('details.hd-collapsible[data-key]').forEach((d) => {
    const storeKey = 'hd-collapse:' + d.dataset.key;
    try {
      const stored = sessionStorage.getItem(storeKey);
      if (stored !== null) d.open = stored === '1';
    } catch (_) { /* storage unavailable */ }
    d.addEventListener('toggle', () => {
      try { sessionStorage.setItem(storeKey, d.open ? '1' : '0'); } catch (_) { /* ignore */ }
    });
  });

  // Toasts: auto-dismiss after data-autodismiss ms, or on close-button click.
  document.querySelectorAll('.hd-toast[data-autodismiss]').forEach((toast) => {
    const dismiss = () => {
      toast.classList.add('hd-toast-hide');
      setTimeout(() => toast.remove(), 300);
    };
    const ms = parseInt(toast.dataset.autodismiss, 10) || 5000;
    const timer = setTimeout(dismiss, ms);
    toast.querySelector('.hd-toast-close')?.addEventListener('click', () => { clearTimeout(timer); dismiss(); });
  });

  const listsSelectAll = document.getElementById('lists-select-all');
  if (listsSelectAll) {
    listsSelectAll.addEventListener('change', () => {
      document.querySelectorAll('.lists-row-check').forEach((cb) => { cb.checked = listsSelectAll.checked; });
    });
  }

  function applyInventoryVisibility() {
    const table = document.getElementById('inventory-table');
    if (!table) return;
    const showCore = document.getElementById('show-core-windows')?.checked;
    const showSoe = document.getElementById('show-soe')?.checked;
    const groupFilter = document.getElementById('inventory-group-filter')?.value || '';
    const textFilter = document.querySelector('[data-filter-for="inventory-table"]')?.value?.trim().toLowerCase() || '';
    table.querySelectorAll('tbody tr').forEach(tr => {
      const group = tr.dataset.group || '';
      let visible = true;
      if (group === 'CoreWindows' && !showCore) visible = false;
      if (group === 'Soe' && !showSoe) visible = false;
      if (groupFilter && group !== groupFilter) visible = false;
      if (textFilter && !tr.textContent.toLowerCase().includes(textFilter)) visible = false;
      tr.style.display = visible ? '' : 'none';
    });
  }

  document.querySelectorAll('.hd-group-toggle').forEach(cb => cb.addEventListener('change', applyInventoryVisibility));
  document.getElementById('inventory-group-filter')?.addEventListener('change', applyInventoryVisibility);
  document.querySelector('[data-filter-for="inventory-table"]')?.addEventListener('input', applyInventoryVisibility);
  applyInventoryVisibility();

  const selectAll = document.getElementById('inventory-select-all');
  if (selectAll) {
    selectAll.addEventListener('change', () => {
      document.querySelectorAll('#inventory-table tbody tr').forEach(tr => {
        if (tr.style.display === 'none') return;
        const cb = tr.querySelector('.inventory-row-check');
        if (cb) cb.checked = selectAll.checked;
      });
    });
  }

  if (window.HeimdallTable) {
    HeimdallTable.initSort(document);
    HeimdallTable.initTextFilter(document);
  }

  document.querySelectorAll('[data-hd-file-picker]').forEach((picker) => {
    const input = picker.querySelector('.hd-file-picker-input');
    const nameEl = picker.querySelector('.hd-file-picker-name');
    if (!input || !nameEl) return;
    input.addEventListener('change', () => {
      const file = input.files?.[0];
      nameEl.textContent = file?.name ?? 'No file chosen';
      nameEl.classList.toggle('is-chosen', !!file);
    });
  });

  // Team apps: keyword filter across Spec overlay + Spec/unlisted candidates.
  function applyTeamAppsFilter() {
    const q = (document.getElementById('team-apps-keyword')?.value || '').trim().toLowerCase();
    document.querySelectorAll('.hd-team-apps-table tbody tr[data-filter-text]').forEach((tr) => {
      const hay = tr.dataset.filterText || '';
      tr.style.display = !q || hay.includes(q) ? '' : 'none';
    });
  }
  document.getElementById('team-apps-keyword')?.addEventListener('input', applyTeamAppsFilter);

  function wireSelectAll(masterId, tableId) {
    const master = document.getElementById(masterId);
    if (!master) return;
    master.addEventListener('change', () => {
      document.querySelectorAll(`#${tableId} tbody tr`).forEach((tr) => {
        if (tr.style.display === 'none') return;
        const cb = tr.querySelector('.team-app-check');
        if (cb && !cb.disabled) cb.checked = master.checked;
      });
    });
  }
  wireSelectAll('spec-select-all', 'spec-overlay-table');
  wireSelectAll('cand-select-all', 'team-candidates-table');

  // Add needs a target list; Track creates “Team – host” when empty. Remove Spec / Ignore do not need a list.
  document.getElementById('team-apps-form')?.addEventListener('submit', (ev) => {
    const submitter = ev.submitter;
    const action = (submitter?.getAttribute('formaction') || '').toLowerCase();
    if (action.includes('trackteamapps')) {
      // Grey Spec rows stay selectable for Remove Spec / Ignore; uncheck them for Track.
      document.querySelectorAll('#spec-overlay-table tbody tr.hd-row-absent .team-app-check:checked')
        .forEach((cb) => { cb.checked = false; });
      return;
    }
    if (!action.includes('addtoapplist')) return;
    const list = document.getElementById('team-apps-target-list');
    if (list && !list.value) {
      ev.preventDefault();
      list.focus();
      alert('Pick a target app list first.');
    }
  });
})();
</script>
}

@section Scripts {
    @if (!renderBody)
    {
        <script src="~/js/ops-tabs.js" asp-append-version="true"></script>
    }
}

