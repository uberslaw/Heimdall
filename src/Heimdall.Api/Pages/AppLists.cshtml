@page
@model AppListsModel
@using Heimdall.Api.Data
@using Heimdall.Api.Services
@using Heimdall.Shared.Contracts
@{
    ViewData["Title"] = "App lists";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
    <div>
        <h1 class="hd-title mb-1">App lists</h1>
        <p class="hd-sub mb-0">Named process schemas · apply anywhere · analyze machines · approve before tracking</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-ghost" asp-page="/TrackSoftware">Track Software</a>
        <a class="btn btn-ghost" asp-page="/Apps">Applications</a>
        <a class="btn btn-ghost" asp-page="/Help" asp-fragment="app-lists" title="How App lists works">Help</a>
    </div>
</div>

<div id="hd-toast-region" class="hd-toast-region">
    @if (TempData["Message"] is string msg)
    {
        <div class="hd-toast hd-toast-success" role="status" data-autodismiss="5000">
            <span>@msg</span>
            <button type="button" class="hd-toast-close" aria-label="Dismiss">&times;</button>
        </div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="hd-toast hd-toast-error" role="alert" data-autodismiss="5000">
            <span>@err</span>
            <button type="button" class="hd-toast-close" aria-label="Dismiss">&times;</button>
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <details class="hd-panel mb-4 hd-collapsible" data-key="existing-lists">
            <summary class="h5 mb-3">Existing lists <span class="text-secondary small">(@Model.Lists.Count)</span></summary>
            @if (Model.Lists.Count == 0)
            {
                <p class="text-secondary mb-0">No app lists yet.</p>
            }
            else
            {
                <form method="post" asp-page-handler="ExportSelectedLists" id="lists-export-form">
                    <div class="table-responsive">
                        <table class="hd-table mb-2">
                            <thead>
                                <tr>
                                    <th style="width:2rem"><input class="form-check-input" type="checkbox" id="lists-select-all" title="Select all" /></th>
                                    <th>Name</th>
                                    <th>Team</th>
                                    <th>Apps</th>
                                    <th>Scopes</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var l in Model.Lists)
                            {
                                <tr>
                                    <td><input class="form-check-input lists-row-check" type="checkbox" name="SelectedListIds" value="@l.Id" /></td>
                                    <td>
                                        <strong>@l.Name</strong>
                                        @if (l.IsAutoDiscovered)
                                        {
                                            <span class="badge-pill badge-ended ms-1">auto</span>
                                        }
                                    </td>
                                    <td>@(l.TeamName ?? "—")</td>
                                    <td>@l.EntryCount</td>
                                    <td>@l.AssignmentCount</td>
                                    <td><a class="btn btn-ghost btn-sm" asp-page-handler="Edit" asp-route-id="@l.Id">Edit</a></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <select class="form-select form-select-sm" name="format" style="max-width:200px">
                            <option value="csv">App list CSV</option>
                            <option value="json">App list JSON</option>
                            <option value="classification-csv">Classification CSV</option>
                        </select>
                        <button type="submit" class="btn btn-ghost btn-sm">Export selected</button>
                    </div>
                </form>
            }
        </details>

        <details class="hd-panel mb-4 hd-collapsible" data-key="create-list" open="@(Model.EditId is not null)">
            <summary class="h5 mb-3">@(Model.EditId is null ? "Create app list" : $"Edit list #{Model.EditId}")</summary>
            <form method="post" asp-page-handler="SaveList">
                <input type="hidden" asp-for="EditId" />
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input class="form-control" asp-for="ListName" required placeholder="e.g. Structural – APAC" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Team (optional)</label>
                    <select class="form-select" asp-for="TeamId">
                        <option value="">— none —</option>
                        @foreach (var t in Model.Teams)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Notes</label>
                    <input class="form-control" asp-for="Notes" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Processes (one per line; optional <code>DisplayName,ProcessName</code>)</label>
                    <textarea class="form-control font-monospace" asp-for="ProcessesText" rows="8" placeholder="Revit&#10;acad&#10;Speckle Connector,Speckle"></textarea>
                </div>
                <button type="submit" class="btn btn-hd">@(Model.EditId is null ? "Create" : "Save")</button>
                @if (Model.EditId is not null)
                {
                    <a class="btn btn-ghost" asp-page="/AppLists">Cancel</a>
                }
            </form>
        </details>

        <details class="hd-panel mb-4 hd-collapsible" data-key="upload">
            <summary class="h5 mb-3">Upload CSV / JSON</summary>
            <p class="mb-2 small text-secondary">
                Header <code>ProcessName</code> or <code>DisplayName,ProcessName</code>; optional <code>Team</code>, <code>ListName</code> columns for bulk create.
                JSON: array of <code>{"processName","displayName?","team?","listName?"}</code>.
                Tip: the <strong>Export selected</strong> buttons on Existing lists / Machine inventory / Proposals below produce files in this exact format, ready to re-import.
            </p>
            <form method="post" asp-page-handler="Upload" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label">Default team (if column omitted)</label>
                    <select class="form-select" asp-for="DefaultUploadTeamId">
                        <option value="">— none —</option>
                        @foreach (var t in Model.Teams)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <input class="form-control" type="file" name="UploadFile" accept=".csv,.json,text/csv,application/json" required />
                </div>
                <button type="submit" class="btn btn-ghost">Upload</button>
            </form>
        </details>
    </div>

    <div class="col-lg-7">
        <details class="hd-panel mb-4 hd-collapsible" data-key="apply-scope">
            <summary class="h5 mb-3">Apply list to scope</summary>
            <form method="post" asp-page-handler="Apply" id="apply-form">
                <div class="mb-3">
                    <label class="form-label">App list</label>
                    <select class="form-select" asp-for="ApplyAppListId" required>
                        <option value="">— select —</option>
                        @foreach (var l in Model.Lists)
                        {
                            <option value="@l.Id">@l.Name (@l.EntryCount apps)</option>
                        }
                    </select>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" asp-for="ApplyGlobal" id="apply-global" />
                    <label class="form-check-label" for="apply-global">Global (all machines)</label>
                </div>
                @{
                    ViewData["TreeId"] = "app-list-tree";
                    ViewData["TreeInputPrefix"] = "Selected";
                }
                <partial name="_MachineTree" model="Model.Tree" />
                <button type="submit" class="btn btn-hd mt-3">Apply</button>
            </form>
        </details>

        <details class="hd-panel mb-4 hd-collapsible" data-key="machine-focus" id="machine-focus" open="@(Model.Lookup is not null)">
            <summary class="h5 mb-3">Machine lookup &amp; analysis</summary>
            <form method="post" class="row g-2 align-items-end mb-3" id="machine-lookup-form">
                <div class="col-md-8">
                    <label class="form-label">Machine</label>
                    <select class="form-select" asp-for="LookupHostname" required
                            onchange="if(this.value){ window.location.href = '@Url.Page("/AppLists")?host=' + encodeURIComponent(this.value) + '#machine-focus'; }">
                        <option value="">— select —</option>
                        @foreach (var m in Model.AllMachines)
                        {
                            <option value="@m.Hostname">@m.Hostname</option>
                        }
                    </select>
                    <p class="text-secondary small mb-0 mt-1">Selecting a machine reloads this section with its current status — no separate lookup step needed.</p>
                </div>
                <div class="col-md-4 d-flex flex-column gap-2">
                    <button type="submit" formaction="?handler=Analyze" class="btn btn-hd">Analyze apps</button>
                    <button type="submit" formaction="?handler=RequestInventory" class="btn btn-ghost">Request full inventory</button>
                </div>
            </form>
            <p class="text-secondary small mb-0">
                Pick a machine, then <strong>Analyze apps</strong> (classify &amp; propose specialization apps) or <strong>Request full inventory</strong>
                (agent uploads every running process — use when discovery shows only a handful of tracked apps).
                Wait ~5 min for agent config refresh + ~1 min upload. Core Windows &amp; SOE are classified but excluded from proposals by default.
            </p>

            @if (Model.Lookup is not null && Model.FocusHostname is not null)
            {
                var status = Model.FocusStatus ?? AppAnalysisStatus.None;
                <div class="mb-3 mt-3">
                    <strong>@Model.FocusHostname</strong>
                    @if (status == AppAnalysisStatus.PendingApproval)
                    {
                        <span class="badge-pill badge-rdp ms-2">Pending approval</span>
                    }
                    else if (status == AppAnalysisStatus.Approved)
                    {
                        <span class="badge-pill badge-active ms-2">Approved</span>
                    }
                    else if (status == AppAnalysisStatus.Dismissed)
                    {
                        <span class="badge-pill badge-ended ms-2">Dismissed</span>
                    }
                    else
                    {
                        <span class="badge-pill badge-ended ms-2">Not analyzed</span>
                    }
                </div>

                <h3 class="h6">Active app lists</h3>
                @if (Model.Lookup.ActiveLists.Count == 0)
                {
                    <p class="text-secondary small">No app lists assigned to this host yet. Pre-approval tracking still uses Config / known defaults.</p>
                }
                else
                {
                    <ul class="small">
                        @foreach (var a in Model.Lookup.ActiveLists)
                        {
                            <li>
                                <strong>@a.Name</strong>
                                (@a.Scope@(string.IsNullOrEmpty(a.ScopeValue) ? "" : $":{a.ScopeValue}"))
                                · @a.EntryCount apps
                                @if (!string.IsNullOrEmpty(a.TeamName)) { <span>· team @a.TeamName</span> }
                            </li>
                        }
                    </ul>
                }

                <h3 class="h6">Merged processes currently tracked (from lists)</h3>
                <p class="small font-monospace">@(Model.Lookup.MergedProcesses.Count == 0 ? "—" : string.Join(", ", Model.Lookup.MergedProcesses))</p>

                @if (Model.FocusPendingInventory)
                {
                    <div class="alert alert-secondary py-2 small mb-3">
                        <strong>Pending inventory</strong> — agent has been asked to upload all running processes.
                        Expect ~5 min (config refresh) + ~1 min (upload). Re-select this machine above (or reload) to refresh.
                    </div>
                }

                @if (Model.MachineInventory.Count > 0)
                {
                    var agentInventoryCount = Model.MachineInventory.Count(r => string.Equals(r.Source, "AgentInventory", StringComparison.OrdinalIgnoreCase));
                    var runsOnlyInventory = agentInventoryCount == 0;
                    <hr />
                    <h3 class="h6">Discovered inventory (@Model.MachineInventory.Count processes)</h3>
                    @if (runsOnlyInventory)
                    {
                        <div class="alert alert-warning py-2 small mb-2">
                            Showing @Model.MachineInventory.Count process(es) from <strong>tracked runs only</strong> (Config includes / known apps).
                            For a full snapshot (~100+ processes), click <strong>Request full inventory</strong> above and wait for the agent upload.
                            Toggle <em>Show Core Windows</em> / <em>Show SOE</em> below — many entries are hidden by default.
                        </div>
                    }
                    <p class="small text-secondary mb-2">
                        Processes seen on this machine@(agentInventoryCount > 0 ? $" ({agentInventoryCount} from agent inventory snapshot)" : "").
                        Grouped as Core Windows, SOE, or Specialization.
                        Select rows and move groups in bulk; user overrides persist in the database and win over static catalogs.
                        Rows marked <span class="badge-pill badge-group-specialization">suggested</span> are new to the catalog with a heuristic classification hint — still needs your confirmation.
                    </p>
                    <form method="post" id="group-edit-form">
                        <input type="hidden" name="AnalyzeHostname" value="@Model.FocusHostname" />
                        <input type="hidden" name="LookupHostname" value="@Model.FocusHostname" />
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                        <input type="search" class="form-control hd-table-filter" placeholder="Filter name or path…" data-filter-for="inventory-table" style="max-width:240px" />
                        <select class="form-select" id="inventory-group-filter" style="max-width:180px">
                            <option value="">All groups</option>
                            <option value="Specialization">Specialization</option>
                            <option value="Soe">SOE</option>
                            <option value="CoreWindows">Core Windows</option>
                        </select>
                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input hd-group-toggle" type="checkbox" id="show-core-windows" data-group="CoreWindows" />
                            <label class="form-check-label small" for="show-core-windows">Show Core Windows</label>
                        </div>
                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input hd-group-toggle" type="checkbox" id="show-soe" data-group="Soe" />
                            <label class="form-check-label small" for="show-soe">Show SOE</label>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <button type="submit" formaction="?handler=MoveToCoreWindows" class="btn btn-ghost btn-sm">Move to Core Windows</button>
                        <button type="submit" formaction="?handler=MoveToSoe" class="btn btn-ghost btn-sm">Move to SOE</button>
                        <button type="submit" formaction="?handler=MoveToSpecialization" class="btn btn-ghost btn-sm">Move to Specialization</button>
                        <span class="vr"></span>
                        <select class="form-select form-select-sm" name="format" style="max-width:200px">
                            <option value="classification-csv">Classification CSV</option>
                            <option value="classification-json">Classification JSON</option>
                            <option value="applist-csv">App list CSV</option>
                            <option value="applist-json">App list JSON</option>
                        </select>
                        <button type="submit" formaction="?handler=ExportSelectedInventory" class="btn btn-ghost btn-sm">Export selected</button>
                    </div>
                    <div class="table-responsive" style="max-height:22rem;overflow:auto">
                        <table class="hd-table hd-sortable mb-0" id="inventory-table">
                            <thead>
                                <tr>
                                    <th style="width:2rem"><input class="form-check-input" type="checkbox" id="inventory-select-all" title="Select all visible" /></th>
                                    <th data-sort="text">Process</th>
                                    <th data-sort="text">Path</th>
                                    <th data-sort="text">Group</th>
                                    <th data-sort="text">Status</th>
                                    <th data-sort="text">Source</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var row in Model.MachineInventory)
                            {
                                var groupLabel = AppListsModel.GroupLabel(row.Group);
                                var statusLabel = AppListsModel.StatusLabel(row.Status);
                                <tr data-group="@row.Group" class="@(row.Status == AppListService.InventoryStatus.Proposed ? "hd-row-highlight" : null)">
                                    <td>
                                        <input class="form-check-input inventory-row-check" type="checkbox" name="SelectedGroupProcesses" value="@row.ProcessName" />
                                    </td>
                                    <td data-sort-value="@row.ProcessName">
                                        <code>@row.ProcessName</code>
                                        @if (!string.Equals(row.DisplayName, row.ProcessName, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="text-secondary small">@row.DisplayName</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(row.ExecutablePath))
                                        {
                                            <div class="hd-process-path">@row.ExecutablePath</div>
                                        }
                                        @if (row.AllowForPresence)
                                        {
                                            <span class="badge-pill badge-rdp ms-1" title="Presence signal only — not proposed for app tracking">signal</span>
                                        }
                                    </td>
                                    <td data-sort-value="@(row.ExecutablePath ?? "")" class="hd-process-path-cell">@(string.IsNullOrWhiteSpace(row.ExecutablePath) ? "—" : row.ExecutablePath)</td>
                                    <td data-sort-value="@groupLabel">
                                        <span class="badge-pill badge-group-@row.Group.ToString().ToLowerInvariant()">@groupLabel</span>
                                        @if (row.SuggestedGroup is not null)
                                        {
                                            <div class="text-secondary small mt-1" title="@row.SuggestionReason">suggested: @AppListsModel.GroupLabel(row.SuggestedGroup.Value)</div>
                                        }
                                    </td>
                                    <td data-sort-value="@statusLabel">@statusLabel</td>
                                    <td data-sort-value="@row.Source" class="small">@row.Source</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    </form>
                }

                @if (Model.HasAutoDiscoveredList && Model.FocusHostname is not null)
                {
                    <form method="post" asp-page-handler="CleanupDiscovered" class="mt-2">
                        <input type="hidden" name="AnalyzeHostname" value="@Model.FocusHostname" />
                        <input type="hidden" name="LookupHostname" value="@Model.FocusHostname" />
                        <button type="submit" class="btn btn-ghost btn-sm"
                                onclick="return confirm('Remove Core Windows and SOE apps from “Discovered on @Model.FocusHostname” (@Model.AutoDiscoveredEntryCount entries)? Specialization apps stay tracked.');">
                            Remove Core Windows &amp; SOE from discovered list (@Model.AutoDiscoveredEntryCount entries)
                        </button>
                        <span class="text-secondary small ms-2">Cleans approved auto-discovered lists without re-approval.</span>
                    </form>
                }

                @if (status == AppAnalysisStatus.PendingApproval && Model.PendingProposals.Count > 0)
                {
                    <hr />
                    <h3 class="h6">Pending approval — proposed specialization apps</h3>
                    <p class="small text-secondary">Choose how to proceed. Nothing below is tracked until you confirm. Core Windows and SOE are omitted.</p>

                    <form method="post" id="approval-form">
                        <input type="hidden" name="AnalyzeHostname" value="@Model.FocusHostname" />
                        <input type="hidden" name="LookupHostname" value="@Model.FocusHostname" />
                        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                            <input type="search" class="form-control hd-table-filter" placeholder="Filter proposals…" data-filter-for="proposals-table" style="max-width:220px" />
                        </div>
                        <table class="hd-table hd-sortable mb-3" id="proposals-table">
                            <thead>
                                <tr>
                                    <th style="width:2rem"></th>
                                    <th data-sort="text">App</th>
                                    <th data-sort="text">Process</th>
                                    <th data-sort="text">Path</th>
                                    <th data-sort="text">Group</th>
                                    <th data-sort="text">Source</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var p in Model.PendingProposals)
                            {
                                var groupLabel = AppListsModel.GroupLabel(p.Group);
                                <tr data-group="@p.Group">
                                    <td>
                                        <input class="form-check-input" type="checkbox" name="SelectedProcesses" value="@p.ProcessName" checked />
                                    </td>
                                    <td data-sort-value="@p.DisplayName">@p.DisplayName</td>
                                    <td data-sort-value="@p.ProcessName"><code>@p.ProcessName</code>
                                        @if (!string.IsNullOrWhiteSpace(p.ExecutablePath))
                                        {
                                            <div class="hd-process-path">@p.ExecutablePath</div>
                                        }
                                    </td>
                                    <td data-sort-value="@(p.ExecutablePath ?? "")" class="hd-process-path-cell">@(string.IsNullOrWhiteSpace(p.ExecutablePath) ? "—" : p.ExecutablePath)</td>
                                    <td data-sort-value="@groupLabel"><span class="badge-pill badge-group-specialization">@groupLabel</span></td>
                                    <td data-sort-value="@p.Source">@p.Source</td>
                                </tr>
                            }
                            </tbody>
                        </table>

                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <button type="submit" formaction="?handler=ApproveAll" class="btn btn-hd">Approve all</button>
                            <button type="submit" formaction="?handler=ApproveSelected" class="btn btn-ghost">Approve selected</button>
                            <button type="submit" formaction="?handler=Dismiss" class="btn btn-ghost" onclick="return confirm('Ignore all proposed apps for this machine?');">Dismiss / Ignore</button>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
                            <select class="form-select form-select-sm" name="format" style="max-width:200px">
                                <option value="classification-csv">Classification CSV</option>
                                <option value="classification-json">Classification JSON</option>
                                <option value="applist-csv">App list CSV</option>
                                <option value="applist-json">App list JSON</option>
                            </select>
                            <button type="submit" formaction="?handler=ExportSelectedProposals" class="btn btn-ghost btn-sm">Export selected</button>
                        </div>
                        <p class="small text-secondary mb-2">
                            <strong>Approve all / selected</strong> → creates machine-scoped list “Discovered on @Model.FocusHostname” and tracks those apps.
                        </p>

                        <div class="border-top pt-3 mt-2">
                            <h3 class="h6">Apply team app list instead</h3>
                            <p class="small text-secondary">Tracks <em>only</em> the chosen team schema on this machine (discards discovered proposals; disables auto-discovered machine lists).</p>
                            @if (Model.TeamOptions.Count == 0)
                            {
                                <p class="text-secondary small mb-0">No team-linked app lists yet. Create a list with a Team on the left.</p>
                            }
                            else
                            {
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-8">
                                        <select class="form-select" name="ApplyTeamListId" asp-for="ApplyTeamListId">
                                            <option value="">— select team list —</option>
                                            @foreach (var o in Model.TeamOptions)
                                            {
                                                <option value="@o.AppListId">
                                                    @o.ListName (@(o.TeamName ?? "team")) · @o.EntryCount apps@(o.MatchesMachineUsers ? " · matches users" : "")
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <button type="submit" formaction="?handler=ApplyTeam" class="btn btn-hd w-100">Apply team list</button>
                                    </div>
                                </div>
                                @if (Model.TeamOptions.FirstOrDefault(o => o.AppListId == Model.ApplyTeamListId) is { } preview)
                                {
                                    <p class="small mt-2 mb-0">Will track: <code>@string.Join(", ", preview.ProcessNames)</code></p>
                                }
                                else
                                {
                                    <p class="small mt-2 text-secondary mb-0">Pick a list to see which processes will be tracked.</p>
                                }
                            }
                        </div>
                    </form>
                }
            }
        </details>

        <details class="hd-panel mb-4 hd-collapsible" data-key="csv-classifications" id="csv-classifications">
            <summary class="h5 mb-3">CSV classifications (AI-assisted)</summary>
            <p class="small mb-2">
                <strong>Central catalog:</strong> @Model.CatalogTotalCount unique process(es) tracked (by name + path)
                · <span class="@(Model.CatalogUnclassifiedCount > 0 ? "text-warning" : "text-secondary")">@Model.CatalogUnclassifiedCount awaiting classification</span>
                · <a asp-page-handler="ExportCatalogCsv" class="small">export full catalog CSV</a>
            </p>
            <p class="small text-secondary mb-3">
                Export → fill <code>Description</code> in AI → Import to batch update groups and descriptions.
                Header row: <code>@ProcessGroupService.CsvHeader</code>
            </p>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <a class="btn btn-ghost btn-sm" asp-page-handler="ExportAllCsv">Export all classified processes</a>
                @if (Model.FocusHostname is not null)
                {
                    <a class="btn btn-hd btn-sm" asp-page-handler="ExportMachineCsv" asp-route-host="@Model.FocusHostname">Export CSV for AI (@Model.FocusHostname)</a>
                }
            </div>
            <form method="post" asp-page-handler="ImportClassifications" enctype="multipart/form-data">
                @if (Model.FocusHostname is not null)
                {
                    <input type="hidden" name="LookupHostname" value="@Model.FocusHostname" />
                    <input type="hidden" name="AnalyzeHostname" value="@Model.FocusHostname" />
                }
                <div class="row g-2 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label">Import CSV</label>
                        <input class="form-control" type="file" name="ClassificationCsvFile" accept=".csv,text/csv" required />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-hd w-100">Import CSV</button>
                    </div>
                </div>
                <p class="small text-secondary mt-2 mb-0">
                    Updates <code>ProcessGroupAssignment</code> by <code>ProcessName</code>. Group values: CoreWindows, Soe, Specialization (friendly names accepted). SOE rows sync SoeApps membership.
                </p>
            </form>
        </details>

        <details class="hd-panel hd-collapsible" data-key="changelog">
            <summary class="h5 mb-3">Change log</summary>
            @if (Model.AuditLogs.Count == 0)
            {
                <p class="text-secondary mb-0">No changes yet.</p>
            }
            else
            {
                <div class="table-responsive" style="max-height:28rem;overflow:auto">
                    <table class="hd-table">
                        <thead>
                            <tr>
                                <th>When (UTC)</th>
                                <th>Action</th>
                                <th>List / host</th>
                                <th>Detail</th>
                                <th>Actor</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var log in Model.AuditLogs)
                        {
                            <tr>
                                <td class="small text-nowrap">@log.Utc.ToString("u")</td>
                                <td><code>@log.Action</code></td>
                                <td class="small">
                                    @(log.AppListName ?? "—")
                                    @if (!string.IsNullOrEmpty(log.MachineHostname))
                                    {
                                        <div>@log.MachineHostname</div>
                                    }
                                    @if (log.Scope is not null)
                                    {
                                        <div class="text-secondary">@log.Scope:@(log.ScopeValue ?? "*")</div>
                                    }
                                </td>
                                <td class="small">@log.Detail</td>
                                <td class="small">@(log.Actor ?? "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </details>
    </div>
</div>

@section Scripts {
<script src="~/js/machine-tree.js" asp-append-version="true"></script>
<script src="~/js/hd-table.js" asp-append-version="true"></script>
<script>
(() => {
  const tree = document.getElementById('app-list-tree');
  if (tree && window.HeimdallTree) HeimdallTree.init(tree);

  // Collapsible cards: collapsed by default (server-rendered), remembered per-browser-session.
  document.querySelectorAll('details.hd-collapsible[data-key]').forEach((d) => {
    const storeKey = 'hd-collapse:' + d.dataset.key;
    try {
      const stored = sessionStorage.getItem(storeKey);
      if (stored !== null) d.open = stored === '1';
    } catch (_) { /* storage unavailable */ }
    d.addEventListener('toggle', () => {
      try { sessionStorage.setItem(storeKey, d.open ? '1' : '0'); } catch (_) { /* ignore */ }
    });
  });

  // Toasts: auto-dismiss after data-autodismiss ms, or on close-button click.
  document.querySelectorAll('.hd-toast[data-autodismiss]').forEach((toast) => {
    const dismiss = () => {
      toast.classList.add('hd-toast-hide');
      setTimeout(() => toast.remove(), 300);
    };
    const ms = parseInt(toast.dataset.autodismiss, 10) || 5000;
    const timer = setTimeout(dismiss, ms);
    toast.querySelector('.hd-toast-close')?.addEventListener('click', () => { clearTimeout(timer); dismiss(); });
  });

  const listsSelectAll = document.getElementById('lists-select-all');
  if (listsSelectAll) {
    listsSelectAll.addEventListener('change', () => {
      document.querySelectorAll('.lists-row-check').forEach((cb) => { cb.checked = listsSelectAll.checked; });
    });
  }

  function applyInventoryVisibility() {
    const table = document.getElementById('inventory-table');
    if (!table) return;
    const showCore = document.getElementById('show-core-windows')?.checked;
    const showSoe = document.getElementById('show-soe')?.checked;
    const groupFilter = document.getElementById('inventory-group-filter')?.value || '';
    const textFilter = document.querySelector('[data-filter-for="inventory-table"]')?.value?.trim().toLowerCase() || '';
    table.querySelectorAll('tbody tr').forEach(tr => {
      const group = tr.dataset.group || '';
      let visible = true;
      if (group === 'CoreWindows' && !showCore) visible = false;
      if (group === 'Soe' && !showSoe) visible = false;
      if (groupFilter && group !== groupFilter) visible = false;
      if (textFilter && !tr.textContent.toLowerCase().includes(textFilter)) visible = false;
      tr.style.display = visible ? '' : 'none';
    });
  }

  document.querySelectorAll('.hd-group-toggle').forEach(cb => cb.addEventListener('change', applyInventoryVisibility));
  document.getElementById('inventory-group-filter')?.addEventListener('change', applyInventoryVisibility);
  document.querySelector('[data-filter-for="inventory-table"]')?.addEventListener('input', applyInventoryVisibility);
  applyInventoryVisibility();

  const selectAll = document.getElementById('inventory-select-all');
  if (selectAll) {
    selectAll.addEventListener('change', () => {
      document.querySelectorAll('#inventory-table tbody tr').forEach(tr => {
        if (tr.style.display === 'none') return;
        const cb = tr.querySelector('.inventory-row-check');
        if (cb) cb.checked = selectAll.checked;
      });
    });
  }

  if (window.HeimdallTable) {
    HeimdallTable.initSort(document);
    HeimdallTable.initTextFilter(document);
  }
})();
</script>
}
