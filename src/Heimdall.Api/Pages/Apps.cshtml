@page
@model AppsModel
@{
    ViewData["Title"] = "Application Usage";
    ViewData["HelpFragment"] = "applications";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
    <div>
        <h1 class="hd-title mb-1">Application Usage</h1>
        <p class="hd-sub mb-0">Tracked process usage across the fleet · @Model.RangeLabel</p>
    </div>
    <div class="d-flex gap-2">
        <a class="hd-btn hd-btn-black" asp-page="/AppLists">App lists</a>
        <a class="hd-btn hd-btn-black" asp-page="/AppLists" asp-route-tab="create">Create app list</a>
        <a class="hd-btn hd-btn-black" asp-page="/Discovery">Discovery &amp; Classification</a>
    </div>
</div>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}

<form method="get" class="hd-panel mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-4 col-lg-3">
            <label class="form-label" for="util-range">Period</label>
            <select class="form-select" name="range" id="util-range">
                @foreach (var opt in IndexModel.RangeOptions)
                {
                    if (Model.Range == opt.Key)
                    {
                        <option value="@opt.Key" selected>@opt.Label</option>
                    }
                    else
                    {
                        <option value="@opt.Key">@opt.Label</option>
                    }
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="hd-btn hd-btn-gold">Apply</button>
        </div>
        <div class="col-md-5 col-lg-5 ms-lg-auto">
            <label class="form-label" for="socratize-host">Socratize machine</label>
            <div class="input-group">
                <select class="form-select" name="Host" id="socratize-host" form="socratize-jump">
                    <option value="">— select host —</option>
                    @foreach (var host in Model.Hostnames)
                    {
                        <option value="@host">@host</option>
                    }
                </select>
                <button type="submit" class="hd-btn hd-btn-silver" form="socratize-jump">Go</button>
            </div>
        </div>
    </div>
</form>
<form method="get" asp-page="/Socratize" id="socratize-jump" class="d-none"></form>

<div class="hd-panel hd-apps-panel">
    <table class="hd-table hd-apps-table hd-sortable" id="apps-table">
        <thead>
            <tr>
                <th data-sort="text" class="hd-apps-col-name">Program / process</th>
                <th data-sort="num" class="hd-apps-col-num" title="Distinct users in the period">Users</th>
                <th data-sort="num" class="hd-apps-col-num" title="Distinct machines in the period">Machines</th>
                <th data-sort="num" class="hd-apps-col-num" title="Time-weighted average concurrent instances">Avg open</th>
                <th data-sort="num" class="hd-apps-col-num" title="Distinct process lifetimes (PID runs)">Runs</th>
                <th data-sort="num" class="hd-apps-col-time" data-default-desc title="Wall-clock time with at least one instance open">Total time</th>
                <th data-sort="date" class="hd-apps-col-seen">Last seen</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Apps.Count == 0)
        {
            <tr><td colspan="7">No tracked application usage yet. Use <strong>Track Software</strong> or enable apps under Config.</td></tr>
        }
        @foreach (var a in Model.Apps)
        {
            var memberLine = a.MemberProcessNames.Count <= 1
                ? null
                : string.Join(", ", a.MemberProcessNames.Take(8))
                  + (a.MemberProcessNames.Count > 8 ? ",…" : "");
            var title = a.IsProgramGroup
                ? (memberLine is null ? a.DisplayName : $"{a.DisplayName} — {memberLine}")
                : (string.Equals(a.DisplayName, a.ProcessName, StringComparison.OrdinalIgnoreCase)
                    ? a.ProcessName
                    : $"{a.DisplayName} ({a.ProcessName})");
            <tr style="cursor:pointer" onclick="window.location='@Url.Page("/Application", new { process = a.ProcessName, range = Model.Range })'">
                <td class="hd-apps-col-name" data-sort-value="@a.DisplayName" title="@title">
                    <a class="hd-apps-name text-truncate d-inline-block"
                       asp-page="/Application" asp-route-process="@a.ProcessName" asp-route-range="@Model.Range"
                       onclick="event.stopPropagation()" title="@title">@a.DisplayName</a>
                    @if (a.IsProgramGroup && memberLine is not null)
                    {
                        <div class="hd-meta-line text-truncate" title="@memberLine">@memberLine</div>
                    }
                    else if (!a.IsProgramGroup && !string.Equals(a.DisplayName, a.ProcessName, StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="hd-meta-line text-truncate" title="@a.ProcessName">@a.ProcessName</div>
                    }
                </td>
                <td class="hd-apps-col-num" data-sort-value="@a.UniqueUsers">@a.UniqueUsers</td>
                <td class="hd-apps-col-num" data-sort-value="@a.UniqueMachines">@a.UniqueMachines</td>
                <td class="hd-apps-col-num" data-sort-value="@a.AvgConcurrentProcesses.ToString(System.Globalization.CultureInfo.InvariantCulture)">@ConcurrentDisplay.Render(a.AvgConcurrentProcesses)</td>
                <td class="hd-apps-col-num" data-sort-value="@a.RunCount">@a.RunCount</td>
                <td class="hd-apps-col-time" data-sort-value="@a.TotalDuration.TotalSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)">@DurationDisplay.Render(a.TotalDuration)</td>
                <td class="hd-apps-col-seen" data-sort-value="@a.LastSeenUtc.ToUnixTimeSeconds()" title="@IndexModel.FormatLocalTimestamp(a.LastSeenUtc)">@IndexModel.FormatLocalTimestamp(a.LastSeenUtc)</td>
            </tr>
        }
        </tbody>
    </table>
    <p class="text-secondary small mt-3 mb-0">
        <strong>Total time</strong> is wall-clock with at least one instance open (overlaps not double-counted).
        <strong>Avg open</strong> is the time-weighted average concurrent instance count.
        <strong>Runs</strong> counts distinct process lifetimes.
        Rows under Program Files are grouped by install program (e.g. Autodesk / Revit); click opens the busiest process in that group.
    </p>
</div>
