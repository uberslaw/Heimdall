@page
@model AppsModel
@{
    ViewData["Title"] = "Applications";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
    <div>
        <h1 class="hd-title mb-1">Applications</h1>
        <p class="hd-sub mb-0">Tracked non-Windows processes · last 30 days</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-hd" asp-page="/TrackSoftware">Track Software</a>
        <a class="btn btn-ghost" asp-page="/AppLists">App lists</a>
    </div>
</div>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}

<div class="hd-panel">
    <table class="hd-table">
        <thead>
            <tr>
                <th>Process</th>
                <th>Users</th>
                <th>Runs</th>
                <th>Total time</th>
                <th>Last seen</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Apps.Count == 0)
        {
            <tr><td colspan="5">No tracked application usage yet. Use <strong>Track Software</strong> or enable apps under Config.</td></tr>
        }
        @foreach (var a in Model.Apps)
        {
            <tr>
                <td><strong>@a.ProcessName</strong></td>
                <td>@a.UniqueUsers</td>
                <td>@a.RunCount</td>
                <td>@a.TotalDuration.ToString(@"d\.hh\:mm\:ss")</td>
                <td>@a.LastSeenUtc.ToLocalTime().ToString("g")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
