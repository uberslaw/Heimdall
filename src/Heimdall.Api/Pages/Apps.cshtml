@page
@model AppsModel
@{
    ViewData["Title"] = "Applications";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
    <div>
        <h1 class="hd-title mb-1">Applications</h1>
        <p class="hd-sub mb-0">Tracked non-Windows processes · @Model.RangeLabel</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-hd" asp-page="/TrackSoftware">Track Software</a>
        <a class="btn btn-ghost" asp-page="/AppLists">App lists</a>
    </div>
</div>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}

<form method="get" class="hd-panel mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-4 col-lg-3">
            <label class="form-label" for="util-range">Period</label>
            <select class="form-select" name="range" id="util-range">
                @foreach (var opt in IndexModel.RangeOptions)
                {
                    if (Model.Range == opt.Key)
                    {
                        <option value="@opt.Key" selected>@opt.Label</option>
                    }
                    else
                    {
                        <option value="@opt.Key">@opt.Label</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3 col-lg-2">
            <button type="submit" class="btn btn-hd w-100">Apply</button>
        </div>
    </div>
</form>

<div class="hd-panel">
    <table class="hd-table">
        <thead>
            <tr>
                <th>Process</th>
                <th>Users</th>
                <th>Runs</th>
                <th>Total time</th>
                <th>Last seen</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Apps.Count == 0)
        {
            <tr><td colspan="5">No tracked application usage yet. Use <strong>Track Software</strong> or enable apps under Config.</td></tr>
        }
        @foreach (var a in Model.Apps)
        {
            <tr style="cursor:pointer" onclick="window.location='@Url.Page("/Application", new { process = a.ProcessName, range = Model.Range })'">
                <td>
                    <a asp-page="/Application" asp-route-process="@a.ProcessName" asp-route-range="@Model.Range" onclick="event.stopPropagation()">
                        <strong>@a.DisplayName</strong>
                    </a>
                    @if (!string.Equals(a.DisplayName, a.ProcessName, StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="text-secondary small">(@a.ProcessName)</span>
                    }
                </td>
                <td>@a.UniqueUsers</td>
                <td>@a.RunCount</td>
                <td>@a.TotalDuration.ToString(@"d\.hh\:mm\:ss")</td>
                <td>@a.LastSeenUtc.ToLocalTime().ToString("g")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
