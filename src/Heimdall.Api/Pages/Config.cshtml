@page
@model ConfigModel
@using Heimdall.Shared.Contracts
@{
    ViewData["Title"] = "Config";
    var editing = Model.EditingConfigId.HasValue;
    var scopeLabel = Model.EditingConfig is not null
        ? ConfigModel.FormatScope(Model.EditingConfig.Scope, Model.EditingConfig.ScopeValue)
        : (editing ? ConfigModel.FormatScope(Model.SamplingScope, null) : "New scoped config");
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <h1 class="hd-title mb-1">Tracking config</h1>
    <a class="btn btn-ghost btn-sm" asp-page="/Help" asp-fragment="tracking-config">Help</a>
</div>
<p class="hd-sub">Scoped sampling, include/exclude process lists, known apps, and metric thresholds · <a asp-page="/Utilization">Utilization criteria</a></p>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="hd-panel mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h2 class="h5 mb-0">Sampling configs</h2>
        <div class="d-flex gap-2">
            <span class="text-secondary small">More specific scopes win · Machine &gt; Office &gt; Country &gt; Region/Group &gt; Global</span>
            <a class="btn btn-ghost btn-sm" asp-page="/Config" asp-route-new="true">New scoped config</a>
        </div>
    </div>
    <table class="hd-table hd-sortable mb-0">
        <thead>
            <tr>
                <th data-sort="text">Name</th>
                <th data-sort="text">Scope</th>
                <th data-sort="text">Sample / Upload</th>
                <th data-sort="num">Min CPU</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (Model.TrackingConfigs.Count == 0)
        {
            <tr><td colspan="5">No sampling configs yet.</td></tr>
        }
        @foreach (var c in Model.TrackingConfigs)
        {
            var active = Model.EditingConfigId == c.Id;
            <tr class="@(active ? "hd-row-active" : null)">
                <td><strong>@c.Name</strong></td>
                <td>
                    <span class="badge-pill badge-local">@c.Scope</span>
                    @if (!string.IsNullOrEmpty(c.ScopeValue))
                    {
                        <span class="text-secondary"> @c.ScopeValue</span>
                    }
                </td>
                <td class="small">@c.SampleIntervalSeconds s / @c.UploadIntervalSeconds s</td>
                <td>@c.MinCpuPercentToTrack.ToString("0.#")%</td>
                <td class="text-nowrap">
                    <a class="btn btn-ghost btn-sm" asp-page="/Config" asp-route-edit="@c.Id">@(active ? "Editing" : "Edit")</a>
                    @if (c.Scope != ConfigScope.All || Model.TrackingConfigs.Count(x => x.Scope == ConfigScope.All) > 1)
                    {
                        <form method="post" asp-page-handler="DeleteTracking" class="d-inline" onsubmit="return confirm('Delete this sampling config?');">
                            <input type="hidden" name="DeleteConfigId" value="@c.Id" />
                            <button type="submit" class="btn btn-ghost btn-sm">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<form method="post" asp-page-handler="SaveTracking" id="sampling-form" class="hd-panel mb-4">
    <input type="hidden" asp-for="EditingConfigId" />
    <input type="hidden" asp-for="IncludeProcessesJson" id="include-json" />
    <input type="hidden" asp-for="ExcludeProcessesJson" id="exclude-json" />

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <h2 class="h5 mb-1">Sampling settings</h2>
            <p class="text-secondary small mb-0">Editing: <strong>@scopeLabel</strong></p>
        </div>
        @if (editing)
        {
            <a class="btn btn-ghost btn-sm" asp-page="/Config" asp-route-new="true">Switch to create…</a>
        }
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label">Config name</label>
            <input class="form-control" asp-for="ConfigName" placeholder="e.g. Sydney office sampling" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Scope type</label>
            <select class="form-select" asp-for="SamplingScope" id="sampling-scope-type" disabled="@editing">
                <option value="@ConfigScope.All">Global (all machines)</option>
                <option value="@ConfigScope.Machine">Individual / multiple machines</option>
                <option value="@ConfigScope.Office">Office (one or more)</option>
                <option value="@ConfigScope.Country">Country (one or more)</option>
                <option value="@ConfigScope.Region">Region (one or more)</option>
                <option value="@ConfigScope.Group">Group name (one or more)</option>
            </select>
            @if (editing)
            {
                <input type="hidden" name="SamplingScope" value="@Model.SamplingScope" />
                <p class="text-secondary small mt-1 mb-0">Scope is fixed while editing. Create a new config to target different machines.</p>
            }
        </div>
    </div>

    <div id="scope-targets" class="mb-3" hidden="@editing">
        <div data-scope-panel="tree" class="mb-2" hidden>
            <label class="form-label">Select targets in the hierarchy</label>
            <p class="text-secondary small">Check regions, offices, and/or machines. Saving creates one sampling config per selected target at the chosen scope level.</p>
            @{
                ViewData["TreeId"] = "sampling-tree";
                ViewData["TreeInputPrefix"] = "Selected";
            }
            <partial name="_MachineTree" model="Model.Tree" />
        </div>
        <div data-scope-panel="country" class="mb-2" hidden>
            <label class="form-label">Countries</label>
            <div class="hd-check-grid">
                @foreach (var c in Model.Countries)
                {
                    <label class="form-check-label">
                        <input class="form-check-input" type="checkbox" name="SelectedCountries" value="@c"
                               @(Model.SelectedCountries.Contains(c) ? "checked" : null) />
                        @c
                    </label>
                }
                @if (Model.Countries.Count == 0)
                {
                    <span class="text-secondary small">No countries yet — agents populate Country from region.</span>
                }
            </div>
        </div>
        <div data-scope-panel="group" class="mb-2" hidden>
            <label class="form-label">Machine groups</label>
            <div class="hd-check-grid">
                @foreach (var g in Model.Groups)
                {
                    <label class="form-check-label">
                        <input class="form-check-input" type="checkbox" name="SelectedGroups" value="@g"
                               @(Model.SelectedGroups.Contains(g) ? "checked" : null) />
                        @g
                    </label>
                }
                @if (Model.Groups.Count == 0)
                {
                    <span class="text-secondary small">No machine groups reported yet.</span>
                }
            </div>
        </div>
        <div data-scope-panel="global" class="mb-2" hidden>
            <p class="text-secondary small mb-0">Applies to every machine. Agents use this when no more-specific sampling config matches.</p>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label class="form-label">Sample interval (seconds)</label>
            <input class="form-control" asp-for="SampleIntervalSeconds" type="number" min="10" max="600" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Upload interval (seconds)</label>
            <input class="form-control" asp-for="UploadIntervalSeconds" type="number" min="30" max="3600" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Min CPU % to track</label>
            <input class="form-control" asp-for="MinCpuPercentToTrack" type="number" min="0" max="100" step="0.1" />
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label">Extra include processes</label>
            <p class="text-secondary small">Pause = temporarily do not track (until expiry). Browse uses a file picker on <em>this</em> browser machine (not the remote agent host).</p>
            <div class="hd-process-list" id="include-list" data-list-kind="Include" data-can-mutate="@editing.ToString().ToLowerInvariant()">
                <div class="hd-process-items" role="list">
                    @if (Model.IncludeItems.Count == 0)
                    {
                        <div class="hd-process-empty text-secondary small">No extra includes yet.</div>
                    }
                    @foreach (var item in Model.IncludeItems)
                    {
                        <label class="hd-process-item">
                            <input type="checkbox" class="form-check-input hd-process-check" value="@item.Name" />
                            <span class="hd-process-name">@item.Name</span>
                            @if (item.IsSoe)
                            {
                                <span class="badge-pill badge-local">SOE</span>
                            }
                            @if (item.PausedUntilUtc is DateTimeOffset until)
                            {
                                <span class="badge-pill badge-disc" title="@until.UtcDateTime.ToString("u")">paused until @until.UtcDateTime.ToString("g") UTC</span>
                            }
                        </label>
                    }
                </div>
                <div class="hd-process-toolbar mt-2">
                    <div class="input-group">
                        <input type="text" class="form-control hd-process-input" placeholder="Process name (e.g. dynamo)" @(editing ? null : "disabled") />
                        <button type="button" class="btn btn-ghost hd-process-browse" @(editing ? null : "disabled")>Browse…</button>
                        <button type="button" class="btn btn-ghost hd-process-add" @(editing ? null : "disabled")>Add</button>
                        <input type="file" class="hd-process-file" accept=".exe,.EXE,application/x-msdownload" hidden />
                    </div>
                    <div class="hd-process-actions mt-2" hidden>
                        <button type="button" class="btn btn-ghost btn-sm hd-process-remove">Remove</button>
                        <button type="button" class="btn btn-ghost btn-sm hd-process-unpause">Unpause</button>
                        <button type="button" class="btn btn-hd btn-sm hd-process-pause">Pause tracking</button>
                    </div>
                    <div class="hd-pause-controls mt-2" hidden>
                        <div class="d-flex flex-wrap gap-2 align-items-end">
                            <div>
                                <label class="form-label small mb-0">Preset</label>
                                <select class="form-select form-select-sm hd-pause-preset">
                                    <option value="">Custom…</option>
                                    <option value="15m">15 minutes</option>
                                    <option value="1h">1 hour</option>
                                    <option value="4h">4 hours</option>
                                    <option value="1d" selected>1 day</option>
                                    <option value="7d">7 days</option>
                                </select>
                            </div>
                            <div>
                                <label class="form-label small mb-0">Days</label>
                                <input type="number" min="0" class="form-control form-control-sm hd-pause-days" value="0" style="width:4.5rem" />
                            </div>
                            <div>
                                <label class="form-label small mb-0">Hours</label>
                                <input type="number" min="0" class="form-control form-control-sm hd-pause-hours" value="0" style="width:4.5rem" />
                            </div>
                            <div>
                                <label class="form-label small mb-0">Minutes</label>
                                <input type="number" min="0" class="form-control form-control-sm hd-pause-minutes" value="0" style="width:4.5rem" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-1">
                <div>
                    <label class="form-label mb-0">Exclude processes (noise)</label>
                    <p class="text-secondary small mb-0">Pause / Allow for diagnostics = temporarily stop excluding (track again until expiry).</p>
                </div>
                @if (editing)
                {
                    <form method="post" asp-page-handler="AutogenerateSoeExcludes" class="d-inline">
                        <input type="hidden" name="EditingConfigId" value="@Model.EditingConfigId" />
                        <button type="submit" class="btn btn-ghost btn-sm" title="Merge curated SOE catalog into this exclude list">Autogenerate SOE excludes</button>
                    </form>
                }
            </div>
            <p class="text-secondary small">Catalog: @Model.SoeCatalogCount SOE apps · diagnostic re-includes expire automatically</p>
            <div class="hd-process-list" id="exclude-list" data-list-kind="Exclude" data-can-mutate="@editing.ToString().ToLowerInvariant()">
                <div class="hd-process-items" role="list">
                    @if (Model.ExcludeItems.Count == 0)
                    {
                        <div class="hd-process-empty text-secondary small">No excludes yet. Use Autogenerate SOE excludes for a starter set.</div>
                    }
                    @foreach (var item in Model.ExcludeItems)
                    {
                        <label class="hd-process-item">
                            <input type="checkbox" class="form-check-input hd-process-check" value="@item.Name" />
                            <span class="hd-process-name">@item.Name</span>
                            @if (item.IsSoe)
                            {
                                <span class="badge-pill badge-local">SOE</span>
                            }
                            @if (item.PausedUntilUtc is DateTimeOffset until)
                            {
                                var label = string.Equals(item.PauseReason, "diagnostics", StringComparison.OrdinalIgnoreCase)
                                    ? "diagnostics until"
                                    : "paused until";
                                <span class="badge-pill badge-disc" title="@until.UtcDateTime.ToString("u")">@label @until.UtcDateTime.ToString("g") UTC</span>
                            }
                        </label>
                    }
                </div>
                <div class="hd-process-toolbar mt-2">
                    <div class="input-group">
                        <input type="text" class="form-control hd-process-input" placeholder="Process name (e.g. svchost)" @(editing ? null : "disabled") />
                        <button type="button" class="btn btn-ghost hd-process-browse" @(editing ? null : "disabled")>Browse…</button>
                        <button type="button" class="btn btn-ghost hd-process-add" @(editing ? null : "disabled")>Add</button>
                        <input type="file" class="hd-process-file" accept=".exe,.EXE,application/x-msdownload" hidden />
                    </div>
                    <div class="hd-process-actions mt-2" hidden>
                        <button type="button" class="btn btn-ghost btn-sm hd-process-remove">Remove</button>
                        <button type="button" class="btn btn-ghost btn-sm hd-process-unpause">End diagnostics</button>
                        <button type="button" class="btn btn-hd btn-sm hd-process-pause">Allow for diagnostics</button>
                    </div>
                    <div class="hd-pause-controls mt-2" hidden>
                        <div class="d-flex flex-wrap gap-2 align-items-end">
                            <div>
                                <label class="form-label small mb-0">Preset</label>
                                <select class="form-select form-select-sm hd-pause-preset">
                                    <option value="">Custom…</option>
                                    <option value="15m">15 minutes</option>
                                    <option value="1h">1 hour</option>
                                    <option value="4h">4 hours</option>
                                    <option value="1d" selected>1 day</option>
                                    <option value="7d">7 days</option>
                                </select>
                            </div>
                            <div>
                                <label class="form-label small mb-0">Days</label>
                                <input type="number" min="0" class="form-control form-control-sm hd-pause-days" value="0" style="width:4.5rem" />
                            </div>
                            <div>
                                <label class="form-label small mb-0">Hours</label>
                                <input type="number" min="0" class="form-control form-control-sm hd-pause-hours" value="0" style="width:4.5rem" />
                            </div>
                            <div>
                                <label class="form-label small mb-0">Minutes</label>
                                <input type="number" min="0" class="form-control form-control-sm hd-pause-minutes" value="0" style="width:4.5rem" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @if (!editing)
            {
                <p class="text-secondary small mt-2 mb-0">Save the sampling config first to Add / Remove / Pause / Autogenerate SOE.</p>
            }
        </div>
    </div>

    <p class="text-secondary small mb-3">
        Process include lists on sampling configs are legacy. Prefer
        <a asp-page="/AppLists">App lists</a> to choose what agents track (apply/ignore by scope or team).
    </p>

    <button type="submit" class="btn btn-hd">@(editing ? "Save sampling config" : "Create sampling config(s)")</button>
</form>

@* Hidden forms for process list mutations *@
<form method="post" asp-page-handler="AddProcess" id="form-add-process" class="d-none">
    <input type="hidden" name="EditingConfigId" value="@Model.EditingConfigId" />
    <input type="hidden" name="ListKind" id="add-list-kind" />
    <input type="hidden" name="ProcessNameInput" id="add-process-name" />
</form>
<form method="post" asp-page-handler="RemoveProcesses" id="form-remove-process" class="d-none">
    <input type="hidden" name="EditingConfigId" value="@Model.EditingConfigId" />
    <input type="hidden" name="ListKind" id="remove-list-kind" />
    <div id="remove-selected"></div>
</form>
<form method="post" asp-page-handler="PauseProcesses" id="form-pause-process" class="d-none">
    <input type="hidden" name="EditingConfigId" value="@Model.EditingConfigId" />
    <input type="hidden" name="ListKind" id="pause-list-kind" />
    <input type="hidden" name="PausePreset" id="pause-preset" />
    <input type="hidden" name="PauseDays" id="pause-days" />
    <input type="hidden" name="PauseHours" id="pause-hours" />
    <input type="hidden" name="PauseMinutes" id="pause-minutes" />
    <div id="pause-selected"></div>
</form>
<form method="post" asp-page-handler="UnpauseProcesses" id="form-unpause-process" class="d-none">
    <input type="hidden" name="EditingConfigId" value="@Model.EditingConfigId" />
    <input type="hidden" name="ListKind" id="unpause-list-kind" />
    <div id="unpause-selected"></div>
</form>

<div class="hd-panel mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h2 class="h5 mb-0">Metric threshold policies</h2>
        <span class="text-secondary small">Most specific scope wins for agents · Machine &gt; Office &gt; Country/Region &gt; All</span>
    </div>

    <table class="hd-table hd-sortable mb-0">
        <thead>
            <tr>
                <th data-sort="text">Name</th>
                <th data-sort="text">Metric</th>
                <th data-sort="text">Thresholds</th>
                <th data-sort="text">Scope</th>
                <th data-sort="text">Enabled</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Policies.Count == 0)
        {
            <tr><td colspan="6">No metric policies yet.</td></tr>
        }
        @foreach (var p in Model.Policies)
        {
            <tr>
                <td><strong>@p.Name</strong></td>
                <td>@FormatMetric(p.MetricType)</td>
                <td class="small">@FormatThresholds(p)</td>
                <td>
                    <span class="badge-pill badge-local">@p.Scope</span>
                    @if (!string.IsNullOrEmpty(p.ScopeValue))
                    {
                        <span class="text-secondary"> @p.ScopeValue</span>
                    }
                </td>
                <td>
                    @if (p.IsEnabled)
                    {
                        <span class="badge-pill badge-active">On</span>
                    }
                    else
                    {
                        <span class="badge-pill badge-ended">Off</span>
                    }
                </td>
                <td class="text-nowrap">
                    <a class="btn btn-ghost btn-sm" asp-page="/Config" asp-route-edit="@Model.EditingConfigId" asp-route-editPolicy="@p.Id">Edit</a>
                    <form method="post" asp-page-handler="TogglePolicy" class="d-inline">
                        <input type="hidden" name="PolicyId" value="@p.Id" />
                        <input type="hidden" name="EditingConfigId" value="@Model.EditingConfigId" />
                        <button type="submit" class="btn btn-ghost btn-sm">@(p.IsEnabled ? "Disable" : "Enable")</button>
                    </form>
                    <form method="post" asp-page-handler="DeletePolicy" class="d-inline" onsubmit="return confirm('Delete this policy?');">
                        <input type="hidden" name="PolicyId" value="@p.Id" />
                        <input type="hidden" name="EditingConfigId" value="@Model.EditingConfigId" />
                        <button type="submit" class="btn btn-ghost btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<form method="post" asp-page-handler="SavePolicy" id="metric-policy-form" class="hd-panel">
    <h2 class="h5 mb-3">@(Model.EditingPolicyId.HasValue ? "Edit metric policy" : "New metric policy")</h2>
    <input type="hidden" asp-for="EditingPolicyId" />
    <input type="hidden" name="EditingConfigId" value="@Model.EditingConfigId" />

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label class="form-label">Name</label>
            <input class="form-control" asp-for="PolicyName" placeholder="e.g. Sydney high RAM" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Metric type</label>
            <select class="form-select" asp-for="PolicyMetricType" id="policy-metric-type">
                <option value="@MetricType.HighRam">High RAM usage</option>
                <option value="@MetricType.HighGpu">High GPU consumption</option>
                <option value="@MetricType.HighDisk">High disk read/write</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Scope type</label>
            <select class="form-select" asp-for="PolicyScope" id="policy-scope-type">
                <option value="@ConfigScope.All">All machines</option>
                <option value="@ConfigScope.Region">Region</option>
                <option value="@ConfigScope.Country">Country</option>
                <option value="@ConfigScope.Office">Office</option>
                <option value="@ConfigScope.Group">Group (legacy)</option>
                <option value="@ConfigScope.Machine">Single machine</option>
            </select>
        </div>
    </div>

    <div class="row g-3 mb-3" data-metric-fields="HighRam">
        <div class="col-md-6">
            <label class="form-label">RAM % threshold</label>
            <input class="form-control" asp-for="RamPercent" type="number" min="1" max="100" step="0.1" />
        </div>
        <div class="col-md-6">
            <label class="form-label">RAM MB threshold</label>
            <input class="form-control" asp-for="RamMb" type="number" min="0" step="1" />
        </div>
    </div>

    <div class="row g-3 mb-3" data-metric-fields="HighGpu" hidden>
        <div class="col-md-6">
            <label class="form-label">GPU util % threshold</label>
            <input class="form-control" asp-for="GpuPercent" type="number" min="1" max="100" step="0.1" />
        </div>
    </div>

    <div class="row g-3 mb-3" data-metric-fields="HighDisk" hidden>
        <div class="col-md-4">
            <label class="form-label">Disk read MB/s</label>
            <input class="form-control" asp-for="DiskReadMBps" type="number" min="0" step="0.1" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Disk write MB/s</label>
            <input class="form-control" asp-for="DiskWriteMBps" type="number" min="0" step="0.1" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Combined MB/s</label>
            <input class="form-control" asp-for="DiskCombinedMBps" type="number" min="0" step="0.1" />
        </div>
    </div>

    <div class="mb-3" id="policy-scope-tree-wrap">
        <label class="form-label">Scope target (pick one region, office, or machine)</label>
        <p class="text-secondary small">For Region/Office/Machine scopes, select exactly one node in the tree. Ignored when scope is All.</p>
        @{
            ViewData["TreeId"] = "policy-tree";
            ViewData["TreeInputPrefix"] = "PolicySelected";
        }
        <partial name="_MachineTree" model="Model.Tree" />
        <div class="mt-2">
            <label class="form-label">Or type scope value</label>
            <input class="form-control" asp-for="PolicyScopeValue" placeholder="e.g. APAC, Australia, APAC/Sydney, or HOSTNAME" />
        </div>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" asp-for="PolicyEnabled" />
        <label class="form-check-label" asp-for="PolicyEnabled">Enabled</label>
    </div>

    <button type="submit" class="btn btn-hd">@(Model.EditingPolicyId.HasValue ? "Update policy" : "Create policy")</button>
    @if (Model.EditingPolicyId.HasValue)
    {
        <a class="btn btn-ghost ms-2" asp-page="/Config" asp-route-edit="@Model.EditingConfigId">Cancel</a>
    }
</form>

@section Scripts {
<script src="~/js/machine-tree.js" asp-append-version="true"></script>
<script src="~/js/process-list.js" asp-append-version="true"></script>
<script>
(() => {
  const typeSel = document.getElementById('policy-metric-type');
  function syncMetricFields() {
    const map = { '0': 'HighRam', '1': 'HighGpu', '2': 'HighDisk',
      'HighRam': 'HighRam', 'HighGpu': 'HighGpu', 'HighDisk': 'HighDisk' };
    const key = map[typeSel.value] || 'HighRam';
    document.querySelectorAll('[data-metric-fields]').forEach(el => {
      el.hidden = el.getAttribute('data-metric-fields') !== key;
    });
  }
  typeSel?.addEventListener('change', syncMetricFields);
  syncMetricFields();

  const tree = document.getElementById('policy-tree');
  HeimdallTree.init(tree);
  tree?.addEventListener('change', e => {
    const cb = e.target;
    if (!cb.classList?.contains('hd-tree-check')) return;
    const data = HeimdallTree.collect(tree);
    const scopeSel = document.getElementById('policy-scope-type');
    const valueInput = document.querySelector('[name="PolicyScopeValue"]');
    if (!valueInput) return;
    if (data.regions.length === 1 && data.offices.length === 0 && data.machines.length === 0) {
      valueInput.value = data.regions[0];
      if (scopeSel) scopeSel.value = '@((int)ConfigScope.Region)';
    } else if (data.offices.length === 1 && data.machines.length === 0 && data.regions.length === 0) {
      valueInput.value = data.offices[0];
      if (scopeSel) scopeSel.value = '@((int)ConfigScope.Office)';
    } else if (data.machines.length === 1 && data.offices.length === 0 && data.regions.length === 0) {
      valueInput.value = data.machines[0];
      if (scopeSel) scopeSel.value = '@((int)ConfigScope.Machine)';
    } else if (data.regions.length + data.offices.length + data.machines.length > 0) {
      if (data.machines.length) valueInput.value = data.machines[0];
      else if (data.offices.length) valueInput.value = data.offices[0];
      else valueInput.value = data.regions[0];
    }
  });

  const samplingTree = document.getElementById('sampling-tree');
  HeimdallTree.init(samplingTree);

  const scopeType = document.getElementById('sampling-scope-type');
  function syncScopePanels() {
    const v = scopeType?.value;
    const map = {
      '@((int)ConfigScope.All)': 'global',
      'All': 'global',
      '@((int)ConfigScope.Machine)': 'tree',
      'Machine': 'tree',
      '@((int)ConfigScope.Office)': 'tree',
      'Office': 'tree',
      '@((int)ConfigScope.Region)': 'tree',
      'Region': 'tree',
      '@((int)ConfigScope.Country)': 'country',
      'Country': 'country',
      '@((int)ConfigScope.Group)': 'group',
      'Group': 'group'
    };
    const panel = map[v] || 'global';
    document.querySelectorAll('#scope-targets [data-scope-panel]').forEach(el => {
      el.hidden = el.getAttribute('data-scope-panel') !== panel;
    });
  }
  scopeType?.addEventListener('change', syncScopePanels);
  syncScopePanels();

  HeimdallProcessList.init(document.getElementById('include-list'));
  HeimdallProcessList.init(document.getElementById('exclude-list'));
  HeimdallProcessList.wireAppBrowse();

  // Before save: sync visible list names into hidden JSON (covers create flow if lists were somehow filled)
  document.getElementById('sampling-form')?.addEventListener('submit', () => {
    const sync = (listId, inputId) => {
      const names = [...document.querySelectorAll(`#${listId} .hd-process-check`)].map(cb => cb.value);
      const el = document.getElementById(inputId);
      if (el) el.value = JSON.stringify(names);
    };
    sync('include-list', 'include-json');
    sync('exclude-list', 'exclude-json');
  });
})();
</script>
}

@functions {
    static string FormatMetric(MetricType t) => t switch
    {
        MetricType.HighRam => "High RAM",
        MetricType.HighGpu => "High GPU",
        MetricType.HighDisk => "High disk",
        _ => t.ToString()
    };

    static string FormatThresholds(Heimdall.Api.Data.MetricPolicy p)
    {
        var parts = new List<string>();
        if (p.RamPercentThreshold is double rp) parts.Add($"{rp:0.#}% RAM");
        if (p.RamMbThreshold is double rm) parts.Add($"{rm:0} MB");
        if (p.GpuPercentThreshold is double gp) parts.Add($"{gp:0.#}% GPU");
        if (p.DiskReadMBpsThreshold is double dr) parts.Add($"R {dr:0.#} MB/s");
        if (p.DiskWriteMBpsThreshold is double dw) parts.Add($"W {dw:0.#} MB/s");
        if (p.DiskCombinedMBpsThreshold is double dc) parts.Add($"Σ {dc:0.#} MB/s");
        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }
}
