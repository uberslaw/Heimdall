@page
@model MachineModel
@using Heimdall.Api.Services
@using Heimdall.Shared.Contracts
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Hostname) ? "Machine" : Model.Hostname;
    ViewData["HelpFragment"] = "machine-detail";
    var d = Model.Detail;
    var shortLabel = Model.RangeDays == 1 ? "1d" : $"{Model.RangeDays}d";
    var appLists = Model.AppListsView;
    var excluded = Model.MachineExcludedProcesses.ToHashSet(StringComparer.OrdinalIgnoreCase);

    static string TruncateName(string name, int max = 20) =>
        name.Length <= max ? name : name[..max] + "…";
}

<div class="d-flex flex-wrap gap-2 mb-3" role="navigation" aria-label="Machine shortcuts">
    <a class="hd-btn hd-btn-silver hd-btn-sm" asp-page="/Index" asp-route-range="@Model.Range">← Computers</a>
    @if (d is not null)
    {
        <a class="hd-btn hd-btn-silver hd-btn-sm"
           asp-page="/Stats"
           asp-route-ScopeKind="Machine"
           asp-route-ScopeValue="@d.Hostname"
           asp-route-Days="@Model.RangeDays">Open in Stats</a>
        <a class="hd-btn hd-btn-silver hd-btn-sm" asp-page="/Socratize" asp-route-Host="@d.Hostname">Socratize</a>
        <a class="hd-btn hd-btn-silver hd-btn-sm" asp-page="/AppLists" asp-route-host="@d.Hostname">Analyze apps</a>
    }
</div>

@if (TempData["Message"] is string toastMsg)
{
    <div class="hd-toast hd-toast-success mb-3" role="status">@toastMsg</div>
}
@if (TempData["Error"] is string toastErr)
{
    <div class="hd-toast hd-toast-error mb-3" role="alert">@toastErr</div>
}

@if (string.IsNullOrWhiteSpace(Model.Hostname))
{
    <div class="hd-panel">
        <p class="text-secondary mb-0">No hostname specified. Pick a computer from the <a asp-page="/Index">Computers</a> list.</p>
    </div>
}
else if (Model.HostNotFound)
{
    <div class="hd-panel">
        <p class="mb-0" style="color:#f0a0a0;">No machine named <strong>@Model.Hostname</strong> in the database yet.</p>
    </div>
}
else if (d is not null)
{
    <h1 class="hd-title hd-title-rose-gold mb-3">@d.Hostname</h1>

    <div class="hd-grid hd-grid-fill mb-3">
        <div class="hd-stat">
            <div class="label d-flex align-items-center justify-content-between gap-2">
                <span>Friendly name</span>
                @if (!Model.EditFriendly)
                {
                    <a class="hd-btn hd-btn-silver hd-btn-sm py-0 px-2" style="font-size:0.7rem;line-height:1.4"
                       asp-page="/Machine" asp-route-Hostname="@d.Hostname" asp-route-Range="@Model.Range" asp-route-StatsDuration="@Model.StatsDuration" asp-route-EditFriendly="true">Edit</a>
                }
            </div>
            @if (Model.EditFriendly)
            {
                <form method="post" asp-page-handler="SaveFriendlyName">
                    <input type="hidden" name="Hostname" value="@Model.Hostname" />
                    <input type="hidden" name="Range" value="@Model.Range" />
                    <input type="hidden" name="StatsDuration" value="@Model.StatsDuration" />
                    <div class="d-flex flex-wrap gap-1 align-items-center">
                        <input class="form-control form-control-sm" name="FriendlyNameInput" value="@Model.FriendlyNameInput"
                               maxlength="80" placeholder="e.g. Revit workstation" style="min-width:10rem;max-width:14rem" />
                        <button type="submit" class="hd-btn hd-btn-silver hd-btn-sm">Save</button>
                        <a class="small" asp-page="/Machine" asp-route-Hostname="@d.Hostname" asp-route-Range="@Model.Range" asp-route-StatsDuration="@Model.StatsDuration">Cancel</a>
                    </div>
                </form>
            }
            else
            {
                <div class="value" style="font-size:1.1rem;">@(string.IsNullOrWhiteSpace(Model.FriendlyName) ? "—" : Model.FriendlyName)</div>
            }
            <div class="text-secondary small">@(string.IsNullOrWhiteSpace(Model.LastIp) ? "No IP yet" : Model.LastIp)</div>
            <form method="post" asp-page-handler="SaveTeam">
                <input type="hidden" name="Hostname" value="@Model.Hostname" />
                <input type="hidden" name="Range" value="@Model.Range" />
                <input type="hidden" name="StatsDuration" value="@Model.StatsDuration" />
                <label class="form-label small text-secondary mb-0" for="machine-team">Team</label>
                <select class="form-select form-select-sm" id="machine-team" name="SelectedTeamId"
                        style="max-width:14rem" onchange="this.form.submit()"
                        title="Same teams as Admin → Teams">
                    <option value="0">— No team —</option>
                    @foreach (var t in Model.TeamOptions)
                    {
                        if (t.Id == Model.SelectedTeamId)
                        {
                            <option value="@t.Id" selected>@t.Label</option>
                        }
                        else
                        {
                            <option value="@t.Id">@t.Label</option>
                        }
                    }
                </select>
            </form>
        </div>
        <div class="hd-stat">
            <div class="label">Status</div>
            <div class="value" style="font-size:1.1rem;">
                @if (d.IsInUse)
                {
                    <span class="badge-pill badge-active">In use</span>
                }
                else if (d.IsOnline)
                {
                    <span class="badge-pill badge-ended">Idle</span>
                }
                else
                {
                    <span class="badge-pill badge-ended">Offline</span>
                }
            </div>
            @if (Model.ResourceGlance is { } glance)
            {
                <div class="hd-resource-glance text-secondary small font-monospace"
                     title="Latest agent sample @MachineModel.FormatLocalTimestamp(glance.SampledAtUtc) (@glance.Source). Disk/network bands are POC MB/s thresholds, not industry standards.">
                    <span>CPU @MachineModel.FormatGlancePct(glance.CpuPercent)</span>
                    <span>GPU @MachineModel.FormatGlancePct(glance.GpuPercent)</span>
                    <span>Disk @glance.DiskLevel</span>
                    <span>Network @glance.NetworkLevel</span>
                </div>
                <div class="text-secondary small">@MachineModel.FormatLocalTimestamp(glance.SampledAtUtc)</div>
            }
            else
            {
                <div class="text-secondary small">No resource sample yet</div>
            }
        </div>
        <div class="hd-stat">
            <div class="label">Agent Check-in</div>
            <div class="value" style="font-size:1rem;">@d.LastSeenUtc.ToLocalTime().ToString("g")</div>
            <div class="text-secondary small">@IndexModel.FormatRelativeUtc(d.LastSeenUtc)</div>
            @{
                var agentVer = Model.ReportedAgentVersion;
                var simpleVer = VersionCompare.TryGetSimpleVersion(agentVer);
            }
            <div class="text-secondary small" title="@(agentVer ?? "")">
                @if (simpleVer is int sv)
                {
                    <span>Agent v@(sv)</span>
                    @if (!VersionCompare.IsPureIntegerVersion(agentVer))
                    {
                        <span> (legacy)</span>
                    }
                }
                else
                {
                    <span>Agent version unknown</span>
                }
            </div>
        </div>
        <div class="hd-stat">
            <div class="label">Last user</div>
            <div class="value" style="font-size:1rem;">@UsernameDisplay.FormatOrDash(d.LastUser)</div>
            @if (d.LastUserDepartedUtc is DateTimeOffset departed)
            {
                <div class="text-secondary small">@((d.LastSessionState == SessionState.Disconnected ? "Disconnected" : "Log off")) · @MachineModel.FormatLocalTimestamp(departed)</div>
            }
            else if (d.LastUserStillLoggedIn)
            {
                <div class="text-secondary small">Still logged in</div>
            }
            else if (!string.IsNullOrWhiteSpace(d.LastUser))
            {
                <div class="text-secondary small">Time unknown</div>
            }
        </div>
        <div class="hd-stat">
            <div class="label">365d utilisation</div>
            <div class="value">@Model.Utilisation365Pct.ToString("0")%</div>
            <div class="text-secondary small">
                @if (Model.TrackingBeganUtc is DateTimeOffset began)
                {
                    <span>Tracking began: @MachineModel.FormatTrackingBegan(began)</span>
                }
                else
                {
                    <span>Tracking began: —</span>
                }
            </div>
        </div>
    </div>

    <div class="hd-stats-duration mb-3" role="navigation" aria-label="Stats duration">
        <a class="hd-stats-duration-arrow"
           asp-page="/Machine"
           asp-route-Hostname="@d.Hostname"
           asp-route-Range="@Model.Range"
           asp-route-StatsDuration="@Model.PrevStatsDuration"
           title="Previous period"
           aria-label="Previous stats duration">‹</a>
        <span class="hd-stats-duration-label">Stats Duration: @Model.StatsDurationLabel</span>
        <a class="hd-stats-duration-arrow"
           asp-page="/Machine"
           asp-route-Hostname="@d.Hostname"
           asp-route-Range="@Model.Range"
           asp-route-StatsDuration="@Model.NextStatsDuration"
           title="Next period"
           aria-label="Next stats duration">›</a>
    </div>

    var ps = Model.PeriodStats;
    var sess = ps?.Sessions ?? d.Sessions;
    <div class="hd-grid mb-3">
        <a class="hd-stat hd-stat-dense hd-stat-link"
           href="@Url.Page("/Sessions", new { hosts = d.Hostname, statsDuration = Model.StatsDuration, hideSystem = "true" })"
           title="Open sessions for @d.Hostname · @Model.StatsDurationLabel">
            <div class="label">Sessions</div>
            <div class="value">@sess.TotalCount</div>
            <div class="hd-stat-lines text-secondary small mt-1">
                <div>Local @sess.LocalCount · Inbound RDP @sess.RdpCount</div>
                <div>Open now @sess.OpenCount</div>
            </div>
        </a>
        <div class="hd-stat hd-stat-dense">
            <div class="label">Top users</div>
            @if (ps is null || ps.TopUsers.Count == 0)
            {
                <div class="text-secondary small mt-2">No sessions in this period</div>
            }
            else
            {
                <ol class="hd-stat-rank mb-0">
                    @foreach (var row in ps.TopUsers)
                    {
                        <li>
                            <a class="hd-stat-rank-name" asp-page="/User" asp-route-username="@row.Label" asp-route-range="@Model.SessionsRangeKey" title="@row.Label">@TruncateName(row.Label, 18)</a>
                            <span class="hd-stat-rank-detail">@row.Detail</span>
                        </li>
                    }
                </ol>
            }
        </div>
        <div class="hd-stat hd-stat-dense">
            <div class="label">Top apps · CPU / GPU</div>
            @if (ps is null || ps.TopComputeApps.Count == 0)
            {
                <div class="text-secondary small mt-2">No CPU/GPU samples yet</div>
            }
            else
            {
                <ol class="hd-stat-rank mb-0">
                    @foreach (var row in ps.TopComputeApps)
                    {
                        <li>
                            <span class="hd-stat-rank-name" title="@row.Label">@TruncateName(row.Label, 16)</span>
                            <span class="hd-stat-rank-detail">@row.Detail</span>
                        </li>
                    }
                </ol>
            }
        </div>
        <div class="hd-stat hd-stat-dense">
            <div class="label">Top apps · Disk / Net</div>
            @if (ps is null || (ps.TopIoApps.Count == 0 && string.IsNullOrWhiteSpace(ps.NetworkSummary)))
            {
                <div class="text-secondary small mt-2">No disk/network samples yet</div>
            }
            else
            {
                if (ps.TopIoApps.Count > 0)
                {
                    <ol class="hd-stat-rank mb-0">
                        @foreach (var row in ps.TopIoApps)
                        {
                            <li>
                                <span class="hd-stat-rank-name" title="@row.Label">@TruncateName(row.Label, 16)</span>
                                <span class="hd-stat-rank-detail">@row.Detail</span>
                            </li>
                        }
                    </ol>
                }
                else
                {
                    <div class="text-secondary small mt-2">No per-app disk data</div>
                }
                if (!string.IsNullOrWhiteSpace(ps.NetworkSummary))
                {
                    <div class="hd-stat-lines text-secondary small mt-2">@ps.NetworkSummary</div>
                }
            }
        </div>
    </div>

    <div class="hd-panel mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <h2 class="hd-section-title mb-0">Storage</h2>
            @if (Model.DiskVolumesUtc is DateTimeOffset volUtc)
            {
                <span class="text-secondary small">Updated @MachineModel.FormatLocalTimestamp(volUtc)</span>
            }
        </div>
        @if (Model.DiskVolumes.Count == 0)
        {
            <p class="text-secondary small mb-0">
                No volume free-space data yet. After the next agent upload (with an updated agent), fixed local drives appear here.
            </p>
        }
        else
        {
            <div class="hd-disk-volumes">
                @foreach (var v in Model.DiskVolumes)
                {
                    var pct = v.UsedPct;
                    var tone = pct >= 85 ? "hd-disk-bar-crit" : pct >= 70 ? "hd-disk-bar-warn" : "hd-disk-bar-ok";
                    <div class="hd-disk-volume">
                        <div class="hd-disk-volume-head">
                            <strong>@v.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(v.Label))
                            {
                                <span class="text-secondary small">@v.Label</span>
                            }
                            <span class="hd-disk-volume-meta text-secondary small">
                                @v.FreeGb.ToString("0.#") GB free of @v.TotalGb.ToString("0.#") GB
                                · @pct.ToString("0")% used
                            </span>
                        </div>
                        <div class="hd-disk-bar" role="progressbar" aria-valuenow="@((int)pct)" aria-valuemin="0" aria-valuemax="100">
                            <div class="hd-disk-bar-fill @tone" style="width:@pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                    </div>
                }
            </div>
        }

        <hr class="my-3" />
        <h3 class="h6 mb-2">Disk usage scan</h3>
        <p class="text-secondary small mb-2">
            On-demand agent scan: largest folders under the drive root, plus files at or above the size threshold.
            Not gated on CPU/GPU idle — the agent picks this up on config refresh (or ~20s poll on current agents), then runs a throttled scan (≤ ~3 minutes).
            Requires agent v@(Heimdall.Api.Services.VersionCompare.MinDiskUsageScanVersion)+.
            @if (!Model.AgentSupportsDiskUsageScan)
            {
                <span class="text-warning">This machine reports agent v@(Model.ReportedAgentVersion ?? "unknown") — update it before requesting a scan.</span>
            }
            Leaving this page does not cancel a queued or running scan.
        </p>
        <div id="disk-usage-status"
             class="@(Model.PendingDiskUsageScan ? "" : "d-none")"
             data-pending="@(Model.PendingDiskUsageScan ? "1" : "0")"
             data-hostname="@Model.Hostname"
             data-requested-utc="@(Model.PendingDiskScanRequestedUtc?.ToString("o") ?? "")"
             data-max-seconds="@Model.PendingDiskScanMaxSeconds"
             aria-live="polite">
            <div class="hd-panel border-0 bg-transparent p-0 mb-2">
                <p class="small mb-1" id="disk-usage-requested-line">
                    @if (Model.PendingDiskScanRequestedUtc is { } reqUtc)
                    {
                        <text>Requested @MachineModel.FormatLocalTimestamp(reqUtc)</text>
                        @if (!string.IsNullOrWhiteSpace(Model.PendingDiskScanRoot))
                        {
                            <text> · @DiskUsageScanRoots.FormatForDisplay(Model.PendingDiskScanRoot)</text>
                        }
                    }
                    else if (Model.PendingDiskUsageScan)
                    {
                        <text>Scan queued@(string.IsNullOrWhiteSpace(Model.PendingDiskScanRoot) ? "" : $" for {DiskUsageScanRoots.FormatForDisplay(Model.PendingDiskScanRoot)}") — waiting for agent.</text>
                    }
                </p>
                <p class="small mb-1" id="disk-usage-elapsed-line"></p>
                <p class="small mb-0" id="disk-usage-progress-line">
                    @if (Model.DiskUsageProgress is { } prog)
                    {
                        <span class="text-warning">@prog.Status</span>
                        @if (!string.IsNullOrWhiteSpace(prog.Message))
                        {
                            <text> — @prog.Message</text>
                        }
                        @if (prog.FilesSeen > 0 || prog.BytesScanned > 0)
                        {
                            <text> · @prog.FilesSeen.ToString("N0") files · @MachineModel.FormatBytes(prog.BytesScanned)</text>
                        }
                    }
                    else if (Model.PendingDiskUsageScan)
                    {
                        <span class="text-warning">Queued</span><text> — waiting for agent pickup (not waiting for low CPU)</text>
                    }
                </p>
            </div>
        </div>
        <form method="post" asp-page-handler="RequestDiskUsageScan" class="row g-2 align-items-end mb-3">
            <input type="hidden" name="Hostname" value="@Model.Hostname" />
            <input type="hidden" name="Range" value="@Model.Range" />
            <input type="hidden" name="StatsDuration" value="@Model.StatsDuration" />
            <div class="col-auto">
                <label class="form-label small mb-0" for="disk-scan-root">Drive</label>
                <select class="form-select form-select-sm" id="disk-scan-root" name="DiskScanRoot" style="min-width:9rem">
                    @{
                        var allRootsValue = DiskUsageScanRoots.AllFixedDrives;
                        var volumeRoots = Model.DiskVolumes.Select(v => v.Name.TrimEnd('\\') + @"\").ToList();
                        var selectedRoot = Model.PendingDiskScanRoot
                            ?? Model.DiskScanRoot
                            ?? allRootsValue;
                        if (string.IsNullOrWhiteSpace(selectedRoot))
                            selectedRoot = allRootsValue;
                        var allSelected = DiskUsageScanRoots.IsAllFixedDrives(selectedRoot);
                    }
                    @if (allSelected)
                    {
                        <option value="@allRootsValue" selected>All fixed drives</option>
                    }
                    else
                    {
                        <option value="@allRootsValue">All fixed drives</option>
                    }
                    @foreach (var r in volumeRoots)
                    {
                        var sel = !allSelected && string.Equals(r, selectedRoot, StringComparison.OrdinalIgnoreCase);
                        if (sel)
                        {
                            <option value="@r" selected>@r</option>
                        }
                        else
                        {
                            <option value="@r">@r</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0" for="disk-scan-min-amount">Min file size</label>
                <div class="d-flex gap-1">
                    <input class="form-control form-control-sm" type="number" id="disk-scan-min-amount"
                           name="DiskScanMinSizeAmount"
                           value="@Model.DiskScanMinSizeAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           min="0.01" max="100000" step="any" style="width:6rem" />
                    <select class="form-select form-select-sm" id="disk-scan-min-unit" name="DiskScanMinSizeUnit" style="width:4.5rem">
                        @foreach (var u in DiskSizeUnits.All)
                        {
                            if (string.Equals(u, Model.DiskScanMinSizeUnit, StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@u" selected>@u</option>
                            }
                            else
                            {
                                <option value="@u">@u</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="hd-btn hd-btn-silver hd-btn-sm"
                        @(Model.PendingDiskUsageScan || !Model.AgentSupportsDiskUsageScan ? "disabled" : null)>
                    Scan disk usage
                </button>
            </div>
        </form>
        @if (Model.PendingDiskUsageScan)
        {
            <form method="post" asp-page-handler="CancelDiskUsageScan" class="mb-3">
                <input type="hidden" name="Hostname" value="@Model.Hostname" />
                <input type="hidden" name="Range" value="@Model.Range" />
                <button type="submit" class="btn btn-link btn-sm text-secondary p-0">Cancel queued scan</button>
            </form>
        }

        @if (Model.DiskUsageScan is { } scan)
        {
            <div class="small text-secondary mb-2">
                Last scan @MachineModel.FormatLocalTimestamp(Model.DiskUsageScanUtc ?? scan.CompletedUtc)
                · @DiskUsageScanRoots.FormatForDisplay(scan.RootPath)
                · @scan.ElapsedSeconds.ToString("0.#")s
                · @scan.FilesSeen.ToString("N0") files
                · @MachineModel.FormatBytes(scan.BytesScanned) seen
                @if (scan.Truncated)
                {
                    <span class="text-warning"> · truncated (time budget)</span>
                }
                @if (!string.IsNullOrWhiteSpace(scan.Error))
                {
                    <span class="text-danger"> · @scan.Error</span>
                }
            </div>

            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <ul class="nav nav-tabs hd-ops-tabs mb-0" id="disk-usage-view-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button type="button" class="nav-link active" id="disk-usage-tab-folders"
                                role="tab" aria-selected="true" aria-controls="disk-usage-view-folders"
                                data-disk-view="folders">Top folders</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button type="button" class="nav-link" id="disk-usage-tab-files"
                                role="tab" aria-selected="false" aria-controls="disk-usage-view-files"
                                data-disk-view="files">Large files (≥ threshold)</button>
                    </li>
                </ul>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="hd-btn hd-btn-silver hd-btn-sm" id="disk-usage-copy-all"
                            title="Copy all scan results with full paths">Copy all</button>
                    <button type="button" class="hd-btn hd-btn-silver hd-btn-sm" id="disk-usage-download-txt"
                            title="Download all scan results as a .txt with full paths"
                            data-filename="@MachineModel.FormatDiskUsageExportFileName(Model.Hostname, Model.DiskUsageScanUtc ?? scan.CompletedUtc)">Download .txt</button>
                </div>
            </div>
            <script type="application/json" id="disk-usage-export-text">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(MachineModel.FormatDiskUsageExportText(Model.Hostname, scan, Model.DiskUsageScanUtc)))</script>
            <div id="disk-usage-view-folders" class="hd-disk-usage-panel" role="tabpanel" aria-labelledby="disk-usage-tab-folders">
                @if (scan.TopFolders.Count == 0)
                {
                    <p class="text-secondary small mb-0">No folders reported.</p>
                }
                else
                {
                    <div class="hd-disk-usage-list small">
                        @foreach (var f in scan.TopFolders)
                        {
                            <div class="hd-disk-usage-row">
                                <span class="hd-disk-usage-size">@MachineModel.FormatBytes(f.SizeBytes)</span>
                                <span class="hd-disk-usage-path" title="@f.Path">@f.Path</span>
                            </div>
                        }
                    </div>
                }
            </div>
            <div id="disk-usage-view-files" class="hd-disk-usage-panel d-none" role="tabpanel" aria-labelledby="disk-usage-tab-files" hidden>
                @if (scan.LargeFiles.Count == 0)
                {
                    <p class="text-secondary small mb-0">None at or above the threshold.</p>
                }
                else
                {
                    <div class="hd-disk-usage-list small">
                        @foreach (var f in scan.LargeFiles)
                        {
                            <div class="hd-disk-usage-row">
                                <span class="hd-disk-usage-size">@MachineModel.FormatBytes(f.SizeBytes)</span>
                                <span class="hd-disk-usage-path" title="@f.Path">@f.Path</span>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (scan.Hotspots.Count > 0)
            {
                <h3 class="h6 mt-3 mb-2">Hotspots</h3>
                <div class="hd-disk-usage-list small">
                    @foreach (var h in scan.Hotspots.Where(x => x.Exists || x.SizeBytes > 0).OrderByDescending(x => x.SizeBytes))
                    {
                        <div class="hd-disk-usage-row">
                            <span class="hd-disk-usage-size">@MachineModel.FormatBytes(h.SizeBytes)</span>
                            <span class="hd-disk-usage-path" title="@h.Path">@h.Key — @h.Path</span>
                        </div>
                    }
                </div>
            }
        }
    </div>

    @if (Model.CanAccessFlood && Model.Tuflow is { FloodEnrolled: true } tuflow)
    {
        <div class="hd-panel mb-3">
            <h2 class="hd-section-title">TUFLOW</h2>

            @if (tuflow.Current is { } cur)
            {
                @if (!string.IsNullOrEmpty(cur.RunName))
                {
                    <p class="text-secondary small mb-2" style="font-size:1.05rem;font-weight:600;">@cur.RunName</p>
                }
                <div class="hd-grid mb-3">
                    <div class="hd-stat">
                        <div class="label">Status</div>
                        <div class="value" style="font-size:1.1rem;">
                            <span class="badge-pill @MachineModel.TuflowStateBadgeClass(cur.State)">@cur.State</span>
                        </div>
                    </div>
                    @if (cur.PercentComplete is double pct)
                    {
                        <div class="hd-stat">
                            <div class="label">Progress</div>
                            <div class="value">@pct.ToString("0.#")%</div>
                        </div>
                    }
                    @if (cur.SimulationTimeHours is double simT)
                    {
                        <div class="hd-stat">
                            <div class="label">Simulated time</div>
                            <div class="value" style="font-size:1rem;margin-top:0.35rem">
                                @simT.ToString("0.##")h@(cur.SimulationEndTimeHours is double simEnd ? $" / {simEnd.ToString("0.##")}h" : "")
                            </div>
                        </div>
                    }
                    @if (cur.ClockTimeRemainingHours is double remain)
                    {
                        <div class="hd-stat">
                            <div class="label">Est. remaining</div>
                            <div class="value" style="font-size:1rem;margin-top:0.35rem">@remain.ToString("0.#")h</div>
                        </div>
                    }
                    @if (cur.WarningCount is int warn)
                    {
                        <div class="hd-stat">
                            <div class="label">Warnings</div>
                            <div class="value">@warn</div>
                        </div>
                    }
                    @if (cur.MassErrorPercent is double mErr)
                    {
                        <div class="hd-stat">
                            <div class="label">Mass error</div>
                            <div class="value">@mErr.ToString("0.00")%</div>
                        </div>
                    }
                </div>
                <p class="text-secondary small mb-0">
                    @{
                        var curPrimary = !string.IsNullOrWhiteSpace(cur.CmdPath) ? cur.CmdPath : cur.TcfPath;
                        var curPrimaryName = string.IsNullOrWhiteSpace(curPrimary) ? null : System.IO.Path.GetFileName(curPrimary);
                    }
                    <span title="@curPrimary">@(curPrimaryName ?? "—")</span>
                    @if (!string.IsNullOrWhiteSpace(cur.CmdPath) && !string.IsNullOrWhiteSpace(cur.TcfPath)
                         && !string.Equals(cur.CmdPath, cur.TcfPath, StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="text-secondary small" title="@cur.TcfPath">tcf: @System.IO.Path.GetFileName(cur.TcfPath)</div>
                    }
                    @if (!string.IsNullOrEmpty(cur.LastCheckpointFile))
                    {
                        <div>Last checkpoint: @cur.LastCheckpointFile</div>
                    }
                    @{
                        var curFailDetail = !string.IsNullOrEmpty(cur.ErrorSummary) ? cur.ErrorSummary : cur.Message;
                    }
                    @if (!string.IsNullOrEmpty(curFailDetail) && (cur.State == TuflowRunStates.Failed || !string.IsNullOrEmpty(cur.ErrorSummary)))
                    {
                        <div style="color:#f0a0a0;">@curFailDetail</div>
                    }
                </p>
            }
            else
            {
                <p class="text-secondary mb-0">No TUFLOW run has been queued from Heimdall on this machine yet — see the TUFLOW Runs page.</p>
            }

            @if (tuflow.History.Count > 0)
            {
                <h3 class="hd-section-title mt-4" style="font-size:1rem;">Recent runs</h3>
                <div class="table-responsive">
                    <table class="hd-table mb-0 hd-sortable">
                        <thead>
                            <tr>
                                <th data-sort="text">Run</th>
                                <th data-sort="text">By</th>
                                <th data-sort="text">Requested</th>
                                <th data-sort="text">File</th>
                                <th data-sort="text">Outcome</th>
                                <th data-sort="text">Duration</th>
                                <th data-sort="text">Detail</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var run in tuflow.History)
                            {
                                <tr>
                                    <td>@run.RunName</td>
                                    <td class="text-secondary small">@UsernameDisplay.FormatOrDash(run.RequestedBy)</td>
                                    <td>@MachineModel.FormatLocalTimestamp(run.RequestedUtc)</td>
                                    <td class="text-secondary small" title="@run.DisplayFileFullPath">@run.DisplayFileName</td>
                                    <td><span class="badge-pill @MachineModel.TuflowStateBadgeClass(run.State)">@run.State</span></td>
                                    <td class="text-secondary small">@MachineModel.FormatDuration(run.StartedUtc, run.EndedUtc)</td>
                                    <td class="text-secondary small">
                                        @if (run.IsFailure && !string.IsNullOrEmpty(run.ErrorSummary))
                                        {
                                            <span style="color:#f0a0a0;" title="@run.ErrorSummary">
                                                @(run.ErrorSummary!.Length > 80 ? run.ErrorSummary[..80] + "…" : run.ErrorSummary)
                                            </span>
                                        }
                                        else if (run.PercentComplete is double p)
                                        {
                                            @($"{p:0.#}% complete")
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    @if (appLists is not null)
    {
        <div class="hd-panel mb-3">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                <h2 class="hd-section-title mb-0">App lists</h2>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <form method="post" asp-page-handler="RequestInventory" class="d-inline">
                        <input type="hidden" asp-for="Hostname" />
                        <input type="hidden" asp-for="Range" />
                        <input type="hidden" asp-for="StatsDuration" />
                        <button type="submit" class="hd-btn hd-btn-silver hd-btn-sm"
                                @(Model.PendingInventory ? "disabled" : null)
                                title="Ask the agent to upload all running processes (config ~5 min + upload ~1 min)">
                            Request full inventory
                        </button>
                    </form>
                    <a class="hd-btn hd-btn-black hd-btn-sm" asp-page="/AppLists" asp-route-host="@d.Hostname" asp-fragment="team-apps">Open Team apps</a>
                </div>
            </div>
            @if (Model.PendingInventory)
            {
                <p class="small mb-2" style="color:var(--hd-gold, var(--hd-accent));">
                    Inventory pending — waiting for agent config refresh, then next upload.
                </p>
            }
            else if (Model.InventoryCollectedUtc is DateTimeOffset invUtc)
            {
                <p class="text-secondary small mb-2">Last inventory @MachineModel.FormatLocalTimestamp(invUtc)</p>
            }
            @if (appLists.ActiveLists.Count == 0)
            {
                <p class="text-secondary small mb-3">No app lists apply to this machine yet. Assign one below or use <a asp-page="/AppLists" asp-route-host="@d.Hostname">Analyze apps</a>.</p>
            }
            else
            {
                <ul class="list-unstyled mb-3 hd-app-list-assignments">
                    @foreach (var a in appLists.ActiveLists)
                    {
                        <li class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <strong>@a.Name</strong>
                            <span class="badge-pill badge-ended">@a.Scope@(string.IsNullOrEmpty(a.ScopeValue) ? "" : $":{a.ScopeValue}")</span>
                            <span class="text-secondary small">@a.EntryCount apps</span>
                            @if (!string.IsNullOrEmpty(a.TeamName))
                            {
                                <span class="text-secondary small">· @a.TeamName</span>
                            }
                            @if (a.CanUnassign)
                            {
                                <form method="post" asp-page-handler="RemoveAppList" class="d-inline ms-auto">
                                    <input type="hidden" asp-for="Hostname" />
                                    <input type="hidden" asp-for="Range" />
                                    <input type="hidden" asp-for="StatsDuration" />
                                    <input type="hidden" name="RemoveAssignmentId" value="@a.AssignmentId" />
                                    <button type="submit" class="hd-btn hd-btn-silver hd-btn-sm" onclick="return confirm('Remove @a.Name from this machine?');">Remove</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-secondary small ms-auto">Inherited</span>
                            }
                        </li>
                    }
                </ul>
            }

            <form method="post" asp-page-handler="ApplyAppList" class="row g-2 align-items-end mb-3">
                <input type="hidden" asp-for="Hostname" />
                <input type="hidden" asp-for="Range" />
                <input type="hidden" asp-for="StatsDuration" />
                <div class="col-md-8 col-lg-6">
                    <label class="form-label" for="apply-applist">Apply app list to this machine</label>
                    <select class="form-select" asp-for="ApplyAppListId" id="apply-applist" required>
                        <option value="">— select list —</option>
                        @foreach (var l in Model.AppListPicker)
                        {
                            <option value="@l.Id">@l.Name (@l.EntryCount apps)</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="hd-btn hd-btn-gold">Apply</button>
                </div>
            </form>

            @if (appLists.MergedProcesses.Count > 0)
            {
                <details class="mt-2">
                    <summary class="form-label mb-0" style="cursor:pointer">Customize tracked apps for this machine</summary>
                    <p class="text-secondary small mt-2 mb-2">
                        Uncheck apps to stop tracking them on <strong>@d.Hostname</strong> only. Global and shared app lists are unchanged.
                    </p>
                    <form method="post" asp-page-handler="SaveTrackingOverrides">
                        <input type="hidden" asp-for="Hostname" />
                        <input type="hidden" asp-for="Range" />
                        <input type="hidden" asp-for="StatsDuration" />
                        <div class="hd-check-grid mb-2">
                            @foreach (var proc in appLists.MergedProcesses)
                            {
                                var isTracked = !excluded.Contains(proc);
                                <label class="badge-pill @(isTracked ? "badge-local" : "badge-ended")" style="cursor:pointer;">
                                    <input type="checkbox" name="TrackedProcesses" value="@proc" class="form-check-input me-1" @(isTracked ? "checked" : null) />
                                    @proc
                                </label>
                            }
                        </div>
                        <button type="submit" class="hd-btn hd-btn-silver hd-btn-sm">Save tracking overrides</button>
                    </form>
                </details>
            }
        </div>
    }

    <form method="get" class="hd-panel mb-3">
        <input type="hidden" name="hostname" value="@d.Hostname" />
        <input type="hidden" name="statsDuration" value="@Model.StatsDuration" />
        <div class="row g-3 align-items-end">
            <div class="col-md-4 col-lg-3">
                <label class="form-label" for="util-range">Applications table · time range</label>
                <select class="form-select" name="range" id="util-range">
                    @foreach (var opt in IndexModel.RangeOptions)
                    {
                        if (Model.Range == opt.Key)
                        {
                            <option value="@opt.Key" selected>@opt.Label</option>
                        }
                        else
                        {
                            <option value="@opt.Key">@opt.Label</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="hd-btn hd-btn-gold">Apply</button>
            </div>
        </div>
    </form>

    <div class="hd-panel">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <h2 class="hd-section-title mb-0">Applications</h2>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                @if (Model.AppTableRows.Count > 0)
                {
                    <button type="button" class="hd-btn hd-btn-silver hd-btn-sm" id="machine-apps-select-all" title="Check all rows">Select all</button>
                    <button type="button" class="hd-btn hd-btn-silver hd-btn-sm" id="machine-apps-deselect-all" title="Uncheck all rows">Deselect all</button>
                    <button type="button" class="hd-btn hd-btn-silver hd-btn-sm" id="machine-apps-expand-all" aria-pressed="false">Show full details</button>
                }
            </div>
        </div>
        <p class="text-secondary small mb-2">
            Default shows tracked apps. Use checkboxes to customize the view (Shift+click for a range, Ctrl+click to toggle without clearing).
            Lists column shows which app list(s) include each process. Changing checkboxes does not change agent tracking.
        </p>
        @if (Model.AppTableRows.Count == 0)
        {
            <p class="text-secondary mb-0">
                No tracked apps on this machine yet. Assign an app list above, or wait for process runs in this period.
            </p>
        }
        else
        {
            <div class="hd-machine-apps" id="machine-apps-grid">
                <div class="hd-machine-apps-head">
                    <div class="hd-machine-apps-th hd-machine-apps-th--check" title="Include in view">
                        <input type="checkbox" id="machine-apps-check-all" class="form-check-input" title="Select / deselect all" aria-label="Select all apps" />
                    </div>
                    <div class="hd-machine-apps-th" data-sort="text">Application</div>
                    <div class="hd-machine-apps-th" data-sort="text">Lists</div>
                    <div class="hd-machine-apps-th" data-sort="num" data-default-desc>Time open</div>
                    <div class="hd-machine-apps-th" data-sort="num">Avg # open</div>
                    <div class="hd-machine-apps-th" data-sort="num">Runs</div>
                    <div class="hd-machine-apps-th" data-sort="num">Users</div>
                    <div class="hd-machine-apps-th" data-sort="num">Share</div>
                    <div class="hd-machine-apps-th" data-sort="num" title="Peak GPU % from ProcessRun samples in this period (replaces Peak CPU).">Peak GPU</div>
                </div>
                @foreach (var a in Model.AppTableRows)
                {
                    var label = a.DisplayName;
                    var truncated = label.Length > 20;
                    var shortLabel2 = TruncateName(label);
                    var listsLabel = a.ListNames.Count == 0 ? "—" : string.Join(", ", a.ListNames);
                    var listsSort = a.ListNames.Count == 0 ? "" : string.Join("|", a.ListNames);
                    <div class="hd-machine-apps-row@(a.IsTracked ? "" : " d-none")"
                         data-process="@a.ProcessName"
                         data-tracked="@(a.IsTracked ? "1" : "0")">
                        <div class="hd-machine-apps-cell hd-machine-apps-cell--check">
                            <input type="checkbox"
                                   class="form-check-input machine-apps-row-check"
                                   value="@a.ProcessName"
                                   @(a.IsTracked ? "checked" : null)
                                   aria-label="Show @label" />
                        </div>
                        <div class="hd-machine-apps-cell hd-machine-apps-cell--app"
                             data-sort-value="@label"
                             data-full-name="@label"
                             data-process="@a.ProcessName"
                             data-path="@(a.ExecutablePath ?? "")"
                             data-truncated="@(truncated ? "true" : "false")">
                            <a asp-page="/Application" asp-route-process="@a.ProcessName" asp-route-range="@Model.Range" asp-route-hostname="@d.Hostname" class="hd-machine-apps-link" title="@(truncated ? label : null)">
                                <strong class="hd-machine-apps-name">@shortLabel2</strong>
                            </a>
                            @if (!string.Equals(a.DisplayName, a.ProcessName, StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="hd-machine-apps-meta text-secondary">@TruncateName(a.ProcessName)</span>
                            }
                            @if (!a.IsTracked)
                            {
                                <span class="hd-machine-apps-meta text-secondary" title="Not on this machine's track list">not tracked</span>
                            }
                            else if (!a.HasData)
                            {
                                <span class="hd-machine-apps-meta text-secondary" title="No process runs in the selected time range">no runs</span>
                            }
                            @if (truncated || !string.IsNullOrWhiteSpace(a.ExecutablePath))
                            {
                                <div class="hd-machine-apps-detail" hidden>
                                    @if (truncated)
                                    {
                                        <div class="hd-machine-apps-fullname">@label</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(a.ExecutablePath))
                                    {
                                        <div class="hd-machine-apps-path text-secondary">@a.ExecutablePath</div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="hd-machine-apps-cell" data-sort-value="@listsSort" title="@listsLabel">
                            <span class="hd-machine-apps-val hd-machine-apps-lists">@TruncateName(listsLabel, 28)</span>
                        </div>
                        <div class="hd-machine-apps-cell" data-sort-value="@(a.TotalOpenSeconds ?? -1)">
                            <span class="hd-machine-apps-val">@(a.TotalOpenSeconds is double open ? DurationDisplay.Render(open) : "—")</span>
                        </div>
                        <div class="hd-machine-apps-cell" data-sort-value="@(a.AvgConcurrentProcesses?.ToString("0.###") ?? "-1")">
                            <span class="hd-machine-apps-val">@(a.AvgConcurrentProcesses is double avg ? ConcurrentDisplay.Render(avg) : "—")</span>
                        </div>
                        <div class="hd-machine-apps-cell" data-sort-value="@(a.RunCount ?? -1)">
                            <span class="hd-machine-apps-val">@(a.RunCount?.ToString() ?? "—")</span>
                        </div>
                        <div class="hd-machine-apps-cell" data-sort-value="@(a.UniqueUsers ?? -1)">
                            <span class="hd-machine-apps-val">@(a.UniqueUsers?.ToString() ?? "—")</span>
                        </div>
                        <div class="hd-machine-apps-cell" data-sort-value="@a.SharePct">
                            <span class="hd-machine-apps-val">@(a.TotalOpenSeconds is null ? "—" : a.SharePct.ToString("0") + "%")</span>
                        </div>
                        <div class="hd-machine-apps-cell" data-sort-value="@(a.PeakGpuPercent ?? -1)">
                            <span class="hd-machine-apps-val">@StatsModel.FormatPct(a.PeakGpuPercent)</span>
                        </div>
                    </div>
                }
            </div>
            <p class="text-secondary small mb-0 mt-2" id="machine-apps-filter-status"></p>
        }
    </div>
}

@section Scripts {
<script>
(() => {
  const grid = document.getElementById('machine-apps-grid');
  if (grid) {
    const expandBtn = document.getElementById('machine-apps-expand-all');
    const selectAllBtn = document.getElementById('machine-apps-select-all');
    const deselectAllBtn = document.getElementById('machine-apps-deselect-all');
    const headerCheck = document.getElementById('machine-apps-check-all');
    const statusLine = document.getElementById('machine-apps-filter-status');
    const head = grid.querySelector('.hd-machine-apps-head');
    let lastCheckIndex = -1;

    const rowChecks = () => [...grid.querySelectorAll('.machine-apps-row-check')];
    const rows = () => [...grid.querySelectorAll('.hd-machine-apps-row')];

    const syncVisibility = () => {
      let shown = 0;
      rows().forEach((row) => {
        const cb = row.querySelector('.machine-apps-row-check');
        const on = !!(cb && cb.checked);
        row.classList.toggle('d-none', !on);
        if (on) shown++;
      });
      const total = rows().length;
      if (statusLine) {
        statusLine.textContent = shown === total
          ? `Showing all ${total} apps`
          : `Showing ${shown} of ${total} apps`;
      }
      if (headerCheck) {
        headerCheck.checked = shown === total && total > 0;
        headerCheck.indeterminate = shown > 0 && shown < total;
      }
    };

    const setAll = (on) => {
      rowChecks().forEach((cb) => { cb.checked = on; });
      lastCheckIndex = -1;
      syncVisibility();
    };

    const setExpanded = (on) => {
      grid.classList.toggle('hd-machine-apps--expanded', on);
      if (expandBtn) {
        expandBtn.textContent = on ? 'Hide full details' : 'Show full details';
        expandBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
      }
    };
    if (expandBtn) {
      expandBtn.addEventListener('click', () => setExpanded(!grid.classList.contains('hd-machine-apps--expanded')));
    }
    if (selectAllBtn) selectAllBtn.addEventListener('click', () => setAll(true));
    if (deselectAllBtn) deselectAllBtn.addEventListener('click', () => setAll(false));
    if (headerCheck) {
      headerCheck.addEventListener('change', () => setAll(headerCheck.checked));
    }

    rowChecks().forEach((cb, idx) => {
      cb.addEventListener('click', (e) => {
        const checks = rowChecks();
        const i = checks.indexOf(cb);
        if (e.shiftKey && lastCheckIndex >= 0 && lastCheckIndex !== i) {
          const from = Math.min(lastCheckIndex, i);
          const to = Math.max(lastCheckIndex, i);
          const state = cb.checked;
          for (let k = from; k <= to; k++) checks[k].checked = state;
        } else if (e.ctrlKey || e.metaKey) {
          // Native toggle already applied; leave other boxes alone.
        }
        lastCheckIndex = i >= 0 ? i : idx;
        syncVisibility();
      });
    });

    grid.querySelectorAll('.hd-machine-apps-cell--app[data-truncated="true"]').forEach(cell => {
      cell.addEventListener('click', (e) => {
        if (e.target.closest('a')) return;
        const detail = cell.querySelector('.hd-machine-apps-detail');
        if (!detail) return;
        const open = cell.classList.toggle('is-expanded');
        detail.hidden = !open;
      });
    });

    const headers = [...grid.querySelectorAll('.hd-machine-apps-th[data-sort]')];
    headers.forEach((th) => {
      th.style.cursor = 'pointer';
      th.addEventListener('click', () => {
        const type = th.dataset.sort;
        const colIdx = head ? [...head.children].indexOf(th) : -1;
        if (colIdx < 0) return;
        const list = rows();
        const asc = th.dataset.dir === 'desc';
        headers.forEach(h => { h.dataset.dir = ''; h.classList.remove('sorted-asc', 'sorted-desc'); });
        th.dataset.dir = asc ? 'asc' : 'desc';
        th.classList.add(asc ? 'sorted-asc' : 'sorted-desc');
        list.sort((ra, rb) => {
          const ca = ra.children[colIdx], cb = rb.children[colIdx];
          let va = ca?.dataset.sortValue ?? ca?.textContent ?? '';
          let vb = cb?.dataset.sortValue ?? cb?.textContent ?? '';
          if (type === 'num') {
            va = parseFloat(va); vb = parseFloat(vb);
            if (Number.isNaN(va)) va = -Infinity;
            if (Number.isNaN(vb)) vb = -Infinity;
            return asc ? va - vb : vb - va;
          }
          va = String(va).toLowerCase(); vb = String(vb).toLowerCase();
          return asc ? va.localeCompare(vb) : vb.localeCompare(va);
        });
        list.forEach(r => grid.appendChild(r));
      });
      if (th.dataset.defaultDesc !== undefined) th.click();
    });

    syncVisibility();
  }

  const diskViewTabs = document.getElementById('disk-usage-view-tabs');
  if (diskViewTabs) {
    const storeKey = 'hd-disk-usage-view';
    const panels = {
      folders: document.getElementById('disk-usage-view-folders'),
      files: document.getElementById('disk-usage-view-files')
    };
    const buttons = diskViewTabs.querySelectorAll('[data-disk-view]');
    const showView = (view) => {
      const key = view === 'files' ? 'files' : 'folders';
      Object.entries(panels).forEach(([name, el]) => {
        if (!el) return;
        const on = name === key;
        el.classList.toggle('d-none', !on);
        el.hidden = !on;
      });
      buttons.forEach(btn => {
        const on = btn.getAttribute('data-disk-view') === key;
        btn.classList.toggle('active', on);
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      try { sessionStorage.setItem(storeKey, key); } catch (_) { /* ignore */ }
    };
    buttons.forEach(btn => {
      btn.addEventListener('click', () => showView(btn.getAttribute('data-disk-view')));
    });
    let initial = 'folders';
    try {
      const stored = sessionStorage.getItem(storeKey);
      if (stored === 'files' || stored === 'folders') initial = stored;
    } catch (_) { /* ignore */ }
    showView(initial);
  }

  const diskExportEl = document.getElementById('disk-usage-export-text');
  const diskCopyBtn = document.getElementById('disk-usage-copy-all');
  const diskDlBtn = document.getElementById('disk-usage-download-txt');
  const getDiskExportText = () => {
    if (!diskExportEl) return '';
    try { return JSON.parse(diskExportEl.textContent || '""'); }
    catch (_) { return diskExportEl.textContent || ''; }
  };
  if (diskCopyBtn && diskExportEl) {
    diskCopyBtn.addEventListener('click', async () => {
      const text = getDiskExportText();
      if (!text) return;
      const label = diskCopyBtn.textContent;
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(text);
        } else {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
        }
        diskCopyBtn.textContent = 'Copied';
        setTimeout(() => { diskCopyBtn.textContent = label; }, 1500);
      } catch (_) {
        diskCopyBtn.textContent = 'Copy failed';
        setTimeout(() => { diskCopyBtn.textContent = label; }, 2000);
      }
    });
  }
  if (diskDlBtn && diskExportEl) {
    diskDlBtn.addEventListener('click', () => {
      const text = getDiskExportText();
      if (!text) return;
      const name = diskDlBtn.getAttribute('data-filename') || 'heimdall-disk-usage.txt';
      const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = name;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    });
  }

  const statusEl = document.getElementById('disk-usage-status');
  if (statusEl && statusEl.dataset.pending === '1') {
    const hostname = statusEl.dataset.hostname || '';
    const elapsedLine = document.getElementById('disk-usage-elapsed-line');
    const progressLine = document.getElementById('disk-usage-progress-line');
    const requestedLine = document.getElementById('disk-usage-requested-line');
    let requestedMs = Date.parse(statusEl.dataset.requestedUtc || '');
    let maxSeconds = parseInt(statusEl.dataset.maxSeconds || '180', 10) || 180;
    let stopped = false;

    const fmtBytes = (n) => {
      if (n == null || n < 1024) return (n || 0) + ' B';
      let v = n, u = ['KB', 'MB', 'GB', 'TB'], i = -1;
      do { v /= 1024; i++; } while (v >= 1024 && i < u.length - 1);
      return v.toFixed(2).replace(/\.?0+$/, '') + ' ' + u[i];
    };
    const fmtElapsed = (sec) => {
      sec = Math.max(0, Math.floor(sec));
      const m = Math.floor(sec / 60), s = sec % 60;
      return m > 0 ? `${m}m ${s}s` : `${s}s`;
    };
    const tickElapsed = () => {
      if (!elapsedLine || !Number.isFinite(requestedMs)) return;
      const elapsed = (Date.now() - requestedMs) / 1000;
      const budget = maxSeconds + 30;
      const remain = Math.max(0, budget - elapsed);
      elapsedLine.textContent = Number.isFinite(requestedMs)
        ? `Elapsed ${fmtElapsed(elapsed)} · rough remaining ≤ ${fmtElapsed(remain)} (pickup + scan budget)`
        : '';
    };

    const renderProgress = (p) => {
      if (!progressLine || !p) return;
      let html = `<span class="text-warning">${p.status || 'Queued'}</span>`;
      if (p.message) html += ` — ${p.message}`;
      if ((p.filesSeen | 0) > 0 || (p.bytesScanned | 0) > 0) {
        html += ` · ${Number(p.filesSeen || 0).toLocaleString()} files · ${fmtBytes(p.bytesScanned || 0)}`;
      }
      if (typeof p.elapsedSeconds === 'number' && p.elapsedSeconds > 0) {
        html += ` · agent ${fmtElapsed(p.elapsedSeconds)}`;
      }
      progressLine.innerHTML = html;
    };

    const poll = async () => {
      if (stopped || !hostname) return;
      try {
        const url = new URL(window.location.href);
        url.searchParams.set('handler', 'DiskUsageStatus');
        url.searchParams.set('Hostname', hostname);
        const res = await fetch(url.toString(), { credentials: 'same-origin', headers: { 'Accept': 'application/json' } });
        if (!res.ok) return;
        const data = await res.json();
        if (!data.ok) return;
        if (data.requestedUtc) {
          const ms = Date.parse(data.requestedUtc);
          if (Number.isFinite(ms)) {
            requestedMs = ms;
            statusEl.dataset.requestedUtc = data.requestedUtc;
            if (requestedLine && data.rootPath) {
              const when = new Date(ms).toLocaleString();
              requestedLine.textContent = `Requested ${when} · ${data.rootPath}`;
            }
          }
        }
        if (data.maxSeconds) maxSeconds = data.maxSeconds;
        if (data.progress) renderProgress(data.progress);
        tickElapsed();
        if (data.complete || data.pending === false) {
          stopped = true;
          if (progressLine) {
            progressLine.innerHTML = '<span class="text-success">Ready</span> — refreshing…';
          }
          window.location.reload();
        }
      } catch (_) { /* next tick */ }
    };

    tickElapsed();
    setInterval(tickElapsed, 1000);
    poll();
    setInterval(poll, 3000);
  }
})();
</script>
}
