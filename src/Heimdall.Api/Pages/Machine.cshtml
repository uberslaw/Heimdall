@page
@model MachineModel
@using Heimdall.Api.Services
@using Heimdall.Shared.Contracts
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Hostname) ? "Machine" : Model.Hostname;
    var d = Model.Detail;
    var shortLabel = Model.RangeDays == 1 ? "1d" : $"{Model.RangeDays}d";
    var appTotal = d?.Apps.Sum(a => a.TotalOpenSeconds) ?? 0;
    var appLists = Model.AppListsView;
    var excluded = Model.MachineExcludedProcesses.ToHashSet(StringComparer.OrdinalIgnoreCase);

    static string TruncateName(string name, int max = 20) =>
        name.Length <= max ? name : name[..max] + "…";
}

<p class="hd-meta-line mb-2">
    <a asp-page="/Index" asp-route-range="@Model.Range">← Computers</a>
    @if (d is not null)
    {
        <span> · </span>
        <a asp-page="/Stats" asp-route-ScopeKind="Machine" asp-route-ScopeValue="@d.Hostname" asp-route-Days="@Model.RangeDays">Open in Stats</a>
        <span> · </span>
        <a asp-page="/Socratize" asp-route-Host="@d.Hostname">Socratize</a>
        <span> · </span>
        <a asp-page="/AppLists" asp-route-host="@d.Hostname">Analyze apps</a>
    }
</p>

@if (TempData["Message"] is string toastMsg)
{
    <div class="hd-toast hd-toast-success mb-3" role="status">@toastMsg</div>
}
@if (TempData["Error"] is string toastErr)
{
    <div class="hd-toast hd-toast-error mb-3" role="alert">@toastErr</div>
}

@if (string.IsNullOrWhiteSpace(Model.Hostname))
{
    <div class="hd-panel">
        <p class="text-secondary mb-0">No hostname specified. Pick a computer from the <a asp-page="/Index">Computers</a> list.</p>
    </div>
}
else if (Model.HostNotFound)
{
    <div class="hd-panel">
        <p class="mb-0" style="color:#f0a0a0;">No machine named <strong>@Model.Hostname</strong> in the database yet.</p>
    </div>
}
else if (d is not null)
{
    <h1 class="hd-title">@d.Hostname</h1>
    <p class="hd-sub">@Model.RangeLabel utilisation · apps used on this machine</p>

    <div class="hd-grid mb-3">
        <div class="hd-stat">
            <div class="label d-flex align-items-center justify-content-between gap-2">
                <span>Friendly name</span>
                @if (!Model.EditFriendly)
                {
                    <a class="hd-btn hd-btn-silver hd-btn-sm py-0 px-2" style="font-size:0.7rem;line-height:1.4"
                       asp-page="/Machine" asp-route-Hostname="@d.Hostname" asp-route-Range="@Model.Range" asp-route-EditFriendly="true">Edit</a>
                }
            </div>
            @if (Model.EditFriendly)
            {
                <form method="post" asp-page-handler="SaveFriendlyName" class="mt-1">
                    <input type="hidden" name="Hostname" value="@Model.Hostname" />
                    <input type="hidden" name="Range" value="@Model.Range" />
                    <div class="d-flex flex-wrap gap-1 align-items-center">
                        <input class="form-control form-control-sm" name="FriendlyNameInput" value="@Model.FriendlyNameInput"
                               maxlength="80" placeholder="e.g. Revit workstation" style="min-width:10rem;max-width:14rem" />
                        <button type="submit" class="hd-btn hd-btn-silver hd-btn-sm">Save</button>
                        <a class="small" asp-page="/Machine" asp-route-Hostname="@d.Hostname" asp-route-Range="@Model.Range">Cancel</a>
                    </div>
                </form>
            }
            else
            {
                <div class="value" style="font-size:1.1rem;">@(string.IsNullOrWhiteSpace(Model.FriendlyName) ? "—" : Model.FriendlyName)</div>
            }
            <div class="text-secondary small mt-1">@(string.IsNullOrWhiteSpace(Model.LastIp) ? "No IP yet" : Model.LastIp)</div>
            <form method="post" asp-page-handler="SaveTeam" class="mt-2">
                <input type="hidden" name="Hostname" value="@Model.Hostname" />
                <input type="hidden" name="Range" value="@Model.Range" />
                <label class="form-label small text-secondary mb-0" for="machine-team">Team</label>
                <select class="form-select form-select-sm" id="machine-team" name="SelectedTeamId"
                        style="max-width:14rem" onchange="this.form.submit()"
                        title="Same teams as Admin → Teams">
                    <option value="0">— No team —</option>
                    @foreach (var t in Model.TeamOptions)
                    {
                        if (t.Id == Model.SelectedTeamId)
                        {
                            <option value="@t.Id" selected>@t.Label</option>
                        }
                        else
                        {
                            <option value="@t.Id">@t.Label</option>
                        }
                    }
                </select>
            </form>
        </div>
        <div class="hd-stat">
            <div class="label">Status</div>
            <div class="value" style="font-size:1.1rem;">
                @if (d.IsInUse)
                {
                    <span class="badge-pill badge-active">In use</span>
                }
                else if (d.IsOnline)
                {
                    <span class="badge-pill badge-ended">Idle</span>
                }
                else
                {
                    <span class="badge-pill badge-ended">Offline</span>
                }
            </div>
            @if (Model.ResourceGlance is { } glance)
            {
                <div class="hd-resource-glance text-secondary small mt-1 font-monospace"
                     title="Latest agent sample @MachineModel.FormatLocalTimestamp(glance.SampledAtUtc) (@glance.Source). Disk/network bands are POC MB/s thresholds, not industry standards.">
                    <span>CPU @MachineModel.FormatGlancePct(glance.CpuPercent)</span>
                    <span>GPU @MachineModel.FormatGlancePct(glance.GpuPercent)</span>
                    <span>Disk @glance.DiskLevel</span>
                    <span>Network @glance.NetworkLevel</span>
                </div>
            }
            else
            {
                <div class="text-secondary small mt-1">No resource sample yet</div>
            }
        </div>
        <div class="hd-stat">
            <div class="label">Last check-in</div>
            <div class="value" style="font-size:1rem;margin-top:0.35rem">
                @d.LastSeenUtc.ToLocalTime().ToString("g")
                <br/><span class="text-secondary small">@IndexModel.FormatRelativeUtc(d.LastSeenUtc)</span>
            </div>
        </div>
        <div class="hd-stat">
            <div class="label">Last user</div>
            <div class="value" style="font-size:1rem;margin-top:0.35rem">
                @UsernameDisplay.FormatOrDash(d.LastUser)
                @if (d.LastUserDepartedUtc is DateTimeOffset departed)
                {
                    <div class="text-secondary small">@((d.LastSessionState == SessionState.Disconnected ? "Disconnected" : "Log off")) · @MachineModel.FormatLocalTimestamp(departed)</div>
                }
                else if (d.LastUserStillLoggedIn)
                {
                    <div class="text-secondary small">Still logged in</div>
                }
                else if (!string.IsNullOrWhiteSpace(d.LastUser))
                {
                    <div class="text-secondary small">Time unknown</div>
                }
            </div>
        </div>
        <div class="hd-stat">
            <div class="label">@shortLabel utilisation</div>
            <div class="value">@d.UtilisationPct.ToString("0")%</div>
        </div>
    </div>

    <div class="hd-panel mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <h2 class="hd-section-title mb-0">Storage</h2>
            @if (Model.DiskVolumesUtc is DateTimeOffset volUtc)
            {
                <span class="text-secondary small">Updated @MachineModel.FormatLocalTimestamp(volUtc)</span>
            }
        </div>
        @if (Model.DiskVolumes.Count == 0)
        {
            <p class="text-secondary small mb-0">
                No volume free-space data yet. After the next agent upload (with an updated agent), fixed local drives appear here.
            </p>
        }
        else
        {
            <div class="hd-disk-volumes">
                @foreach (var v in Model.DiskVolumes)
                {
                    var pct = v.UsedPct;
                    var tone = pct >= 90 ? "hd-disk-bar-crit" : pct >= 80 ? "hd-disk-bar-warn" : "hd-disk-bar-ok";
                    <div class="hd-disk-volume">
                        <div class="hd-disk-volume-head">
                            <strong>@v.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(v.Label))
                            {
                                <span class="text-secondary small">@v.Label</span>
                            }
                            <span class="hd-disk-volume-meta text-secondary small">
                                @v.FreeGb.ToString("0.#") GB free of @v.TotalGb.ToString("0.#") GB
                                · @pct.ToString("0")% used
                            </span>
                        </div>
                        <div class="hd-disk-bar" role="progressbar" aria-valuenow="@((int)pct)" aria-valuemin="0" aria-valuemax="100">
                            <div class="hd-disk-bar-fill @tone" style="width:@pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                    </div>
                }
            </div>
        }

        <hr class="my-3" />
        <h3 class="h6 mb-2">Disk usage scan</h3>
        <p class="text-secondary small mb-2">
            On-demand agent scan: largest folders under the drive root, plus files at or above the size threshold.
            Requires an updated agent. Pickup is usually within ~20s; scan itself is throttled (≤ ~3 minutes).
            Leaving this page does not cancel a queued or running scan.
        </p>
        <div id="disk-usage-status"
             class="@(Model.PendingDiskUsageScan ? "" : "d-none")"
             data-pending="@(Model.PendingDiskUsageScan ? "1" : "0")"
             data-hostname="@Model.Hostname"
             data-requested-utc="@(Model.PendingDiskScanRequestedUtc?.ToString("o") ?? "")"
             data-max-seconds="@Model.PendingDiskScanMaxSeconds"
             aria-live="polite">
            <div class="hd-panel border-0 bg-transparent p-0 mb-2">
                <p class="small mb-1" id="disk-usage-requested-line">
                    @if (Model.PendingDiskScanRequestedUtc is { } reqUtc)
                    {
                        <text>Requested @MachineModel.FormatLocalTimestamp(reqUtc)</text>
                        @if (!string.IsNullOrWhiteSpace(Model.PendingDiskScanRoot))
                        {
                            <text> · @Model.PendingDiskScanRoot</text>
                        }
                    }
                    else if (Model.PendingDiskUsageScan)
                    {
                        <text>Scan queued@(string.IsNullOrWhiteSpace(Model.PendingDiskScanRoot) ? "" : $" for {Model.PendingDiskScanRoot}") — waiting for agent.</text>
                    }
                </p>
                <p class="small mb-1" id="disk-usage-elapsed-line"></p>
                <p class="small mb-0" id="disk-usage-progress-line">
                    @if (Model.DiskUsageProgress is { } prog)
                    {
                        <span class="text-warning">@prog.Status</span>
                        @if (!string.IsNullOrWhiteSpace(prog.Message))
                        {
                            <text> — @prog.Message</text>
                        }
                        @if (prog.FilesSeen > 0 || prog.BytesScanned > 0)
                        {
                            <text> · @prog.FilesSeen.ToString("N0") files · @MachineModel.FormatBytes(prog.BytesScanned)</text>
                        }
                    }
                    else if (Model.PendingDiskUsageScan)
                    {
                        <span class="text-warning">Queued</span><text> - waiting for agent (usually within about 20s)</text>
                    }
                </p>
            </div>
        </div>
        <form method="post" asp-page-handler="RequestDiskUsageScan" class="row g-2 align-items-end mb-3">
            <input type="hidden" name="Hostname" value="@Model.Hostname" />
            <input type="hidden" name="Range" value="@Model.Range" />
            <div class="col-auto">
                <label class="form-label small mb-0" for="disk-scan-root">Drive</label>
                <select class="form-select form-select-sm" id="disk-scan-root" name="DiskScanRoot" style="min-width:6rem">
                    @{
                        var roots = Model.DiskVolumes.Select(v => v.Name.TrimEnd('\\') + @"\").ToList();
                        if (roots.Count == 0) { roots.Add(@"C:\"); }
                        var selectedRoot = Model.PendingDiskScanRoot ?? roots[0];
                    }
                    @foreach (var r in roots)
                    {
                        if (string.Equals(r, selectedRoot, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@r" selected>@r</option>
                        }
                        else
                        {
                            <option value="@r">@r</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0" for="disk-scan-min">Min file size (MB)</label>
                <input class="form-control form-control-sm" type="number" id="disk-scan-min" name="DiskScanMinFileMb"
                       value="@Model.DiskScanMinFileMb" min="10" max="10240" step="10" style="width:7rem" />
            </div>
            <div class="col-auto">
                <button type="submit" class="hd-btn hd-btn-silver hd-btn-sm" @(Model.PendingDiskUsageScan ? "disabled" : null)>
                    Scan disk usage
                </button>
            </div>
        </form>

        @if (Model.DiskUsageScan is { } scan)
        {
            <div class="small text-secondary mb-2">
                Last scan @MachineModel.FormatLocalTimestamp(Model.DiskUsageScanUtc ?? scan.CompletedUtc)
                · @scan.RootPath
                · @scan.ElapsedSeconds.ToString("0.#")s
                · @scan.FilesSeen.ToString("N0") files
                · @MachineModel.FormatBytes(scan.BytesScanned) seen
                @if (scan.Truncated)
                {
                    <span class="text-warning"> · truncated (time budget)</span>
                }
                @if (!string.IsNullOrWhiteSpace(scan.Error))
                {
                    <span class="text-danger"> · @scan.Error</span>
                }
            </div>

            <div class="row g-3">
                <div class="col-lg-6">
                    <h4 class="h6">Top folders</h4>
                    @if (scan.TopFolders.Count == 0)
                    {
                        <p class="text-secondary small mb-0">No folders reported.</p>
                    }
                    else
                    {
                        <pre class="hd-disk-usage-tree small mb-0">@foreach (var f in scan.TopFolders)
{<text>@MachineModel.FormatBytes(f.SizeBytes).PadLeft(10)  @f.Path
</text>}</pre>
                    }
                </div>
                <div class="col-lg-6">
                    <h4 class="h6">Large files (≥ threshold)</h4>
                    @if (scan.LargeFiles.Count == 0)
                    {
                        <p class="text-secondary small mb-0">None at or above the threshold.</p>
                    }
                    else
                    {
                        <pre class="hd-disk-usage-tree small mb-0">@foreach (var f in scan.LargeFiles)
{<text>@MachineModel.FormatBytes(f.SizeBytes).PadLeft(10)  @f.Path
</text>}</pre>
                    }
                </div>
            </div>
        }
    </div>

    @if (Model.CanAccessFlood && Model.Tuflow is { FloodEnrolled: true } tuflow)
    {
        <div class="hd-panel mb-3">
            <h2 class="hd-section-title">TUFLOW</h2>

            @if (tuflow.Current is { } cur)
            {
                @if (!string.IsNullOrEmpty(cur.RunName))
                {
                    <p class="text-secondary small mb-2" style="font-size:1.05rem;font-weight:600;">@cur.RunName</p>
                }
                <div class="hd-grid mb-3">
                    <div class="hd-stat">
                        <div class="label">Status</div>
                        <div class="value" style="font-size:1.1rem;">
                            <span class="badge-pill @MachineModel.TuflowStateBadgeClass(cur.State)">@cur.State</span>
                        </div>
                    </div>
                    @if (cur.PercentComplete is double pct)
                    {
                        <div class="hd-stat">
                            <div class="label">Progress</div>
                            <div class="value">@pct.ToString("0.#")%</div>
                        </div>
                    }
                    @if (cur.SimulationTimeHours is double simT)
                    {
                        <div class="hd-stat">
                            <div class="label">Simulated time</div>
                            <div class="value" style="font-size:1rem;margin-top:0.35rem">
                                @simT.ToString("0.##")h@(cur.SimulationEndTimeHours is double simEnd ? $" / {simEnd.ToString("0.##")}h" : "")
                            </div>
                        </div>
                    }
                    @if (cur.ClockTimeRemainingHours is double remain)
                    {
                        <div class="hd-stat">
                            <div class="label">Est. remaining</div>
                            <div class="value" style="font-size:1rem;margin-top:0.35rem">@remain.ToString("0.#")h</div>
                        </div>
                    }
                    @if (cur.WarningCount is int warn)
                    {
                        <div class="hd-stat">
                            <div class="label">Warnings</div>
                            <div class="value">@warn</div>
                        </div>
                    }
                    @if (cur.MassErrorPercent is double mErr)
                    {
                        <div class="hd-stat">
                            <div class="label">Mass error</div>
                            <div class="value">@mErr.ToString("0.00")%</div>
                        </div>
                    }
                </div>
                <p class="text-secondary small mb-0">
                    <span title="@cur.TcfPath">@System.IO.Path.GetFileName(cur.TcfPath)</span>
                    @if (!string.IsNullOrEmpty(cur.LastCheckpointFile))
                    {
                        <div>Last checkpoint: @cur.LastCheckpointFile</div>
                    }
                    @if (!string.IsNullOrEmpty(cur.ErrorSummary))
                    {
                        <div style="color:#f0a0a0;">@cur.ErrorSummary</div>
                    }
                </p>
            }
            else
            {
                <p class="text-secondary mb-0">No TUFLOW run has been queued from Heimdall on this machine yet — see the TUFLOW Runs page.</p>
            }

            @if (tuflow.History.Count > 0)
            {
                <h3 class="hd-section-title mt-4" style="font-size:1rem;">Recent runs</h3>
                <div class="table-responsive">
                    <table class="hd-table mb-0 hd-sortable">
                        <thead>
                            <tr>
                                <th data-sort="text">Run</th>
                                <th data-sort="text">By</th>
                                <th data-sort="text">Requested</th>
                                <th data-sort="text">.tcf</th>
                                <th data-sort="text">Outcome</th>
                                <th data-sort="text">Duration</th>
                                <th data-sort="text">Detail</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var run in tuflow.History)
                            {
                                <tr>
                                    <td>@run.RunName</td>
                                    <td class="text-secondary small">@UsernameDisplay.FormatOrDash(run.RequestedBy)</td>
                                    <td>@MachineModel.FormatLocalTimestamp(run.RequestedUtc)</td>
                                    <td class="text-secondary small" title="@run.TcfPath">@System.IO.Path.GetFileName(run.TcfPath)</td>
                                    <td><span class="badge-pill @MachineModel.TuflowStateBadgeClass(run.State)">@run.State</span></td>
                                    <td class="text-secondary small">@MachineModel.FormatDuration(run.StartedUtc, run.EndedUtc)</td>
                                    <td class="text-secondary small">
                                        @if (run.IsFailure && !string.IsNullOrEmpty(run.ErrorSummary))
                                        {
                                            <span style="color:#f0a0a0;" title="@run.ErrorSummary">
                                                @(run.ErrorSummary!.Length > 80 ? run.ErrorSummary[..80] + "…" : run.ErrorSummary)
                                            </span>
                                        }
                                        else if (run.PercentComplete is double p)
                                        {
                                            @($"{p:0.#}% complete")
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    @if (appLists is not null)
    {
        <div class="hd-panel mb-3">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                <h2 class="hd-section-title mb-0">App lists</h2>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <form method="post" asp-page-handler="RequestInventory" class="d-inline">
                        <input type="hidden" asp-for="Hostname" />
                        <input type="hidden" asp-for="Range" />
                        <button type="submit" class="hd-btn hd-btn-silver hd-btn-sm"
                                @(Model.PendingInventory ? "disabled" : null)
                                title="Ask the agent to upload all running processes (config ~5 min + upload ~1 min)">
                            Request full inventory
                        </button>
                    </form>
                    <a class="hd-btn hd-btn-black hd-btn-sm" asp-page="/AppLists" asp-route-host="@d.Hostname" asp-fragment="team-apps">Open Team apps</a>
                </div>
            </div>
            @if (Model.PendingInventory)
            {
                <p class="small mb-2" style="color:var(--hd-gold, var(--hd-accent));">
                    Inventory pending — waiting for agent config refresh, then next upload.
                </p>
            }
            else if (Model.InventoryCollectedUtc is DateTimeOffset invUtc)
            {
                <p class="text-secondary small mb-2">Last inventory @MachineModel.FormatLocalTimestamp(invUtc)</p>
            }
            @if (appLists.ActiveLists.Count == 0)
            {
                <p class="text-secondary small mb-3">No app lists apply to this machine yet. Assign one below or use <a asp-page="/AppLists" asp-route-host="@d.Hostname">Analyze apps</a>.</p>
            }
            else
            {
                <ul class="list-unstyled mb-3 hd-app-list-assignments">
                    @foreach (var a in appLists.ActiveLists)
                    {
                        <li class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <strong>@a.Name</strong>
                            <span class="badge-pill badge-ended">@a.Scope@(string.IsNullOrEmpty(a.ScopeValue) ? "" : $":{a.ScopeValue}")</span>
                            <span class="text-secondary small">@a.EntryCount apps</span>
                            @if (!string.IsNullOrEmpty(a.TeamName))
                            {
                                <span class="text-secondary small">· @a.TeamName</span>
                            }
                            @if (a.CanUnassign)
                            {
                                <form method="post" asp-page-handler="RemoveAppList" class="d-inline ms-auto">
                                    <input type="hidden" asp-for="Hostname" />
                                    <input type="hidden" asp-for="Range" />
                                    <input type="hidden" name="RemoveAssignmentId" value="@a.AssignmentId" />
                                    <button type="submit" class="btn btn-ghost btn-sm" onclick="return confirm('Remove @a.Name from this machine?');">Remove</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-secondary small ms-auto">Inherited</span>
                            }
                        </li>
                    }
                </ul>
            }

            <form method="post" asp-page-handler="ApplyAppList" class="row g-2 align-items-end mb-3">
                <input type="hidden" asp-for="Hostname" />
                <input type="hidden" asp-for="Range" />
                <div class="col-md-8 col-lg-6">
                    <label class="form-label" for="apply-applist">Apply app list to this machine</label>
                    <select class="form-select" asp-for="ApplyAppListId" id="apply-applist" required>
                        <option value="">— select list —</option>
                        @foreach (var l in Model.AppListPicker)
                        {
                            <option value="@l.Id">@l.Name (@l.EntryCount apps)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 col-lg-2">
                    <button type="submit" class="btn btn-hd w-100">Apply</button>
                </div>
            </form>

            @if (appLists.MergedProcesses.Count > 0)
            {
                <details class="mt-2">
                    <summary class="form-label mb-0" style="cursor:pointer">Customize tracked apps for this machine</summary>
                    <p class="text-secondary small mt-2 mb-2">
                        Uncheck apps to stop tracking them on <strong>@d.Hostname</strong> only. Global and shared app lists are unchanged.
                    </p>
                    <form method="post" asp-page-handler="SaveTrackingOverrides">
                        <input type="hidden" asp-for="Hostname" />
                        <input type="hidden" asp-for="Range" />
                        <div class="hd-check-grid mb-2">
                            @foreach (var proc in appLists.MergedProcesses)
                            {
                                var isTracked = !excluded.Contains(proc);
                                <label class="badge-pill @(isTracked ? "badge-local" : "badge-ended")" style="cursor:pointer;">
                                    <input type="checkbox" name="TrackedProcesses" value="@proc" class="form-check-input me-1" @(isTracked ? "checked" : null) />
                                    @proc
                                </label>
                            }
                        </div>
                        <button type="submit" class="btn btn-ghost btn-sm">Save tracking overrides</button>
                    </form>
                </details>
            }
        </div>
    }

    <div class="hd-grid mb-3">
        <div class="hd-stat">
            <div class="label">Sessions (@shortLabel)</div>
            <div class="value">@d.Sessions.TotalCount</div>
        </div>
        <div class="hd-stat">
            <div class="label">Local</div>
            <div class="value">@d.Sessions.LocalCount</div>
        </div>
        <div class="hd-stat">
            <div class="label">Inbound RDP</div>
            <div class="value">@d.Sessions.RdpCount</div>
        </div>
        <div class="hd-stat">
            <div class="label">Open now</div>
            <div class="value">@d.Sessions.OpenCount</div>
        </div>
    </div>

    <form method="get" class="hd-panel mb-3">
        <input type="hidden" name="hostname" value="@d.Hostname" />
        <div class="row g-3 align-items-end">
            <div class="col-md-4 col-lg-3">
                <label class="form-label" for="util-range">Tracking Time Range</label>
                <select class="form-select" name="range" id="util-range">
                    @foreach (var opt in IndexModel.RangeOptions)
                    {
                        if (Model.Range == opt.Key)
                        {
                            <option value="@opt.Key" selected>@opt.Label</option>
                        }
                        else
                        {
                            <option value="@opt.Key">@opt.Label</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3 col-lg-2">
                <button type="submit" class="btn btn-hd w-100">Apply</button>
            </div>
        </div>

        @if (d.AppOptions.Count > 0)
        {
            <div class="mt-3">
                <label class="form-label">Show Usage Data</label>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var opt in d.AppOptions)
                    {
                        var checkedAttr = Model.Apps.Count == 0 || Model.Apps.Contains(opt.ProcessName, StringComparer.OrdinalIgnoreCase);
                        <label class="badge-pill @(opt.IsTracked ? "badge-local" : "badge-ended")" style="cursor:pointer;">
                            <input type="checkbox" name="apps" value="@opt.ProcessName" class="form-check-input me-1" @(checkedAttr ? "checked" : null) />
                            @opt.DisplayName
                            @if (!opt.HasData)
                            {
                                <span class="text-secondary" title="No usage data in this period">*</span>
                            }
                        </label>
                    }
                </div>
                <p class="text-secondary small mb-0 mt-2">
                    Tracked apps from config plus any process seen on this machine in the period.
                    Uncheck apps to hide them from the table below; leave all checked to show everything with data.
                </p>
            </div>
        }
    </form>

    <div class="hd-panel">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <h2 class="hd-section-title mb-0">Applications</h2>
            @if (d.Apps.Count > 0)
            {
                <button type="button" class="btn btn-ghost btn-sm" id="machine-apps-expand-all" aria-pressed="false">Show full details</button>
            }
        </div>
        @if (d.Apps.Count == 0)
        {
            <p class="text-secondary mb-0">
                No process runs for the selected apps in this period.
                Time-open stats come from <code>ProcessRun</code> durations (allowlisted apps only).
            </p>
        }
        else
        {
            <div class="hd-machine-apps" id="machine-apps-grid">
                <div class="hd-machine-apps-head">
                    <div class="hd-machine-apps-th" data-sort="text" data-default-desc>Application</div>
                    <div class="hd-machine-apps-th" data-sort="num" data-default-desc>Time open</div>
                    <div class="hd-machine-apps-th" data-sort="num">Avg # open</div>
                    <div class="hd-machine-apps-th" data-sort="num">Runs</div>
                    <div class="hd-machine-apps-th" data-sort="num">Users</div>
                    <div class="hd-machine-apps-th" data-sort="num">Share</div>
                    <div class="hd-machine-apps-th" data-sort="num">Peak CPU</div>
                </div>
                @foreach (var a in d.Apps)
                {
                    var share = appTotal <= 0 ? 0 : a.TotalOpenSeconds * 100.0 / appTotal;
                    var display = d.AppOptions.FirstOrDefault(o =>
                        string.Equals(o.ProcessName, a.ProcessName, StringComparison.OrdinalIgnoreCase))?.DisplayName
                        ?? a.ProcessName;
                    d.ProcessPaths.TryGetValue(a.ProcessName, out var exePath);
                    var label = display;
                    var truncated = label.Length > 20;
                    var shortLabel2 = TruncateName(label);
                    <div class="hd-machine-apps-row">
                        <div class="hd-machine-apps-cell hd-machine-apps-cell--app"
                             data-sort-value="@label"
                             data-full-name="@label"
                             data-process="@a.ProcessName"
                             data-path="@(exePath ?? "")"
                             data-truncated="@(truncated ? "true" : "false")">
                            <a asp-page="/Application" asp-route-process="@a.ProcessName" asp-route-range="@Model.Range" asp-route-hostname="@d.Hostname" class="hd-machine-apps-link" title="@(truncated ? label : null)">
                                <strong class="hd-machine-apps-name">@shortLabel2</strong>
                            </a>
                            @if (!string.Equals(display, a.ProcessName, StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="hd-machine-apps-meta text-secondary">@TruncateName(a.ProcessName)</span>
                            }
                            @if (truncated || !string.IsNullOrWhiteSpace(exePath))
                            {
                                <div class="hd-machine-apps-detail" hidden>
                                    @if (truncated)
                                    {
                                        <div class="hd-machine-apps-fullname">@label</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(exePath))
                                    {
                                        <div class="hd-machine-apps-path text-secondary">@exePath</div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="hd-machine-apps-cell" data-sort-value="@a.TotalOpenSeconds">
                            <span class="hd-machine-apps-val">@DurationDisplay.Render(a.TotalOpenSeconds)</span>
                        </div>
                        <div class="hd-machine-apps-cell" data-sort-value="@a.AvgConcurrentProcesses.ToString("0.###")">
                            <span class="hd-machine-apps-val">@ConcurrentDisplay.Render(a.AvgConcurrentProcesses)</span>
                        </div>
                        <div class="hd-machine-apps-cell" data-sort-value="@a.RunCount">
                            <span class="hd-machine-apps-val">@a.RunCount</span>
                        </div>
                        <div class="hd-machine-apps-cell" data-sort-value="@a.UniqueUsers">
                            <span class="hd-machine-apps-val">@a.UniqueUsers</span>
                        </div>
                        <div class="hd-machine-apps-cell" data-sort-value="@share">
                            <span class="hd-machine-apps-val">@share.ToString("0")%</span>
                        </div>
                        <div class="hd-machine-apps-cell" data-sort-value="@(a.PeakCpuPercent ?? -1)">
                            <span class="hd-machine-apps-val">@StatsModel.FormatPct(a.PeakCpuPercent)</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@section Scripts {
<script>
(() => {
  const grid = document.getElementById('machine-apps-grid');
  if (grid) {
    const expandBtn = document.getElementById('machine-apps-expand-all');
    const setExpanded = (on) => {
      grid.classList.toggle('hd-machine-apps--expanded', on);
      if (expandBtn) {
        expandBtn.textContent = on ? 'Hide full details' : 'Show full details';
        expandBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
      }
    };
    if (expandBtn) {
      expandBtn.addEventListener('click', () => setExpanded(!grid.classList.contains('hd-machine-apps--expanded')));
    }

    grid.querySelectorAll('.hd-machine-apps-cell--app[data-truncated="true"]').forEach(cell => {
      cell.addEventListener('click', (e) => {
        if (e.target.closest('a')) return;
        const detail = cell.querySelector('.hd-machine-apps-detail');
        if (!detail) return;
        const open = cell.classList.toggle('is-expanded');
        detail.hidden = !open;
      });
    });

    const headers = [...grid.querySelectorAll('.hd-machine-apps-th[data-sort]')];
    headers.forEach((th, colIdx) => {
      th.style.cursor = 'pointer';
      th.addEventListener('click', () => {
        const type = th.dataset.sort;
        const rows = [...grid.querySelectorAll('.hd-machine-apps-row')];
        // First click / empty dir → descending; then toggle asc ↔ desc.
        const asc = th.dataset.dir === 'desc';
        headers.forEach(h => { h.dataset.dir = ''; h.classList.remove('sorted-asc', 'sorted-desc'); });
        th.dataset.dir = asc ? 'asc' : 'desc';
        th.classList.add(asc ? 'sorted-asc' : 'sorted-desc');
        rows.sort((ra, rb) => {
          const ca = ra.children[colIdx], cb = rb.children[colIdx];
          let va = ca?.dataset.sortValue ?? ca?.textContent ?? '';
          let vb = cb?.dataset.sortValue ?? cb?.textContent ?? '';
          if (type === 'num') {
            va = parseFloat(va); vb = parseFloat(vb);
            if (Number.isNaN(va)) va = -Infinity;
            if (Number.isNaN(vb)) vb = -Infinity;
            return asc ? va - vb : vb - va;
          }
          va = String(va).toLowerCase(); vb = String(vb).toLowerCase();
          return asc ? va.localeCompare(vb) : vb.localeCompare(va);
        });
        rows.forEach(r => grid.appendChild(r));
      });
      if (th.dataset.defaultDesc !== undefined) th.click();
    });
  }

  const statusEl = document.getElementById('disk-usage-status');
  if (statusEl && statusEl.dataset.pending === '1') {
    const hostname = statusEl.dataset.hostname || '';
    const elapsedLine = document.getElementById('disk-usage-elapsed-line');
    const progressLine = document.getElementById('disk-usage-progress-line');
    const requestedLine = document.getElementById('disk-usage-requested-line');
    let requestedMs = Date.parse(statusEl.dataset.requestedUtc || '');
    let maxSeconds = parseInt(statusEl.dataset.maxSeconds || '180', 10) || 180;
    let stopped = false;

    const fmtBytes = (n) => {
      if (n == null || n < 1024) return (n || 0) + ' B';
      let v = n, u = ['KB', 'MB', 'GB', 'TB'], i = -1;
      do { v /= 1024; i++; } while (v >= 1024 && i < u.length - 1);
      return v.toFixed(2).replace(/\.?0+$/, '') + ' ' + u[i];
    };
    const fmtElapsed = (sec) => {
      sec = Math.max(0, Math.floor(sec));
      const m = Math.floor(sec / 60), s = sec % 60;
      return m > 0 ? `${m}m ${s}s` : `${s}s`;
    };
    const tickElapsed = () => {
      if (!elapsedLine || !Number.isFinite(requestedMs)) return;
      const elapsed = (Date.now() - requestedMs) / 1000;
      const budget = maxSeconds + 30;
      const remain = Math.max(0, budget - elapsed);
      elapsedLine.textContent = Number.isFinite(requestedMs)
        ? `Elapsed ${fmtElapsed(elapsed)} · rough remaining ≤ ${fmtElapsed(remain)} (pickup + scan budget)`
        : '';
    };

    const renderProgress = (p) => {
      if (!progressLine || !p) return;
      let html = `<span class="text-warning">${p.status || 'Queued'}</span>`;
      if (p.message) html += ` — ${p.message}`;
      if ((p.filesSeen | 0) > 0 || (p.bytesScanned | 0) > 0) {
        html += ` · ${Number(p.filesSeen || 0).toLocaleString()} files · ${fmtBytes(p.bytesScanned || 0)}`;
      }
      if (typeof p.elapsedSeconds === 'number' && p.elapsedSeconds > 0) {
        html += ` · agent ${fmtElapsed(p.elapsedSeconds)}`;
      }
      progressLine.innerHTML = html;
    };

    const poll = async () => {
      if (stopped || !hostname) return;
      try {
        const url = new URL(window.location.href);
        url.searchParams.set('handler', 'DiskUsageStatus');
        url.searchParams.set('Hostname', hostname);
        const res = await fetch(url.toString(), { credentials: 'same-origin', headers: { 'Accept': 'application/json' } });
        if (!res.ok) return;
        const data = await res.json();
        if (!data.ok) return;
        if (data.requestedUtc) {
          const ms = Date.parse(data.requestedUtc);
          if (Number.isFinite(ms)) {
            requestedMs = ms;
            statusEl.dataset.requestedUtc = data.requestedUtc;
            if (requestedLine && data.rootPath) {
              const when = new Date(ms).toLocaleString();
              requestedLine.textContent = `Requested ${when} · ${data.rootPath}`;
            }
          }
        }
        if (data.maxSeconds) maxSeconds = data.maxSeconds;
        if (data.progress) renderProgress(data.progress);
        tickElapsed();
        if (data.complete || data.pending === false) {
          stopped = true;
          if (progressLine) {
            progressLine.innerHTML = '<span class="text-success">Ready</span> — refreshing…';
          }
          window.location.reload();
        }
      } catch (_) { /* next tick */ }
    };

    tickElapsed();
    setInterval(tickElapsed, 1000);
    poll();
    setInterval(poll, 3000);
  }
})();
</script>
}
