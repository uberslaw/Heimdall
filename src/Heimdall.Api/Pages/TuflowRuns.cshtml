@page
@model Heimdall.Api.Pages.TuflowRunsModel
@{
    ViewData["Title"] = "TUFLOW Runs";
    ViewData["HelpFragment"] = "tuflow-runs";
}

<div class="hd-panel mb-3">
    <h2 class="hd-section-title mb-0">TUFLOW Runs</h2>
    <p class="text-secondary small mb-0 mt-2"><a asp-page="/Flood" asp-route-tab="sims">View Fleet Sim Progress →</a> (who's running what, where, and how it's tracking)</p>
</div>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-message">@msg</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-error">@err</div>
}

@if (Model.EnrolledCount == 0)
{
    <div class="hd-panel mb-3">
        <p class="text-secondary mb-0">
            No Flood machines are enrolled yet. Enroll machines from <a asp-page="/Flood" asp-route-tab="enroll">Flood → Enrollment</a>
            (Flood allowlist for TUFLOW startability — util sampling is always-on for all clients).
        </p>
    </div>
}
else
{
    <div class="hd-panel mb-3">
        <p class="mb-0">
            <strong>@Model.RunningCount</strong> of <strong>@Model.EnrolledCount</strong> Flood machines
            currently running TUFLOW
            <span class="text-secondary small">
                (≈ @Model.RunningCount licence@(Model.RunningCount == 1 ? "" : "s") in use —
                counts any running TUFLOW instance detected by fleet sampling, not just runs queued from this page)
            </span>
        </p>
    </div>
}

<div class="hd-panel mb-3">
    <div class="table-responsive">
        <table class="hd-table hd-sortable mb-0">
            <thead>
                <tr>
                    <th data-sort="text">Machine</th>
                    <th data-sort="text">Licence / process</th>
                    <th data-sort="text">Heimdall run status</th>
                    <th data-sort="text">Run</th>
                    <th data-sort="text">Last checkpoint</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@(row.FriendlyName ?? row.Hostname)</td>
                    <td><span class="badge-pill @TuflowRunsModel.FleetStatusBadgeClass(row.FleetStatus)">@TuflowRunsModel.FleetStatusLabel(row.FleetStatus)</span></td>
                    <td><span class="badge-pill @TuflowRunsModel.RunStateBadgeClass(row.Status?.State)">@(row.Status?.State ?? "No run")</span></td>
                    <td>
                        @if (row.Status is not null)
                        {
                            <div>@(row.Status.RunName ?? TuflowRunsModel.StatusPrimaryFileName(row.Status))</div>
                            <div class="text-secondary small" title="@TuflowRunsModel.StatusPrimaryPath(row.Status)">@TuflowRunsModel.StatusPrimaryPath(row.Status)</div>
                            @if (!string.IsNullOrWhiteSpace(row.Status.CmdPath) && !string.IsNullOrWhiteSpace(row.Status.TcfPath))
                            {
                                <div class="text-secondary small">tcf: @row.Status.TcfPath</div>
                            }
                            <div class="text-secondary small">run @row.Status.RunId</div>
                        }
                    </td>
                    <td>
                        @if (row.Status?.LastCheckpointUtc is DateTimeOffset cp)
                        {
                            @cp.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            <div class="text-secondary small">@row.Status.LastCheckpointFile</div>
                        }
                    </td>
                    <td>
                        @if (TuflowRunsModel.CanStop(row))
                        {
                            <form method="post" asp-page-handler="StopGraceful" style="display:inline">
                                <input type="hidden" name="hostname" value="@row.Hostname" />
                                <button type="submit" class="btn btn-ghost btn-sm"
                                        onclick="return confirm('Send a graceful stop to TUFLOW on @row.Hostname? It will finish its current checkpoint, release the licence and exit — resume later from the last checkpoint written.');">
                                    Stop gracefully
                                </button>
                            </form>
                        }
                        else if (TuflowRunsModel.CanStart(row))
                        {
                            <button type="button" class="btn btn-hd btn-sm" onclick="document.getElementById('start-@row.Hostname').showModal()">
                                Start…
                            </button>
                            <dialog id="start-@row.Hostname">
                                <form method="post" asp-page-handler="Start" class="hd-panel mb-0" data-tuflow-start>
                                    <input type="hidden" name="hostname" value="@row.Hostname" />
                                    <label class="d-block mb-2">Run name (optional — shown on the Fleet Sim Progress page; defaults to the .tcf or .cmd filename if left blank)
                                        <input class="form-control" name="runName" placeholder="e.g. sim1, 100yr ARI" /></label>
                                    <label class="d-block mb-2">Your name (who's kicking this off)
                                        <input class="form-control" name="requestedBy" value="@Model.SuggestedRequestedBy" placeholder="e.g. C.Smith" /></label>

                                    <fieldset class="mb-2">
                                        <legend class="form-label mb-1">Launch mode</legend>
                                        <label class="d-inline-flex align-items-center me-3 gap-1">
                                            <input type="radio" name="launchMode" value="ExeTcf" checked
                                                   onchange="hdTuflowToggleLaunchMode(this.form)" />
                                            TUFLOW exe + .tcf
                                        </label>
                                        <label class="d-inline-flex align-items-center gap-1">
                                            <input type="radio" name="launchMode" value="Cmd"
                                                   onchange="hdTuflowToggleLaunchMode(this.form)" />
                                            Use existing CMD
                                        </label>
                                    </fieldset>

                                    <div data-mode="ExeTcf">
                                        <label class="d-block mb-2">TUFLOW .exe path <input class="form-control" name="exePath" required placeholder="C:\TUFLOW\Releases\...\TUFLOW_iSP_w64.exe" /></label>
                                        <label class="d-block mb-2">.tcf path <input class="form-control" name="tcfPath" required placeholder="\\server\share\Models\...\MR_H99_C25_Q100.tcf" /></label>
                                        <label class="d-block mb-2">Scenarios (space/comma separated, optional) <input class="form-control" name="scenarios" placeholder="e.g. RESUME" /></label>
                                        <label class="d-block mb-2">Events (space/comma separated, optional) <input class="form-control" name="events" /></label>
                                    </div>
                                    <div data-mode="Cmd" hidden>
                                        <label class="d-block mb-2">CMD/BAT path (absolute or UNC)
                                            <input class="form-control" name="cmdPath" placeholder="\\server\share\Models\...\run_model.cmd" /></label>
                                        <p class="text-secondary small mb-2">
                                            The agent service account must be able to read this path (prefer UNC over mapped drives).
                                            Heimdall checks the script looks like a TUFLOW launch, then runs it with <code>cmd.exe /c</code>
                                            — it does not rebuild TUFLOW.exe arguments from the file.
                                        </p>
                                    </div>

                                    <label class="d-block mb-2">Working directory (optional) <input class="form-control" name="workingDirectory" /></label>
                                    <label class="d-block mb-3">Results folder (optional, else auto-detected) <input class="form-control" name="resultsFolder" /></label>
                                    <button type="submit" class="btn btn-hd btn-sm">Queue start</button>
                                    <button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('start-@row.Hostname').close()">Cancel</button>
                                </form>
                            </dialog>
                        }
                        else if (TuflowRunsModel.IsHeimdallTrackedRunActive(row))
                        {
                            <span class="text-secondary small">Starting…</span>
                        }
                        else
                        {
                            <span class="text-secondary small">TUFLOW is running on this machine outside Heimdall — stop it manually before queuing a run here.</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.RecentDetectedRuns.Count > 0)
{
    <div class="hd-panel mb-3">
        <h3 class="h6 mb-2">Recent detected runs</h3>
        <p class="text-secondary small mb-2">
            CPU-threshold detection (tuflow.exe &gt; 20% for 2 samples → start; ≤ 20% or gone for 2 → stop).
            Independent of Heimdall-queued launches above. Sample series retained for behaviour analysis.
        </p>
        <div class="table-responsive">
            <table class="hd-table hd-sortable mb-0">
                <thead>
                    <tr>
                        <th data-sort="text">Machine</th>
                        <th data-sort="text">User</th>
                        <th data-sort="text">State</th>
                        <th data-sort="text">Launch</th>
                        <th data-sort="text">Stop</th>
                        <th data-sort="num">Duration</th>
                        <th data-sort="num">Ramp-up</th>
                        <th data-sort="num">Ramp-down</th>
                        <th data-sort="num">Peak CPU</th>
                        <th data-sort="num">Peak GPU</th>
                        <th data-sort="text">Hardware</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var d in Model.RecentDetectedRuns)
                {
                    <tr>
                        <td>@(d.FriendlyName ?? d.Hostname)</td>
                        <td>@(d.Username ?? "—")</td>
                        <td>@d.State</td>
                        <td data-sort-value="@(d.DetectedStartUtc?.ToUnixTimeSeconds() ?? 0)">
                            @(d.DetectedStartUtc is { } s ? s.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "—")
                        </td>
                        <td data-sort-value="@(d.DetectedEndUtc?.ToUnixTimeSeconds() ?? 0)">
                            @(d.DetectedEndUtc is { } e ? e.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "—")
                        </td>
                        <td data-sort-value="@(d.Duration?.TotalSeconds ?? -1)">
                            @(d.Duration is { } dur ? TuflowRunsModel.FormatDuration(dur) : "—")
                        </td>
                        <td data-sort-value="@(d.RampUpSeconds ?? -1)">
                            @(d.RampUpSeconds is { } ru ? TuflowRunsModel.FormatSeconds(ru) : "—")
                        </td>
                        <td data-sort-value="@(d.RampDownSeconds ?? -1)">
                            @(d.RampDownSeconds is { } rd ? TuflowRunsModel.FormatSeconds(rd) : "—")
                        </td>
                        <td data-sort-value="@(d.PeakCpuPercent ?? -1)">@(d.PeakCpuPercent is { } pc ? $"{pc:0.0}%" : "—")</td>
                        <td data-sort-value="@(d.PeakGpuPercent ?? -1)">@(d.PeakGpuPercent is { } pg ? $"{pg:0.0}%" : "—")</td>
                        <td class="small text-secondary">
                            @{
                                var hw = string.Join(" · ", new[] { d.HardwareCpu, d.HardwareGpu }.Where(x => !string.IsNullOrWhiteSpace(x)));
                            }
                            @(string.IsNullOrWhiteSpace(hw) ? "—" : hw)
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<script>
function hdTuflowToggleLaunchMode(form) {
    if (!form) return;
    var mode = (form.querySelector('input[name="launchMode"]:checked') || {}).value || 'ExeTcf';
    form.querySelectorAll('[data-mode]').forEach(function (block) {
        var on = block.getAttribute('data-mode') === mode;
        block.hidden = !on;
        block.querySelectorAll('input').forEach(function (input) {
            if (on) {
                if (input.name === 'exePath' || input.name === 'tcfPath') input.required = true;
                if (input.name === 'cmdPath') input.required = true;
            } else {
                input.required = false;
            }
        });
    });
}
document.querySelectorAll('form[data-tuflow-start]').forEach(hdTuflowToggleLaunchMode);
</script>
