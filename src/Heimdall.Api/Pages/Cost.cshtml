@page
@model CostModel
@{
    ViewData["Title"] = "Cost";
    var isPartial = OpsPartial.IsPartial(ViewContext.HttpContext.Request);
    if (isPartial)
        Layout = null;
    var editing = Model.Rows.FirstOrDefault(r => r.Id == Model.EditingMachineId);
}

@if (!isPartial)
{
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <h1 class="hd-title mb-1">Cost</h1>
        <a class="btn btn-ghost btn-sm" asp-page="/Help" asp-fragment="cost">Help</a>
    </div>
}
<p class="hd-sub">
    Hardware purchase cost · user vs <code>ops.</code> support hours · inventory · reimage identity
</p>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="hd-grid">
    <div class="hd-stat">
        <div class="label">Machines</div>
        <div class="value">@Model.Rows.Count</div>
    </div>
    <div class="hd-stat">
        <div class="label">Purchase total</div>
        <div class="value">@(Model.TotalPurchaseCost is null ? "—" : Model.TotalPurchaseCost.Value.ToString("N0"))</div>
    </div>
    <div class="hd-stat">
        <div class="label">User hours (30d)</div>
        <div class="value">@Model.TotalUserHours30d.ToString("0.#")</div>
    </div>
    <div class="hd-stat">
        <div class="label">Support hours (30d)</div>
        <div class="value">@Model.TotalSupportHours30d.ToString("0.#")</div>
    </div>
    <div class="hd-stat">
        <div class="label">Warranty active</div>
        <div class="value">@Model.ActiveWarrantyCount</div>
    </div>
    <div class="hd-stat">
        <div class="label">Reimaged</div>
        <div class="value">@Model.ReimagedCount</div>
    </div>
</div>

<form method="get" class="hd-panel mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-5 col-lg-4">
            <label class="form-label" for="cost-q">Filter</label>
            <input class="form-control" type="search" name="Q" id="cost-q" value="@Model.Q"
                   placeholder="Host, brand, model, serial, CPU, GPU…" />
        </div>
        <div class="col-md-3 col-lg-2">
            <label class="form-label" for="cost-warranty">Warranty</label>
            <select class="form-select" name="Warranty" id="cost-warranty">
                <option value="all" selected="@(string.IsNullOrWhiteSpace(Model.Warranty) || Model.Warranty == "all" ? "selected" : null)">All</option>
                <option value="Active" selected="@(Model.Warranty == "Active" ? "selected" : null)">Active</option>
                <option value="Expired" selected="@(Model.Warranty == "Expired" ? "selected" : null)">Expired</option>
                <option value="Unknown" selected="@(Model.Warranty == "Unknown" ? "selected" : null)">Unknown</option>
            </select>
        </div>
        <div class="col-md-2 col-lg-2">
            <button type="submit" class="btn btn-hd w-100">Apply</button>
        </div>
    </div>
</form>

@if (Model.EditingMachineId is int)
{
    <form method="post" asp-page-handler="Save" class="hd-panel mb-4">
        <input type="hidden" name="Q" value="@Model.Q" />
        <input type="hidden" name="Warranty" value="@Model.Warranty" />
        <input type="hidden" asp-for="EditingMachineId" />
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
            <div>
                <h2 class="h5 mb-1">Edit · @(editing?.Hostname ?? $"#{Model.EditingMachineId}")</h2>
                <p class="text-secondary small mb-0">
                    Agent fills empty hardware fields on heartbeat unless manual override is on.
                    Hostname serial pattern: 3-letter city + optional DT/LT + serial (e.g. <code>BNEDTABC123</code>) — configurable via <code>Heimdall:HostnameSerialPattern</code>.
                </p>
            </div>
            <a class="btn btn-ghost btn-sm" asp-page="/Cost" asp-route-q="@Model.Q" asp-route-warranty="@Model.Warranty">Cancel</a>
        </div>

        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Purchase cost (hardware)</label>
                <input class="form-control" asp-for="PurchaseCost" type="number" step="0.01" min="0" placeholder="e.g. 4200" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Currency</label>
                <input class="form-control" asp-for="PurchaseCurrency" maxlength="8" placeholder="AUD" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Support rate ($/hr)</label>
                <input class="form-control" asp-for="SupportHourlyRate" type="number" step="0.01" min="0" placeholder="optional" />
                <div class="form-text">Applied to <code>ops.</code> sessions · optional</div>
            </div>
            <div class="col-md-2">
                <label class="form-label">Warranty start</label>
                <input class="form-control" asp-for="WarrantyStartDate" type="date" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Warranty end</label>
                <input class="form-control" asp-for="WarrantyEndDate" type="date" />
            </div>
        </div>

        <hr class="border-secondary opacity-25 my-3" />

        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Brand</label>
                <input class="form-control" asp-for="HardwareBrand" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Model</label>
                <input class="form-control" asp-for="HardwareModel" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Asset serial (display)</label>
                <input class="form-control" asp-for="HardwareSerialNumber" />
                <div class="form-text">Prefers hostname serial when BIOS is generic</div>
            </div>
            <div class="col-md-3">
                <label class="form-label">GPU</label>
                <input class="form-control" asp-for="HardwareGpu" />
            </div>
            <div class="col-md-3">
                <label class="form-label">BIOS serial</label>
                <input class="form-control" asp-for="BiosSerial" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Hostname serial</label>
                <input class="form-control" asp-for="AssetSerial" />
            </div>
            <div class="col-md-4">
                <label class="form-label">CPU</label>
                <input class="form-control" asp-for="HardwareCpu" />
            </div>
            <div class="col-md-2">
                <label class="form-label">RAM (GB)</label>
                <input class="form-control" asp-for="HardwareRamGb" type="number" step="0.1" min="0" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Disk (GB)</label>
                <input class="form-control" asp-for="HardwareDiskGb" type="number" step="1" min="0" />
            </div>
            <div class="col-md-2">
                <label class="form-label">PSU (W)</label>
                <input class="form-control" asp-for="PsuWatts" type="number" step="1" min="0" placeholder="manual" />
                <div class="form-text">Rated wattage only — draw not measurable via agent</div>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input class="form-check-input" asp-for="HardwareManualOverride" />
                    <label class="form-check-label" asp-for="HardwareManualOverride">Manual override (block agent)</label>
                </div>
            </div>
        </div>

        @if (editing is not null)
        {
            <div class="row g-3 mt-1 small text-secondary">
                <div class="col-md-4">
                    <strong>OS install (WMI/registry)</strong><br />
                    @(editing.OsInstallDateUtc?.ToString("u") ?? "—")
                    <div class="form-text">May move on Windows feature update</div>
                </div>
                <div class="col-md-4">
                    <strong>Windows folder created</strong><br />
                    @(editing.WindowsFolderCreatedUtc?.ToString("u") ?? "—")
                    <div class="form-text">Often closer to original image</div>
                </div>
                <div class="col-md-4">
                    <strong>Identity</strong><br />
                    Guid: <code>@(editing.MachineGuid ?? "—")</code><br />
                    SMBIOS: <code>@(editing.SmbiosUuid ?? "—")</code>
                    @if (editing.LastReimagedUtc is DateTimeOffset ri)
                    {
                        <div><span class="badge-pill badge-rdp">Reimaged @ri.ToLocalTime().ToString("d")</span></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(editing.CityCode) || !string.IsNullOrWhiteSpace(editing.ChassisHint))
                    {
                        <div>Hostname: @(editing.CityCode) @(editing.ChassisHint)</div>
                    }
                </div>
            </div>
        }

        <div class="d-flex flex-wrap gap-2 mt-3 align-items-center">
            <button type="submit" class="btn btn-hd">Save</button>
            <button type="button" class="btn btn-ghost" disabled
                    title="Backlog: Dell/HP official warranty APIs using detected serial — no web scraping.">
                Lookup warranty (Dell/HP) · soon
            </button>
            @if (editing?.ManualOverride == true)
            {
                <button type="submit" formaction="?handler=ClearOverride" formmethod="post"
                        name="machineId" value="@Model.EditingMachineId"
                        class="btn btn-ghost btn-sm"
                        onclick="return confirm('Allow agent to fill blank hardware fields again?');">
                    Clear override
                </button>
            }
            <span class="text-secondary small">
                Power draw is not reliably measurable via the agent (NVML/RAPL are vendor-specific) — enter PSU rating manually.
            </span>
        </div>

        @if (Model.IdentityHistory.Count > 0)
        {
            <hr class="border-secondary opacity-25 my-3" />
            <h3 class="h6">Identity history</h3>
            <table class="hd-table small hd-sortable">
                <thead>
                    <tr>
                        <th data-sort="date">When</th>
                        <th data-sort="text">Event</th>
                        <th data-sort="text">Old Guid</th>
                        <th data-sort="text">New Guid</th>
                        <th data-sort="text">Detail</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var e in Model.IdentityHistory)
                {
                    <tr>
                        <td data-sort-value="@e.ObservedAtUtc.ToUnixTimeSeconds()">@e.ObservedAtUtc.ToLocalTime().ToString("g")</td>
                        <td><span class="badge-pill badge-rdp">@e.EventType</span></td>
                        <td><code class="small">@(e.OldMachineGuid ?? "—")</code></td>
                        <td><code class="small">@(e.NewMachineGuid ?? "—")</code></td>
                        <td>@(e.Detail ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </form>
}

<div class="hd-panel">
    <table class="hd-table hd-sortable" id="cost-table">
        <thead>
            <tr>
                <th data-sort="text">Host</th>
                <th data-sort="num" data-default-desc>Purchase</th>
                <th data-sort="num" title="Non-ops active hours (30d)">User hrs</th>
                <th data-sort="num" title="ops. / OPS domain active hours (30d)">Support hrs</th>
                <th data-sort="num" title="Purchase ÷ user hours (30d)">$/user hr</th>
                <th data-sort="text">Warranty</th>
                <th data-sort="text">Brand / model</th>
                <th data-sort="text">Serial</th>
                <th data-sort="text">CPU</th>
                <th data-sort="num">RAM</th>
                <th data-sort="num">Disk</th>
                <th data-sort="num">PSU</th>
                <th data-sort="text">OS / identity</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Rows.Count == 0)
        {
            <tr><td colspan="14">No machines match. Wait for agents or clear filters.</td></tr>
        }
        @foreach (var r in Model.Rows)
        {
            var userHrs = r.UserSeconds30d / 3600.0;
            var supportHrs = r.SupportSeconds30d / 3600.0;
            <tr>
                <td data-sort-value="@r.Hostname">
                    <strong>@r.Hostname</strong>
                    @if (r.ManualOverride)
                    {
                        <span class="badge-pill badge-local ms-1" title="Manual override — agent will not change hardware">manual</span>
                    }
                    @if (r.LastReimagedUtc is DateTimeOffset re)
                    {
                        <span class="badge-pill badge-rdp ms-1" title="MachineGuid changed">Reimaged @re.ToLocalTime().ToString("d")</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(r.ChassisHint))
                    {
                        <span class="badge-pill badge-ended ms-1">@r.ChassisHint</span>
                    }
                </td>
                <td data-sort-value="@(r.PurchaseCost ?? -1)">
                    @if (r.PurchaseCost is decimal c)
                    {
                        <span>@c.ToString("N0") @(r.Currency ?? "AUD")</span>
                    }
                    else
                    {
                        <span class="text-secondary">—</span>
                    }
                </td>
                <td data-sort-value="@userHrs">@userHrs.ToString("0.#")</td>
                <td data-sort-value="@supportHrs">
                    @supportHrs.ToString("0.#")
                    @if (r.SupportCostEstimate is decimal sc)
                    {
                        <div class="text-secondary small">est. @sc.ToString("N0")</div>
                    }
                    @if (r.UserToSupportRatio is double ratio)
                    {
                        <div class="text-secondary small">user:ops @ratio:1</div>
                    }
                </td>
                <td data-sort-value="@(r.CostPerUserHour ?? -1)">
                    @if (r.CostPerUserHour is decimal cph)
                    {
                        <span title="Based on @userHrs.ToString("0.#") user hours (30d)">@cph.ToString("N2")</span>
                    }
                    else
                    {
                        <span class="text-secondary">—</span>
                    }
                </td>
                <td data-sort-value="@r.WarrantyStatus">
                    <span class="badge-pill @CostModel.BadgeClass(r.WarrantyStatus)">@r.WarrantyStatus</span>
                    @if (r.WarrantyEnd is DateOnly we)
                    {
                        <div class="text-secondary small">to @we.ToString("yyyy-MM-dd")</div>
                    }
                </td>
                <td data-sort-value="@(r.Brand) @(r.Model)">
                    @(string.IsNullOrWhiteSpace(r.Brand) && string.IsNullOrWhiteSpace(r.Model)
                        ? "—"
                        : $"{r.Brand} {r.Model}".Trim())
                </td>
                <td data-sort-value="@(r.SerialNumber ?? r.AssetSerial ?? "")">
                    <code class="small">@(r.SerialNumber ?? r.AssetSerial ?? "—")</code>
                    @if (!string.IsNullOrWhiteSpace(r.BiosSerial) &&
                         !string.Equals(r.BiosSerial, r.SerialNumber, StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="text-secondary small">BIOS: @r.BiosSerial</div>
                    }
                </td>
                <td data-sort-value="@(r.Cpu ?? "")" class="small">@(r.Cpu ?? "—")</td>
                <td data-sort-value="@(r.RamGb ?? -1)">@(r.RamGb is double ram ? $"{ram:0.#} GB" : "—")</td>
                <td data-sort-value="@(r.DiskGb ?? -1)">@(r.DiskGb is double disk ? $"{disk:0} GB" : "—")</td>
                <td data-sort-value="@(r.PsuWatts ?? -1)">@(r.PsuWatts is int w ? $"{w} W" : "—")</td>
                <td data-sort-value="@(r.WindowsFolderCreatedUtc?.ToUnixTimeSeconds() ?? -1)" class="small">
                    @if (r.OsInstallDateUtc is DateTimeOffset oi)
                    {
                        <div title="WMI/registry InstallDate — may move on feature update">OS: @oi.ToLocalTime().ToString("d")</div>
                    }
                    @if (r.WindowsFolderCreatedUtc is DateTimeOffset wf)
                    {
                        <div title="%SystemRoot% creation time">Win: @wf.ToLocalTime().ToString("d")</div>
                    }
                    @if (r.OsInstallDateUtc is null && r.WindowsFolderCreatedUtc is null)
                    {
                        <span class="text-secondary">—</span>
                    }
                </td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-ghost btn-sm"
                       asp-page="/Cost"
                       asp-route-edit="@r.Id"
                       asp-route-q="@Model.Q"
                       asp-route-warranty="@Model.Warranty">Edit</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
