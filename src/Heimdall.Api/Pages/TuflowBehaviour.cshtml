@page
@model Heimdall.Api.Pages.TuflowBehaviourModel
@{
    ViewData["Title"] = "TUFLOW Run Behaviour";
    ViewData["HelpFragment"] = "tuflow-behaviour";
    var isPartial = OpsPartial.IsPartial(ViewContext.HttpContext.Request);
    if (isPartial)
        Layout = null;

    var a = Model.Analytics;
    var maxHour = a.StartHourHistogram.Count > 0 ? a.StartHourHistogram.Max(h => h.Count) : 0;
}

@if (!isPartial)
{
    <p class="text-secondary small">
        <a asp-page="/TuflowRuns">← TUFLOW Runs</a>
        ·
        <a asp-page="/Flood" asp-route-tab="sims">Fleet Sims</a>
    </p>
}

<div class="hd-panel mb-3">
    @if (!isPartial)
    {
        <h2 class="hd-section-title mb-2">TUFLOW run behaviour</h2>
    }
    <p class="text-secondary small mb-3">
        Confirmed starts use <code>DetectedStartUtc</code> / <code>DetectedEndUtc</code> from CPU/GPU threshold detection
        (same source as Live Active stamps). Watching-only rows without a confirmed start are excluded.
        Duration averages use completed runs only; open Active runs are counted separately.
    </p>

    <form method="get" action="/TuflowBehaviour" class="d-flex flex-wrap gap-2 align-items-end mb-3">
        <div>
            <label class="form-label small mb-1" for="days">Date range</label>
            <select class="form-select form-select-sm" id="days" name="days" onchange="this.form.submit()">
                @foreach (var d in TuflowBehaviourModel.DayChoices)
                {
                    if (Model.Days == d)
                    {
                        <option value="@d" selected>Last @d days</option>
                    }
                    else
                    {
                        <option value="@d">Last @d days</option>
                    }
                }
            </select>
        </div>
        <span class="text-secondary small pb-1">
            From @a.FromUtc.ToLocalTime().ToString("dd/MM/yyyy") (local) · @a.ConfirmedStarts confirmed start@(a.ConfirmedStarts == 1 ? "" : "s")
        </span>
    </form>

    <div class="hd-grid mb-0">
        <div class="hd-stat"><div class="label">Confirmed starts</div><div class="value">@a.ConfirmedStarts</div></div>
        <div class="hd-stat"><div class="label">Completed</div><div class="value">@a.CompletedRuns</div></div>
        <div class="hd-stat"><div class="label">Open / in progress</div><div class="value">@a.OpenRuns</div></div>
        <div class="hd-stat"><div class="label">Avg completed</div><div class="value">@TuflowBehaviourModel.FormatDuration(a.AvgCompletedDuration)</div></div>
        <div class="hd-stat"><div class="label">Median completed</div><div class="value">@TuflowBehaviourModel.FormatDuration(a.MedianCompletedDuration)</div></div>
        <div class="hd-stat"><div class="label">Peak start hour</div><div class="value">@TuflowBehaviourModel.FormatPeakHour(a.PeakStartHourLocal)</div></div>
    </div>
</div>

<div class="hd-panel mb-3">
    <h3 class="h6 mb-2">When do runs usually start?</h3>
    <p class="text-secondary small mb-2">Local hour of day · confirmed <code>DetectedStartUtc</code> only</p>
    @if (maxHour <= 0)
    {
        <p class="text-secondary mb-0">No confirmed starts in this range.</p>
    }
    else
    {
        <div class="hd-user-bars hd-user-bars--hours">
            @foreach (var row in a.StartHourHistogram)
            {
                <div class="hd-user-bar-row">
                    <div class="hd-user-bar-label" title="@($"{row.HourLocal:00}:00")">@($"{row.HourLocal:00}")</div>
                    <div class="hd-user-bar-track" title="@row.Count start(s)" aria-hidden="true">
                        <div class="hd-user-bar-fill" style="width:@TuflowBehaviourModel.FormatHourBar(row.Count, maxHour)"></div>
                    </div>
                    <div class="hd-user-bar-val">@row.Count</div>
                </div>
            }
        </div>
    }
</div>

<div class="hd-panel mb-3">
    <h3 class="h6 mb-2">By user</h3>
    <p class="text-secondary small mb-2">
        Username from the interactive session on the host when the run was detected
        (ops.* names are not preferred once a non-ops user is known).
    </p>
    @if (a.ByUser.Count == 0)
    {
        <p class="text-secondary mb-0">No data.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="hd-table hd-sortable mb-0">
                <thead>
                    <tr>
                        <th data-sort="text">User</th>
                        <th data-sort="num">Starts</th>
                        <th data-sort="num">Completed</th>
                        <th data-sort="num">Open</th>
                        <th data-sort="num">Avg duration</th>
                        <th data-sort="num">Median duration</th>
                        <th data-sort="num">Peak start hour</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in a.ByUser)
                {
                    <tr>
                        <td>@row.Label</td>
                        <td data-sort-value="@row.RunCount">
                            @if (row.RunCount > 0)
                            {
                                <button type="button"
                                        class="hd-runs-filter-btn"
                                        data-runs-filter-dim="user"
                                        data-runs-filter-value="@row.Label"
                                        data-runs-filter-status="all"
                                        title="Show runs for this user">@row.RunCount</button>
                            }
                            else
                            {
                                @row.RunCount
                            }
                        </td>
                        <td data-sort-value="@row.CompletedCount">
                            @if (row.CompletedCount > 0)
                            {
                                <button type="button"
                                        class="hd-runs-filter-btn"
                                        data-runs-filter-dim="user"
                                        data-runs-filter-value="@row.Label"
                                        data-runs-filter-status="completed"
                                        title="Show completed runs for this user">@row.CompletedCount</button>
                            }
                            else
                            {
                                @row.CompletedCount
                            }
                        </td>
                        <td data-sort-value="@row.OpenCount">@row.OpenCount</td>
                        <td data-sort-value="@(row.AvgCompletedDuration?.TotalSeconds ?? -1)">@TuflowBehaviourModel.FormatDuration(row.AvgCompletedDuration)</td>
                        <td data-sort-value="@(row.MedianCompletedDuration?.TotalSeconds ?? -1)">@TuflowBehaviourModel.FormatDuration(row.MedianCompletedDuration)</td>
                        <td data-sort-value="@(row.PeakStartHourLocal ?? -1)">@TuflowBehaviourModel.FormatPeakHour(row.PeakStartHourLocal)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="hd-panel mb-3">
    <h3 class="h6 mb-2">By machine</h3>
    @if (a.ByMachine.Count == 0)
    {
        <p class="text-secondary mb-0">No data.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="hd-table hd-sortable mb-0">
                <thead>
                    <tr>
                        <th data-sort="text">Machine</th>
                        <th data-sort="num">Starts</th>
                        <th data-sort="num">Completed</th>
                        <th data-sort="num">Open</th>
                        <th data-sort="num">Avg duration</th>
                        <th data-sort="num">Median duration</th>
                        <th data-sort="num">Peak start hour</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in a.ByMachine)
                {
                    <tr>
                        <td>@row.Label</td>
                        <td data-sort-value="@row.RunCount">
                            @if (row.RunCount > 0)
                            {
                                <button type="button"
                                        class="hd-runs-filter-btn"
                                        data-runs-filter-dim="machine"
                                        data-runs-filter-value="@row.Label"
                                        data-runs-filter-status="all"
                                        title="Show runs for this machine">@row.RunCount</button>
                            }
                            else
                            {
                                @row.RunCount
                            }
                        </td>
                        <td data-sort-value="@row.CompletedCount">
                            @if (row.CompletedCount > 0)
                            {
                                <button type="button"
                                        class="hd-runs-filter-btn"
                                        data-runs-filter-dim="machine"
                                        data-runs-filter-value="@row.Label"
                                        data-runs-filter-status="completed"
                                        title="Show completed runs for this machine">@row.CompletedCount</button>
                            }
                            else
                            {
                                @row.CompletedCount
                            }
                        </td>
                        <td data-sort-value="@row.OpenCount">@row.OpenCount</td>
                        <td data-sort-value="@(row.AvgCompletedDuration?.TotalSeconds ?? -1)">@TuflowBehaviourModel.FormatDuration(row.AvgCompletedDuration)</td>
                        <td data-sort-value="@(row.MedianCompletedDuration?.TotalSeconds ?? -1)">@TuflowBehaviourModel.FormatDuration(row.MedianCompletedDuration)</td>
                        <td data-sort-value="@(row.PeakStartHourLocal ?? -1)">@TuflowBehaviourModel.FormatPeakHour(row.PeakStartHourLocal)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="hd-panel mb-3" id="hd-behaviour-runs">
    <h3 class="h6 mb-2">Runs</h3>
    <p class="text-secondary small mb-2">
        Confirmed starts in this range (newest first). Each run shows details, then a multi-metric chart
        (GPU/CPU/RAM% and Disk W / Net Tx MB/s; process metrics when present). Toggle series with the checkboxes.
        Scroll-wheel or buttons zoom; reset restores the full run. Zoom bottoms out at sample spacing (~10s while TUFLOW is watched).
        Click a Starts or Completed count in the tables above to filter this list, or use the controls below.
        @if (a.RunsTruncated)
        {
            <span>Showing latest @a.Runs.Count of @a.RunsTotalInWindow.</span>
        }
    </p>
    @if (a.Runs.Count == 0)
    {
        <p class="text-secondary mb-0">No confirmed runs in this range.</p>
    }
    else
    {
        var runUsers = a.Runs
            .Select(r => string.IsNullOrWhiteSpace(r.Username) ? "(unknown)" : r.Username!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(u => u, StringComparer.OrdinalIgnoreCase)
            .ToList();
        var runMachines = a.Runs
            .Select(r => r.MachineLabel)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(m => m, StringComparer.OrdinalIgnoreCase)
            .ToList();
        <div class="hd-runs-toolbar mb-2" data-runs-toolbar>
            <div class="hd-runs-toolbar-fields">
                <div>
                    <label class="form-label small mb-1" for="hd-runs-user">User</label>
                    <select class="form-select form-select-sm" id="hd-runs-user" data-runs-user>
                        <option value="">All users</option>
                        @foreach (var u in runUsers)
                        {
                            <option value="@u">@u</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label small mb-1" for="hd-runs-machine">Machine</label>
                    <select class="form-select form-select-sm" id="hd-runs-machine" data-runs-machine>
                        <option value="">All machines</option>
                        @foreach (var m in runMachines)
                        {
                            <option value="@m">@m</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label small mb-1" for="hd-runs-from">From</label>
                    <input type="date" class="form-control form-control-sm" id="hd-runs-from" data-runs-from />
                </div>
                <div>
                    <label class="form-label small mb-1" for="hd-runs-to">To</label>
                    <input type="date" class="form-control form-control-sm" id="hd-runs-to" data-runs-to />
                </div>
                <div>
                    <label class="form-label small mb-1" for="hd-runs-status">Status</label>
                    <select class="form-select form-select-sm" id="hd-runs-status" data-runs-status>
                        <option value="all">All</option>
                        <option value="completed">Completed</option>
                        <option value="open">Open</option>
                    </select>
                </div>
                <div>
                    <label class="form-label small mb-1" for="hd-runs-limit">Show</label>
                    <select class="form-select form-select-sm" id="hd-runs-limit" data-runs-limit>
                        <option value="10">10 runs</option>
                        <option value="25">25 runs</option>
                        <option value="50">50 runs</option>
                        <option value="0" selected>All listed</option>
                    </select>
                </div>
            </div>
            <div class="hd-runs-toolbar-actions">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-gpu-toggle-all aria-pressed="true">Hide all charts</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-runs-filter-clear>Clear filters</button>
            </div>
        </div>
        <p class="text-secondary small mb-2" data-runs-filter-label></p>
        <div class="hd-run-list" data-runs-list>
        @foreach (var row in a.Runs)
        {
            var seriesJson = TuflowBehaviourModel.GpuSeriesJson(row);
            var userKey = string.IsNullOrWhiteSpace(row.Username) ? "(unknown)" : row.Username!;
            var startLocal = row.DetectedStartUtc.ToLocalTime();
            <div class="hd-run-block"
                 data-run-user="@userKey"
                 data-run-machine="@row.MachineLabel"
                 data-run-open="@(row.IsOpen ? "1" : "0")"
                 data-run-start="@startLocal.ToString("yyyy-MM-dd")">
                <div class="hd-run-meta-row">
                    <div class="hd-run-meta table-responsive">
                        <table class="hd-table mb-0 hd-run-meta-table">
                            <thead>
                                <tr>
                                    <th>Machine</th>
                                    <th>User</th>
                                    <th>Start</th>
                                    <th>End</th>
                                    <th>Duration</th>
                                    <th title="@TuflowBehaviourModel.AvgGpuTitle">Avg GPU</th>
                                    <th title="@TuflowBehaviourModel.PeakGpuTitle">Peak GPU</th>
                                    <th title="@TuflowBehaviourModel.HighGpuTitle">High GPU</th>
                                    <th>Samples</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>@row.MachineLabel</td>
                                    <td>@(row.Username ?? "—")</td>
                                    <td>@TuflowBehaviourModel.FormatLocalStamp(row.DetectedStartUtc)</td>
                                    <td>
                                        @if (row.IsOpen || row.DetectedEndUtc is null)
                                        {
                                            <span class="text-secondary">open</span>
                                        }
                                        else
                                        {
                                            @TuflowBehaviourModel.FormatLocalStamp(row.DetectedEndUtc.Value)
                                        }
                                    </td>
                                    <td>@TuflowBehaviourModel.FormatDuration(row.Duration)</td>
                                    <td title="@TuflowBehaviourModel.AvgGpuTitle">@TuflowBehaviourModel.FormatGpuPercent(row.AvgGpuPercent)</td>
                                    <td title="@TuflowBehaviourModel.PeakGpuTitle">@TuflowBehaviourModel.FormatGpuPercent(row.PeakGpuPercent)</td>
                                    <td title="@TuflowBehaviourModel.HighGpuTitle">@TuflowBehaviourModel.FormatHighGpu(row.HighGpuSeconds)</td>
                                    <td>@row.GpuSeries.Count</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary hd-run-gpu-toggle"
                            data-gpu-toggle
                            aria-pressed="true"
                            title="Show or hide this run’s utilization chart">Hide chart</button>
                </div>
                <div class="hd-gpu-chart"
                     data-gpu-panel
                     data-start-unix="@row.DetectedStartUtc.ToUnixTimeSeconds()"
                     data-end-unix="@((row.DetectedEndUtc ?? DateTimeOffset.UtcNow).ToUnixTimeSeconds())"
                     data-series="@seriesJson">
                    <div class="hd-gpu-chart-toolbar">
                        <span class="hd-gpu-chart-title">Utilization over run</span>
                        <span class="hd-gpu-chart-range text-secondary small" data-range-label></span>
                        <div class="hd-gpu-chart-actions">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-zoom-out title="Zoom out">−</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-zoom-in title="Zoom in">+</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-zoom-reset title="Show full run">Reset</button>
                        </div>
                    </div>
                    <canvas class="hd-gpu-chart-canvas" width="900" height="140" aria-label="Utilization over time"></canvas>
                    <p class="hd-gpu-chart-hint text-secondary small mb-0">Scroll wheel over the chart to zoom · drag to pan when zoomed</p>
                </div>
            </div>
        }
        </div>
        <p class="text-secondary small mb-0" data-runs-filter-empty hidden>No listed runs match this filter.</p>
        <script src="~/js/hd-gpu-run-chart.js" asp-append-version="true"></script>
        <script src="~/js/hd-behaviour-runs.js" asp-append-version="true"></script>
    }
</div>
