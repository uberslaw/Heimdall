<?xml version="1.0" encoding="utf-8"?>
<!--
  Ensures restores can reach nuget.org (needed for Pack-WorkstationCollector /
  self-contained publish). Corporate machines often only have offline VS feeds,
  which causes NU1101 for Microsoft.Data.Sqlite, runtime packs, etc.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
